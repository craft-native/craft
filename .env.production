# Production release credentials — encrypted, and committed on purpose.
#
# Everything below is ciphertext once set, so this file is safe in the
# repository: the only thing that opens it is DOTENV_PRIVATE_KEY_PRODUCTION,
# which is the single repository secret the release workflow needs. That is the
# trade — the ciphertext is public, so the key is the whole of the secrecy — and
# what it buys is that rotating a certificate is a reviewable commit rather than
# seven trips through a settings page, and that the same file signs a build on a
# laptop through `bun scripts/env.ts get`.
#
# Encryption is Stacks' — X25519 + HKDF-SHA-256 + AES-256-GCM per value, so
# every entry carries its own ephemeral key and nothing is reused across the
# file. See @stacksjs/env.
#
# Set a value (encrypts in place, generates the keypair on first use):
#
#   bun scripts/env.ts set APPLE_TEAM_ID 'XXXXXXXXXX'
#
# The first `set` writes DOTENV_PRIVATE_KEY_PRODUCTION to .env.keys, which is
# gitignored. Put it in the repository's secrets and nowhere else; it is not
# recoverable from this file.
#
# Read one back locally:
#
#   bun scripts/env.ts get APPLE_TEAM_ID

# The Developer ID Application certificate, as a base64 .p12.
#   base64 -i certificate.p12 | pbcopy
APPLE_CERTIFICATE_BASE64=

# The password the .p12 was exported with.
APPLE_CERTIFICATE_PASSWORD=

# The identity codesign signs with, exactly as `security find-identity -v
# -p codesigning` prints it — e.g. "Developer ID Application: Name (TEAMID)".
APPLE_SIGNING_IDENTITY=

# Any string. It is the password for the throwaway keychain CI creates for the
# certificate and destroys with the runner.
KEYCHAIN_PASSWORD=

# The Apple ID that notarizes, and an app-specific password for it —
# appleid.apple.com → Sign-In and Security → App-Specific Passwords. Not the
# account password.
APPLE_ID=
APPLE_APP_PASSWORD=

# The ten-character team identifier from developer.apple.com → Membership.
APPLE_TEAM_ID=
