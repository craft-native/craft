// Compiled with the released CraftNativeMedia into an iOS simulator process.
import AVFoundation

let base = CommandLine.arguments[1]
let phase = CommandLine.arguments[2]
let fm = FileManager.default
func check(_ yes: @autoclosure () -> Bool, _ message: String) {
    guard yes() else { print("FAIL: \(message)"); exit(1) }
    print("PASS: \(message)")
}
func wait(_ ready: () -> Bool) {
    let limit = Date().addingTimeInterval(25)
    while !ready() && Date() < limit { RunLoop.current.run(until: Date().addingTimeInterval(0.01)) }
    check(ready(), "operation settled")
}
var latestTask: URLSessionTask?
var latestErrorCode: String?
func start(_ source: String, cacheKey: String? = nil, _ done: @escaping (Bool) -> Void) {
    let address = CraftNativeMedia.identity(source, options: cacheKey.map { ["cacheKey": $0] } ?? [:])
    if let local = CraftNativeMedia.local(address) { done((CraftNativeMedia.describe(address, local)["size"] as? Int ?? 0) > 0); return }
    guard let flight = CraftNativeMedia.begin(address, { result in
        if case .success(let data) = result { done((data as? [String: Any])?["ok"] as? Bool == true) }
        else if case .failure(let error) = result { latestErrorCode = error.code; done(false) }
    }) else { return }
    let task = URLSession.shared.downloadTask(with: URL(string: source)!) { location, response, error in
        let result: Result<Any, CraftNativeActionError>
        if error != nil { result = .failure(CraftNativeActionError(code: "NETWORK_ERROR", message: "Interrupted")) }
        else if let location, let response = response as? HTTPURLResponse { result = CraftNativeMedia.store(address, at: location, response: response, flight: flight) }
        else { result = .failure(CraftNativeActionError(code: "NETWORK_ERROR", message: "No file")) }
        CraftNativeMedia.finish(address, flight: flight, result)
    }
    latestTask = task
    task.resume()
}
func keep(_ address: String, cacheKey: String? = nil) -> Bool {
    var result: Bool?
    start(address, cacheKey: cacheKey) { result = $0 }
    wait { result != nil }
    return result!
}
let restart = base + "/restart.mp4"
if phase == "storage" {
    let volume = CraftNativeMedia.root.deletingLastPathComponent()
    let capacity = try volume.resourceValues(forKeys: [.volumeTotalCapacityKey]).volumeTotalCapacity ?? 0
    check(capacity > 0 && capacity <= 32 * 1024 * 1024, "storage pressure is confined to a bounded disposable volume")
    let progress = volume.appendingPathComponent("workout-progress.json")
    let saved = Data(#"{"sets":["A1"],"note":"Keep this workout","rpe":7}"#.utf8)
    try saved.write(to: progress)
    let pressure = volume.appendingPathComponent("pressure")
    defer { try? fm.removeItem(at: pressure); try? fm.removeItem(at: progress) }
    let retained = base + "/retained.mp4"
    check(keep(retained), "existing video is kept before storage pressure")
    let original = try Data(contentsOf: CraftNativeMedia.local(retained)!)
    fm.createFile(atPath: pressure.path, contents: nil)
    let writer = try FileHandle(forWritingTo: pressure)
    var written = 0
    for size in [65536, 1024] {
        let chunk = Data(repeating: 0x5A, count: size)
        while written < 32 * 1024 * 1024 {
            do { try writer.write(contentsOf: chunk); written += size }
            catch { break }
        }
    }
    try writer.close()
    let fresh = base + "/storage.mp4"
    check(!keep(fresh), "full cache volume refuses a new video")
    check(latestErrorCode == "NO_SPACE", "a full disk is reported as NO_SPACE, not a network failure")
    check(CraftNativeMedia.local(fresh) == nil, "storage failure never publishes a partial video")
    check((try? Data(contentsOf: CraftNativeMedia.local(retained)!)) == original, "storage failure preserves an existing video")
    check(((try? fm.contentsOfDirectory(atPath: CraftNativeMedia.root.path)) ?? []).allSatisfy { !$0.hasSuffix(".part") }, "storage failure removes staging files")
    check(CraftNativeMedia.prune(keep: []) == 1, "cache cleanup frees only the retained video")
    check((try? Data(contentsOf: progress)) == saved, "cache cleanup preserves workout progress and feedback")
    check(keep(fresh), "same missing video downloads after cache cleanup frees space")
    let generator = AVAssetImageGenerator(asset: AVURLAsset(url: CraftNativeMedia.local(fresh)!))
    do { _ = try generator.copyCGImage(at: CMTime(seconds: 1, preferredTimescale: 600), actualTime: nil) }
    catch { check(false, "downloaded replacement decodes: \(error)") }
    check(true, "downloaded replacement plays from its local file")
    check((try? Data(contentsOf: progress)) == saved, "redownloading leaves workout progress and feedback unchanged")
    _ = CraftNativeMedia.prune(keep: [])
    exit(0)
}
if phase == "retire" || phase == "retired-recover" {
    let a = base + "/selective-a.mp4"
    let b = base + "/selective-b.mp4"
    let saved = CraftNativeMedia.root.deletingLastPathComponent().appendingPathComponent("obsolete-stamp.json")
    if phase == "retire" {
        check(keep(a) && keep(b), "two authorized videos are kept")
        let flight = CraftNativeMedia.begin(a) { _ in }!
        let stamp = CraftNativeMedia.ownershipStamp(a, flight: flight)!
        try JSONEncoder().encode(stamp).write(to: saved)
        try fm.setAttributes([.posixPermissions: 0o555], ofItemAtPath: CraftNativeMedia.root.path)
        var unlinkFailed = false
        do { _ = try CraftNativeMedia.remove(a) } catch { unlinkFailed = true }
        try fm.setAttributes([.posixPermissions: 0o700], ofItemAtPath: CraftNativeMedia.root.path)
        check(unlinkFailed, "a real unlink failure is reported")
        check(CraftNativeMedia.local(a) == nil && CraftNativeMedia.local(b) != nil, "failed unlink hides revoked A and preserves authorized B")
        let removed = try CraftNativeMedia.remove(a)
        check(removed == 1, "removing A removes only its copy")
        check(CraftNativeMedia.local(a) == nil && CraftNativeMedia.local(b) != nil, "B stays available after A is revoked")
    } else {
        let stamp = try JSONDecoder().decode(CraftNativeMediaOwnership.Stamp.self, from: Data(contentsOf: saved))
        check(CraftNativeMedia.local(a) == nil && CraftNativeMedia.local(b) != nil, "selective revocation survives a fresh simulator process")
        func obsoleteCompletion() throws {
            let payload = CraftNativeMedia.root.deletingLastPathComponent().appendingPathComponent("obsolete-download.mp4")
            try Data(contentsOf: CraftNativeMedia.local(b)!).write(to: payload)
            defer { try? fm.removeItem(at: payload) }
            let response = HTTPURLResponse(url: URL(string: a)!, statusCode: 200, httpVersion: nil, headerFields: nil)!
            let result = CraftNativeMedia.store(a, at: payload, response: response, stamp: stamp)
            if case .failure(let error) = result { check(error.code == "CANCELLED", "obsolete transfer cannot publish after process restart") }
            else { check(false, "obsolete transfer was accepted") }
        }
        try obsoleteCompletion()
        check(keep(a), "a new authorized keep can re-grant A")
        try obsoleteCompletion()
        check(CraftNativeMedia.local(a) != nil && CraftNativeMedia.local(b) != nil, "old completion cannot replace re-granted A or remove B")
        let generator = AVAssetImageGenerator(asset: AVURLAsset(url: CraftNativeMedia.local(b)!))
        _ = try generator.copyCGImage(at: CMTime(seconds: 1, preferredTimescale: 600), actualTime: nil)
        check(true, "unrelated B still decodes offline after revocation and re-grant")
        _ = try CraftNativeMedia.clear()
        try fm.removeItem(at: saved)
    }
    exit(0)
}
if phase == "interrupt" {
    _ = CraftNativeMedia.prune(keep: [])
    start(restart) { _ in }
    print("INTERRUPTING"); fflush(stdout)
    wait { (latestTask?.countOfBytesReceived ?? 0) > 0 }
    print("KILLING"); fflush(stdout)
    raise(SIGKILL)
    exit(2)
}
if phase == "recover" {
    check(CraftNativeMedia.local(restart) == nil, "interrupted process never published a partial video")
    check(keep(restart), "retry after process death downloads a complete video")
    let local = CraftNativeMedia.local(restart)!
    let generator = AVAssetImageGenerator(asset: AVURLAsset(url: local))
    do { _ = try generator.copyCGImage(at: CMTime(seconds: 1, preferredTimescale: 600), actualTime: nil) }
    catch { check(false, "recovered video decodes offline: \(error)") }
    check(true, "recovered local video decodes a frame without network")
    _ = CraftNativeMedia.prune(keep: [])
    exit(0)
}
_ = CraftNativeMedia.prune(keep: [])
let broken = base + "/broken.mp4"
check(!keep(broken), "truncated transfer fails")
check(CraftNativeMedia.local(broken) == nil, "truncated transfer is not playable cache")
check(keep(broken), "same URL retries successfully")
check(!keep(base + "/partial.mp4"), "unsolicited partial response is refused")
check(!keep(base + "/empty.mp4"), "empty file is refused")
let signed = base + "/keyed.mp4?token=first"
let key = "account:one:lesson:7:version:a"
check(keep(signed, cacheKey: key), "authorized signed URL downloads under account/version identity")
let identity = CraftNativeMedia.identity(signed, options: ["cacheKey": key])
let rotated = CraftNativeMedia.identity(base + "/keyed.mp4?token=second", options: ["cacheKey": key])
check(identity == rotated && CraftNativeMedia.local(rotated) != nil, "renewing a signed URL reuses the complete cached file offline")
check(keep(base + "/keyed.mp4?token=second", cacheKey: key), "renewed authorization does not redownload unchanged content")
check(CraftNativeMedia.local(CraftNativeMedia.identity(signed, options: ["cacheKey": "account:two:lesson:7:version:a"])) == nil, "another account cannot address the private copy")
check(CraftNativeMedia.local(CraftNativeMedia.identity(signed, options: ["cacheKey": "account:one:lesson:7:version:b"])) == nil, "a new prepared version invalidates the old copy")
_ = CraftNativeMedia.prune(keep: [rotated])
check(CraftNativeMedia.local(rotated) != nil, "key-aware prune retains the current authorized source")
_ = CraftNativeMedia.prune(keep: [])
check(CraftNativeMedia.local(rotated) == nil, "definitive revocation removes the keyed copy")
let slow = base + "/slow.mp4"
var answers = [Bool]()
start(slow) { answers.append($0) }
start(slow) { answers.append($0) }
RunLoop.current.run(until: Date().addingTimeInterval(0.15))
_ = CraftNativeMedia.prune(keep: [])
wait { answers.count == 2 }
check(answers == [true, true], "concurrent downloads coalesce and survive prune")
let parts = (try? fm.contentsOfDirectory(atPath: CraftNativeMedia.root.path))?.filter { $0.hasSuffix(".part") } ?? []
check(parts.isEmpty, "no abandoned staging files remain")
_ = CraftNativeMedia.prune(keep: [])
let privateVideo = base + "/account/slow.mp4"
var previousAnswer: Bool?
start(privateVideo) { previousAnswer = $0 }
let previousTask = latestTask!
wait { previousTask.countOfBytesReceived > 0 }
_ = try CraftNativeMedia.clear()
check(previousAnswer == false && latestErrorCode == "CANCELLED", "sign-out cancels the previous athlete's download")
check(CraftNativeMedia.local(privateVideo) == nil, "signed-out video is not playable from cache")
check(keep(privateVideo), "the next athlete downloads the same URL in a new transfer")
wait { previousTask.state == .completed }
let cached = CraftNativeMedia.local(privateVideo)!
let generator = AVAssetImageGenerator(asset: AVURLAsset(url: cached))
_ = try generator.copyCGImage(at: CMTime(seconds: 1, preferredTimescale: 600), actualTime: nil)
check(true, "the next athlete's local video decodes after the old download settles")
_ = try CraftNativeMedia.clear()
check(CraftNativeMedia.local(privateVideo) == nil, "sign-out removes the next athlete's cached copy too")
