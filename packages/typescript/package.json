{
  "name": "craft-native",
  "version": "0.0.87",
  "type": "module",
  "description": "Build desktop apps with web languages - TypeScript SDK for Craft",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/craft-native/craft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craft-native/craft.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/craft-native/craft/issues"
  },
  "keywords": [
    "desktop",
    "app",
    "framework",
    "webview",
    "zig",
    "native",
    "cross-platform",
    "electron-alternative",
    "tauri-alternative",
    "gui",
    "typescript",
    "bun"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js",
      "default": "./dist/mobile.js"
    },
    "./ios": {
      "browser": null,
      "types": "./dist/ios/src/index.d.ts",
      "import": "./dist/ios/src/index.js"
    },
    "./android": {
      "browser": null,
      "types": "./dist/android/src/index.d.ts",
      "import": "./dist/android/src/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "mobile": [
        "./dist/mobile.d.ts"
      ],
      "ios": [
        "./dist/ios/src/index.d.ts"
      ],
      "android": [
        "./dist/android/src/index.d.ts"
      ]
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "bin": {
    "craft-sdk": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build.ts && bun run build:types",
    "build:lib": "bun build src/index.ts --outdir dist --format esm --target bun && bun build src/index.ts --outfile dist/index.cjs --format cjs --target node",
    "build:types": "bunx --bun tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "dev": "bun --watch src/index.ts",
    "lint": "bunx --bun pickier lint . --config ../../pickier.config.ts --max-warnings 9999",
    "lint:fix": "bunx --bun pickier lint . --fix --config ../../pickier.config.ts --max-warnings 9999",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@stacksjs/clapp": "^0.2.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "better-dx": "^0.2.7"
  }
}
