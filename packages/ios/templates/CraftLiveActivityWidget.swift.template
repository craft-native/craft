import ActivityKit
import SwiftUI
import WidgetKit

@main
struct CraftLiveActivityBundle: WidgetBundle {
    var body: some Widget { CraftLiveActivityWidget() }
}

struct CraftLiveActivityWidget: Widget {
    var body: some WidgetConfiguration {
        ActivityConfiguration(for: CraftActivityAttributes.self) { context in
            HStack(spacing: 12) {
                activityIcon(context).font(.title2)
                VStack(alignment: .leading, spacing: 4) {
                    Text(context.attributes.title).font(.headline).lineLimit(2)
                    if let detail = context.state.detail, !detail.isEmpty {
                        Text(detail).font(.subheadline).lineLimit(1)
                    }
                    Text(context.isStale ? context.state.staleStatus ?? context.state.status : context.state.status).font(.caption).foregroundStyle(.secondary).lineLimit(1)
                }
                Spacer(minLength: 8)
                VStack(alignment: .trailing, spacing: 4) {
                    timer(context).font(.title2.monospacedDigit().weight(.semibold))
                    metrics(context).font(.caption.monospacedDigit())
                }
            }
            .foregroundStyle(.white)
            .padding()
            .activityBackgroundTint(Color(red: 0.07, green: 0.10, blue: 0.16))
            .activitySystemActionForegroundColor(.white)
            .widgetURL(context.attributes.deepLink.flatMap(URL.init(string:)))
        } dynamicIsland: { context in
            DynamicIsland {
                DynamicIslandExpandedRegion(.leading) {
                    activityIcon(context).font(.title2)
                }
                DynamicIslandExpandedRegion(.trailing) {
                    timer(context).font(.title2.monospacedDigit().weight(.semibold))
                }
                DynamicIslandExpandedRegion(.center) {
                    VStack(spacing: 3) {
                        Text(context.attributes.title).font(.headline).lineLimit(2)
                        Text(context.isStale ? context.state.staleStatus ?? context.state.status : context.state.status).font(.caption).foregroundStyle(.secondary).lineLimit(1)
                    }
                }
                DynamicIslandExpandedRegion(.bottom) {
                    VStack(spacing: 8) {
                        HStack {
                            Text(context.state.detail ?? "").font(.subheadline).lineLimit(1)
                            Spacer()
                            metrics(context).font(.caption.monospacedDigit())
                        }
                        if let end = context.state.timerEndsAt, context.state.paused != true, let start = context.state.timerStartedAt, end > start {
                            ProgressView(timerInterval: date(start)...date(end), countsDown: false).labelsHidden().tint(tint(context))
                        } else {
                            ProgressView(value: context.state.progress).tint(tint(context))
                        }
                    }
                }
            } compactLeading: {
                activityIcon(context)
            } compactTrailing: {
                timer(context).monospacedDigit().frame(width: 64, alignment: .trailing)
            } minimal: {
                activityIcon(context)
            }
            .widgetURL(context.attributes.deepLink.flatMap(URL.init(string:)))
            .keylineTint(tint(context))
        }
    }

    private func activityIcon(_ context: ActivityViewContext<CraftActivityAttributes>) -> some View {
        // The pause glyph uses the active symbol's footprint, keeping the
        // title's leading edge steady through state changes.
        Image(systemName: context.attributes.symbol ?? "timer")
            .hidden()
            .overlay { Image(systemName: symbol(context)) }
            .foregroundStyle(tint(context))
    }

    private func symbol(_ context: ActivityViewContext<CraftActivityAttributes>) -> String {
        context.state.paused == true ? "pause.fill" : context.attributes.symbol ?? "timer"
    }

    private func tint(_ context: ActivityViewContext<CraftActivityAttributes>) -> Color {
        let raw = context.attributes.tint?.trimmingCharacters(in: CharacterSet(charactersIn: "#")) ?? "007aff"
        guard raw.count == 6, let value = UInt32(raw, radix: 16) else { return .blue }
        return Color(red: Double((value >> 16) & 255) / 255, green: Double((value >> 8) & 255) / 255, blue: Double(value & 255) / 255)
    }

    private func date(_ milliseconds: Double) -> Date { Date(timeIntervalSince1970: milliseconds / 1000) }

    private func timer(_ context: ActivityViewContext<CraftActivityAttributes>) -> some View {
        // Measure the hour format in the inherited native font. A widget's
        // ticking Text is horizontally flexible; an overlay bounds it to this
        // footprint so names retain the same width when the timer pauses.
        Text(duration(max(3600, context.state.durationSeconds, context.state.remainingSeconds ?? 0)))
            .lineLimit(1)
            .hidden()
            .overlay(alignment: .trailing) {
                timerContent(context)
                    .multilineTextAlignment(.trailing)
                    .lineLimit(1)
                    .minimumScaleFactor(0.8)
            }
    }

    @ViewBuilder
    private func timerContent(_ context: ActivityViewContext<CraftActivityAttributes>) -> some View {
        if context.state.paused == true {
            Text(duration(context.state.remainingSeconds ?? context.state.durationSeconds))
        } else if let end = context.state.timerEndsAt {
            // Clamped at zero, with no JavaScript timer or per-second Activity.update.
            let start = min(date(context.state.timerStartedAt ?? end - 1), date(end))
            Text(timerInterval: start...date(end), countsDown: true)
        } else if let start = context.state.timerStartedAt {
            Text(date(start), style: .timer)
        } else {
            Text(duration(context.state.durationSeconds))
        }
    }

    @ViewBuilder
    private func metrics(_ context: ActivityViewContext<CraftActivityAttributes>) -> some View {
        HStack(spacing: 8) {
            if let bpm = context.state.heartRate, bpm > 0 {
                Label("\(Int(bpm))", systemImage: "heart.fill").foregroundStyle(.pink).privacySensitive()
            }
            if context.state.showsDistance != false {
                Text(Measurement(value: context.state.distanceMeters, unit: UnitLength.meters), format: .measurement(width: .abbreviated, usage: .road)).privacySensitive()
            }
        }
    }

    private func duration(_ seconds: Double) -> String {
        let value = max(Int(seconds), 0)
        return value >= 3600 ? String(format: "%d:%02d:%02d", value / 3600, value / 60 % 60, value % 60) : String(format: "%d:%02d", value / 60, value % 60)
    }
}
