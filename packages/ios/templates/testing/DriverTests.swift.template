import XCTest
import Darwin

/// Drives the installed app from a script the Mac serves (netswitch.ts
/// `/script`), one command a line:
///
///   launch | activate | terminate | home
///   notifications          Home, then reveal Notification Center's Lock Screen presentation
///   systemexpect <text> [| secs] / systemabsent <text> / systemtap <text>
///                          assert or tap SpringBoard content, including Live Activities
///   systemtree <name>      SpringBoard accessibility tree → shots/<name>.txt
///   background <secs>     Home, wait, back to the app
///   wait <seconds>
///   net offline|online
///   delay <ms>            every proxied request waits this long (0 = off)
///   exec <hook>           runs the switch's HOOKS/<hook>.sh on the Mac (restart the API, …)
///   openurl <url>         opens a link through the system, answering "Open in the app?"
///   universallink <https-url> waits up to 60s for an OS-verified link; never opens a browser
///   shot <name>           screenshot → shots/<name>.png
///   tree <name>           accessibility tree → shots/<name>.txt
///   tap <text>            first hittable element whose label contains text
///   tapif <text>          tap it when it is on screen, else carry on (the big timer's "Show the controls")
///   tapid <identifier>
///   longpressid <identifier> holds a hittable native element to open its edit menu
///   holdtab <name> [| secs] standard XCTest hold (2–10s, default 6), BEGIN/END timing receipt
///   touches <JSON>       timed normalized touch paths in one native dispatch
///   tapxy <x> <y>         normalised 0…1 of the screen
///   tapexact <label>      a button whose label is exactly this
///   back                  the navigation bar's back button, else an edge swipe
///   type <text>           into the focused element
///   return                the keyboard's return key (Go on a sign-in form)
///   field <n> <text>      tap the n-th text field (0-based, secure fields after plain) and type
///   typeid <identifier> <text>  tap the element with this identifier and type
///   sliderid <identifier> <0…1> adjusts a hittable native slider
///   expectapp <bundle-id> [| secs] asserts a native app handoff reached the foreground
///   expect <text> [| secs]  waits for an element containing text; logs PASS/FAIL
///   expectexact <label> [| secs]  a button or text whose label is exactly this
///   absent <text>         logs PASS when no element contains text
///   expectid <id> [| secs] / absentid <id>   the same by accessibility identifier (testID)
///   labelid <id> <text>   that element's label is exactly text (a count, a status)
///   valueid <id> <text>   that element's actual string value is exactly text
///   tabbar shown|hidden   the native tab bar (Today, Calendar, …) can be tapped, or not
///   selected <tab>        the tab bar's selected button is this one
///   tab <name>            tap a tab bar button
///   scrollto <text>       swipes up (at most 8 times) until text is hittable
///   swipe up|down|left|right
///   drag x1 y1 x2 y2     slow app-relative drag, held 0.3s before release
///   audit <name>          accessibility audit (element descriptions, Dynamic Type, contrast); logs each issue
///   unlabelled            logs every hittable button without a label (FAIL if any)
///   dismiss [label]       a system prompt's button (default Not Now: "Save Password?")
///   ifid <id> <command…>  runs the command only when that element is there (a screen shown the first time)
///   log <text>
///
/// With a bundled journey.txt, evidence is kept as native XCTest attachments
/// and PASS/FAIL lines appear in the test log. Control-server journeys also
/// write driver.log; matrix.sh counts those checks.
final class DriverTests: XCTestCase {
    let control = ProcessInfo.processInfo.environment["CRAFT_TEST_CONTROL"] ?? {{CONTROL_URL}}
    let app = XCUIApplication(bundleIdentifier: {{BUNDLE_ID}})
    let tabs: [String] = {{TABS}}
    let tabIdentifiers: [String: String] = {{TAB_IDENTIFIERS}}
    private var bundledJourney = false

    func get(_ path: String, timeout: Double = 15) -> Data? {
        var result: Data?
        let done = expectation(description: path)
        URLSession.shared.dataTask(with: URL(string: control + path)!) { data, response, error in
            if error == nil, let response = response as? HTTPURLResponse, (200..<300).contains(response.statusCode) { result = data }
            done.fulfill()
        }.resume()
        wait(for: [done], timeout: timeout)
        return result
    }

    /// The journey, from the runner's control server, asked for again
    /// until a minute has passed.
    ///
    /// The server is up before the test starts, but a freshly created
    /// simulator's first request can outlast one wait: the first journey of
    /// a CI run spent 15s on it and failed before doing anything. XCTWaiter
    /// reports a timeout instead of failing the test, so a slow first answer
    /// is retried rather than fatal.
    func remoteScript(seconds: Double = 60) -> Data? {
        let end = Date().addingTimeInterval(seconds)
        repeat {
            var result: Data?
            let done = XCTestExpectation(description: "/script")
            URLSession.shared.dataTask(with: URL(string: control + "/script")!) { data, _, _ in result = data; done.fulfill() }.resume()
            if XCTWaiter().wait(for: [done], timeout: 15) == .completed, let result, !result.isEmpty { return result }
            Thread.sleep(forTimeInterval: 1)
        } while Date() < end
        return nil
    }

    func post(_ path: String, _ body: Data) {
        if bundledJourney {
            guard path.hasPrefix("/save?"),
                  let name = URLComponents(string: path)?.queryItems?.first(where: { $0.name == "name" })?.value else { return }
            let attachment = XCTAttachment(data: body, uniformTypeIdentifier: name.hasSuffix(".png") ? "public.png" : "public.plain-text")
            attachment.name = name
            attachment.lifetime = .keepAlways
            add(attachment)
            return
        }
        var request = URLRequest(url: URL(string: control + path)!)
        request.httpMethod = "POST"
        request.httpBody = body
        let done = expectation(description: path)
        URLSession.shared.dataTask(with: request) { _, _, _ in done.fulfill() }.resume()
        wait(for: [done], timeout: 15)
    }

    func note(_ text: String) {
        print("DRIVER \(text)")
        if !bundledJourney { post("/note", Data(text.utf8)) }
    }

    func check(_ ok: Bool, _ what: String) {
        note(ok ? "PASS \(what)" : "FAIL \(what)")
        XCTAssertTrue(ok, what)
    }

    /// testIDs are exact identifiers. Resolving a unique element with the
    /// subscript scans the whole accessibility tree for ambiguous matches;
    /// firstMatch can stop at the identified node, including a scrolled row.
    func identified(_ id: String) -> XCUIElement {
        app.descendants(matching: .any).matching(NSPredicate(format: "identifier == %@", id)).firstMatch
    }

    func element(containing text: String, in target: XCUIApplication? = nil) -> XCUIElement? {
        let root = target ?? app
        let predicate = NSPredicate(format: "label CONTAINS[c] %@ OR value CONTAINS[c] %@ OR identifier == %@", text, text, text)
        for query in [root.buttons, root.links, root.staticTexts, root.otherElements, root.cells, root.textFields] {
            let matches = query.matching(predicate)
            let count = min(matches.count, 25)
            for index in 0..<count {
                let candidate = matches.element(boundBy: index)
                if candidate.exists && candidate.isHittable { return candidate }
            }
        }
        let any = root.descendants(matching: .any).matching(predicate).firstMatch
        return any.exists ? any : nil
    }

    func exact(_ label: String) -> XCUIElement? {
        let predicate = NSPredicate(format: "label == %@", label)
        for query in [app.buttons, app.links, app.staticTexts] {
            let matches = query.matching(predicate)
            for index in 0..<min(matches.count, 25) {
                let candidate = matches.element(boundBy: index)
                if candidate.exists && candidate.isHittable { return candidate }
            }
        }
        return nil
    }

    func poll(_ seconds: Double, _ find: () -> XCUIElement?) -> XCUIElement? {
        let end = Date().addingTimeInterval(seconds)
        repeat {
            if let found = find() { return found }
            Thread.sleep(forTimeInterval: 0.5)
        } while Date() < end
        return nil
    }

    /// About a third of a screen of scrolling, as a held drag.
    ///
    /// `app.swipeUp()` is a flick, and how far a flick throws a scroll view
    /// depends on how its touches arrive: on a loaded machine, with a map
    /// keeping the app busy, eight of them moved a trail page less than one
    /// screen. A drag that stops before it lifts moves the content by its
    /// own length every time. It runs between the middle of the screen and
    /// the upper part, where a flick began too, so it stays off the keys when
    /// a keyboard is up - an iOS 27 simulator reports its keyboard's frame
    /// below the screen while drawing it over the lower half - and it stops
    /// short of a keyboard whose frame is known.
    func scrollPage(towardTop: Bool) {
        let frame = app.frame
        var lower = frame.minY + frame.height * 0.55
        let keyboard = app.keyboards.firstMatch
        if keyboard.exists, !keyboard.frame.isEmpty, keyboard.frame.minY < frame.maxY {
            lower = min(lower, keyboard.frame.minY - 24)
        }
        let upper = max(frame.minY + frame.height * 0.15, lower - frame.height * 0.4)
        let point = { (y: CGFloat) in self.app.coordinate(withNormalizedOffset: .zero).withOffset(CGVector(dx: frame.midX, dy: y)) }
        let (from, to) = towardTop ? (point(upper), point(lower)) : (point(lower), point(upper))
        from.press(forDuration: 0.05, thenDragTo: to, withVelocity: .default, thenHoldForDuration: 0.2)
    }

    /// Whether `target`, or a field inside it, holds the keyboard.
    func hasKeyboardFocus(_ target: XCUIElement) -> Bool {
        if (target.value(forKey: "hasKeyboardFocus") as? Bool) == true { return true }
        return target.descendants(matching: .any).matching(NSPredicate(format: "hasKeyboardFocus == 1")).firstMatch.exists
    }

    /// Taps `target` until it holds the keyboard, for up to `seconds`.
    ///
    /// A tap is not focus. The first keyboard a freshly created simulator
    /// shows takes its keyboard process many seconds to start - one CI run
    /// spent 20s delivering the tap - and the field had not become first
    /// responder when the text was typed, which failed with "Neither element
    /// nor any descendant has keyboard focus". A later tap lands once the app
    /// is idle again.
    func focus(_ target: XCUIElement, seconds: Double = 15) -> Bool {
        let end = Date().addingTimeInterval(seconds)
        repeat {
            target.tap()
            let settle = Date().addingTimeInterval(3)
            repeat {
                if hasKeyboardFocus(target) { return true }
                Thread.sleep(forTimeInterval: 0.25)
            } while Date() < settle
        } while Date() < end
        return hasKeyboardFocus(target)
    }

    func waitFor(_ text: String, _ seconds: Double) -> XCUIElement? {
        poll(seconds) { element(containing: text) }
    }

    /// The native tab bar's button: Craft's floating bar is not a UITabBar, and
    /// XCUITest calls its buttons not hittable, so it is the button with this
    /// label in the bottom fifth of the window. A configured stable identifier
    /// keeps dynamic captions from changing the tab's native identity.
    func tabButton(_ name: String) -> XCUIElement? {
        let height = app.windows.firstMatch.frame.height
        if let identifier = tabIdentifiers[name] {
            let candidate = app.buttons.matching(NSPredicate(format: "identifier == %@", identifier)).firstMatch
            if candidate.exists && candidate.frame.minY > height * 0.8 && candidate.frame.maxY <= height + 1 && candidate.frame.width > 0 { return candidate }
            return nil
        }
        let matches = app.buttons.matching(NSPredicate(format: "label == %@", name))
        for index in 0..<min(matches.count, 10) {
            let candidate = matches.element(boundBy: index)
            if candidate.exists && candidate.frame.minY > height * 0.8 && candidate.frame.maxY <= height + 1 && candidate.frame.width > 0 { return candidate }
        }
        return nil
    }

    func tabBarShown() -> Bool {
        let required = min(3, tabs.count)
        return required > 0 && tabs.filter { tabButton($0) != nil }.count >= required
    }

    func split(_ arg: String) -> (String, Double) {
        let parts = arg.split(separator: "|").map { $0.trimmingCharacters(in: .whitespaces) }
        return (parts[0], parts.count > 1 ? Double(parts[1]) ?? 10 : 10)
    }

    /// A tap that never fails the run: an element covered a moment (the big
    /// timer coming up) is tapped where it is, and the check after says.
    func press(_ element: XCUIElement) {
        if element.isHittable { element.tap() }
        else { element.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.5)).tap() }
    }

    func answerOpenPrompt() {
        // A direct app link has already arrived. Querying an invisible
        // SpringBoard here can stall its accessibility snapshot on iOS 27.
        if app.wait(for: .runningForeground, timeout: 2) { return }
        let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
        let open = springboard.buttons["Open"]
        if open.waitForExistence(timeout: 4) { open.tap() }
    }

    func testScript() throws {
        continueAfterFailure = false
        let data: Data?
        if let resource = Bundle(for: DriverTests.self).url(forResource: "journey", withExtension: "txt") {
            bundledJourney = true
            data = try Data(contentsOf: resource)
        } else {
            data = remoteScript()
        }
        guard let data, let script = String(data: data, encoding: .utf8) else {
            XCTFail("no script")
            return
        }
        for raw in script.split(separator: "\n") {
            let line = raw.trimmingCharacters(in: .whitespaces)
            if line.isEmpty || line.hasPrefix("#") { continue }
            run(line)
        }
    }

    func run(_ line: String) {
        let parts = line.split(separator: " ", maxSplits: 1).map(String.init)
        let command = parts[0]
        let arg = parts.count > 1 ? parts[1] : ""
        if bundledJourney && ["net", "delay", "exec"].contains(command) {
            check(false, "\(command) requires a control-server journey")
            return
        }
        switch command {
        case "ifid":
            let rest = arg.split(separator: " ", maxSplits: 1).map(String.init)
            if rest.count == 2, identified(rest[0]).waitForExistence(timeout: 3) { note("ifid \(rest[0]): shown"); run(rest[1]) }
            else { note("ifid \(rest.first ?? ""): not shown") }
        case "launch": app.launch()
        case "activate": app.activate()
        case "terminate": app.terminate()
        case "home": XCUIDevice.shared.press(.home)
        case "notifications":
            XCUIDevice.shared.press(.home)
            let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
            let start = springboard.coordinate(withNormalizedOffset: CGVector(dx: 0.1, dy: 0.005))
            let end = springboard.coordinate(withNormalizedOffset: CGVector(dx: 0.1, dy: 0.85))
            start.press(forDuration: 0.1, thenDragTo: end)
            note("notifications: opened")
        case "systemexpect":
            let (text, seconds) = split(arg)
            let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
            check(poll(seconds, { element(containing: text, in: springboard) }) != nil, "systemexpect \(text)")
        case "systemabsent":
            let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
            check(element(containing: arg, in: springboard) == nil, "systemabsent \(arg)")
        case "systemtap":
            let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
            // Widget text lives in a remote accessibility host. Its frame can
            // be visible while XCTest cannot resolve an activation point. Tap
            // the containing system button (the actual Live Activity card).
            let predicate = NSPredicate(format: "label CONTAINS[c] %@ OR identifier == %@", arg, arg)
            let card = springboard.buttons.containing(predicate).firstMatch
            if card.exists && card.isHittable { press(card); note("systemtap \(arg): ok") }
            else if let target = poll(10, { element(containing: arg, in: springboard) }) { press(target); note("systemtap \(arg): ok") }
            else { XCTFail("System element not found"); note("FAIL systemtap \(arg): NOT FOUND") }
        case "systemtree":
            let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
            post("/save?name=\(arg).txt", Data(springboard.debugDescription.utf8))
        case "background":
            XCUIDevice.shared.press(.home)
            Thread.sleep(forTimeInterval: Double(arg) ?? 3)
            app.activate()
        case "wait": Thread.sleep(forTimeInterval: Double(arg) ?? 1)
        case "net": _ = get("/\(arg)"); note("net \(arg)")
        case "delay": _ = get("/delay?ms=\(arg)"); note("delay \(arg)ms")
        case "exec":
            guard let data = get("/exec?name=\(arg)", timeout: 180), let out = String(data: data, encoding: .utf8) else {
                check(false, "exec \(arg): hook failed or returned no successful response")
                return
            }
            note("exec \(arg): \(out.trimmingCharacters(in: .whitespacesAndNewlines))")
        case "openurl":
            if let url = URL(string: arg) {
                XCUIDevice.shared.system.open(url)
                answerOpenPrompt()
                note("openurl \(arg)")
            }
        case "universallink":
            guard let url = URL(string: arg), url.scheme == "https" else {
                check(false, "universallink requires an HTTPS URL")
                return
            }
            let host = XCUIApplication(bundleIdentifier: "{{BUNDLE_PREFIX}}.host")
            host.launchArguments = ["--craft-universal-link", url.absoluteString]
            host.launch()
            host.buttons["craft-driver-open-universal-link"].tap()
            let opened = app.wait(for: .runningForeground, timeout: 75)
            if !opened {
                post("/save?name=universal-link-host.txt", Data(host.debugDescription.utf8))
                post("/save?name=universal-link-app.txt", Data(app.debugDescription.utf8))
            }
            check(opened, "universallink \(arg) opened the target app")
            host.terminate()
        case "shot":
            let shot = XCUIScreen.main.screenshot()
            post("/save?name=\(arg).png", shot.pngRepresentation)
        case "tree":
            post("/save?name=\(arg).txt", Data(app.debugDescription.utf8))
        case "tap":
            if let target = waitFor(arg, 10) { press(target); note("tap \(arg): ok") }
            else { XCTFail("Element not found"); note("FAIL tap \(arg): NOT FOUND") }
        case "tapif":
            if let target = element(containing: arg), target.isHittable { press(target); note("tapif \(arg): tapped") }
            else { note("tapif \(arg): not shown") }
        case "tapexact":
            if let target = poll(10, { exact(arg) }) { press(target); note("tapexact \(arg): ok") }
            else { XCTFail("Element not found"); note("FAIL tapexact \(arg): NOT FOUND") }
        case "tapid":
            let target = identified(arg)
            if target.waitForExistence(timeout: 10) { press(target); note("tapid \(arg): ok") }
            else { XCTFail("Element not found"); note("FAIL tapid \(arg): NOT FOUND") }
        case "longpressid":
            let target = identified(arg)
            guard target.waitForExistence(timeout: 10), target.isHittable else {
                check(false, "longpressid \(arg) is hittable")
                return
            }
            target.press(forDuration: 1.2)
            note("longpressid \(arg): ok")
        case "holdtab":
            let parts = arg.components(separatedBy: "|").map { $0.trimmingCharacters(in: .whitespaces) }
            guard parts.count <= 2, let name = parts.first, !name.isEmpty,
                  let duration = parts.count == 2 ? Double(parts[1]) : 6,
                  duration.isFinite, (2...10).contains(duration) else {
                check(false, "holdtab needs a tab name and 2–10 seconds")
                return
            }
            guard let button = poll(10, { tabButton(name) }) else {
                check(false, "holdtab cannot find tab \(name)")
                return
            }
            let frame = button.frame
            let coordinate = button.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.5))
            let startedAt = Date().timeIntervalSince1970
            let startedUptime = ProcessInfo.processInfo.systemUptime
            // BEGIN arms the independent screenshot watcher. XCTest still
            // performs its normal idle checks before synthesizing the press;
            // the watcher must wait for that synthesis, not infer touch-down.
            note("BEGIN holdtab \(name) | \(duration) | \(startedAt)")
            fflush(nil)
            coordinate.press(forDuration: duration)
            let returnedAt = Date().timeIntervalSince1970
            let returnedUptime = ProcessInfo.processInfo.systemUptime
            note("END holdtab \(name) | \(returnedAt)")
            let receipt: [String: Any] = [
                "tab": name, "requestedSeconds": duration,
                "input": "XCUICoordinate.press(forDuration:)",
                "startedAt": startedAt, "returnedAt": returnedAt,
                "startedUptime": startedUptime, "returnedUptime": returnedUptime,
                "frame": ["x": frame.minX, "y": frame.minY, "width": frame.width, "height": frame.height],
                "note": "Call times include XCTest idle checks; during-hold screenshots require an independent synthesis-timed capture.",
            ]
            if let data = try? JSONSerialization.data(withJSONObject: receipt, options: [.sortedKeys]) {
                post("/save?name=holdtab-\(Int(startedUptime * 1000)).json", data)
            }
            check(true, "holdtab \(name): standard \(duration)s press returned")
        case "touches":
            do {
                guard let data = arg.data(using: .utf8),
                      let rawPaths = try JSONSerialization.jsonObject(with: data) as? [[[String: Any]]] else {
                    check(false, "touches requires JSON arrays of x/y/at or tab/at points")
                    return
                }
                let frame = app.frame
                var tabLocations: [String: CGPoint] = [:]
                var paths: [[[String: NSNumber]]] = []
                for rawPath in rawPaths {
                    var path: [[String: NSNumber]] = []
                    for rawPoint in rawPath {
                        var point = rawPoint
                        if let name = point.removeValue(forKey: "tab") as? String {
                            if tabLocations[name] == nil {
                                guard let button = tabButton(name), frame.width > 0, frame.height > 0 else {
                                    check(false, "Timed native input cannot find tab \(name)")
                                    return
                                }
                                let rect = button.frame
                                tabLocations[name] = CGPoint(x: (rect.midX - frame.minX) / frame.width,
                                                             y: (rect.midY - frame.minY) / frame.height)
                            }
                            point["x"] = tabLocations[name]!.x
                            point["y"] = tabLocations[name]!.y
                        }
                        guard let numbers = point as? [String: NSNumber] else {
                            check(false, "Timed touch points must contain numeric coordinates and times")
                            return
                        }
                        path.append(numbers)
                    }
                    paths.append(path)
                }
                let scheduled = try JSONSerialization.data(withJSONObject: paths, options: [.sortedKeys])
                let started = ProcessInfo.processInfo.systemUptime
                if (paths.flatMap { $0 }.compactMap { $0["at"]?.doubleValue }.max() ?? 0) >= 2 {
                    note("BEGIN held timed native input")
                    fflush(nil)
                }
                try CraftTimedInput.synthesize(paths: paths, frame: frame)
                let elapsed = ProcessInfo.processInfo.systemUptime - started
                post("/save?name=timed-input-\(Int(started * 1000)).json", scheduled)
                check(true, "timed native input: \(paths.count) paths, \(elapsed)s wall time")
            } catch { check(false, "timed native input: \(error)") }
        case "tapxy":
            let xy = arg.split(separator: " ").compactMap { Double($0) }
            if xy.count == 2 && xy.allSatisfy({ $0 >= 0 && $0 <= 1 }) {
                app.coordinate(withNormalizedOffset: CGVector(dx: xy[0], dy: xy[1])).tap()
            } else { XCTFail("tapxy needs two coordinates between 0 and 1") }
        case "back":
            let bar = app.navigationBars.buttons.firstMatch
            if bar.exists && bar.isHittable { bar.tap(); note("back: bar button") }
            else {
                let start = app.coordinate(withNormalizedOffset: CGVector(dx: 0.02, dy: 0.5))
                start.press(forDuration: 0.05, thenDragTo: app.coordinate(withNormalizedOffset: CGVector(dx: 0.8, dy: 0.5)))
                note("back: edge swipe")
            }
        case "type": app.typeText(arg)
        case "return": app.typeText(XCUIKeyboardKey.return.rawValue); note("return")
        case "typeid":
            let idParts = arg.split(separator: " ", maxSplits: 1).map(String.init)
            let target = identified(idParts[0])
            if target.waitForExistence(timeout: 10) {
                guard focus(target) else {
                    check(false, "typeid \(idParts[0]) takes keyboard focus")
                    return
                }
                app.typeText(idParts.count > 1 ? idParts[1] : "")
                note("typeid \(idParts[0]): ok")
            } else { XCTFail("Element not found"); note("FAIL typeid \(idParts[0]): NOT FOUND") }
        case "sliderid":
            let parts = arg.split(separator: " ", maxSplits: 1).map(String.init)
            guard parts.count == 2, let position = Double(parts[1]), position.isFinite, (0...1).contains(position) else {
                check(false, "sliderid requires an identifier and normalized position")
                return
            }
            let slider = app.sliders.matching(NSPredicate(format: "identifier == %@", parts[0])).firstMatch
            guard slider.waitForExistence(timeout: 10), slider.isHittable else {
                check(false, "sliderid \(parts[0]) is hittable")
                return
            }
            slider.adjust(toNormalizedSliderPosition: CGFloat(position))
            note("sliderid \(parts[0]): \(position)")
        case "expectapp":
            let (bundle, seconds) = split(arg)
            let target = XCUIApplication(bundleIdentifier: bundle)
            check(target.wait(for: .runningForeground, timeout: seconds), "expectapp \(bundle)")
        case "field":
            let fieldParts = arg.split(separator: " ", maxSplits: 1).map(String.init)
            let index = Int(fieldParts[0]) ?? 0
            let fields = app.textFields.allElementsBoundByIndex + app.secureTextFields.allElementsBoundByIndex
            if index >= 0 && index < fields.count {
                guard focus(fields[index]) else {
                    check(false, "field \(index) takes keyboard focus")
                    return
                }
                app.typeText(fieldParts.count > 1 ? fieldParts[1] : "")
                note("field \(index): ok")
            } else { XCTFail("Element not found"); note("FAIL field \(index): NOT FOUND (\(fields.count) fields)") }
        case "expect":
            let (text, seconds) = split(arg)
            check(waitFor(text, seconds) != nil, "expect \(text)")
        case "expectexact":
            let (text, seconds) = split(arg)
            check(poll(seconds, { exact(text) }) != nil, "expectexact \(text)")
        case "expectid":
            let (id, seconds) = split(arg)
            check(identified(id).waitForExistence(timeout: seconds), "expectid \(id)")
        case "labelid":
            let idParts = arg.split(separator: " ", maxSplits: 1).map(String.init)
            let target = identified(idParts[0])
            let want = idParts.count > 1 ? idParts[1] : ""
            let seen = target.waitForExistence(timeout: 5) ? target.label : "(missing)"
            check(seen == want, "labelid \(idParts[0]) \(want) (saw \(seen))")
        case "valueid":
            let idParts = arg.split(separator: " ", maxSplits: 1).map(String.init)
            let target = identified(idParts[0])
            let want = idParts.count > 1 ? idParts[1] : ""
            let matched = poll(5) {
                target.exists && (target.value as? String) == want ? target : nil
            }
            check(matched != nil, "valueid \(idParts[0]) \(want)")
        case "absentid":
            check(!identified(arg).exists, "absentid \(arg)")
        case "absent":
            check(element(containing: arg) == nil, "absent \(arg)")
        case "tabbar":
            let want = arg != "hidden"
            let end = Date().addingTimeInterval(5)
            var shown = tabBarShown()
            while shown != want && Date() < end { Thread.sleep(forTimeInterval: 0.5); shown = tabBarShown() }
            check(shown == want, "tabbar \(arg)")
        case "selected":
            check(poll(5, { tabButton(arg).flatMap { $0.isSelected ? $0 : nil } }) != nil, "selected \(arg)")
        case "tab":
            if let button = poll(10, { tabButton(arg) }) { button.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.5)).tap(); note("tab \(arg): ok") }
            else { XCTFail("Element not found"); note("FAIL tab \(arg): NOT FOUND") }
        case "scrollto":
            var found = element(containing: arg)
            var drags = 0
            while (found == nil || !(found!.isHittable)) && drags < 12 {
                let towardTop = found.map { !$0.frame.isEmpty && $0.frame.midY < app.frame.midY } ?? false
                scrollPage(towardTop: towardTop)
                drags += 1
                found = element(containing: arg)
            }
            check(found != nil && found!.isHittable, "scrollto \(arg)")
        case "swipe":
            switch arg {
            case "up": app.swipeUp()
            case "down": app.swipeDown()
            case "left": app.swipeLeft()
            default: app.swipeRight()
            }
        case "drag":
            let parts = arg.split(separator: " ")
            let coordinates = parts.compactMap { Double($0) }
            guard parts.count == 4, coordinates.count == 4,
                  coordinates.allSatisfy({ $0.isFinite && (0...1).contains($0) }) else {
                check(false, "drag needs four coordinates between 0 and 1")
                return
            }
            let start = app.coordinate(withNormalizedOffset: CGVector(dx: CGFloat(coordinates[0]), dy: CGFloat(coordinates[1])))
            let end = app.coordinate(withNormalizedOffset: CGVector(dx: CGFloat(coordinates[2]), dy: CGFloat(coordinates[3])))
            start.press(forDuration: 0.05, thenDragTo: end, withVelocity: .slow, thenHoldForDuration: 0.3)
            note("drag \(arg): ok")
        case "edge":
            // The system back-swipe: a drag in from the left edge (or the
            // right one with `edge right`), which a centred swipe never is.
            let fromRight = arg == "right"
            let start = app.coordinate(withNormalizedOffset: CGVector(dx: fromRight ? 0.995 : 0.005, dy: 0.5))
            let end = app.coordinate(withNormalizedOffset: CGVector(dx: fromRight ? 0.15 : 0.85, dy: 0.5))
            start.press(forDuration: 0.05, thenDragTo: end)
            note("edge \(fromRight ? "right" : "left"): ok")
        case "audit":
            var issues: [String] = []
            do {
                try app.performAccessibilityAudit(for: [.sufficientElementDescription, .dynamicType, .contrast, .hitRegion]) { issue in
                    let label = issue.element?.label ?? ""
                    let id = issue.element?.identifier ?? ""
                    issues.append("\(issue.auditType.rawValue) \(issue.compactDescription) [\(label)|\(id)]")
                    return true
                }
            } catch { issues.append("audit error \(error)") }
            post("/save?name=audit-\(arg).txt", Data(issues.joined(separator: "\n").utf8))
            note("AUDIT \(arg): \(issues.count) issue(s)")
        case "unlabelled":
            let buttons = app.buttons.allElementsBoundByIndex.filter { $0.exists && $0.isHittable && $0.label.trimmingCharacters(in: .whitespaces).isEmpty }
            let where_ = buttons.prefix(5).map { "\(Int($0.frame.midX)),\(Int($0.frame.midY)) id=\($0.identifier)" }.joined(separator: "; ")
            check(buttons.isEmpty, "unlabelled buttons \(arg) \(buttons.count) \(where_)")
        case "dismiss":
            // A system prompt over the app ("Save Password?" → Not Now), wherever iOS shows it.
            let label = arg.isEmpty ? "Not Now" : arg
            let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
            let candidates = [app.buttons[label], springboard.buttons[label]]
            let end = Date().addingTimeInterval(6)
            var done = false
            while !done && Date() < end {
                if let button = candidates.first(where: { $0.exists && $0.isHittable }) { button.tap(); done = true }
                else { Thread.sleep(forTimeInterval: 0.5) }
            }
            note("dismiss \(label): \(done ? "tapped" : "none shown")")
        case "log": note(arg)
        default: XCTFail("Unknown command \(command)"); note("FAIL unknown command \(command)")
        }
    }
}
