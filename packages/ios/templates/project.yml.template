name: {{APP_NAME}}
options:
  bundleIdPrefix: {{BUNDLE_ID_PREFIX}}
  deploymentTarget:
    iOS: "{{IOS_VERSION}}"
settings:
  base:
    MARKETING_VERSION: "{{VERSION}}"
    CURRENT_PROJECT_VERSION: "{{BUILD_NUMBER}}"
    CODE_SIGN_STYLE: Automatic
    DEVELOPMENT_TEAM: "{{TEAM_ID}}"
  configs:
    debug:
      CRAFT_APNS_ENVIRONMENT: development
    release:
      CRAFT_APNS_ENVIRONMENT: production
      SWIFT_OPTIMIZATION_LEVEL: "-O"
      SWIFT_COMPILATION_MODE: wholemodule
      GCC_OPTIMIZATION_LEVEL: s
      DEAD_CODE_STRIPPING: YES
      STRIP_INSTALLED_PRODUCT: YES
      COPY_PHASE_STRIP: YES
targets:
  {{APP_NAME}}:
    type: application
    platform: iOS
    sources:
      - Sources
      - Shared
      - path: dist
        type: folder
        buildPhase: resources
      - path: craft.config.json
        optional: true
        buildPhase: resources
{{NATIVE_FONT_RESOURCES}}
      - path: Assets.xcassets
        buildPhase: resources
      - path: PrivacyInfo.xcprivacy
        buildPhase: resources
    settings:
      INFOPLIST_FILE: Info.plist
      CODE_SIGN_ENTITLEMENTS: Craft.entitlements
      PRODUCT_NAME: "$(TARGET_NAME)"
      PRODUCT_BUNDLE_IDENTIFIER: {{BUNDLE_ID}}
      TARGETED_DEVICE_FAMILY: "{{DEVICE_FAMILIES}}"
      SWIFT_VERSION: "5.0"
      ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
{{CRAFT_RUNTIME_SETTINGS}}
{{FEATURE_SETTINGS}}
{{NATIVE_DEPENDENCIES}}
{{NATIVE_TARGETS}}
# A shared scheme, so CI (Xcode Cloud, a fresh checkout's xcodebuild) can
# build and archive the app without Xcode first creating a per-user one.
schemes:
  {{APP_NAME}}:
    build:
      targets:
        {{APP_NAME}}: all
    run:
      config: Debug
    test:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release
