    <View testID="nested-shared-wrap" style={{"width":160,"height":80,"flexDirection":"row","gap":8,"backgroundColor":"#2f4f50"}}>
      <View testID="nested-shared-column" style={{"width":72,"height":60,"flexDirection":"column","gap":6,"padding":4,"backgroundColor":"#3f6061"}}>
