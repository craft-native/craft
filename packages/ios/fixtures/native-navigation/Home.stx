      <Text testID="boolean-width-text" style={{"width":true,"height":20}}>boolean width is ignored</Text>
      <Text testID="boolean-font-size-text" style={{"fontSize":false}}>boolean font size is ignored</Text>
    </View>
    <Text testID="boolean-number-lines" numberOfLines={true} style={{"width":120}}>line one wraps across line two and line three</Text>
    <View testID="nested-shrink-row-parent" style={{"width":140,"height":60,"flexDirection":"row","backgroundColor":"#553b62"}}>
      <View testID="nested-shrink-row" style={{"width":100,"height":60,"flexDirection":"row","backgroundColor":"#6d4c7d"}}>
        <Text testID="nested-shrink-row-text" style={{"width":80,"height":24}}>wide row label</Text>
        <View testID="nested-shrink-row-sibling" style={{"width":40,"height":24,"backgroundColor":"#d8b4fe"}} />
      </View>
      <View testID="nested-shrink-row-parent-sibling" style={{"width":40,"height":24,"backgroundColor":"#c084fc"}} />
    </View>
    <View testID="nested-shrink-column-parent" style={{"width":100,"height":60,"flexDirection":"column","backgroundColor":"#365a58"}}>
      <View testID="nested-shrink-column" style={{"width":100,"height":60,"flexDirection":"column","backgroundColor":"#477b78"}}>
        <Text testID="nested-shrink-column-text" style={{"width":100,"height":80}}>tall column label</Text>
      </View>
    </View>
    <View testID="nested-grid-parent" style={{"width":150,"height":76,"flexDirection":"row","gap":10,"backgroundColor":"#3b4a5a"}}>
      <View testID="nested-grid" style={{"display":"grid","gridTemplateColumns":"repeat(2, 1fr)","columnGap":4,"rowGap":6,"width":100,"height":60,"backgroundColor":"#465d73"}}>
        <View testID="nested-grid-first" style={{"height":20,"backgroundColor":"#7dd3fc"}} />
        <View testID="nested-grid-second" style={{"height":20,"backgroundColor":"#38bdf8"}} />
        <View testID="nested-grid-third" style={{"height":20,"backgroundColor":"#0ea5e9"}} />
      </View>
      <View testID="nested-grid-sibling" style={{"width":30,"height":20,"backgroundColor":"#94a3b8"}} />
    </View>
    <View testID="nested-reverse-parent" style={{"width":100,"height":60,"flexDirection":"row","gap":8,"backgroundColor":"#394b5f"}}>
      <View testID="nested-reverse" style={{"flexDirection":"column-reverse","width":48,"height":44,"backgroundColor":"#4f6b85"}}>
        <Text testID="nested-reverse-first" style={{"height":14}}>reverse first</Text>
        <Text testID="nested-reverse-second" style={{"height":12}}>reverse second</Text>
      </View>
      <View testID="nested-reverse-sibling" style={{"width":24,"height":20,"backgroundColor":"#a8c0d8"}} />
    </View>
    <View testID="nested-wrap-reverse-parent" style={{"width":100,"height":60,"flexDirection":"row","gap":8,"backgroundColor":"#3f5368"}}>
      <View testID="nested-wrap-reverse" style={{"flexDirection":"row","flexWrap":"wrap-reverse","width":48,"height":44,"backgroundColor":"#5c7893"}}>
        <Text testID="nested-wrap-reverse-first" style={{"width":40,"height":12}}>wrap first</Text>
        <Text testID="nested-wrap-reverse-second" style={{"width":40,"height":12}}>wrap second</Text>
      </View>
      <View testID="nested-wrap-reverse-sibling" style={{"width":24,"height":20,"backgroundColor":"#b9cee2"}} />
    </View>
    <Text testID="layout-status" :text="layoutWidth > 0 ? 'Layout width: ' + layoutWidth : 'layout pending'" />
    <Text testID="layout-transform-status" :text="transformedLayoutWidth > 0 ? 'Transformed layout width: ' + transformedLayoutWidth : 'transformed layout pending'" />
    <View testID="hidden-layout-parent" style={{"display":"none"}}>
      <Text testID="hidden-layout-child" @layout="captureHiddenLayout()">Hidden child</Text>
    </View>
    <Text testID="hidden-layout-status" :text="'Hidden layout events: ' + hiddenLayoutEvents" />
    <Button testID="toggle-layout-width" @click="toggleLayoutWidth()">Toggle layout width</Button>
    <Button testID="toggle-input-colors" @click="toggleInputColors()">Toggle input colors</Button>
    <Text testID="input-style-status" :text="inputStyleStatus" />
    <Button testID="toggle-invalid-input-colors" @click="toggleInvalidInputColors()">Toggle invalid input colors</Button>
    <Text testID="invalid-input-style-status" :text="invalidInputStyleStatus" />
    <Button testID="toggle-name-mode" @click="toggleNameMode()">Toggle name mode</Button>
    <Text testID="name-mode" :text="nameMultiline ? 'multiline' : 'single-line'" />
    <TextInput testID="name-input" value={name} multiline={nameMultiline} placeholder="Your name" placeholderTextColor={invalidInputColors ? "not-a-color" : (inputColors ? "#94a3b8" : undefined)} selectionColor={invalidInputColors ? "not-a-color" : (inputColors ? "#22c55e" : undefined)} maxLength={8} keyboardType="email-address" returnKeyType="done" style={{"textDecorationLine":"underline","textDecorationStyle":"dashed","textDecorationColor":"#22c55e","paddingHorizontal":inputPadded ? 24 : null}} @input="changeName($event)" @focus="focusName()" @submit-editing="submitName()" @blur="blurName()" @end-editing="endNameEditing()" />
    <TextInput testID="boolean-max-length" maxLength={true} placeholder="Boolean length" />
    <TextInput testID="boolean-input-lines" multiline numberOfLines={true} defaultValue="one two three four five six" style={{"width":120}} />
    <TextInput testID="notes-input" multiline numberOfLines={3} maxLength={24} defaultValue="Draft" placeholder="Notes" placeholderTextColor={invalidInputColors ? "not-a-color" : (inputColors ? "#94a3b8" : undefined)} selectionColor={invalidInputColors ? "not-a-color" : (inputColors ? "#22c55e" : undefined)} style={{"paddingVertical":inputPadded ? 12 : null}} @focus="focusNotes($event)" @submit-editing="submitName()" @blur="blurNotes()" @end-editing="endNotesEditing()" />
    <TextInput testID="readonly-input" :editable="false" defaultValue="Read only" />
    <TextInput testID="password-input" secureTextEntry defaultValue="secret" />
    <Text testID="greeting" :text="'Hello ' + name" />
    <Text testID="name-submits" :text="'Submits: ' + submits" />
    <Text testID="name-focuses" :text="'Focuses: ' + nameFocuses" />
    <Text testID="notes-focus-text" :text="'Notes focus: ' + notesFocusText" />
    <Text testID="name-blurs" :text="'Blurs: ' + nameBlurs" />
    <Text testID="name-end-editings" :text="'End edits: ' + nameEndEditings" />
    <Text testID="notes-blurs" :text="'Notes blurs: ' + notesBlurs" />
    <Text testID="notes-end-editings" :text="'Notes end edits: ' + notesEndEditings" />
    <Button testID="increment" @click="increment()">Increment</Button>
    <Text testID="count" :text="'Count: ' + count" />
    <Button testID="open-details" @click="openFormDetails()">Open details</Button>
    </ScrollView>
  <View testID="native-root-overlay" style={{"position":"absolute","top":8,"right":8,"width":24,"height":24,"backgroundColor":"#ef4444"}} />
  <View testID="held-viewer-heartbeat-slot" style={{"position":"absolute","top":8,"left":8,"width":24,"height":24}}>
    <Pressable testID="held-viewer-heartbeat-toggle" @click="heldViewerHeartbeat.set(true)" style={{"width":24,"height":24}}><Text style={{"fontSize":10}}>Live</Text></Pressable>
    <ActivityIndicator testID="held-viewer-heartbeat" color="#22c55e" size="small" :animating="heldViewerHeartbeat()" hidesWhenStopped style={{"position":"absolute","top":0,"left":0,"width":24,"height":24}} />
  </View>
  </SafeAreaView>
</template>
