    <View testID="percent-wrap" style={{"width":240,"height":28,"backgroundColor":"#2f4050"}}>
      <Text testID="percent-width" style={{"width":"50%","height":20}}>half width</Text>
    </View>
    <View testID="percent-basis-wrap" style={{"width":240,"height":28,"flexDirection":"row","backgroundColor":"#40502f"}}>
