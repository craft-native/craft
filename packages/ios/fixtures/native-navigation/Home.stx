    <Text testID="native-link" accessibilityHint="Opens status" accessibilityValue="ready" accessibilityState={linkAccessibilityState()} @click="setStatus('link pressed')">Open native link</Text>
    <a testID="native-route-link" href="/linked-details">Open details link</a>
    <Text testID="native-link-status" :text="status" />
    <Button testID="toggle-link-accessibility" @click="toggleLinkAccessibility()">Toggle link accessibility</Button>
    <View testID="native-panel" accessibilityState={panelAccessibilityState()} @click="pressPanel()" style={{"height":24}}><Text>Native panel</Text></View>
    <Pressable testID="native-pressable" @click="pressNativePressable()" @press-in="pressNativePressableIn()" @press-out="pressNativePressableOut()" style={{"height":24}}><Text>Native pressable</Text></Pressable>
    <Pressable testID="native-linked-pressable" href="/linked-details" style={{"height":24}}><Text>Linked pressable</Text></Pressable>
    <Pressable testID="native-raw-pressable" style={{"height":24,"color":"#ef4444","fontSize":18,"textTransform":"uppercase"}}>Raw pressable</Pressable>
    <Text testID="pressable-lifecycle" :text="'Press lifecycle: ' + pressIns + '/' + pressOuts" />
    <Pressable testID="nested-press-parent" @click="pressNestedParent()" style={{"height":44}}>
      <Button testID="nested-press-button" @click="pressNestedButton()">Nested press</Button>
    </Pressable>
    <Text testID="nested-button-taps" :text="'Nested button taps: ' + nestedButtonTaps" />
    <Text testID="nested-parent-taps" :text="'Nested parent taps: ' + nestedParentTaps" />
    <Pressable testID="disabled-pressable" disabled @click="pressNativePressable()" style={{"height":24}}><Text>Disabled pressable</Text></Pressable>
    <Button testID="toggle-panel-accessibility" @click="togglePanelAccessibility()">Toggle panel accessibility</Button>
    <View testID="long-press-panel" accessibilityState={longPressAccessibilityState()} @longpress="pressPanelLong()" style={{"height":24}}><Text>Long press panel</Text></View>
    <Button testID="toggle-long-press-accessibility" @click="toggleLongPressAccessibility()">Toggle long press accessibility</Button>
    <Text testID="long-press-status" :text="longPressStatus" />
    <Button testID="toggle-button-style" accessibilityState={buttonAccessibilityState()} @click="toggleButtonAccent()" style={{"color":buttonAccent ? "#ef4444" : "#22c55e","fontSize":buttonAccent ? 22 : 16}}>Toggle button style</Button>
    <Button testID="toggle-button-prop-color" :color="buttonPropColor ? '#ef4444' : null" @click="toggleButtonPropColor()">Toggle button prop color</Button>
    <Button testID="toggle-button-padding" @click="toggleButtonPadding()" style={{"paddingHorizontal":buttonPadded ? 32 : null}}>Toggle button padding</Button>
    <Button testID="toggle-input-padding" @click="toggleInputPadding()">Toggle input padding</Button>
    <Button testID="toggle-icon-size" @click="toggleIconSize()">Toggle icon size</Button>
    <Button testID="toggle-image-tint" @click="toggleImageTint()">Toggle image tint</Button>
    <Switch testID="native-switch" value={switchValue} accessibilityState={switchAccessibilityState()} trackColor={switchTrackColor()} thumbColor={switchThumbColor()} ios_backgroundColor="#475569" @value-change="toggleSwitch($event)" />
    <Switch testID="uncontrolled-switch" />
    <Button testID="toggle-invalid-switch-colors" @click="toggleInvalidSwitchColors()">Toggle invalid switch colors</Button>
    {{-- value-change selects the legacy native API when checked is also supplied. --}}
    <Switch testID="nullable-switch" :value="null" :checked="true" @value-change="toggleNullableSwitch($event)" />
    <Text testID="nullable-switch-status" :text="nullableSwitchValue() ? 'nullable switch on' : 'nullable switch off'" />
    <Switch testID="switch-value-precedence" :value="false" :checked="true" @value-change="togglePrecedenceSwitch($event)" />
    <Text testID="switch-precedence-status" :text="precedenceSwitchValue() ? 'precedence switch on' : 'precedence switch off'" />
    <select testID="native-picker" :value="pickerValue" @change="choosePicker($event)">
      <option value="one">One</option>
      <option value="two">Two</option>
      <option value="three">Three</option>
    </select>
    <Text testID="picker-value" :text="pickerValue" />
    <select testID="native-items-picker" :items="pickerItems" :selectedValue="itemsPickerValue" :value="'two'" @change="chooseItemsPicker($event)"></select>
    <Text testID="items-picker-value" :text="itemsPickerValue" />
    <DatePicker testID="native-date-picker" value="2026-10-12" minimumDate="2026-10-01" maximumDate="2026-12-31" @value-change="chooseDate($event)" />
    <Text testID="date-value" :text="dateValue" />
    <DatePicker testID="native-time-picker" mode="time" value="07:30" minuteInterval={5} @value-change="chooseTime($event)" />
    <Text testID="time-value" :text="timeValue" />
    <DatePicker testID="native-countdown" mode="countdown" value="01:30:45" @value-change="chooseCountdown($event)" />
    <Text testID="countdown-value" :text="countdownValue" />
    <Checkbox testID="native-checkbox" label="Accept terms" :value="checkboxValue" :color="invalidControlColors ? 'not-a-color' : '#22c55e'" @value-change="chooseCheckbox($event)" />
    <Text testID="checkbox-status" :text="checkboxStatus" />
    <Checkbox testID="native-checkbox-indeterminate" label="Mixed terms" indeterminate />
    <Checkbox testID="checkbox-checked-precedence" :checked="false" :value="true" @value-change="choosePrecedenceCheckbox($event)" />
    <Text testID="checkbox-precedence-status" :text="checkboxPrecedenceValue() ? 'precedence checkbox on' : 'precedence checkbox off'" />
    <Button testID="toggle-invalid-control-colors" @click="toggleInvalidControlColors()">Toggle invalid control colors</Button>
    <Text testID="invalid-control-style-status" :text="invalidControlStyleStatus" />
    <Text testID="date-event-status" :text="dateEventStatus" />
    <Button testID="toggle-modal" @click="toggleModal()">Toggle modal</Button>
    <Modal :if="modalMounted()" testID="native-modal" visible={modalVisible} transparent animationType="slide" style={{"opacity": modalOpacity}} @show="modalShown()" @dismiss="modalDismissed()" @request-close="modalRequested($event)">
      <Text testID="modal-content">Modal content</Text>
      <Button testID="toggle-modal-opacity" @click="toggleModalOpacity()">Toggle modal opacity</Button>
      <Button testID="remove-modal" @click="removeModal()">Remove modal</Button>
      <Text testID="modal-opacity" :text="modalOpacity" />
      <Button testID="toggle-nested-popup" @click="toggleNestedPopup()">Toggle nested popup</Button>
      <Modal testID="nested-popup" visible={nestedPopupVisible} nonModal dismissOnOutsideTap animationType="none" style={{"position":"absolute","left":48,"top":72,"width":160,"height":64,"backgroundColor":"#1e293b"}} @request-close="nestedPopupRequested($event)">
        <Text testID="nested-popup-content">Nested popup</Text>
      </Modal>
      <Button testID="close-modal" @click="toggleModal()">Close modal</Button>
    </Modal>
    <Text testID="modal-status" :text="modalStatus" />
    <Text testID="modal-request-status" :text="modalRequestStatus" />
    <Text testID="nested-popup-request-status" :text="nestedPopupRequestStatus" />
    <Button testID="toggle-popup" @click="togglePopup()">Toggle popup</Button>
    <Modal testID="native-popup" visible={popupVisible} nonModal dismissOnOutsideTap animationType="none" style={{"position":"absolute","left":24,"top":36,"width":180,"height":72,"backgroundColor":"#334155"}} @request-close="popupRequested($event)">
      <Text testID="popup-content">Popup content</Text>
    </Modal>
    <Text testID="popup-request-status" :text="popupRequestStatus" />
    <Slider testID="native-slider" minimumValue={0} maximumValue={1} step={0.1} value={sliderValue} minimumTrackTintColor={invalidSliderColors ? "not-a-color" : "#22c55e"} maximumTrackTintColor={invalidSliderColors ? "not-a-color" : "#64748b"} thumbTintColor={invalidSliderColors ? "not-a-color" : "#16a34a"} @value-change="moveSlider($event)" @sliding-complete="finishSlider()" />
    <Slider testID="boolean-slider" minimumValue={true} maximumValue={2} value={1} />
    <Text testID="slider-value" :text="sliderValue" />
    <Text testID="slider-completions" :text="'Slider completions: ' + sliderCompletions" />
    <Button testID="toggle-invalid-slider-colors" @click="toggleInvalidSliderColors()">Toggle invalid slider colors</Button>
    <Text testID="invalid-slider-style-status" :text="invalidSliderStyleStatus" />
    <ActivityIndicator testID="native-indicator" color={invalidControlColors ? "not-a-color" : "#22c55e"} size="large" />
    <ActivityIndicator testID="boolean-indicator" size={true} />
    <ActivityIndicator testID="stopped-indicator" color="#ef4444" :size="indicatorSize" :animating="false" :hides-when-stopped="indicatorHidesWhenStopped" />
    <Button testID="toggle-indicator-size" @click="indicatorSize.set(indicatorSize() === 'small' ? 'large' : 'small')">Toggle indicator size</Button>
    <Button testID="toggle-indicator-hide" @click="indicatorHidesWhenStopped.set(!indicatorHidesWhenStopped())">Toggle stopped indicator visibility</Button>
    <ActivityIndicator testID="scaled-indicator" size={48} style={{"transform":[{"scale":0.5}]}} />
    <ActivityIndicator testID="hidden-indicator" color="#ef4444" size="small" :animating="false" hidesWhenStopped />
    <ActivityIndicator testID="display-none-indicator" style={{"display":"none"}} />
    <View testID="layout-wrap" @layout="captureLayout($event)" style={{"width":layoutWide ? 240 : 180,"height":90,"flexDirection":"row","flexWrap":"wrap","gap":4,"padding":4,"alignItems":"stretch","backgroundColor":"#223344"}}>
      <Text testID="layout-min" style={{"width":200,"minWidth":120,"maxWidth":140,"height":24}}>bounded</Text>
      <Text testID="layout-stretch" style={{"width":100,"height":24,"alignSelf":"stretch"}}>wrapped</Text>
      <View testID="layout-absolute" style={{"position":"absolute","right":8,"bottom":8,"width":12,"height":12,"backgroundColor":"#abcdef"}} />
      <View testID="layout-absolute-ratio" style={{"position":"absolute","left":8,"right":8,"top":8,"aspectRatio":4,"backgroundColor":"#fedcba"}} />
