<script>
const name = state('')
// Explicit fixture-only compositor stimulus. Static system viewers need not
// produce another video sample while the finger remains held down.
const heldViewerHeartbeat = state(false)
const count = state(0)
const imageTaps = state(0)
const submits = state(0)
const nameFocuses = state(0)
const notesFocusText = state('')
const nameBlurs = state(0)
const nameEndEditings = state(0)
const notesBlurs = state(0)
const notesEndEditings = state(0)
const status = state('')
const pressIns = state(0)
const pressOuts = state(0)
const nestedButtonTaps = state(0)
const nestedParentTaps = state(0)
const linkAccessibilityDisabled = state(false)
const panelAccessibilityDisabled = state(false)
const longPressStatus = state('')
const longPressAccessibilityDisabled = state(false)
const switchValue = state(false)
const nullableSwitchValue = state(true)
const precedenceSwitchValue = state(false)
const invalidSwitchColors = state(false)
const pickerValue = state('one')
const itemsPickerValue = state('one')
const pickerItems = [{ label: 'One item', value: 'one' }, { label: 'Two item', value: 2 }]
const dateValue = state('2026-10-12')
const timeValue = state('07:30')
const countdownValue = state('01:30:45')
const checkboxValue = state(false)
const checkboxPrecedenceValue = state(false)
const checkboxStatus = state('checkbox pending')
const invalidControlColors = state(false)
const invalidControlStyleStatus = state('')
const dateEventStatus = state('date event pending')
const modalVisible = state(false)
const modalMounted = state(true)
const modalStatus = state('')
const modalRequestStatus = state('')
const modalOpacity = state(1)
const popupVisible = state(false)
const popupRequestStatus = state('')
const nestedPopupVisible = state(false)
const nestedPopupRequestStatus = state('')
const sliderValue = state(0.5)
const indicatorSize = state('small')
const indicatorHidesWhenStopped = state(false)
const sliderCompletions = state(0)
const invalidSliderColors = state(false)
const invalidSliderStyleStatus = state('')
const layoutWidth = state(0)
const transformedLayoutWidth = state(0)
const layoutWide = state(true)
const hiddenLayoutEvents = state(0)
const imageStatus = state('')
const imageLoadEndStatus = state('')
const imageRecoveryStatus = state('')
const imageTintStatus = state('')
const imageErrorStatus = state('')
const imageBackgroundErrorStatus = state('')
const imageFailureCount = state(0)
const imageTinted = state(true)
const invalidImageTint = state(false)
const imageResizeMode = state('cover')
const imageSource = state('http://example.com/image.png')
const validImageSource = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII='
const intrinsicImageWide = state(false)
const intrinsicImageWidth = state(0)
const intrinsicImageHeight = state(0)
const intrinsicImageStatus = state('intrinsic image pending')
const buttonAccent = state(false)
const buttonPropColor = state(false)
const buttonPadded = state(false)
const inputPadded = state(false)
const iconSized = state(false)
const inputColors = state(true)
const inputStyleStatus = state('')
const invalidInputColors = state(false)
const invalidInputStyleStatus = state('')
const nameMultiline = state(false)
const panelStyled = state(true)
const panelStyleStatus = state('')
const shadowStyled = state(true)
const shadowStyleStatus = state('')
const textWidthUnset = state(false)
const navigationName = 'Ada'
const navigationCount = state(0)
const navigationLifecycle = state('Lifecycle pending')
const audioContextStatus = state('AudioContext pending')
const navigationRows = state([
  { id: 'a', label: 'Ada row' },
  { id: 'b', label: 'Bea row' },
])
const navigationRowSelection = state('none')
const navigationRowsReordered = state(false)
const sectionScrolls = state(0)
const safeAreaBottomOnly = state(false)
const retainedSafeArea = state(false)
const screenBackgroundSolid = state(false)
const statusBarContent = state('default')

globalThis.craft.storage.remove('native-navigation-details-destroyed')
globalThis.craft.navigation.setOptions({
  title: 'Home',
  largeTitle: true,
  rightButtons: [
    { id: 'fixture-messages', symbol: 'bubble.left', variant: 'accent', badge: 3, accessibilityLabel: 'Messages' },
    { id: 'fixture-account', title: 'CB', variant: 'account', badge: 1, badgeStyle: 'dot', accessibilityLabel: 'Account' },
  ],
})

function incrementNavigation() {
  navigationCount.update(value => value + 1)
}

function reorderNavigationRows() {
  navigationRows.set([
    { id: 'b', label: 'Bea row updated' },
    { id: 'c', label: 'Cy row' },
  ])
}

function selectNavigationRow(id) {
  navigationRowSelection.set(id)
}

function updateNavigationDraft(id, event) {
  if (id === 'b' && event.text === 'draft' && !navigationRowsReordered()) {
    navigationRowsReordered.set(true)
    reorderNavigationRows()
  }
}

async function verifyNavigationLifecycle() {
  const marker = await globalThis.craft.storage.get('native-navigation-details-destroyed')
  navigationLifecycle.set(marker ? `Disposed ${marker}` : 'Lifecycle pending')
}

function verifyAudioContext() {
  try {
    const context = new AudioContext()
    const oscillator = context.createOscillator()
    const gain = context.createGain()
    const buffer = context.createBuffer(2, 32, context.sampleRate)
    const source = context.createBufferSource()
    const filter = context.createBiquadFilter()
    const compressor = context.createDynamicsCompressor()
    const convolver = context.createConvolver()
    source.buffer = buffer
    convolver.buffer = buffer
    buffer.getChannelData(0).set([0.25, -0.25, 0.125, 0])
    buffer.getChannelData(1).set([-0.125, 0.125, -0.0625, 0])
    oscillator.connect(gain)
    source.connect(filter).connect(gain)
    gain.connect(compressor).connect(convolver).connect(context.destination)
    oscillator.frequency.setValueAtTime(220, context.currentTime)
    oscillator.frequency.linearRampToValueAtTime(220, context.currentTime + 0.05)
    gain.gain.setValueAtTime(0, context.currentTime)
    gain.gain.linearRampToValueAtTime(0, context.currentTime + 0.05)
    source.start(context.currentTime, 0, 0.01)
    context.close()
    audioContextStatus.set('AudioContext ready')
  } catch (error) {
    audioContextStatus.set('AudioContext failed')
  }
}

function linkAccessibilityState() {
  return { disabled: linkAccessibilityDisabled() }
}

function panelAccessibilityState() {
  return { disabled: panelAccessibilityDisabled() }
}

function longPressAccessibilityState() {
  return { disabled: longPressAccessibilityDisabled() }
}

function buttonAccessibilityState() {
  return { selected: buttonAccent() }
}

function switchAccessibilityState() {
  return { checked: switchValue() }
}

function switchTrackColor() {
  return invalidSwitchColors() ? { false: 'not-a-color', true: 'not-a-color' } : { false: '#64748b', true: '#22c55e' }
}

function switchThumbColor() {
  return invalidSwitchColors() ? 'not-a-color' : '#ffffff'
}

function toggleInvalidSwitchColors() {
  invalidSwitchColors.update(value => !value)
  invalidControlStyleStatus.set(invalidSwitchColors() ? 'invalid switch colors on' : 'invalid switch colors off')
}

function validImage() {
  return { uri: validImageSource }
}

function currentImage() {
  return { uri: imageSource() }
}

function intrinsicImage() {
  const square = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg=='
  const wide = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAYAAAD0In+KAAAADklEQVR4nGP4z8DwH4QBEfcD/ePF9e8AAAAASUVORK5CYII='
  return { uri: intrinsicImageWide() ? wide : square }
}

function changeName(event) {
  name.set(event.text)
}

function focusName() {
  nameFocuses.update(value => value + 1)
}

function focusNotes(event) {
  notesFocusText.set(event.text)
}

function increment() {
  count.update(value => value + 1)
}

function tapImage() {
  imageTaps.update(value => value + 1)
}

function imageLoadStart() {
  imageStatus.set('image loading')
}

function imageLoaded() {
  imageStatus.set('image loaded')
}

function imageLoadEnded() {
  imageLoadEndStatus.set('image load ended')
}

function imageRecovered() {
  imageRecoveryStatus.set('image recovered')
}

function imageFailed() {
  imageErrorStatus.set('image failed')
  imageFailureCount.update(value => value + 1)
}

function imageBackgroundFailed() {
  imageBackgroundErrorStatus.set('background failed')
}

function toggleImageSource() {
  imageSource.set(imageSource().startsWith('http') ? validImageSource : 'http://example.com/image.png')
  imageRecoveryStatus.set('')
  imageErrorStatus.set('')
}

function clearImageSource() {
  imageSource.set('')
  imageRecoveryStatus.set('')
  imageErrorStatus.set('')
}

function toggleImageTint() {
  imageTinted.update(value => !value)
  imageTintStatus.set(imageTinted() ? 'image tint on' : 'image tint off')
}

function toggleInvalidImageTint() {
  invalidImageTint.update(value => !value)
}

function toggleImageResizeMode() {
  imageResizeMode.set(imageResizeMode() === 'cover' ? 'contain' : 'cover')
}

function captureIntrinsicImageLayout(event) {
  // A one-pixel image can be smaller than one logical point on dense displays.
  const width = event.layout.width
  const height = event.layout.height
  if (width <= 0 || height <= 0) return
  if (intrinsicImageWide() && (width !== intrinsicImageWidth() || height !== intrinsicImageHeight())) {
    intrinsicImageStatus.set('intrinsic image resized')
  }
  else if (!intrinsicImageWide()) {
    intrinsicImageStatus.set('intrinsic image ready')
  }
  intrinsicImageWidth.set(width)
  intrinsicImageHeight.set(height)
}

function toggleIntrinsicImage() {
  intrinsicImageWide.update(value => !value)
}

function toggleButtonAccent() {
  buttonAccent.update(value => !value)
  status.set(buttonAccent() ? 'button style accented' : 'button style default')
}

function toggleButtonPropColor() {
  buttonPropColor.update(value => !value)
  status.set(buttonPropColor() ? 'button prop accented' : 'button prop default')
}

function toggleButtonPadding() {
  buttonPadded.update(value => !value)
}

function toggleInputPadding() {
  inputPadded.update(value => !value)
}

function toggleIconSize() {
  iconSized.update(value => !value)
}

function toggleInputColors() {
  inputColors.update(value => !value)
  inputStyleStatus.set(inputColors() ? 'input colors on' : 'input colors off')
}

function toggleInvalidInputColors() {
  invalidInputColors.update(value => !value)
  invalidInputStyleStatus.set(invalidInputColors() ? 'invalid input colors on' : 'invalid input colors off')
}

function toggleNameMode() {
  nameMultiline.update(value => !value)
}

function togglePanelStyle() {
  panelStyled.update(value => !value)
  panelStyleStatus.set(panelStyled() ? 'panel style on' : 'panel style off')
}

function toggleShadowStyle() {
  shadowStyled.update(value => !value)
  shadowStyleStatus.set(shadowStyled() ? 'shadow style on' : 'shadow style off')
}

function toggleTextWidth() {
  textWidthUnset.update(value => !value)
}

function submitName() {
  submits.update(value => value + 1)
}

function blurName() {
  nameBlurs.update(value => value + 1)
}

function endNameEditing() {
  nameEndEditings.update(value => value + 1)
}

function blurNotes() {
  notesBlurs.update(value => value + 1)
}

function endNotesEditing() {
  notesEndEditings.update(value => value + 1)
}

function setStatus(value) {
  status.set(value)
}

function toggleLinkAccessibility() {
  linkAccessibilityDisabled.update(value => !value)
  status.set(linkAccessibilityDisabled() ? 'link accessibility disabled' : 'link accessibility enabled')
}

function togglePanelAccessibility() {
  panelAccessibilityDisabled.update(value => !value)
  status.set(panelAccessibilityDisabled() ? 'panel accessibility disabled' : 'panel accessibility enabled')
}

function pressPanel() {
  status.set('panel pressed')
}

function pressNativePressable() {
  status.set('pressable pressed')
}

function pressNativePressableIn() {
  pressIns.update(value => value + 1)
}

function pressNativePressableOut() {
  pressOuts.update(value => value + 1)
}

function pressNestedButton() {
  nestedButtonTaps.update(value => value + 1)
}

function pressNestedParent() {
  nestedParentTaps.update(value => value + 1)
}

function pressPanelLong() {
  longPressStatus.set('panel long pressed')
}

function toggleLongPressAccessibility() {
  longPressAccessibilityDisabled.update(value => !value)
  longPressStatus.set(longPressAccessibilityDisabled() ? 'long press disabled' : 'long press enabled')
}

function toggleSwitch(event) {
  switchValue.set(event.value)
  status.set(switchValue() ? 'switch on' : 'switch off')
}

function toggleNullableSwitch(event) {
  nullableSwitchValue.set(event.value)
}

function togglePrecedenceSwitch(event) {
  precedenceSwitchValue.set(event.value)
}

function choosePicker(event) {
  pickerValue.set(event.value)
  status.set(`picker ${pickerValue()}`)
}

function chooseItemsPicker(event) {
  itemsPickerValue.set(event.value)
  status.set(`items picker ${itemsPickerValue()}`)
}

function chooseDate(event) {
  dateValue.set(event.value)
  dateEventStatus.set(event.iso && event.timestamp > 0 ? `${event.value}|event complete` : 'date event incomplete')
}

function chooseTime(event) {
  timeValue.set(event.value)
  dateEventStatus.set(event.iso && event.timestamp > 0 ? `${event.value}|event complete` : 'time event incomplete')
}

function chooseCountdown(event) {
  countdownValue.set(event.value)
  // The duration the picker shows, as ISO 8601 and milliseconds, for
  // whatever it was turned to (01:31:45 is PT5505S and 5505000).
  const parts = String(event.value).split(':').map(Number)
  const total = parts[0] * 3600 + parts[1] * 60 + parts[2]
  dateEventStatus.set(event.iso === `PT${total}S` && event.timestamp === total * 1000 ? `${event.value}|duration complete` : 'countdown event incomplete')
}

function chooseCheckbox(event) {
  checkboxValue.set(event.value)
  checkboxStatus.set(event.value ? 'checkbox on' : 'checkbox off')
}

function choosePrecedenceCheckbox(event) {
  checkboxPrecedenceValue.set(event.value)
}

function toggleInvalidControlColors() {
  invalidControlColors.update(value => !value)
  invalidControlStyleStatus.set(invalidControlColors() ? 'invalid control colors on' : 'invalid control colors off')
}

function toggleModal() {
  modalVisible.update(value => !value)
}

function removeModal() {
  modalMounted.set(false)
  modalVisible.set(false)
}

function modalShown() {
  modalRequestStatus.set('')
  modalStatus.set('modal shown')
}

function modalDismissed() {
  modalStatus.set('modal dismissed')
}

function modalRequested(event) {
  modalRequestStatus.set(`modal requested ${event.reason || 'unknown'}`)
  modalVisible.set(false)
}

function toggleModalOpacity() {
  modalOpacity.update(value => value === 1 ? 0.45 : 1)
}

function togglePopup() {
  popupVisible.update(value => !value)
}

function popupRequested(event) {
  popupRequestStatus.set(`popup requested ${event.reason || 'unknown'}`)
  popupVisible.set(false)
}

function toggleNestedPopup() {
  nestedPopupVisible.update(value => !value)
}

function nestedPopupRequested(event) {
  nestedPopupRequestStatus.set(`nested popup requested ${event.reason || 'unknown'}`)
  nestedPopupVisible.set(false)
}

function moveSlider(event) {
  sliderValue.set(event.value)
  status.set('slider moved')
}

function finishSlider() {
  sliderCompletions.update(value => value + 1)
}

function toggleInvalidSliderColors() {
  invalidSliderColors.update(value => !value)
  invalidSliderStyleStatus.set(invalidSliderColors() ? 'invalid slider colors on' : 'invalid slider colors off')
}

function captureLayout(event) {
  layoutWidth.set(event.layout.width)
}

function captureTransformedLayout(event) {
  transformedLayoutWidth.set(event.layout.width)
}

function toggleLayoutWidth() {
  layoutWide.update(value => !value)
}

function captureHiddenLayout() {
  hiddenLayoutEvents.update(value => value + 1)
}

function openDetails() {
  globalThis.craft.navigation.push('details', { name: navigationName, count: navigationCount() })
}

// The form's own name and count, which the push test types and increments
// (the navigation-state section above has its own).
function openFormDetails() {
  globalThis.craft.navigation.push('details', { name: name(), count: count() })
}

function openCapabilities() {
  globalThis.craft.navigation.push('capabilities')
}

function captureSectionScroll() {
  sectionScrolls.set(1)
}

function toggleSafeAreaEdges() {
  safeAreaBottomOnly.update(value => !value)
}

function toggleRetainedSafeArea() {
  retainedSafeArea.update(value => !value)
}

function toggleScreenBackground() {
  const solid = !screenBackgroundSolid()
  screenBackgroundSolid.set(solid)
  globalThis.craft.navigation.setOptions({ backgroundColor: solid ? '#123456' : null })
}

function openDetailsThenUpdateBackground() {
  setTimeout(() => {
    screenBackgroundSolid.set(true)
    globalThis.craft.navigation.setOptions({ backgroundColor: '#654321' })
  }, 300)
  openDetails()
}
</script>

<template>
  <SafeAreaView testID="root" :edges="safeAreaBottomOnly() ? ['bottom'] : ['top', 'bottom']" class="p-4">
    <StatusBar :barStyle="statusBarContent()" />
    <ScrollView testID="native-root-scroll" style={{"flex":1}}>
    <View testID="theme-probe" class="bg-white dark:bg-slate-950" style={{"height":24}}>
      <Text testID="theme-probe-label" class="text-slate-900 dark:text-white">Theme probe</Text>
    </View>
    <Text testID="home-title">Home</Text>
    <Text testID="selectable-native-text" selectable>Long press to copy this native text.</Text>
    <Button testID="toggle-safe-area" @click="toggleSafeAreaEdges()">Toggle safe edges</Button>
    <Text testID="safe-area-status" :text="safeAreaBottomOnly() ? 'Safe edges: bottom' : 'Safe edges: top,bottom'" />
    <Button testID="toggle-retained-safe-area" @click="toggleRetainedSafeArea()">Toggle retained safe area</Button>
    <Text testID="retained-safe-area-status" :text="retainedSafeArea() ? 'Retained: safe' : 'Retained: plain'" />
    <View :if="!retainedSafeArea()" key="retained-safe-area" testID="retained-safe-area" style={{"height":24,"paddingTop":4,"backgroundColor":"#334455"}}>
      <Text testID="retained-safe-area-label">Plain retained container</Text>
    </View>
    <SafeAreaView :if="retainedSafeArea()" key="retained-safe-area" testID="retained-safe-area" :edges="['top']" style={{"height":24,"paddingTop":4,"backgroundColor":"#334455"}}>
      <Text testID="retained-safe-area-label">Safe retained container</Text>
    </SafeAreaView>
    <Button testID="toggle-screen-background" @click="toggleScreenBackground()">Toggle screen background</Button>
    <Button testID="toggle-status-bar-content" @click="statusBarContent.set(statusBarContent() === 'light-content' ? 'dark-content' : 'light-content')">Toggle status bar content</Button>
    <Button testID="black-screen-background" @click="globalThis.craft.navigation.setOptions({ backgroundColor: '#000000' })">Black focus background</Button>
    <Button testID="background-open-details" @click="openDetailsThenUpdateBackground()">Update retained background</Button>
    <ScrollView testID="tab-swipe-carousel" horizontal style={{"width":240,"height":48}}>
      <View style={{"width":720,"height":40,"flexDirection":"row","alignItems":"center","gap":16,"paddingHorizontal":12,"backgroundColor":"#1e293b"}}>
        <Text testID="tab-swipe-carousel-label" style={{"width":220,"color":"#ffffff"}}>Horizontal carousel content</Text>
        <Text style={{"width":220,"color":"#cbd5e1"}}>Scroll before changing tabs</Text>
        <Text style={{"width":220,"color":"#94a3b8"}}>End of carousel</Text>
      </View>
    </ScrollView>
    <View testID="max-content-bubble" style={{"alignSelf":"flex-start","maxWidth":220,"paddingHorizontal":12,"paddingVertical":8,"backgroundColor":"#334155"}}>
      <Text testID="max-content-bubble-text" style={{"color":"#ffffff"}}>Went 4.3 miles</Text>
    </View>
    <Text testID="keyed-list-status" :text="'Selected: ' + navigationRowSelection" />
    <View :for="row in navigationRows" :key="row.id" style={{"height":52,"flexDirection":"row","gap":4}}>
      <Text :text="row.label" style={{"width":100}} />
      <TextInput :testID="'navigation-input-' + row.id" placeholder="Draft" style={{"width":100}} @input="updateNavigationDraft(row.id, $event)" />
      <Button :testID="'navigation-select-' + row.id" @click="selectNavigationRow(row.id)">Select row</Button>
    </View>
    <Button testID="keyed-list-reorder" @click="reorderNavigationRows()">Reorder rows</Button>
    <Text testID="navigation-home-state" :text="'Home state: ' + navigationName + '/' + navigationCount" />
    <Button testID="navigation-increment" @click="incrementNavigation()">Increment navigation state</Button>
    <Button testID="open-identity" @click="globalThis.craft.navigation.open('/identity')">Repeated selector identity</Button>
    <Button testID="navigation-open-details" @click="openDetails()">Open navigation details</Button>
    <Button testID="navigation-check-lifecycle" @click="verifyNavigationLifecycle()">Check details lifecycle</Button>
    <Text testID="navigation-lifecycle" :text="navigationLifecycle" />
    <Button testID="native-audio-context" @click="verifyAudioContext()">Check audio context</Button>
    <Text testID="audio-context-status" :text="audioContextStatus" />
    <Button testID="open-capabilities" @click="openCapabilities()">Open capabilities</Button>
    <Button testID="disabled-button" disabled>Disabled</Button>
    <Text testID="null-width-text" style={{"width":textWidthUnset ? null : 160,"alignSelf":"flex-start"}}>intrinsic</Text>
    <Button testID="toggle-null-width" @click="toggleTextWidth()">Toggle null width</Button>
    <Button testID="toggle-panel-style" @click="togglePanelStyle()">Toggle panel style</Button>
    <Text testID="panel-style-status" :text="panelStyleStatus" />
    <View testID="dynamic-style-box" style={{"width":120,"height":24,"backgroundColor":panelStyled ? "#334455" : null,"borderWidth":panelStyled ? 2 : null,"borderColor":panelStyled ? "#abcdef" : null}} />
    <View testID="dynamic-shadow-box" style={{"width":120,"height":24,"shadowColor":shadowStyled ? "#123456" : null,"shadowOpacity":shadowStyled ? 0.35 : null,"shadowRadius":shadowStyled ? 6 : null,"shadowOffset":shadowStyled ? {"width":0,"height":3} : null}} />
    <Button testID="toggle-shadow-style" @click="toggleShadowStyle()">Toggle shadow style</Button>
    <Text testID="shadow-style-status" :text="shadowStyleStatus" />
    <ScrollView testID="native-scroll" keyboardDismissMode="on-drag" keyboardShouldPersistTaps="handled" contentContainerStyle={{"paddingTop":12}} style={{"height":72,"gap":4}}>
      <Image
        testID="native-image"
        source={validImage()}
        accessibilityLabel="Native pixel"
        accessibilityRole="image"
        @click="tapImage()"
        @load-start="imageLoadStart()"
        @load="imageLoaded()"
        @load-end="imageLoadEnded()"
        style={{"width":24,"height":24,"borderRadius":12,"resizeMode":"cover","tintColor":imageTinted ? "#2563eb" : null}}
      />
      <Image
        testID="dynamic-resize-image"
        source={validImage()}
        style={{"width":48,"height":32,"borderRadius":8,"resizeMode":imageResizeMode()}}
      />
      <Button testID="toggle-image-resize-mode" @click="toggleImageResizeMode()">Toggle image resize mode</Button>
      <Text testID="image-resize-mode-status" :text="imageResizeMode()" />
      <Image testID="intrinsic-image" source={intrinsicImage()} style={{"alignSelf":"flex-start"}} @layout="captureIntrinsicImageLayout($event)" />
      <Text testID="intrinsic-image-status" :text="intrinsicImageStatus" />
      <Button testID="toggle-intrinsic-image" @click="toggleIntrinsicImage()">Resize intrinsic image</Button>
      <ImageBackground
        testID="native-image-background"
        source={validImage()}
        resizeMode="cover"
        accessibilityLabel="Native image background"
        style={{"width":80,"height":36,"tintColor":invalidImageTint ? "not-a-color" : (imageTinted ? "#2563eb" : null)}}
      >
        <Text testID="native-image-background-label" style={{"color":"#ffffff"}}>Background child</Text>
      </ImageBackground>
      <Button testID="toggle-invalid-image-tint" @click="toggleInvalidImageTint()">Toggle invalid image tint</Button>
      <ImageBackground
        testID="unsupported-image-background"
        source={currentImage()}
        accessibilityLabel="Unsupported background"
        @error="imageBackgroundFailed()"
        style={{"width":80,"height":36}}
      >
        <Text style={{"color":"#ffffff"}}>Broken background</Text>
      </ImageBackground>
      <Text testID="image-background-error-status" :text="imageBackgroundErrorStatus" />
      <KeyboardAvoidingView
        testID="native-keyboard-avoiding"
        behavior="padding"
        keyboardVerticalOffset={4}
        style={{"width":180,"height":48,"backgroundColor":"#1e293b"}}
      >
        <TextInput testID="native-keyboard-avoiding-input" placeholder="Keyboard input" />
      </KeyboardAvoidingView>
      <svg
        testID="native-svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        fill-rule="evenodd"
        fill-opacity="0.75"
        stroke="currentColor"
        stroke-opacity="0.8"
        stroke-width="2"
        stroke-dasharray="2 1"
        stroke-dashoffset="0.5"
        stroke-miterlimit="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        accessibilityLabel="Native vector"
      >
        <g stroke="#2563eb">
          <path d="M4 12h16" />
          <text x="12" y="21" text-anchor="middle" dominant-baseline="middle" fill="#111827" stroke="none" font-size="4">SVG</text>
        </g>
        <g font-weight="500">
          <text x="12" y="5" text-anchor="middle" dominant-baseline="middle" fill="#111827" font-size="3">W</text>
        </g>
      </svg>
      <Icon testID="native-icon" symbol="sun.max" accessibilityLabel="Native icon" style={{"width":iconSized ? 24 : null,"height":iconSized ? 24 : null,"color":"#f59e0b"}} />
      <Video testID="native-video" source={{"uri":""}} style={{"width":120,"height":68}} />
      <Text testID="native-caption" :text="'Image taps: ' + imageTaps" />
      <Text testID="image-status" :text="imageStatus" />
      <Text testID="image-load-end-status" :text="imageLoadEndStatus" />
      <Text testID="image-recovery-status" :text="imageRecoveryStatus" />
      <Text testID="image-tint-status" :text="imageTintStatus" />
      <Text testID="image-error-status" :text="imageErrorStatus" />
      <Image
        testID="unsupported-image"
        source={currentImage()}
        accessibilityLabel="Unsupported image"
        @load="imageRecovered()"
        @error="imageFailed()"
        style={{"width":16,"height":16}}
      />
      <Button testID="toggle-image-source" @click="toggleImageSource()">Toggle image source</Button>
      <Button testID="clear-image-source" @click="clearImageSource()">Clear image source</Button>
      <Text testID="image-error-count" :text="imageFailureCount" />
      <View testID="reverse-column" style={{"flexDirection":"column-reverse","width":120,"height":48,"backgroundColor":"#556677"}}>
        <Text testID="reverse-column-first">top source</Text>
        <Text testID="reverse-column-second">bottom source</Text>
      </View>
      <View testID="reverse-wrap" style={{"flexDirection":"row-reverse","flexWrap":"wrap","width":120,"height":64,"backgroundColor":"#46515f"}}>
        <Text testID="reverse-wrap-first" style={{"width":48}}>first</Text>
        <Text testID="reverse-wrap-second" style={{"width":48}}>second</Text>
        <Text testID="reverse-wrap-third" style={{"width":48}}>third</Text>
        <Text testID="reverse-wrap-fourth" style={{"width":48}}>fourth</Text>
      </View>
      <View style={{"height":120}} />
      <Text testID="scroll-end">End of native scroll content</Text>
    </ScrollView>
    <SectionList testID="native-section-list" @scroll="captureSectionScroll()" style={{"height":64,"width":220,"backgroundColor":"#2f4050"}}>
      <Text testID="native-section-header" style={{"fontWeight":"700"}}>Section header</Text>
