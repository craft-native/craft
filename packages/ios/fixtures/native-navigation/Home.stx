<script>
let name = ''
let count = 0
let imageTaps = 0
let submits = 0
let nameFocuses = 0
let nameBlurs = 0
let nameEndEditings = 0
let notesBlurs = 0
let notesEndEditings = 0
let status = ''
let linkAccessibilityDisabled = false
let switchValue = false
let sliderValue = 0.5
let sliderCompletions = 0
let layoutWidth = 0
let layoutWide = true
let imageStatus = ''
let imageErrorStatus = ''
let imageTinted = true
let buttonAccent = false
let inputColors = true
let inputStyleStatus = ''
let panelStyled = true
let panelStyleStatus = ''

function changeName(event) {
  name = event.text
}

function focusName() {
  nameFocuses += 1
}

function increment() {
  count += 1
}

function tapImage() {
  imageTaps += 1
}

function imageLoadStart() {
  imageStatus = 'image loading'
}

function imageLoaded() {
  imageStatus = 'image loaded'
}

function imageFailed() {
  imageErrorStatus = 'image failed'
}

function toggleImageTint() {
  imageTinted = !imageTinted
  imageStatus = imageTinted ? 'image tint on' : 'image tint off'
}

function toggleButtonAccent() {
  buttonAccent = !buttonAccent
  status = buttonAccent ? 'button style accented' : 'button style default'
}

function toggleInputColors() {
  inputColors = !inputColors
  inputStyleStatus = inputColors ? 'input colors on' : 'input colors off'
}

function togglePanelStyle() {
  panelStyled = !panelStyled
  panelStyleStatus = panelStyled ? 'panel style on' : 'panel style off'
}

function submitName() {
  submits += 1
}

function blurName() {
  nameBlurs += 1
}

function endNameEditing() {
  nameEndEditings += 1
}

function blurNotes() {
  notesBlurs += 1
}

function endNotesEditing() {
  notesEndEditings += 1
}

function setStatus(value) {
  status = value
}

function toggleLinkAccessibility() {
  linkAccessibilityDisabled = !linkAccessibilityDisabled
  status = linkAccessibilityDisabled ? 'link accessibility disabled' : 'link accessibility enabled'
}

function toggleSwitch(event) {
  switchValue = event.value
  status = switchValue ? 'switch on' : 'switch off'
}

function moveSlider(event) {
  sliderValue = event.value
  status = 'slider moved'
}

function finishSlider() {
  sliderCompletions += 1
}

function captureLayout(event) {
  layoutWidth = event.layout.width
}

function toggleLayoutWidth() {
  layoutWide = !layoutWide
}

function openDetails() {
  globalThis.craft.navigation.push('details', { name, count })
}

function openCapabilities() {
  globalThis.craft.navigation.push('capabilities')
}
</script>

<template>
  <SafeAreaView class="p-4">
    <Text testID="home-title">Home</Text>
    <Button testID="open-capabilities" onPress={openCapabilities}>Open capabilities</Button>
    <Button testID="disabled-button" disabled>Disabled</Button>
    <View
      testID="styled-row"
      style={{"flexDirection":"row-reverse","alignItems":"center","justifyContent":"center","gap":6,"paddingHorizontal":10,"paddingVertical":5,"width":240,"height":64,"backgroundColor":"#123456","opacity":0.75,"borderWidth":2,"borderColor":"#abcdef","borderRadius":7,"overflow":"hidden"}}
    >
      <Text testID="styled-first" style={{"width":70,"color":"#fedcba","fontSize":21,"fontWeight":"700","fontStyle":"italic","textAlign":"right","letterSpacing":1,"lineHeight":26,"textTransform":"uppercase","textDecorationLine":"underline"}}>first</Text>
      <Text testID="styled-second" style={{"width":70}}>second</Text>
    </View>
    <View testID="grid-wrap" style={{"display":"grid","gridTemplateColumns":"repeat(2, 1fr)","gridAutoRows":28,"columnGap":6,"rowGap":4,"width":240,"padding":4,"backgroundColor":"#334455"}}>
      <Text testID="grid-first">grid one</Text>
      <Text testID="grid-second">grid two</Text>
      <Text testID="grid-third">grid three</Text>
    </View>
    <View testID="flex-grow-wrap" style={{"flexDirection":"row","width":240,"height":32,"gap":4,"backgroundColor":"#445566"}}>
      <Text testID="flex-grow-first" style={{"width":40,"flexGrow":1}}>grow</Text>
      <Text testID="flex-grow-second" style={{"width":40}}>fixed</Text>
    </View>
    <Link testID="native-link" accessibilityHint="Opens status" accessibilityValue="ready" accessibilityState={{"disabled":linkAccessibilityDisabled}} onPress={() => setStatus('link pressed')}>Open native link</Link>
    <Text testID="native-link-status">{status}</Text>
    <Button testID="toggle-link-accessibility" onPress={toggleLinkAccessibility}>Toggle link accessibility</Button>
    <Button testID="toggle-button-style" accessibilityState={{"selected":buttonAccent}} onPress={toggleButtonAccent} style={{"color":buttonAccent ? "#ef4444" : "#22c55e","fontSize":buttonAccent ? 22 : 16}}>Toggle button style</Button>
    <Button testID="toggle-image-tint" onPress={toggleImageTint}>Toggle image tint</Button>
    <Button testID="toggle-panel-style" onPress={togglePanelStyle}>Toggle panel style</Button>
    <Text testID="panel-style-status">{panelStyleStatus}</Text>
    <View testID="dynamic-style-box" style={{"width":120,"height":24,"backgroundColor":panelStyled ? "#334455" : undefined,"borderWidth":panelStyled ? 2 : undefined,"borderColor":panelStyled ? "#abcdef" : undefined}} />
    <Switch testID="native-switch" value={switchValue} accessibilityState={{"checked":switchValue}} trackColor={{"false":"#64748b","true":"#22c55e"}} thumbColor="#ffffff" ios_backgroundColor="#475569" onValueChange={toggleSwitch} />
    <Slider testID="native-slider" minimumValue={0} maximumValue={1} step={0.1} value={sliderValue} minimumTrackTintColor="#22c55e" maximumTrackTintColor="#64748b" thumbTintColor="#16a34a" onValueChange={moveSlider} onSlidingComplete={finishSlider} />
    <Text testID="slider-value">{sliderValue}</Text>
    <Text testID="slider-completions">Slider completions: {sliderCompletions}</Text>
    <ActivityIndicator testID="native-indicator" color="#22c55e" size="large" />
    <ActivityIndicator testID="stopped-indicator" color="#ef4444" size="small" animating={false} hidesWhenStopped={false} />
    <View testID="layout-wrap" onLayout={captureLayout} style={{"width":layoutWide ? 240 : 180,"height":90,"flexDirection":"row","flexWrap":"wrap","gap":4,"padding":4,"alignItems":"stretch","backgroundColor":"#223344"}}>
      <Text testID="layout-min" style={{"width":200,"minWidth":120,"maxWidth":140,"height":24}}>bounded</Text>
      <Text testID="layout-stretch" style={{"width":100,"height":24,"alignSelf":"stretch"}}>wrapped</Text>
      <View testID="layout-absolute" style={{"position":"absolute","right":8,"bottom":8,"width":12,"height":12,"backgroundColor":"#abcdef"}} />
    </View>
    <Text testID="layout-status">{layoutWidth > 0 ? `Layout width: ${layoutWidth}` : 'layout pending'}</Text>
    <Button testID="toggle-layout-width" onPress={toggleLayoutWidth}>Toggle layout width</Button>
    <ScrollView testID="native-scroll" keyboardDismissMode="on-drag" style={{"height":72,"gap":4}}>
      <Image
        testID="native-image"
        source={{"uri":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="}}
        accessibilityLabel="Native pixel"
        accessibilityRole="image"
        onPress={tapImage}
        onLoadStart={imageLoadStart}
        onLoad={imageLoaded}
        onLoadEnd={imageLoaded}
        style={{"width":24,"height":24,"resizeMode":"cover","tintColor":imageTinted ? "#2563eb" : undefined}}
      />
      <Text testID="native-caption">Image taps: {imageTaps}</Text>
      <Text testID="image-status">{imageStatus}</Text>
      <Text testID="image-error-status">{imageErrorStatus}</Text>
      <Image
        testID="unsupported-image"
        source={{"uri":"http://example.com/image.png"}}
        accessibilityLabel="Unsupported image"
        onError={imageFailed}
        style={{"width":16,"height":16}}
      />
      <View style={{"height":120}} />
      <Text testID="scroll-end">End of native scroll content</Text>
    </ScrollView>
    <Button testID="toggle-input-colors" onPress={toggleInputColors}>Toggle input colors</Button>
    <Text testID="input-style-status">{inputStyleStatus}</Text>
    <TextInput testID="name-input" placeholder="Your name" placeholderTextColor={inputColors ? "#94a3b8" : undefined} selectionColor={inputColors ? "#22c55e" : undefined} maxLength={8} keyboardType="email-address" returnKeyType="done" onChange={changeName} onFocus={focusName} onSubmitEditing={submitName} onBlur={blurName} onEndEditing={endNameEditing} />
    <TextInput testID="notes-input" multiline numberOfLines={3} maxLength={24} defaultValue="Draft" placeholder="Notes" placeholderTextColor={inputColors ? "#94a3b8" : undefined} selectionColor={inputColors ? "#22c55e" : undefined} onSubmitEditing={submitName} onBlur={blurNotes} onEndEditing={endNotesEditing} />
    <Text testID="greeting">Hello {name}</Text>
    <Text testID="name-submits">Submits: {submits}</Text>
    <Text testID="name-focuses">Focuses: {nameFocuses}</Text>
    <Text testID="name-blurs">Blurs: {nameBlurs}</Text>
    <Text testID="name-end-editings">End edits: {nameEndEditings}</Text>
    <Text testID="notes-blurs">Notes blurs: {notesBlurs}</Text>
    <Text testID="notes-end-editings">Notes end edits: {notesEndEditings}</Text>
    <Button testID="increment" onPress={increment}>Increment</Button>
    <Text testID="count">Count: {count}</Text>
    <Button testID="open-details" onPress={openDetails}>Open details</Button>
  </SafeAreaView>
</template>
