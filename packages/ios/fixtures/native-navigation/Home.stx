<script>
let name = ''
let count = 0
let imageTaps = 0

function changeName(event) {
  name = event.text
}

function increment() {
  count += 1
}

function tapImage() {
  imageTaps += 1
}

function openDetails() {
  globalThis.craft.navigation.push('details', { name, count })
}
</script>

<template>
  <View class="p-4">
    <Text testID="home-title">Home</Text>
    <View
      testID="styled-row"
      style={{"flexDirection":"row-reverse","alignItems":"center","justifyContent":"center","gap":6,"paddingHorizontal":10,"paddingVertical":5,"width":240,"height":64,"backgroundColor":"#123456","opacity":0.75,"borderWidth":2,"borderColor":"#abcdef","borderRadius":7,"overflow":"hidden"}}
    >
      <Text testID="styled-first" style={{"width":70,"color":"#fedcba","fontSize":21,"fontWeight":"700","fontStyle":"italic","textAlign":"right","letterSpacing":1,"lineHeight":26,"textTransform":"uppercase","textDecorationLine":"underline"}}>first</Text>
      <Text testID="styled-second" style={{"width":70}}>second</Text>
    </View>
    <ScrollView testID="native-scroll" style={{"height":72,"gap":4}}>
      <Image
        testID="native-image"
        source={{"uri":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M/wHwAF/gL+XhO6WQAAAABJRU5ErkJggg=="}}
        accessibilityLabel="Native pixel"
        accessibilityRole="image"
        onPress={tapImage}
        style={{"width":24,"height":24,"resizeMode":"cover"}}
      />
      <Text testID="native-caption">Image taps: {imageTaps}</Text>
    </ScrollView>
    <TextInput testID="name-input" placeholder="Your name" onChange={changeName} />
    <Text testID="greeting">Hello {name}</Text>
    <Button testID="increment" onPress={increment}>Increment</Button>
    <Text testID="count">Count: {count}</Text>
    <Button testID="open-details" onPress={openDetails}>Open details</Button>
  </View>
</template>
