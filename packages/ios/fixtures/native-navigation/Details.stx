<script client>
const name = state(String(globalThis.craft.route.params.name ?? ''))
const count = state(Number(globalThis.craft.route.params.count ?? 0))
let people = Array.from({ length: 40 }, (_, index) => ({ id: `person-${index}`, name: `Person ${index}` }))
let listEvents = 0
let rowLayouts = 0
let peopleRefreshing = false

function captureRowLayout() {
  rowLayouts += 1
}

function shufflePeople() {
  people = [people[1], { ...people[0], name: 'Person zero updated' }, ...people.slice(2)]
  listEvents += 1
}

function clearPeople() {
  people = []
  listEvents += 1
}

function loadMorePeople() {
  if (people.length !== 40)
    return
  const index = people.length
  people = [...people, { id: `person-${index}`, name: `Person ${index}` }]
  listEvents += 1
}

function refreshPeople() {
  peopleRefreshing = true
  setTimeout(() => {
    peopleRefreshing = false
    listEvents += 1
  }, 50)
}

function goBack() {
  globalThis.craft.navigation.back()
}

function replaceWithSummary() {
  globalThis.craft.navigation.replace('summary', { name: name(), count: count() })
}

function incrementDetails() {
  count.update(function(value) { return value + 1 })
}

onDestroy(function() {
  globalThis.craft.storage.set('native-navigation-details-destroyed', `${name()}/${count()}`)
})
</script>

<template>
  <View class="p-4">
    <Text testID="details-title" :text="'Details for ' + name()" />
    <Text testID="details-count" :text="'Count: ' + count()" />
    <Button testID="details-increment" @click="incrementDetails()">Increment details state</Button>
    <Text testID="people-count">People: {people.length}; events: {listEvents}</Text>
    <FlatList
      testID="people-list"
      keyboardDismissMode="on-drag"
      keyboardShouldPersistTaps="handled"
      contentContainerStyle={{"paddingTop":8}}
      data={people}
      keyExtractor={item.id}
      numColumns={2}
      onEndReached={loadMorePeople}
      onEndReachedThreshold={null}
      onRefresh={refreshPeople}
      refreshing={peopleRefreshing}
      threshold={0.8}
      style={{"height":160}}
    >
      <Text listRole="header" accessibilityRole="header" testID="people-header">People directory</Text>
      <View listRole="item" accessibilityLabel={item.name} onLayout={captureRowLayout}>
        <Text testID={'person-label-' + item.id}>{index}: {item.name}</Text>
        <TextInput testID={'person-input-' + item.id} placeholder="Note" />
      </View>
      <View listRole="separator" style={{"height":1,"backgroundColor":"#abcdef"}} />
      <Text listRole="empty" testID="people-empty">Nobody here</Text>
      <Text listRole="footer" testID="people-footer">End of people</Text>
    </FlatList>
    <Text testID="people-layout-status">Rows laid out: {rowLayouts}</Text>
    <Button testID="shuffle-people" onPress={shufflePeople}>Shuffle people</Button>
    <Button testID="clear-people" onPress={clearPeople}>Clear people</Button>
    <Button testID="details-back" @click="goBack()">Back in app</Button>
    <Button testID="open-summary" @click="replaceWithSummary()">Show summary</Button>
  </View>
</template>
