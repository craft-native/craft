<script>
const name = String(globalThis.craft.route.params.name ?? '')
const count = state(Number(globalThis.craft.route.params.count ?? 0))
const people = state(Array.from({ length: 40 }, (_, index) => ({ id: `person-${index}`, name: `Person ${index}` })))
const listEvents = state(0)
const rowLayouts = state(0)
const peopleRefreshing = state(false)
const detailsModalVisible = state(false)
const detailsModalStatus = state('')

// The guarded tab exercises a real mount/appearance redirect when prewarmed.
function guardFocusedRoute() {
  if (globalThis.craft.route.params.path === '/guarded' && globalThis.craft.navigation.isFocused())
    globalThis.craft.navigation.push('summary')
}

onMount(() => {
  globalThis.__detailsFocusAtMount = globalThis.craft.navigation.isFocused()
  guardFocusedRoute()
})
globalThis.craft.navigation.onAppear(guardFocusedRoute)

function captureRowLayout() {
  rowLayouts.update(value => value + 1)
}

function shufflePeople() {
  people.update(items => [items[1], { ...items[0], name: 'Person zero updated' }, ...items.slice(2)])
  listEvents.update(value => value + 1)
}

function clearPeople() {
  people.set([])
  listEvents.update(value => value + 1)
}

function loadMorePeople() {
  if (people().length !== 40)
    return
  const index = people().length
  people.update(items => [...items, { id: `person-${index}`, name: `Person ${index}` }])
  listEvents.update(value => value + 1)
}

function refreshPeople() {
  peopleRefreshing.set(true)
  setTimeout(() => {
    peopleRefreshing.set(false)
    listEvents.update(value => value + 1)
  }, 50)
}

function goBack() {
  globalThis.craft.navigation.back()
}

function toggleDetailsModal() {
  detailsModalVisible.update(value => !value)
}

function detailsModalRequested(event) {
  detailsModalStatus.set('details modal requested ' + event.reason)
  detailsModalVisible.set(false)
}

function replaceWithSummary() {
  globalThis.craft.navigation.replace('summary', { name, count: count() })
}

function incrementDetails() {
  count.update(value => value + 1)
}

onDestroy(() => globalThis.craft.storage.setSync('native-navigation-details-destroyed', `${name}/${count()}`))

globalThis.craft.navigation.setOptions({
  title: 'Details',
  tabAccessory: {
    path: '/capabilities',
    title: 'Capabilities',
    symbol: 'ellipsis.circle',
    accessibilityLabel: 'Open capabilities',
  },
})
</script>

<template>
  <SafeAreaView class="p-4">
    <Text testID="details-title" :text="'Details for ' + name" />
    <Text testID="details-count" :text="'Count: ' + count" />
    <Button testID="details-increment" @click="incrementDetails()">Increment details state</Button>
    <Text testID="people-count" :text="'People: ' + people().length + '; events: ' + listEvents" />
    <ScrollView
      testID="people-list"
      :stickyHeaderIndices="[0]"
      keyboardDismissMode="on-drag"
      keyboardShouldPersistTaps="handled"
      contentContainerStyle={{"paddingTop":8}}
      @refresh="refreshPeople()"
      refreshing={peopleRefreshing}
      style={{"height":160}}
    >
      <Text accessibilityRole="header" testID="people-header">People directory</Text>
      <View :for="(item, index) in people" :key="item.id" :accessibility-label="item.name" @layout="captureRowLayout()">
        <Text :test-id="'person-label-' + item.id" :text="index + ': ' + item.name" />
        <TextInput :test-id="'person-input-' + item.id" placeholder="Note" />
      </View>
      <Text :if="people().length === 0" testID="people-empty">Nobody here</Text>
      <Text testID="people-footer">End of people</Text>
    </ScrollView>
    <Text testID="people-layout-status" :text="'Rows laid out: ' + rowLayouts" />
    <Button testID="load-more-people" @click="loadMorePeople()">Load more people</Button>
    <Button testID="shuffle-people" @click="shufflePeople()">Shuffle people</Button>
    <Button testID="clear-people" @click="clearPeople()">Clear people</Button>
    <Button testID="details-back" @click="goBack()">Back in app</Button>
    <Button testID="open-summary" @click="replaceWithSummary()">Show summary</Button>
    <Button testID="toggle-details-modal" @click="toggleDetailsModal()">Show details modal</Button>
    <Text testID="details-modal-request-status" :text="detailsModalStatus" />
    <Modal testID="details-modal" visible={detailsModalVisible} animationType="none" @request-close="detailsModalRequested($event)">
      <Text testID="details-modal-content">Details modal</Text>
    </Modal>
  </SafeAreaView>
</template>
