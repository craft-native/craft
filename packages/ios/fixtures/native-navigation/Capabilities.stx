<script>
const status = state('Ready')
const appState = state(globalThis.craft.lifecycle.getState())

globalThis.craft.lifecycle.onStateChange(function(state) {
  appState.set(state)
})

async function saveData() {
  try {
    await globalThis.craft.storage.set('native-e2e-profile', { name: 'Ada', visits: 2 })
    await globalThis.craft.db.execute('CREATE TABLE IF NOT EXISTS native_e2e_people (name TEXT NOT NULL)')
    await globalThis.craft.db.execute('DELETE FROM native_e2e_people')
    await globalThis.craft.db.execute('INSERT INTO native_e2e_people (name) VALUES (?)', ['Grace'])
    status.set('Saved Ada and Grace')
  }
  catch (error) {
    status.set(`Save error ${error.code || 'UNKNOWN'}: ${error.message}`)
  }
}

async function loadData() {
  try {
    const profile = await globalThis.craft.storage.get('native-e2e-profile')
    const rows = await globalThis.craft.db.query('SELECT name FROM native_e2e_people')
    status.set(`Loaded ${profile.name} and ${rows[0].name}`)
  }
  catch (error) {
    status.set(`Load error ${error.code || 'UNKNOWN'}: ${error.message}`)
  }
}

async function testNotifications() {
  try {
    await globalThis.craft.notifications.schedule({
      id: 'native-e2e-reminder',
      title: 'Native reminder',
      body: 'Capability bridge',
      delay: 60000,
    })
    const scheduled = await globalThis.craft.notifications.pending()
    await globalThis.craft.notifications.cancel('native-e2e-reminder')
    const remaining = await globalThis.craft.notifications.pending()
    const found = scheduled.some(function(item) { return item.id === 'native-e2e-reminder' })
    const removed = !remaining.some(function(item) { return item.id === 'native-e2e-reminder' })
    status.set(`Notifications ${found && removed ? 'scheduled and cancelled' : 'failed'}`)
  }
  catch (error) {
    status.set(`Notification error ${error.code || 'UNKNOWN'}: ${error.message}`)
  }
}

async function testSecureStorage() {
  let stage = 'SecureStorage.set'
  try {
    await globalThis.craft.secureStorage.set('native-e2e-secret', 'keychain-value')
    stage = 'SecureStorage.get'
    const value = await globalThis.craft.secureStorage.get('native-e2e-secret')
    stage = 'SecureStorage.delete'
    await globalThis.craft.secureStorage.delete('native-e2e-secret')
    stage = 'Biometrics.isAvailable'
    await globalThis.craft.biometrics.isAvailable()
    stage = 'Biometrics.getBiometricType'
    await globalThis.craft.biometrics.getBiometricType()
    status.set(value === 'keychain-value' ? 'Secure storage roundtrip' : 'Secure storage failed')
  }
  catch (error) {
    status.set(`Secure storage error at ${stage} ${error.code || 'UNKNOWN'}: ${error.message}`)
  }
}
</script>

<template>
  <View class="p-4">
    <Text testID="capabilities-title">Native capabilities</Text>
    <Text testID="capabilities-platform" :text="'Platform: ' + globalThis.craft.platform" />
    <Text testID="capabilities-state" :text="'App state: ' + appState" />
    <Text testID="capabilities-status" :text="status" />
    <Button testID="save-capabilities" @click="saveData()">Save persistent data</Button>
    <Button testID="load-capabilities" @click="loadData()">Load persistent data</Button>
    <Button testID="test-notifications" @click="testNotifications()">Test notifications</Button>
    <Button testID="test-secure-storage" @click="testSecureStorage()">Test secure storage</Button>
  </View>
</template>
