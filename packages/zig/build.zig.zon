.{
    .fingerprint = 0xf45c4a848bf58c1c,
    .name = .craft,
    .version = "0.0.76",
    .minimum_zig_version = "0.17.0-dev",
    .dependencies = .{
        // First-party, and the engine craft's own JavaScript runs on — see
        // src/js_runtime.zig. A sibling checkout rather than a URL because
        // zig-js's own dependencies are relative paths; publishing those is
        // what would let this become a fetchable `.url` dependency.
        .zig_js = .{ .path = "../../../../Libraries/zig-js" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "test",
    },
}
