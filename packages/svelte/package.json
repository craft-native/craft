{
  "name": "@craft-native/svelte",
  "version": "0.0.70",
  "private": true,
  "description": "Svelte bindings for Craft framework",
  "svelte": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "keywords": [
    "craft",
    "svelte",
    "stores",
    "actions",
    "native"
  ],
  "author": "Craft Team",
  "license": "MIT",
  "peerDependencies": {
    "svelte": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "svelte": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2"
  }
}
