{
  "name": "@craft-native/svelte",
  "version": "0.0.533",
  "homepage": "https://github.com/craft-native/craft/tree/main/packages/svelte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craft-native/craft.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/craft-native/craft/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "description": "Svelte bindings for Craft framework",
  "svelte": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-bindings.ts && tsc --emitDeclarationOnly",
    "dev": "bun --watch ../../scripts/build-bindings.ts"
  },
  "keywords": [
    "craft",
    "svelte",
    "stores",
    "actions",
    "native"
  ],
  "author": "Craft Team",
  "license": "MIT",
  "peerDependencies": {
    "svelte": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.55.7",
    "typescript": "7.1.0-dev.20261011.1"
  },
  "dependencies": {
    "craft-native": "workspace:*"
  }
}
