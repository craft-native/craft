    val selectionCornerRadius: Float? = null,
)

internal data class CraftTabIconAppearance(val symbol: String, val tint: Int?, val pulse: Boolean)

/** The app's paths (`nativeScreens`), its tabs and its site. */
internal class CraftNativeRoutes(config: JSONObject) {
    private data class Route(val segments: List<String>, val screen: String)

    /**
     * The iOS shell's order (CraftHybrid.swift's route table): a trailing
     * `*` last, then more fixed segments first, then longer patterns, then
     * by name, so `/m/store/library` is never taken for `/m/store/:slug`.
     */
    private val routes: List<Route> = buildList {
        val screens = config.optJSONObject("nativeScreens") ?: JSONObject()
        screens.keys().forEach { pattern ->
            val screen = screens.optString(pattern)
            if (screen.isNotBlank()) add(Route(segmentsOf(pattern), screen))
        }
    }.sortedWith(
        compareBy<Route> { if (it.segments.lastOrNull() == "*") 1 else 0 }
            .thenByDescending { route -> route.segments.count { it != "*" && !it.startsWith(":") } }
            .thenByDescending { it.segments.size }
            .thenBy { it.segments.joinToString("/") },
    )

    val tabs: List<CraftNativeTab> = buildList {
        val list = config.optJSONArray("tabs") ?: JSONArray()
        for (index in 0 until list.length()) {
            val tab = list.optJSONObject(index) ?: continue
            val id = tab.optString("id").takeIf { it.isNotBlank() } ?: continue
            add(CraftNativeTab(normalize(id), tab.optString("title", id), tab.optString("symbol"),
                tab.optString("selectedSymbol").trim().takeUnless { tab.isNull("selectedSymbol") || it.isBlank() },
                tab.optString("selectedIconTint").takeUnless { tab.isNull("selectedIconTint") || it.isBlank() },
                if (tab.opt("selectedIconPulse") is Boolean) tab.optBoolean("selectedIconPulse") else null))
        }
    }

    val tabBarAppearance: CraftNativeTabBarAppearance = config.optJSONObject("tabBar")
        ?.optJSONObject("selection")
        ?.let { selection ->
            CraftNativeTabBarAppearance(
                selection.optString("color").takeIf { it.isNotBlank() },
                (selection.opt("cornerRadius") as? Number)?.toFloat()?.takeIf { it.isFinite() && it >= 0 },
            )
        }
        ?: CraftNativeTabBarAppearance()

    /** The app's site (`devServerURL`): its origin answers paths no screen draws. */
    val site: Uri? = config.optString("devServerURL").takeIf { it.isNotBlank() }?.let(Uri::parse)
    val siteOrigin: String? = site?.let { uri ->
        val port = if (uri.port > 0) ":${uri.port}" else ""
        "${uri.scheme?.lowercase()}://${uri.host?.lowercase()}$port"
    }

    /** Where the app opens: the site's path when a screen draws it, else the first tab. */
    val initialPath: String = site?.let { uri ->
        val path = uri.encodedPath?.takeIf { it.isNotBlank() } ?: "/"
        val query = uri.encodedQuery?.takeIf { it.isNotBlank() }?.let { "?$it" } ?: ""
        (path + query).takeIf { match(it) != null }
    } ?: tabs.firstOrNull()?.id ?: "/"

    val isEmpty: Boolean get() = routes.isEmpty()

    /** The tab whose root is `path` (without its query), if any. */
    fun tabFor(path: String): CraftNativeTab? {
        val bare = normalize(path.substringBefore('?').substringBefore('#'))
        return tabs.firstOrNull { it.id == bare }
    }

    /**
     * The path inside the app for `target`: a path as it is, or an address on
     * the app's own site (or its URL scheme, `hqtraining://m/connections`) as
     * its path and query. Another site's address is not the app's: null.
     */
    fun appPath(target: String, schemes: Collection<String>): String? {
        if (target.startsWith("/")) return target
        val uri = runCatching { Uri.parse(target) }.getOrNull() ?: return null
        val scheme = uri.scheme?.lowercase() ?: return null
        if (scheme in schemes) {
            // hqtraining://m/connections: the host is the first segment.
            val path = "/" + listOfNotNull(uri.host?.takeIf { it.isNotBlank() }, uri.path?.trim('/')?.takeIf { it.isNotBlank() })
                .joinToString("/")
            return path + (uri.encodedQuery?.let { "?$it" } ?: "")
        }
        val origin = siteOrigin ?: return null
        val port = if (uri.port > 0) ":${uri.port}" else ""
        if ("${scheme}://${uri.host?.lowercase()}$port" != origin) return null
        return (uri.encodedPath ?: "/") + (uri.encodedQuery?.let { "?$it" } ?: "")
    }

    /** The screen that draws `path`, with its parameters and query as params. */
    fun match(path: String): CraftNativeRouteMatch? {
        val bare = normalize(path.substringBefore('#').substringBefore('?'))
        val query = path.substringBefore('#').substringAfter('?', "")
        val parts = segmentsOf(bare)
        for (route in routes) {
            val params = bind(route.segments, parts) ?: continue
            if (query.isNotBlank()) {
                query.split('&').filter { it.isNotBlank() }.forEach { pair ->
                    val key = Uri.decode(pair.substringBefore('='))
                    if (key.isNotBlank() && !params.has(key)) params.put(key, decode(pair.substringAfter('=', "").replace('+', ' ')))
                }
            }
            return CraftNativeRouteMatch(route.screen, params, bare)
        }
        return null
    }

    private fun bind(pattern: List<String>, parts: List<String>): JSONObject? {
        val params = JSONObject()
        for (index in pattern.indices) {
            val expected = pattern[index]
            if (expected == "*") {
                params.put("*", parts.drop(index).joinToString("/"))
                return params
            }
            if (index >= parts.size) return null
            if (expected.startsWith(":")) {
                if (parts[index].isBlank()) return null
                params.put(expected.removePrefix(":"), Uri.decode(parts[index]))
            } else if (expected != parts[index]) return null
        }
        return if (pattern.size == parts.size) params else null
    }

    /** The tab a path belongs under (`/m/store/42` → `/m/store`), for a link opened from outside. */
    fun tabOwning(path: String): CraftNativeTab? {
        val bare = normalize(path.substringBefore('?').substringBefore('#'))
        return tabs.filter { tab -> bare == tab.id || bare.startsWith(tab.id.trimEnd('/') + "/") }
            .maxByOrNull { it.id.length }
            ?.takeIf { it.id != "/" }
    }

    /** An address on the site for a path no screen draws. */
    fun siteURL(path: String): String? = siteOrigin?.let { it + (if (path.startsWith("/")) path else "/$path") }

    companion object {
        fun normalize(path: String): String {
            val trimmed = path.trim().ifBlank { "/" }
            val withSlash = if (trimmed.startsWith("/")) trimmed else "/$trimmed"
            return if (withSlash.length > 1) withSlash.trimEnd('/') else withSlash
        }

        private fun segmentsOf(path: String): List<String> =
            normalize(path).split('/').filter { it.isNotBlank() }

        private fun decode(value: String): String =
            runCatching { URLDecoder.decode(value, "UTF-8") }.getOrDefault(value)
    }
}

/**
 * The stores a screen reads synchronously, shared by the whole process:
 *
 * - `storage`: the `craft-native-storage` preferences behind `craft.storage`
 *   (JSON text per key, CraftNativeCapabilities.storage).
 * - `secure`: the encrypted preferences behind `craft.secureStorage`.
 * - `snapshots`: `files/craft-snapshots/<name>.json`, what a screen keeps for
 *   its next first frame and for no signal (`craft.snapshots`).
 *
 * Writes happen on one background thread, in order.
 */
/** One process-wide boundary for committed storage reads and mutations. */
internal object CraftNativeStorage {
    val lock = Any()
    fun jsonEqual(left: Any?, right: Any?): Boolean {
        if (left == null || left === JSONObject.NULL) return right == null || right === JSONObject.NULL
        if (left is Boolean || right is Boolean) return left is Boolean && right is Boolean && left == right
        if (left is Number && right is Number) return java.math.BigDecimal(left.toString()).compareTo(java.math.BigDecimal(right.toString())) == 0
        if (left is JSONObject && right is JSONObject) return left.length() == right.length() && left.keys().asSequence().all { right.has(it) && jsonEqual(left.get(it), right.get(it)) }
        if (left is JSONArray && right is JSONArray) return left.length() == right.length() && (0 until left.length()).all { jsonEqual(left.get(it), right.get(it)) }
        return left is String && right is String && left == right
    }
    fun commit(storage: SharedPreferences, update: (android.content.SharedPreferences.Editor) -> Unit): Boolean {
        val previous = storage.all
        val editor = storage.edit()
        update(editor)
        if (editor.commit()) return true
        // A failed commit has already changed SharedPreferences' memory map.
        // Restore it before a later draft read can mistake it for a checkpoint.
        val rollback = storage.edit().clear()
        previous.forEach { (key, value) -> when (value) {
            is String -> rollback.putString(key, value)
            is Boolean -> rollback.putBoolean(key, value)
            is Long -> rollback.putLong(key, value)
            is Int -> rollback.putInt(key, value)
            is Float -> rollback.putFloat(key, value)
            else -> error("Invalid stored value")
        } }
        rollback.commit()
        return false
    }

}

internal class CraftNativeStores private constructor(
    context: Context,
    private val secureEnabled: Boolean,
    private val snapshotFiles: CraftSnapshotFile,
) {
    private constructor(context: Context, secureEnabled: Boolean) : this(context, secureEnabled, CraftSnapshotFile())
    private val appContext = context.applicationContext
    private val storage: SharedPreferences = appContext.getSharedPreferences("craft-native-storage", Context.MODE_PRIVATE)
    private val snapshotsDir = File(appContext.filesDir, "craft-snapshots").apply { mkdirs() }
    private val writer = Executors.newSingleThreadExecutor()
    private val main = Handler(Looper.getMainLooper())

    private val secure: SharedPreferences? by lazy {
        if (!secureEnabled) return@lazy null
        runCatching {
            val masterKey = MasterKey.Builder(appContext).setKeyScheme(MasterKey.KeyScheme.AES256_GCM).build()
            EncryptedSharedPreferences.create(
                appContext,
                "craft_secure_prefs",
                masterKey,
                EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
                EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM,
            )
        }.onFailure { Log.e("CraftNativeAndroid", "Secure storage could not be opened", it) }.getOrNull()
    }

    /**
     * The snapshots, read from disk once and kept as their JSON text: every
     * isolate starts with all of them (a screen reads one synchronously), and
     * reading the folder for each new screen took longer than a frame.
     */
    private val snapshotCache: MutableMap<String, String> by lazy {
        val cache = ConcurrentHashMap<String, String>()
        snapshotsDir.listFiles()?.forEach { file ->
            if (!file.name.endsWith(".json")) return@forEach
            val name = snapshotName(file) ?: return@forEach
            runCatching { cache[name] = file.readText() }
        }
        cache
    }

    /**
     * Everything an isolate needs before its first line runs, as JSON text:
     * `{ storage: { key: json }, secure: { key: value }, snapshots: { name: json } }`.
     * Values stay JSON text; the isolate parses what it reads. Built off the
     * main thread (it can run to megabytes with a few weeks of sessions kept).
     */
    fun preloadText(): String {
        val out = StringBuilder(64 * 1024)
        fun section(name: String, values: Map<String, String>) {
            out.append(JSONObject.quote(name)).append(":{")
            var first = true
            for ((key, value) in values) {
                if (!first) out.append(',')
                first = false
                out.append(JSONObject.quote(key)).append(':').append(JSONObject.quote(value))
            }
            out.append('}')
        }
        out.append('{')
        section("storage", synchronized(CraftNativeStorage.lock) { storage.all.mapNotNull { (key, value) -> (value as? String)?.let { key to it } }.toMap() })
        out.append(',')
        section("secure", runCatching { secure?.all?.mapNotNull { (key, value) -> (value as? String)?.let { key to it } }?.toMap() }.getOrNull() ?: emptyMap())
        out.append(',')
        section("snapshots", snapshotCache)
        out.append('}')
        return out.toString()
    }

    /** The same, parsed (tests and small hosts). */
    fun preload(): JSONObject = JSONObject(preloadText())

    fun snapshot(name: String): String? = snapshotCache[name]

    /** `craft.storage.setSync`: null removes the key. Tells every isolate. */
    fun setStorage(key: String, json: String?, from: String?) {
        synchronized(CraftNativeStorage.lock) {
            val previous = storage.getString(key, null)
            val kept = CraftNativeStorage.commit(storage) {
                if (json == null) it.remove(key) else it.putString(key, json)
            }
            if (kept) changed("storage", key, json, from)
            else changed("storage", key, previous, null)
        }
    }

    /** `craft.snapshots.set`: null deletes it. `done` hears whether it was kept, on the main thread. */
    fun setSnapshot(name: String, json: String?, from: String?, done: (Boolean) -> Unit) {
        if (!isSnapshotName(name)) {
            main.post { done(false) }
            return
        }
        writer.execute {
            val file = snapshotFile(name)
            val previous = snapshotCache[name]
            val ok = runCatching {
                if (json == null) {
                    !file.exists() || file.delete()
                } else {
                    snapshotFiles.set(file, json)
                    true
                }
            }.getOrDefault(false)
            if (ok) {
                if (json == null) snapshotCache.remove(name) else snapshotCache[name] = json
            }
            main.post {
                // Isolates optimistically display their write. Restore the
                // confirmed value before rejecting an unsuccessful checkpoint.
                changed("snapshots", name, if (ok) json else previous, null)
                done(ok)
            }
        }
    }

    /** `craft.snapshots.clear(keep)`: every snapshot but those named, as a sign-out does. */
    fun clearSnapshots(keep: Set<String>, done: (Boolean) -> Unit) {
        writer.execute {
            val removed = mutableListOf<String>()
            var ok = true
            snapshotsDir.listFiles()?.forEach { file ->
                if (!file.name.endsWith(".json")) return@forEach
                val name = snapshotName(file) ?: return@forEach
                if (name in keep) return@forEach
                if (file.delete()) removed.add(name) else ok = false
            }
            removed.forEach(snapshotCache::remove)
            main.post {
                removed.forEach { changed("snapshots", it, null, null) }
                done(ok)
            }
        }
    }

    /** A change made through the capability API (`Storage`, `SecureStorage`): every isolate's copy follows it. */
    fun changed(store: String, key: String?, value: String?, from: String?) {
        val payload = JSONObject().put("store", store)
        if (key == null) payload.put("clear", true) else payload.put("key", key).put("value", value ?: JSONObject.NULL)
        CraftNativeHub.broadcast("SYNC_UPDATE", payload, except = from)
    }

    private fun isSnapshotName(name: String): Boolean = name.matches(Regex("[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}"))

    private fun snapshotFile(name: String): File = File(snapshotsDir, URLEncoder.encode(name, "UTF-8") + ".json")

    private fun snapshotName(file: File): String? =
        runCatching { URLDecoder.decode(file.name.removeSuffix(".json"), "UTF-8") }.getOrNull()

    companion object {
        @Volatile private var shared: CraftNativeStores? = null

        fun get(context: Context, config: JSONObject): CraftNativeStores = shared ?: synchronized(this) {
            shared ?: CraftNativeStores(context, config.optBoolean("enableSecureStorage")).also { shared = it }
        }
    }
}

/**
 * The script every isolate runs before the bundle: the bridge object stx's
 * runtime reads, the synchronous stores, and the routing of `SYNC_*`
 * messages that keep them current. `post` is how the bridge sends a string
 * to the host in this isolate (a message port or the console).
 */
internal object CraftNativePrelude {
    /**
     * The secure-storage key the signed-in account's token lives under
     * (`sessionTokenKey` in craft.config.json, `auth.token` by default):
     * `craft.session` follows it, and a change of it is `SESSION_CHANGED`.
     */
    fun sessionTokenKey(config: JSONObject): String = config.optString("sessionTokenKey").ifBlank { "auth.token" }

    fun script(
        bridgeFields: String,
        post: String,
        receiveSetup: String,
        stores: String,
        routePrelude: String,
    ): String = template(bridgeFields, post, receiveSetup, routePrelude).replace(STORES, stores)

    /** Where the stores go: put in after the (small) script is laid out, so megabytes are never re-indented. */
    private const val STORES = "__CRAFT_PRELOADED_STORES__"

    private fun template(
        bridgeFields: String,
        post: String,
        receiveSetup: String,
        routePrelude: String,
    ): String = """
        $routePrelude
        // JavaScriptSandbox has no DOM window, but browser-safe SDK bridges
        // address the host through `window.craft`. Keep native screens
        // compatible without pretending a document exists.
        if (typeof globalThis.window === 'undefined') globalThis.window = globalThis;
        // JavaScriptSandbox intentionally has no browser URL/encoding
        // globals. Install named failures instead of letting a shared module
        // die with an unhelpful `URLSearchParams is not defined` halfway
        // through its load path. The full browser implementations belong to
        // the shared STX runtime; these diagnostics keep the native boundary
        // explicit until that runtime is present.
        (function() {
          function unavailable(name, hint) {
            var failure = function() {
              throw new ReferenceError(name + ' is not available on a native screen — ' + hint);
            };
            failure.prototype.constructor = failure;
            return failure;
          }
          if (typeof globalThis.URL === 'undefined') globalThis.URL = unavailable('URL', 'use an absolute URL or build the path with encodeURIComponent');
          if (typeof globalThis.URLSearchParams === 'undefined') globalThis.URLSearchParams = unavailable('URLSearchParams', 'build query strings with encodeURIComponent');
          if (typeof globalThis.TextEncoder === 'undefined') globalThis.TextEncoder = unavailable('TextEncoder', 'use a native-supported encoding helper');
        })();
        (function() {
          var forward = null;
          var listeners = [];
          var queued = [];
          var sync = { storage: {}, secure: {}, snapshots: {} };
          var preload = $STORES;
          ['storage', 'secure', 'snapshots'].forEach(function(store) {
            var given = preload[store] || {};
            Object.keys(given).forEach(function(key) { sync[store][key] = given[key]; });
          });
          var waiting = {};
          var nextWait = 0;
          // JavaScriptSandbox has no timers: the host keeps them (TIMER /
          // TIMER_CLEAR out, TIMER_FIRE back), as Craft's iOS host gives
          // JavaScriptCore its own.
          var timers = {};
          var nextTimer = 0;
          function arm(fn, ms, args, every) {
            if (typeof fn !== 'function') return 0;
            var id = ++nextTimer;
            var delay = Math.max(0, Number(ms) || 0);
            timers[id] = { fn: fn, args: args, every: every ? Math.max(1, delay) : null };
            send(JSON.stringify({ type: 'TIMER', payload: { id: id, ms: delay } }));
            return id;
          }
          function disarm(id) {
            if (!timers[id]) return;
            delete timers[id];
            send(JSON.stringify({ type: 'TIMER_CLEAR', payload: { id: id } }));
          }
          // requestAnimationFrame from the host's vsync, for the screen on
          // display only (Choreographer); one request covers every callback.
          var frames = [];
          var cancelledFrames = {};
          var nextFrame = 0;
          if (typeof globalThis.requestAnimationFrame !== 'function') {
            globalThis.requestAnimationFrame = function(fn) {
              if (typeof fn !== 'function') return 0;
              var id = ++nextFrame;
              frames.push({ id: id, fn: fn });
              if (frames.length === 1) send(JSON.stringify({ type: 'FRAME', payload: {} }));
              return id;
            };
            globalThis.cancelAnimationFrame = function(id) { cancelledFrames[id] = true; };
          }
          if (typeof globalThis.setTimeout !== 'function') {
            globalThis.setTimeout = function(fn, ms) { return arm(fn, ms, Array.prototype.slice.call(arguments, 2), false); };
            globalThis.setInterval = function(fn, ms) { return arm(fn, ms, Array.prototype.slice.call(arguments, 2), true); };
            globalThis.clearTimeout = disarm;
            globalThis.clearInterval = disarm;
          }
          function send(value) { if (typeof value !== 'string') value = JSON.stringify(value); $post }
          function emit(message) {
            var raw = typeof message === 'string' ? message : JSON.stringify(message);
            listeners.slice().forEach(function(callback) {
              try { callback(raw); } catch (error) {}
            });
            if (forward) forward(raw);
            else queued.push(message);
          }
          function deliver(raw) {
            var message = raw;
            if (typeof raw === 'string') {
              try { message = JSON.parse(raw); } catch (error) { return emit(raw); }
            }
            if (message && message.type === 'SYNC_UPDATE') {
              var payload = message.payload || {};
              var bucket = sync[payload.store];
              if (!bucket) return;
              var sessionBefore = payload.store === 'secure' ? sessionToken() : null;
              if (payload.clear) {
                Object.keys(bucket).forEach(function(key) {
                  if (!(payload.keep || []).includes(key)) {
                    delete bucket[key];
                    if (payload.store === 'snapshots') emit({ type: 'SNAPSHOT_CHANGED', payload: { name: key } });
                  }
                });
                if (payload.store === 'secure') sessionMoved(sessionBefore);
                return;
              }
              if (payload.value === null || payload.value === undefined) delete bucket[payload.key];
              else bucket[payload.key] = payload.value;
              if (payload.store === 'snapshots') emit({ type: 'SNAPSHOT_CHANGED', payload: { name: payload.key } });
              if (payload.store === 'secure') sessionMoved(sessionBefore);
              return;
            }
            if (message && message.type === 'TIMER_FIRE') {
              var timer = timers[message.payload && message.payload.id];
              if (!timer) return;
              if (timer.every === null) delete timers[message.payload.id];
              else send(JSON.stringify({ type: 'TIMER', payload: { id: message.payload.id, ms: timer.every } }));
              try { timer.fn.apply(null, timer.args); } catch (error) { console.error('[timer] ' + (error && error.stack || error)); }
              return;
            }
            if (message && message.type === 'FRAME_FIRE') {
              var due = frames;
              frames = [];
              var time = message.payload && message.payload.time || Date.now();
              due.forEach(function(entry) {
                if (cancelledFrames[entry.id]) { delete cancelledFrames[entry.id]; return; }
                try { entry.fn(time); } catch (error) { console.error('[frame] ' + (error && error.stack || error)); }
              });
              return;
            }
            if (message && message.type === 'SYNC_RESULT') {
              var done = waiting[message.payload && message.payload.id];
              if (done) {
                delete waiting[message.payload.id];
                done(message.payload.ok === true);
              }
              return;
            }
            emit(raw);
          }
          // The signed-in account: the token under `sessionTokenKey` in the
          // secure store. Every isolate hears every secure write (SYNC_UPDATE,
          // the writer's too), so a change of the token, whoever made it, is
          // one `SESSION_CHANGED { key, token, previous }` here, after the
          // store holds it, then the `craft.session.onChange` listeners.
          var sessionListeners = [];
          function sessionKey() {
            var bridge = globalThis.__stxNativeBridge;
            return bridge && typeof bridge.sessionTokenKey === 'string' && bridge.sessionTokenKey ? bridge.sessionTokenKey : 'auth.token';
          }
          function sessionToken() {
            var value = sync.secure[sessionKey()];
            return typeof value === 'string' && value !== '' ? value : null;
          }
          function sessionMoved(before) {
            var token = sessionToken();
            if (token === before) return;
            var change = { key: sessionKey(), token: token, previous: before };
            emit({ type: 'SESSION_CHANGED', payload: change });
            sessionListeners.slice().forEach(function(callback) {
              try { callback(token, before); } catch (error) { console.error('[session] ' + (error && error.stack || error)); }
            });
          }
          function wait(type, payload) {
            return new Promise(function(resolve, reject) {
              var id = 'sync-' + (++nextWait);
              waiting[id] = function(ok) { ok ? resolve() : reject(new Error('craft.' + type + ' could not be written')); };
              payload.id = id;
              send(JSON.stringify({ type: 'SYNC_WRITE', payload: payload }));
            });
          }
          globalThis.__stxNativeBridge = {
            $bridgeFields,
            postMessage: function(value) { send(value); },
            onMessage: function(callback) {
              forward = callback;
              var pending = queued;
              queued = [];
              pending.forEach(emit);
            },
            addMessageListener: function(callback) {
              if (typeof callback !== 'function') return function() {};
              listeners.push(callback);
              return function() {
                var index = listeners.indexOf(callback);
                if (index >= 0) listeners.splice(index, 1);
              };
            }
          };
          $receiveSetup

          function parsed(json) {
            if (json === null || json === undefined) return null;
            try { return JSON.parse(json); } catch (error) { return null; }
          }
          function validSnapshotName(name) {
            return /^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$/.test(name);
          }
          var craft = globalThis.craft = globalThis.craft || {};
          function keep(name, extras) {
            var current = {};
            function adopt(next) {
              current = next && typeof next === 'object' ? next : {};
              Object.keys(extras).forEach(function(key) {
                if (!(key in current)) current[key] = extras[key];
              });
            }
            adopt(craft[name]);
            Object.defineProperty(craft, name, { configurable: true, enumerable: true, get: function() { return current; }, set: adopt });
          }
          keep('storage', {
            getSync: function(key) { return parsed(sync.storage[String(key)]); },
            setSync: function(key, value) {
              var json = value === null || value === undefined ? null : JSON.stringify(value);
              if (json === null) delete sync.storage[String(key)];
              else sync.storage[String(key)] = json;
              send(JSON.stringify({ type: 'SYNC_WRITE', payload: { store: 'storage', key: String(key), value: json } }));
            }
          });
          keep('snapshots', {
            get: function(name) {
              name = String(name);
              return validSnapshotName(name) ? parsed(sync.snapshots[name]) : null;
            },
            set: function(name, value) {
              name = String(name);
              if (!validSnapshotName(name)) return Promise.reject(new TypeError('Snapshot names are letters, digits, ".", "_" and "-"'));
              var json = value === null ? null : JSON.stringify(value);
              if (json === undefined) return Promise.reject(new TypeError('Snapshot ' + name + ' is not JSON'));
              if (json === null) delete sync.snapshots[name];
              else sync.snapshots[name] = json;
              return wait('snapshots.set', { store: 'snapshots', key: name, value: json });
            },
            clear: function(keepNames) {
              var names = Array.isArray(keepNames) ? keepNames.map(String) : [];
              return wait('snapshots.clear', { store: 'snapshots', clear: true, keep: names });
            }
          });
          keep('secureStorage', {
            getSync: function(key) {
              var value = sync.secure[String(key)];
              return value === undefined ? null : value;
            }
          });
          keep('session', {
            key: sessionKey(),
            token: sessionToken,
            onChange: function(callback) {
              if (typeof callback !== 'function') throw new TypeError('craft.session.onChange needs a function');
              sessionListeners.push(callback);
              return function() {
                var index = sessionListeners.indexOf(callback);
                if (index >= 0) sessionListeners.splice(index, 1);
              };
            }
          });
          // Older native bundles call the page-shaped `craft.dialog` API
          // directly. Keep that API on the capability bridge so JavaScript
          // Core/JavaScriptSandbox screens never fall back to a DOM sheet.
          // Native capability ownership wins over any browser-shaped dialog
          // object the bundle installed before the bridge ran. Otherwise an
          // action sheet silently falls back to the DOM renderer.
          var nextDialogRequest = 0;
          function dialogRequest(method, args) {
              return new Promise(function(resolve, reject) {
                var id = 'craft-dialog-' + (++nextDialogRequest);
                var remove = __stxNativeBridge.addMessageListener(function(raw) {
                  var message;
                  try { message = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (error) { return; }
                  var payload = message && message.payload;
                  if (!payload || payload.requestId !== id) return;
                  remove();
                  if (message.type === 'API_ERROR') {
                    var failure = new Error(payload.message || 'Native dialog failed');
                    failure.code = payload.code || 'NATIVE_CALL_FAILED';
                    reject(failure);
                  } else if (message.type === 'API_RESPONSE') {
                    resolve(payload.data === undefined ? null : payload.data);
                  }
                });
                __stxNativeBridge.postMessage(JSON.stringify({
                  type: 'API_REQUEST',
                  id: id,
                  payload: {
                    version: __stxNativeBridge.capabilityProtocolVersion || 1,
                    module: 'Dialog',
                    method: method,
                    args: args,
                    untimed: true,
                  },
                }));
              });
          }
          function installNativeDialog() {
            var craft = globalThis.craft = globalThis.craft || {};
            if (Array.isArray(__stxNativeBridge.capabilities) && __stxNativeBridge.capabilities.indexOf('dialog') >= 0) {
              craft.dialog = {
                alert: function(options) { return dialogRequest('alert', [options || {}]).then(function() {}); },
                confirm: function(options) { return dialogRequest('confirm', [options || {}]).then(Boolean); },
                actionSheet: function(options) { return dialogRequest('actionSheet', [options || {}]).then(function(id) { return typeof id === 'string' ? id : null; }); },
              };
            }
          }
          globalThis.__craftInstallNativeDialog = installNativeDialog;
          installNativeDialog();
        })();
    """.trimIndent()
}

/**
 * The bar above a screen (back, title, the screen's buttons) and the tab bar
 * below it, in plain Android views. A screen sets its bar with
 * `craft.navigation.setOptions` (title, largeTitle, hidden, rightButtons,
 * tabAccessory, tabBarHidden); the tabs come from the app's `tabs`.
 */
internal class CraftNativeChrome(
    context: Context,
    private val tabs: List<CraftNativeTab>,
    private val tabBarAppearance: CraftNativeTabBarAppearance = CraftNativeTabBarAppearance(),
) : LinearLayout(context) {
    val content = FrameLayout(context)
    private val bar = LinearLayout(context)
    private val backButton = ImageView(context)
    private val leadingButtons = LinearLayout(context)
    private val titleView = TextView(context)
    private val largeTitleView = TextView(context)
    private val buttons = LinearLayout(context)
    private val tabBar = LinearLayout(context)
    private val tabRow = LinearLayout(context)
    private val accessory = FrameLayout(context)
    private val accessoryIcon = ImageView(context)
    private val accessoryBadge = TextView(context)
    private var accessorySpec: JSONObject? = null
    private val tabViews = mutableListOf<Pair<TextView, TextView>>()
    private val tabIconText = mutableMapOf<String, String>()
    private val tabTitles = mutableMapOf<String, String>()
    private val tabAccessibilityLabels = mutableMapOf<String, String>()
    private val tabIconTints = mutableMapOf<String, Int>()
    private val tabIconPulses = mutableSetOf<String>()
    private val selectedSymbols = mutableMapOf<String, String>()
    /** The page's own symbol for a tab while it says so, in place of the configured one. */
    private val tabSymbols = mutableMapOf<String, String>()
    private val selectedIconTints = mutableMapOf<String, Int>()
    private val selectedIconPulses = mutableMapOf<String, Boolean>()
    private val tabImageURLs = mutableMapOf<String, String>()
    private val tabImages = mutableMapOf<String, android.graphics.drawable.Drawable>()
    private val navButtonSpecs = mutableMapOf<TextView, JSONObject>()
    private var renderedButtonSpecs: Pair<String, String>? = null
    private val density = resources.displayMetrics.density
    private var screenBackgroundColor: Int? = null
    private var selectedTab = 0
    private var tabBarHiddenByScreen = false
    private var visiblePath: String? = null
    private val accessorySelected: Boolean
        get() = accessorySpec?.optString("path")?.let { path -> visiblePath == path || visiblePath?.startsWith(path + "/") == true } == true
    private var swipeTracking = false
    private var swipeIntercepted = false
    private var horizontalScrollDeferred = false
    private var swipeDownX = 0f
    private var swipeDownY = 0f
    private val swipeSlop = ViewConfiguration.get(context).scaledTouchSlop

    var onBack: (() -> Unit)? = null
    var onButton: ((String) -> Unit)? = null
    var onTab: ((Int) -> Unit)? = null
    var onAccessory: ((String) -> Unit)? = null
    var onTabSwipeStart: ((Float, Float, Float) -> Boolean)? = null
    var onTabSwipeMove: ((Float) -> Unit)? = null
    var onTabSwipeEnd: ((Float, Boolean) -> Unit)? = null
    /** Lets a native horizontal scroller own the gesture from its first down. */
    var onTabSwipeShouldDefer: ((Float, Float) -> Boolean)? = null
    var tabSwipeEnabled = true

    init {
        orientation = VERTICAL
        bar.orientation = HORIZONTAL
        bar.gravity = Gravity.CENTER_VERTICAL
        bar.setPadding(dp(4), 0, dp(8), 0)
        backButton.setImageResource(androidx.appcompat.R.drawable.abc_ic_ab_back_material)
        backButton.contentDescription = "Back"
        backButton.setPadding(dp(12), dp(12), dp(12), dp(12))
        backButton.background = rippleBackground()
        backButton.setOnClickListener { onBack?.invoke() }
        bar.addView(backButton, LayoutParams(dp(48), dp(48)))
        leadingButtons.orientation = HORIZONTAL
        leadingButtons.gravity = Gravity.CENTER_VERTICAL
        bar.addView(leadingButtons, LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, dp(56)))
        titleView.textSize = 20f
        titleView.typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
        titleView.isSingleLine = true
        titleView.ellipsize = TextUtils.TruncateAt.END
        titleView.setPadding(dp(12), 0, dp(8), 0)
        bar.addView(titleView, LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
        buttons.orientation = HORIZONTAL
        buttons.gravity = Gravity.CENTER_VERTICAL or Gravity.END
        bar.addView(buttons, LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, dp(56)))
        addView(bar, LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(56)))
        largeTitleView.textSize = 32f
        largeTitleView.typeface = Typeface.create("sans-serif", Typeface.BOLD)
        largeTitleView.isSingleLine = true
        largeTitleView.ellipsize = TextUtils.TruncateAt.END
        largeTitleView.setPadding(dp(16), 0, dp(16), dp(8))
        addView(largeTitleView, LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
        addView(content, LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f))
        tabBar.orientation = HORIZONTAL
        tabBar.gravity = Gravity.CENTER
        tabs.forEachIndexed { index, tab ->
            tab.selectedSymbol?.trim()?.takeIf { it.isNotEmpty() }?.let { selectedSymbols[tab.id] = it }
            tab.selectedIconTint?.let { runCatching { Color.parseColor(it) }.getOrNull() }?.let { selectedIconTints[tab.id] = it }
            tab.selectedIconPulse?.let { selectedIconPulses[tab.id] = it }
            val cell = LinearLayout(context)
            cell.orientation = VERTICAL
            cell.gravity = Gravity.CENTER
            cell.background = rippleBackground()
            cell.contentDescription = tab.title
            cell.tag = "craft-tab-${tab.id}"
            cell.importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_YES
            ViewCompat.setAccessibilityDelegate(cell, object : AccessibilityDelegateCompat() {
                override fun onInitializeAccessibilityNodeInfo(host: View, info: AccessibilityNodeInfoCompat) {
                    super.onInitializeAccessibilityNodeInfo(host, info)
                    info.viewIdResourceName = "craft-tab-${tab.id}"
                    info.className = android.widget.Button::class.java.name
                    info.isSelected = host.isSelected
                }
            })
            val icon = TextView(context)
            icon.importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
            icon.text = CraftNativeSymbols.glyph(tab.symbol)
            icon.textSize = 22f
            icon.minWidth = dp(26)
            icon.minHeight = dp(26)
            icon.gravity = Gravity.CENTER
            icon.includeFontPadding = false
            val label = TextView(context)
            label.importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
            label.text = tab.title
            label.textSize = 12f
            label.fontFeatureSettings = "tnum"
            label.gravity = Gravity.CENTER
            label.isSingleLine = true
            cell.addView(icon, LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))
            cell.addView(label, LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))
            cell.setOnClickListener { onTab?.invoke(index) }
            tabBar.addView(cell, LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT, 1f))
            tabViews.add(icon to label)
        }
        tabRow.orientation = HORIZONTAL
        tabRow.gravity = Gravity.CENTER_VERTICAL
        tabRow.setPadding(dp(12), dp(4), dp(12), dp(4))
        tabRow.addView(tabBar, LayoutParams(0, dp(64), 1f))
        accessory.addView(accessoryIcon, FrameLayout.LayoutParams(dp(26), dp(26), Gravity.CENTER))
        accessoryBadge.textSize = 10f
        accessoryBadge.gravity = Gravity.CENTER
        accessoryBadge.setTextColor(Color.WHITE)
        accessoryBadge.setPadding(dp(4), 0, dp(4), 0)
        accessoryBadge.background = GradientDrawable().apply { setColor(Color.RED); cornerRadius = dp(9).toFloat() }
        accessory.addView(accessoryBadge, FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, dp(18), Gravity.TOP or Gravity.END))
        accessory.setOnClickListener { accessorySpec?.optString("path")?.let { onAccessory?.invoke(it) } }
        accessory.visibility = View.GONE
        tabRow.addView(accessory, LayoutParams(dp(64), dp(64)).apply { marginStart = dp(8) })
        addView(tabRow, LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(72)))
        tabRow.visibility = if (tabs.isEmpty()) View.GONE else View.VISIBLE
        refreshColors()
    }

    override fun onInterceptTouchEvent(event: MotionEvent): Boolean {
        when (event.actionMasked) {
            MotionEvent.ACTION_DOWN -> {
                val overHorizontalScroll = onTabSwipeShouldDefer?.invoke(event.x, event.y) == true
                horizontalScrollDeferred = overHorizontalScroll
                if (overHorizontalScroll) parent?.requestDisallowInterceptTouchEvent(true)
                swipeTracking = tabs.size > 1 && tabSwipeEnabled && !overHorizontalScroll && tabRow.visibility == View.VISIBLE && event.y < tabRow.top
                swipeIntercepted = false
                swipeDownX = event.x
                swipeDownY = event.y
            }
            MotionEvent.ACTION_MOVE -> if (swipeTracking && !swipeIntercepted) {
                val dx = event.x - swipeDownX
                val dy = event.y - swipeDownY
                if (kotlin.math.abs(dx) > swipeSlop && kotlin.math.abs(dx) > kotlin.math.abs(dy)) {
                    swipeTracking = false
                    swipeIntercepted = onTabSwipeStart?.invoke(dx, event.x, event.y) == true
                    // Android cancels the child's touch target for this move;
                    // it does not replay the move through our onTouchEvent.
                    // Apply it now so a paused or coalesced drag still previews
                    // the incoming tab before another input event arrives.
                    if (swipeIntercepted) onTabSwipeMove?.invoke(dx)
                    return swipeIntercepted
                }
            }
            MotionEvent.ACTION_CANCEL, MotionEvent.ACTION_UP -> {
                swipeTracking = false
                if (horizontalScrollDeferred) {
                    horizontalScrollDeferred = false
                    parent?.requestDisallowInterceptTouchEvent(false)
                }
            }
        }
        return swipeIntercepted
    }

    override fun onTouchEvent(event: MotionEvent): Boolean {
        if (!swipeIntercepted) return super.onTouchEvent(event)
        when (event.actionMasked) {
            MotionEvent.ACTION_MOVE -> onTabSwipeMove?.invoke(event.x - swipeDownX)
            MotionEvent.ACTION_UP -> {
                onTabSwipeEnd?.invoke(event.x - swipeDownX, false)
                swipeIntercepted = false
            }
            MotionEvent.ACTION_CANCEL -> {
                onTabSwipeEnd?.invoke(event.x - swipeDownX, true)
                swipeIntercepted = false
            }
        }
        return true
    }

    /** Draws `options` (a screen's `setOptions`) for a screen `depth` deep in its stack. */
    fun apply(options: JSONObject, depth: Int, fallbackTitle: String?, path: String? = null) {
        visiblePath = path
        screenBackgroundColor = options.opt("backgroundColor")
            ?.takeUnless { it == JSONObject.NULL }
            ?.let { craftNativeOptionalString(it) }
            ?.let { runCatching { craftNativeColor(it) }.getOrNull() }
        options.optJSONObject("tabItem")?.let(::updateTab)
        val hidden = options.optBoolean("hidden", false)
        val large = options.optBoolean("largeTitle", false) && depth == 0
        val title = options.optString("title").takeIf { options.has("title") } ?: fallbackTitle.orEmpty()
        bar.visibility = if (hidden) View.GONE else View.VISIBLE
        backButton.visibility = if (depth > 0) View.VISIBLE else View.GONE
        bar.setPadding(if (depth > 0) dp(4) else dp(4), 0, dp(8), 0)
        titleView.text = if (large) "" else title
        largeTitleView.text = title
        largeTitleView.visibility = if (!hidden && large && title.isNotBlank()) View.VISIBLE else View.GONE
        val leading = options.optJSONArray("leftButtons") ?: JSONArray()
        val list = options.optJSONArray("rightButtons") ?: JSONArray()
        // The activity passes cumulative screen options, even for a live BPM
        // patch. Keep unchanged toolbar views, images and touch targets alive.
        val buttonSpecs = leading.toString() to list.toString()
        if (buttonSpecs != renderedButtonSpecs) {
            buttons.removeAllViews()
            leadingButtons.removeAllViews()
            navButtonSpecs.clear()
            for (index in 0 until leading.length()) {
                val button = leading.optJSONObject(index) ?: continue
                leadingButtons.addView(navButton(button))
            }
            for (index in 0 until list.length()) {
                val button = list.optJSONObject(index) ?: continue
                buttons.addView(navButton(button))
            }
            renderedButtonSpecs = buttonSpecs
        }
        val tabBarHidden = options.optBoolean("tabBarHidden", false) || depth > 0 && options.optBoolean("tabBarHiddenWhenPushed", false)
        if (tabBarHiddenByScreen != tabBarHidden) {
            tabBarHiddenByScreen = tabBarHidden
            tabRow.animate().cancel()
            val duration = if (android.animation.ValueAnimator.areAnimatorsEnabled()) 240L else 0L
            if (tabBarHidden) {
                tabRow.animate().translationY(dp(80).toFloat()).alpha(0f).setDuration(duration).withEndAction {
                    if (tabBarHiddenByScreen) tabRow.visibility = View.GONE
                }.start()
            } else if (tabs.isNotEmpty()) {
                tabRow.visibility = View.VISIBLE
                tabRow.animate().translationY(0f).alpha(1f).setDuration(duration).start()
            }
        } else if (tabs.isEmpty()) tabRow.visibility = View.GONE
        accessorySpec = options.optJSONObject("tabAccessory")?.takeIf {
            val path = it.optString("path")
            path.startsWith("/") && !path.startsWith("//") && it.has("title")
        }
        accessory.visibility = if (accessorySpec == null) View.GONE else View.VISIBLE
        accessorySpec?.let {
            accessory.contentDescription = it.optString("accessibilityLabel").ifBlank { it.optString("title") } + it.optString("badge").takeIf { badge -> badge.isNotBlank() && badge != "null" }?.let { badge -> ", $badge" }.orEmpty()
            accessoryBadge.text = it.optString("badge").takeUnless { badge -> badge == "null" }.orEmpty().take(8)
            accessoryBadge.visibility = if (accessoryBadge.text.isEmpty()) View.GONE else View.VISIBLE
        }
        tabSwipeEnabled = options.optBoolean("tabSwipeEnabled", true)
        refreshColors()
    }

    fun selectTab(index: Int) {
        selectedTab = index
        refreshColors()
    }

    private fun updateTab(item: JSONObject) {
        val id = item.optString("id")
        val index = tabs.indexOfFirst { it.id == id }
        if (index < 0) return
        if (item.has("accessibilityLabel")) {
            tabAccessibilityLabels.remove(id)
            item.optString("accessibilityLabel").takeUnless { item.isNull("accessibilityLabel") || it.isBlank() }?.let { tabAccessibilityLabels[id] = it.take(160) }
        }
        if (item.has("iconText")) {
            tabIconText.remove(id)
            item.optString("iconText").takeUnless { item.isNull("iconText") || it.isBlank() }?.let { tabIconText[id] = it.take(8) }
        }
        if (item.has("title")) {
            tabTitles.remove(id)
            item.optString("title").takeUnless { item.isNull("title") || it.isBlank() }?.let { tabTitles[id] = it.take(40) }
        }
        if (item.has("iconTint")) {
            tabIconTints.remove(id)
            if (!item.isNull("iconTint")) runCatching { Color.parseColor(item.optString("iconTint")) }.getOrNull()?.let { tabIconTints[id] = it }
        }
        if (item.has("iconPulse")) {
            if (item.optBoolean("iconPulse", false)) tabIconPulses.add(id) else tabIconPulses.remove(id)
        }
        if (item.has("symbol")) {
            tabSymbols.remove(id)
            item.optString("symbol").trim().takeUnless { item.isNull("symbol") || it.isBlank() }?.let { tabSymbols[id] = it }
        }
        if (item.has("selectedSymbol")) {
            selectedSymbols.remove(id)
            item.optString("selectedSymbol").trim().takeUnless { item.isNull("selectedSymbol") || it.isBlank() }?.let { selectedSymbols[id] = it }
        }
        if (item.has("selectedIconTint")) {
            selectedIconTints.remove(id)
            if (!item.isNull("selectedIconTint")) runCatching { Color.parseColor(item.optString("selectedIconTint")) }.getOrNull()?.let { selectedIconTints[id] = it }
        }
        if (item.has("selectedIconPulse")) {
            selectedIconPulses.remove(id)
            if (item.opt("selectedIconPulse") is Boolean) selectedIconPulses[id] = item.optBoolean("selectedIconPulse")
        }
        if (item.has("image")) {
            val address = item.optString("image").takeIf { !item.isNull("image") && it.startsWith("https://") }
            if (address != tabImageURLs[id]) {
                tabImages.remove(id)
                tabImageURLs.remove(id)
                if (address != null) {
                    tabImageURLs[id] = address
                    Thread {
                        val image = runCatching {
                            val connection = java.net.URL(address).openConnection().apply { connectTimeout = 5000; readTimeout = 5000 }
                            val bitmap = connection.getInputStream().use { android.graphics.BitmapFactory.decodeStream(it) } ?: return@runCatching null
                            androidx.core.graphics.drawable.RoundedBitmapDrawableFactory.create(resources, android.graphics.Bitmap.createScaledBitmap(bitmap, dp(27), dp(27), true)).apply { isCircular = true }
                        }.getOrNull()
                        post {
                            if (tabImageURLs[id] == address && image != null) {
                                tabImages[id] = image
                                refreshColors()
                            }
                        }
                    }.start()
                }
            }
        }
    }

    /** Selection belongs to the native tab stack, including retained pushed screens. */
    internal fun tabIconAppearance(index: Int, motionAllowed: Boolean): CraftTabIconAppearance {
        val tab = tabs[index]
        val selected = index == selectedTab && !accessorySelected
        return CraftTabIconAppearance(
            if (selected) selectedSymbols[tab.id] ?: tabSymbols[tab.id] ?: tab.symbol else tabSymbols[tab.id] ?: tab.symbol,
            if (selected) selectedIconTints[tab.id] ?: tabIconTints[tab.id] else tabIconTints[tab.id],
            (if (selected) selectedIconPulses[tab.id] ?: tabIconPulses.contains(tab.id) else tabIconPulses.contains(tab.id)) && motionAllowed,
        )
    }

    /** Light or dark changed: the bars follow the screen's background. */
    fun refreshColors() {
        val background = screenBackgroundColor ?: ContextCompat.getColor(context, R.color.background)
        val dark = Color.luminance(background) < 0.5
        val text = if (dark) Color.WHITE else Color.BLACK
        val muted = if (dark) Color.parseColor("#8E8E93") else Color.parseColor("#6C6C70")
        val accent = accentColor(dark)
        setBackgroundColor(background)
        bar.setBackgroundColor(background)
        largeTitleView.setBackgroundColor(background)
        titleView.setTextColor(text)
        largeTitleView.setTextColor(text)
        backButton.imageTintList = ColorStateList.valueOf(accent)
        val surface = if (dark) Color.parseColor("#1C1C1E") else Color.parseColor("#F9F9F9")
        tabBar.background = GradientDrawable().apply { setColor(surface); cornerRadius = dp(32).toFloat() }
        accessory.isSelected = accessorySelected
        accessory.background = GradientDrawable().apply { setColor(if (accessorySelected) Color.argb(36, Color.red(accent), Color.green(accent), Color.blue(accent)) else surface); cornerRadius = dp(32).toFloat() }
        accessorySpec?.let { accessoryIcon.setImageDrawable(CraftNativeIcons.drawable(context, null, it.optString("symbol"), if (accessorySelected) accent else text)) }
        tabViews.forEachIndexed { index, (icon, label) ->
            tabBar.getChildAt(index).isSelected = index == selectedTab && !accessorySelected
            tabBar.getChildAt(index).background = tabCellBackground(index, dark)
            val color = if (index == selectedTab && !accessorySelected) accent else muted
            val id = tabs[index].id
            val number = tabIconText[id]
            val appearance = tabIconAppearance(index, hasWindowFocus() && tabRow.isShown && android.animation.ValueAnimator.areAnimatorsEnabled())
            val iconColor = appearance.tint ?: if (number != null) Color.parseColor("#FF2D55") else color
            icon.setTextColor(iconColor)
            label.text = tabTitles[id] ?: tabs[index].title
            tabBar.getChildAt(index).contentDescription = tabAccessibilityLabels[id] ?: label.text
            label.setTextColor(color)
            val vector = tabImages[id] ?: if (number == null) CraftNativeIcons.drawable(context, null, appearance.symbol, iconColor) else null
            val pulse = appearance.pulse && number == null && tabImages[id] == null
            if (pulse && icon.animation == null) {
                icon.startAnimation(android.view.animation.AlphaAnimation(1f, 0.55f).apply {
                    duration = 700
                    repeatCount = android.view.animation.Animation.INFINITE
                    repeatMode = android.view.animation.Animation.REVERSE
                })
            } else if (!pulse) {
                icon.clearAnimation()
                icon.alpha = 1f
            }
            icon.foreground = vector
            icon.text = if (vector != null) "" else number ?: CraftNativeSymbols.glyph(appearance.symbol)
        }
        navButtonSpecs.forEach { (view, spec) -> applyNavButtonTint(view, spec, dark) }
    }

    override fun onWindowFocusChanged(hasWindowFocus: Boolean) {
        super.onWindowFocusChanged(hasWindowFocus)
        if (hasWindowFocus) refreshColors() else tabViews.forEach { (icon, _) -> icon.clearAnimation() }
    }

    override fun onDetachedFromWindow() {
        tabViews.forEach { (icon, _) -> icon.clearAnimation() }
        super.onDetachedFromWindow()
    }

    private fun navButton(button: JSONObject): View {
        val id = button.optString("id")
        val title = button.optString("title")
        val symbol = button.optString("symbol")
        val view = TextView(context)
        val dark = Color.luminance(ContextCompat.getColor(context, R.color.background)) < 0.5
        val tint = navButtonTint(button, dark)
        val vector = if (symbol.isNotBlank()) CraftNativeIcons.drawable(context, null, symbol, tint) else null
        view.text = if (vector != null) "" else if (symbol.isNotBlank()) CraftNativeSymbols.glyph(symbol) else title
        view.textSize = if (symbol.isNotBlank()) 22f else 16f
        if (vector != null) {
            view.foreground = android.graphics.drawable.InsetDrawable(vector, dp(10), dp(15), dp(10), dp(15))
            view.minWidth = dp(46)
        }
        view.gravity = Gravity.CENTER
        view.minWidth = dp(44)
        view.setPadding(dp(10), 0, dp(10), 0)
        view.background = rippleBackground()
        view.contentDescription = button.optString("accessibilityLabel").ifBlank { title.ifBlank { symbol } }
        view.setTextColor(tint)
        navButtonSpecs[view] = button
        val badge = button.optInt("badge", 0)
        if (badge > 0) {
            view.text = "${view.text}${if (button.optString("badgeStyle") == "dot") " •" else " $badge"}"
        }
        view.setOnClickListener { onButton?.invoke(id) }
        view.layoutParams = LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.MATCH_PARENT)
        return view
    }

    private fun navButtonTint(button: JSONObject, dark: Boolean): Int {
        val defaultTint = if (button.optString("variant") == "neutral") {
            if (dark) Color.WHITE else Color.parseColor("#1C1C1E")
        } else accentColor(dark)
        return button.optString("color").takeIf { it.isNotBlank() }?.let {
            runCatching { craftNativeColor(it) }.getOrNull()
        } ?: defaultTint
    }

    private fun applyNavButtonTint(view: TextView, button: JSONObject, dark: Boolean) {
        val tint = navButtonTint(button, dark)
        view.setTextColor(tint)
        val symbol = button.optString("symbol")
        if (symbol.isNotBlank()) {
            CraftNativeIcons.drawable(context, null, symbol, tint)?.let {
                view.foreground = android.graphics.drawable.InsetDrawable(it, dp(10), dp(15), dp(10), dp(15))
            }
        }
    }

    private fun accentColor(dark: Boolean): Int = if (dark) Color.parseColor("#0A84FF") else Color.parseColor("#007AFF")

    private fun tabCellBackground(index: Int, dark: Boolean): android.graphics.drawable.Drawable? {
        if (accessorySelected || index != selectedTab || (tabBarAppearance.selectionColor == null && tabBarAppearance.selectionCornerRadius == null)) return rippleBackground()
        val color = tabBarAppearance.selectionColor?.let { runCatching { Color.parseColor(it) }.getOrNull() }
            ?: if (dark) Color.argb(42, 255, 255, 255) else Color.argb(23, 0, 0, 0)
        val radius = tabBarAppearance.selectionCornerRadius?.let { (it * density).toInt().toFloat() } ?: dp(32).toFloat()
        return GradientDrawable().apply {
            setColor(color)
            cornerRadius = radius
        }
    }

    private fun rippleBackground(): android.graphics.drawable.Drawable? {
        val value = TypedValue()
        return if (context.theme.resolveAttribute(android.R.attr.selectableItemBackgroundBorderless, value, true)) {
            ContextCompat.getDrawable(context, value.resourceId)
        } else null
    }

    private fun dp(value: Int) = (value * density).toInt()
}

/**
 * SF Symbol names (what stx resolves an icon to, for iOS) as glyphs Android's
 * own fonts draw, for the bars. A name with no glyph gets a neutral dot.
 */
internal object CraftNativeSymbols {
    fun glyph(symbol: String): String {
        val base = symbol.removeSuffix(".fill").removeSuffix(".circle")
        return when (symbol) {
            "plus", "plus.circle", "plus.circle.fill" -> "+"
            "xmark", "xmark.circle", "xmark.circle.fill" -> "✕"
            "checkmark", "checkmark.circle", "checkmark.circle.fill" -> "✓"
            "ellipsis", "ellipsis.circle" -> "⋯"
            "square.and.arrow.up" -> "⇪"
            "magnifyingglass" -> "⌕"
            "gear", "gearshape", "gearshape.fill" -> "⚙"
            "bell", "bell.fill", "bell.badge" -> "🔔︎"
            "person", "person.fill", "person.crop.circle", "person.crop.circle.fill", "person.circle" -> "👤︎"
            "person.2", "person.2.fill" -> "👥︎"
            "message", "message.fill", "bubble.left", "bubble.left.and.bubble.right", "bubble.left.fill" -> "💬︎"
            "paperplane", "paperplane.fill" -> "➤"
            "sun.max", "sun.max.fill" -> "☀︎"
            "moon", "moon.fill", "moon.zzz" -> "☾"
            "calendar" -> "▦"
            "chart.line.uptrend.xyaxis", "chart.xyaxis.line", "chart.bar", "chart.bar.fill" -> "📈︎"
            "heart", "heart.text.square" -> "♡"
            "heart.fill" -> "♥"
            "bag", "bag.fill", "cart", "cart.fill" -> "🛍︎"
            "house", "house.fill" -> "⌂"
            "pencil", "square.and.pencil" -> "✎"
            "trash", "trash.fill" -> "🗑︎"
            "arrow.clockwise" -> "↻"
            "slider.horizontal.3" -> "☰"
            "line.3.horizontal", "list.bullet" -> "☰"
            "play", "play.fill" -> "▶"
            "pause", "pause.fill" -> "⏸︎"
            "star", "star.fill" -> "★"
            "qrcode", "qrcode.viewfinder" -> "▣"
            "info.circle" -> "ⓘ"
            else -> when (base) {
                "chevron.left" -> "‹"
                "chevron.right" -> "›"
                else -> "•"
            }
        }
    }
}

/**
 * Video and audio kept on the phone for offline (`craft.media`), the iOS
 * host's CraftNativeMedia: `files/craft-media/<sha256 of the address>.<ext>`.
 * A native Video given an address with a copy here plays the copy.
 *
 * Each download is a WorkManager job named by its address
 * (CraftNativeMediaWorker), so it carries on when Android stops the app and
 * runs when its network is there: any connection, or an unmetered one for a
 * Wi-Fi-only keep. A part file is kept between attempts and resumed with a
 * Range request. A keep the phone cannot fetch now (no connection, or only
 * a metered one for a Wi-Fi-only keep) answers at once with `{ ok: false,
 * reason: "offline" | "cellular", queued: true }`, as iOS does, and the
 * transfer finishes on its own; the next keep answers from the copy.
 */
internal object CraftNativeMedia {
    const val ATTEMPT_SETTLED = "craft.media.attemptSettled"
    private const val TAG = "craft-media"
    private const val PREFS = "craft.media"
    private val lock = Any()
    /** Keeps waiting in this process for an address's transfer. */
    private data class Waiting(val generation: Int, val answer: (CraftNativeCapabilityResult) -> Unit)
    private val waiting = HashMap<String, MutableList<Waiting>>()
    /** One transfer writes an address's part file at a time. */
    private val writers = ConcurrentHashMap<String, Any>()
    private val background = Executors.newSingleThreadExecutor()
    private val main = Handler(Looper.getMainLooper())

    private fun root(context: Context) = File(context.applicationContext.filesDir, "craft-media")

    fun digest(address: String): String =
        java.security.MessageDigest.getInstance("SHA-256").digest(address.toByteArray()).joinToString("") { "%02x".format(it) }

    fun file(context: Context, address: String): File {
        val ext = runCatching { Uri.parse(address).lastPathSegment?.substringAfterLast('.', "")?.lowercase() }.getOrNull().orEmpty()
        val safe = if (Regex("^[a-z0-9]{1,5}$").matches(ext)) ext else "bin"
        return File(root(context), "${digest(address)}.$safe")
    }

    /** Where an address's transfer writes until the file is whole; kept between attempts to resume. */
    fun part(context: Context, address: String): File = File(root(context), "${file(context, address).name}.part")

    fun local(context: Context, address: String): File? =
        address.takeIf { it.isNotBlank() }?.let { file(context, it) }?.takeIf { it.isFile && it.length() > 0 }

    private fun describe(address: String, file: File) = JSONObject().put("ok", true).put("url", address).put("path", file.absolutePath).put("size", file.length())

    private fun prefs(context: Context): SharedPreferences = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)

    /** How many times the cache was cleared; a transfer started before the last clear does not land. */
    fun generation(context: Context): Int = prefs(context).getInt("generation", 0)

    /** The unique job for an address and connection rule: `any` or `wifi`. */
    private fun workName(address: String, wifiOnly: Boolean) = "$TAG:${digest(address)}:${if (wifiOnly) "wifi" else "any"}"

    fun keep(context: Context, address: String, headers: JSONObject, cellular: Boolean, done: (CraftNativeCapabilityResult) -> Unit) {
        val uri = runCatching { Uri.parse(address) }.getOrNull()
        if (uri == null || uri.scheme?.lowercase() !in setOf("http", "https") || uri.host.isNullOrBlank()) {
            return done(CraftNativeCapabilityResult(code = "INVALID_ARGUMENT", message = "media.keep needs an absolute http or https URL"))
        }
        val app = context.applicationContext
        val started = synchronized(lock) {
            local(app, address)?.let { return done(CraftNativeCapabilityResult(data = describe(address, it))) }
            generation(app).also { waiting.getOrPut(address) { mutableListOf() }.add(Waiting(it, done)) }
        }
        val wifiOnly = !cellular
        val work = androidx.work.WorkManager.getInstance(app)
        // The same address under the other rule gives way; its part file is resumed.
        work.cancelUniqueWork(workName(address, !wifiOnly))
        val request = androidx.work.OneTimeWorkRequestBuilder<CraftNativeMediaWorker>()
            .setConstraints(androidx.work.Constraints.Builder().setRequiredNetworkType(if (wifiOnly) androidx.work.NetworkType.UNMETERED else androidx.work.NetworkType.CONNECTED).build())
            .setInputData(androidx.work.workDataOf("address" to address, "headers" to headers.toString(), "generation" to started))
            .setBackoffCriteria(androidx.work.BackoffPolicy.EXPONENTIAL, 30, java.util.concurrent.TimeUnit.SECONDS)
            .addTag(TAG)
            .addTag("$TAG:generation:$started")
            .addTag("$TAG:${digest(address)}")
            .build()
        // Join a running or freshly queued transfer. Only a failed attempt's
        // backoff is replaced so an explicit retry can resume immediately.
        val name = workName(address, wifiOnly)
        background.execute {
            try {
                if (generation(app) == started) {
                    val pending = work.getWorkInfosForUniqueWork(name).get().any {
                        "$TAG:generation:$started" in it.tags && !it.progress.getBoolean(ATTEMPT_SETTLED, false) &&
                            (it.state == androidx.work.WorkInfo.State.RUNNING ||
                                (it.state == androidx.work.WorkInfo.State.ENQUEUED && it.runAttemptCount == 0))
                    }
                    // The next serial decision must see this enqueue's committed state.
                    work.enqueueUniqueWork(name, if (pending) androidx.work.ExistingWorkPolicy.KEEP else androidx.work.ExistingWorkPolicy.REPLACE, request).result.get()
                }
            } catch (error: Exception) {
                if (error is InterruptedException) Thread.currentThread().interrupt()
                if (generation(app) == started) {
                    deliver(context, address, started, CraftNativeCapabilityResult(code = "IO_ERROR", message = "media.keep could not schedule the download"))
                }
            }
        }
        val reason = when {
            !online(app) -> "offline"
            wifiOnly && metered(app) -> "cellular"
            else -> null
        }
        if (reason != null) deliver(context, address, started, queued(address, reason))
    }

    private fun queued(address: String, reason: String) =
        CraftNativeCapabilityResult(data = JSONObject().put("ok", false).put("url", address).put("reason", reason).put("queued", true))

    /** Answers only keeps belonging to this transfer's cache generation. */
    fun deliver(context: Context, address: String, started: Int, result: CraftNativeCapabilityResult) {
        val answered = synchronized(lock) {
            val pending = waiting[address].orEmpty()
            val matching = pending.filter { it.generation == started }
            val remaining = pending.filter { it.generation != started }.toMutableList()
            if (remaining.isEmpty()) waiting.remove(address) else waiting[address] = remaining
            matching
        }
        if (answered.isNotEmpty()) main.post {
            val current = if (generation(context) == started) result else
                CraftNativeCapabilityResult(code = "CANCELLED", message = "The video cache was cleared")
            answered.forEach { it.answer(current) }
        }
    }

    enum class Outcome { DONE, RETRY }

    /**
     * One attempt at an address's transfer, run by its job: resumes the part
     * file where it stopped, moves it into place whole, and answers whoever
     * waits. RETRY leaves the part file for the next attempt.
     */
    fun transfer(context: Context, address: String, headers: JSONObject, started: Int, attempt: Int, beforeAnswer: () -> Unit = {}, stopped: () -> Boolean): Outcome {
        fun answer(result: CraftNativeCapabilityResult) {
            // The callback can immediately call keep again. Publish completion
            // before that callback, while WorkManager may still say RUNNING.
            synchronized(lock) {
                // A keep registered after this marker belongs to the next
                // attempt; it must not enter the old callback batch.
                beforeAnswer()
                deliver(context, address, started, result)
            }
        }
        // clear() already answered the old generation's waiters. Never answer
        // a new athlete's waiters from an obsolete worker for the same URL.
        if (generation(context) != started) return Outcome.DONE
        local(context, address)?.let {
            answer(CraftNativeCapabilityResult(data = describe(address, it)))
            return Outcome.DONE
        }
        val writer = writers.getOrPut(address) { Any() }
        synchronized(writer) {
            // Another worker can finish, or sign-out can clear the cache, while
            // this worker waits for the address's writer.
            if (generation(context) != started) return Outcome.DONE
            if (stopped()) return Outcome.RETRY
            local(context, address)?.let {
                answer(CraftNativeCapabilityResult(data = describe(address, it)))
                return Outcome.DONE
            }
            val target = file(context, address)
            val staging = part(context, address)
            target.parentFile?.mkdirs()
            val download = CraftResumableDownload()
            val asked = headers.keys().asSequence().associateWith { headers.optString(it) }
            val fetched = try {
                // A part that no longer lines up was dropped: the whole file, now, not after a backoff.
                download.fetch(address, asked, staging, stopped).let { first ->
                    if (first is CraftResumableDownload.Fetched.Restart) download.fetch(address, asked, staging, stopped) else first
                }
            } catch (error: Exception) {
                val full = generateSequence<Throwable>(error) { it.cause }.take(16).any {
                    it is android.system.ErrnoException && it.errno == android.system.OsConstants.ENOSPC
                }
                if (full) {
                    staging.delete()
                    answer(CraftNativeCapabilityResult(code = "NO_SPACE", message = error.message ?: "The phone is out of space"))
                    return Outcome.DONE
                }
                if (stopped()) return Outcome.RETRY
                // Lost the connection part way: the part waits for the next attempt.
                answer(if (!online(context)) queued(address, "offline") else CraftNativeCapabilityResult(code = if (error is java.net.SocketTimeoutException) "TIMEOUT" else "NETWORK_ERROR", message = error.message ?: "media.keep failed"))
                return if (attempt < 8) Outcome.RETRY else Outcome.DONE.also { staging.delete() }
            }
            when (fetched) {
                is CraftResumableDownload.Fetched.Stopped, is CraftResumableDownload.Fetched.Restart -> return Outcome.RETRY
                is CraftResumableDownload.Fetched.Refused -> {
                    answer(CraftNativeCapabilityResult(data = JSONObject().put("ok", false).put("url", address).put("status", fetched.status)))
                    return Outcome.DONE
                }
                is CraftResumableDownload.Fetched.Incomplete -> {
                    answer(CraftNativeCapabilityResult(code = "NETWORK_ERROR", message = "media.keep received an incomplete file"))
                    return if (attempt < 8) Outcome.RETRY else Outcome.DONE.also { staging.delete() }
                }
                is CraftResumableDownload.Fetched.Complete -> Unit
            }
            synchronized(lock) {
                if (generation(context) != started) {
                    staging.delete()
                    return Outcome.DONE
                }
                target.delete()
                if (!staging.renameTo(target)) {
                    answer(CraftNativeCapabilityResult(code = "IO_ERROR", message = "media.keep could not store the file"))
                    return Outcome.DONE
                }
            }
            answer(CraftNativeCapabilityResult(data = describe(address, target)))
            return Outcome.DONE
        }
    }

    /** Whether the connection now is one the person pays for by the byte. */
    private fun metered(context: Context): Boolean = runCatching {
        val connectivity = context.applicationContext.getSystemService(Context.CONNECTIVITY_SERVICE) as android.net.ConnectivityManager
        connectivity.isActiveNetworkMetered
    }.getOrDefault(false)

    /** Whether there is a connection to the internet at all. */
    private fun online(context: Context): Boolean = runCatching {
        val connectivity = context.applicationContext.getSystemService(Context.CONNECTIVITY_SERVICE) as android.net.ConnectivityManager
        val capabilities = connectivity.getNetworkCapabilities(connectivity.activeNetwork)
        capabilities?.hasCapability(android.net.NetworkCapabilities.NET_CAPABILITY_INTERNET) == true
    }.getOrDefault(true)

    /** Removes idle copies outside `keep` and cancels their jobs; pending keeps retain ownership. */
    fun prune(context: Context, keep: List<String>): Int {
        val wanted = keep.map { digest(it) }.toSet()
        var removed = 0
        synchronized(lock) {
            // A keep still waiting owns its files until it is answered.
            val active = waiting.keys.map { digest(it) }.toSet()
            root(context).listFiles()?.forEach { file ->
                val owner = file.name.substringBefore('.')
                // Part files from before transfers resumed (`<sha>.<ext>.<id>.part`) are never picked up again.
                val stale = file.name.endsWith(".part") && file.name.count { it == '.' } > 2
                if (owner !in active && (owner !in wanted || stale) && file.delete()) removed++
            }
        }
        val app = context.applicationContext
        background.execute {
            runCatching {
                androidx.work.WorkManager.getInstance(app).getWorkInfosByTag(TAG).get()
                    .filter { !it.state.isFinished }
                    .forEach { info ->
                        synchronized(lock) {
                            // The query runs asynchronously: a new keep may now
                            // own an address that was idle when prune was called.
                            val active = waiting.keys.map { digest(it) }.toSet()
                            if (info.tags.none { it.startsWith("$TAG:") && it.removePrefix("$TAG:") in wanted + active }) {
                                androidx.work.WorkManager.getInstance(app).cancelWorkById(info.id)
                            }
                        }
                    }
            }
        }
        return removed
    }

    /** Stops every transfer and deletes every copy; none started before this lands after it. */
    fun clear(context: Context): Int {
        var removed = 0
        var failure: java.io.IOException? = null
        val answered = synchronized(lock) {
            // Persisted before the files go: a transfer that outlives the process checks it too.
            prefs(context).edit().putInt("generation", generation(context) + 1).commit()
            val callbacks = waiting.values.flatten()
            waiting.clear()
            root(context).listFiles()?.forEach { file ->
                if (file.delete()) removed++ else failure = java.io.IOException("The video cache could not be cleared")
            }
            // Schedule cancellation before a new generation can enqueue its work.
            androidx.work.WorkManager.getInstance(context.applicationContext).cancelAllWorkByTag(TAG)
            callbacks
        }
        main.post { answered.forEach { it.answer(CraftNativeCapabilityResult(code = "CANCELLED", message = "The video cache was cleared")) } }
        failure?.let { throw it }
        return removed
    }

    fun usage(context: Context): JSONObject {
        val kept = root(context).listFiles()?.filter { !it.name.endsWith(".part") }.orEmpty()
        return JSONObject().put("files", kept.size).put("bytes", kept.sumOf { it.length() })
    }
}

/**
 * One attempt at fetching a file into `part`, resuming what an earlier
 * attempt left there with a Range request. Plain Java I/O, so the JVM tests
 * run it against a local server. A part that no longer lines up with the
 * file (416, or a range that starts elsewhere) is dropped and the attempt
 * says Restart; a server that ignores Range sends the whole file again.
 */
internal class CraftResumableDownload(
    private val open: (String) -> java.net.HttpURLConnection = { java.net.URL(it).openConnection() as java.net.HttpURLConnection },
) {
    sealed class Fetched {
        data class Complete(val size: Long) : Fetched()
        data class Refused(val status: Int) : Fetched()
        object Incomplete : Fetched()
        object Restart : Fetched()
        object Stopped : Fetched()
    }

    fun fetch(address: String, headers: Map<String, String>, part: File, stopped: () -> Boolean): Fetched {
        val have = if (part.isFile) part.length() else 0L
        val connection = open(address)
        connection.connectTimeout = 30_000
        connection.readTimeout = 60_000
        headers.forEach { (name, value) -> connection.setRequestProperty(name, value) }
        if (have > 0) connection.setRequestProperty("Range", "bytes=$have-")
        try {
            val status = connection.responseCode
            val resumed = status == 206 && have > 0 && rangeStart(connection.getHeaderField("Content-Range")) == have
            if (status == 416 || (status == 206 && !resumed)) {
                part.delete()
                return if (have > 0) Fetched.Restart else Fetched.Refused(status)
            }
            if (status != 200 && !resumed) {
                part.delete()
                return Fetched.Refused(status)
            }
            val total = if (resumed) rangeTotal(connection.getHeaderField("Content-Range")) else connection.contentLengthLong
            part.parentFile?.mkdirs()
            connection.inputStream.use { input ->
                java.io.FileOutputStream(part, resumed).use { output ->
                    val buffer = ByteArray(64 * 1024)
                    while (true) {
                        if (stopped()) return Fetched.Stopped
                        val read = input.read(buffer)
                        if (read < 0) break
                        output.write(buffer, 0, read)
                    }
                }
            }
            val size = part.length()
            // HttpURLConnection inflates gzip itself; a Content-Length is then the compressed size.
            val encoded = connection.getHeaderField("Content-Encoding") != null
            if (size <= 0 || (!encoded && total >= 0 && size != total)) {
                // Empty or longer than the file says: nothing useful to resume.
                if (size <= 0 || total in 0 until size) part.delete()
                return Fetched.Incomplete
            }
            return Fetched.Complete(size)
        } finally {
            connection.disconnect()
        }
    }

    companion object {
        /** `bytes 100-199/1000` → 100; -1 when it does not say. */
        fun rangeStart(header: String?): Long = Regex("^bytes (\\d+)-\\d+/(\\d+|\\*)$").find(header?.trim().orEmpty())?.groupValues?.get(1)?.toLongOrNull() ?: -1L

        /** `bytes 100-199/1000` → 1000; -1 when the total is not known. */
        fun rangeTotal(header: String?): Long = Regex("^bytes \\d+-\\d+/(\\d+)$").find(header?.trim().orEmpty())?.groupValues?.get(1)?.toLongOrNull() ?: -1L
    }
}

/** One `craft.media.keep` transfer, run by WorkManager when its network is there (CraftNativeMedia). */
internal class CraftNativeMediaWorker(context: Context, parameters: androidx.work.WorkerParameters) : androidx.work.Worker(context, parameters) {
    override fun doWork(): Result {
        val address = inputData.getString("address") ?: return Result.failure()
        val headers = runCatching { JSONObject(inputData.getString("headers") ?: "{}") }.getOrDefault(JSONObject())
        val started = inputData.getInt("generation", 0)
        return try {
            setProgressAsync(androidx.work.workDataOf(CraftNativeMedia.ATTEMPT_SETTLED to false)).get()
            val outcome = CraftNativeMedia.transfer(applicationContext, address, headers, started, runAttemptCount,
                beforeAnswer = { setProgressAsync(androidx.work.workDataOf(CraftNativeMedia.ATTEMPT_SETTLED to true)).get() }
            ) { isStopped }
            if (outcome == CraftNativeMedia.Outcome.RETRY) Result.retry() else Result.success()
        } catch (error: Exception) {
            if (error is InterruptedException) Thread.currentThread().interrupt()
            // A replacement owns the address's new waiters. A real progress
            // storage failure still needs an answer instead of a lost callback.
            if (!isStopped) CraftNativeMedia.deliver(applicationContext, address, started,
                CraftNativeCapabilityResult(code = "IO_ERROR", message = error.message ?: "media.keep could not store worker progress"))
            if (isStopped) Result.retry() else Result.failure()
        }
    }
}

/**
 * Messages from an isolate on the console bridge (a WebView without
 * JavaScriptSandbox's message ports): the console cuts a message at about
 * 32 KB, which dropped every large render, mutation and snapshot. The
 * prelude sends a long one in numbered pieces (`\u0001<id>:<index>:<count>:`)
 * and this puts them back together.
 */
internal class CraftNativeChunks {
    private val pending = HashMap<String, Array<String?>>()

    /** The whole message once its last piece arrives, the message itself when it came whole, else null. */
    fun accept(body: String): String? {
        if (!body.startsWith("\u0001")) return body
        val header = body.substring(1).split(':', limit = 4)
        if (header.size < 4) return null
        val id = header[0]
        val index = header[1].toIntOrNull() ?: return null
        val count = header[2].toIntOrNull()?.takeIf { it in 1..100_000 } ?: return null
        val pieces = pending.getOrPut(id) { arrayOfNulls(count) }
        if (index !in pieces.indices) return null
        pieces[index] = header[3]
        if (pieces.any { it == null }) return null
        pending.remove(id)
        return pieces.joinToString("")
    }

    companion object {
        /** The console bridge's `post`: long messages in pieces the console keeps whole. */
        fun consolePost(prefix: String): String = """
            var limit = 16000;
            if (value.length <= limit) console.log(${JSONObject.quote(prefix)} + value);
            else {
              globalThis.__craftChunk = (globalThis.__craftChunk || 0) + 1;
              var count = Math.ceil(value.length / limit);
              for (var piece = 0; piece < count; piece++) {
                console.log(${JSONObject.quote(prefix)} + '\u0001' + globalThis.__craftChunk + ':' + piece + ':' + count + ':' + value.slice(piece * limit, (piece + 1) * limit));
              }
            }
        """.trimIndent()
    }
}

/**
 * The app's icons as vectors (`assets/craft-icons.json`): what an `<Icon>`
 * draws on iOS as an SF Symbol, drawn on Android from the same icon the web
 * shows (the app's Iconify set, Lucide for HQ), keyed by its own name and by
 * the SF Symbol stx maps it to. Each entry is an SVG body on a 24-point
 * view box, stroked the way Lucide is (2 points, round caps and joins). An
 * icon the table lacks falls back to the glyph Android's fonts have.
 */
internal object CraftNativeIcons {
    private data class Shape(val path: android.graphics.Path, val filled: Boolean)
    private class Icon(val shapes: List<Shape>, val viewBox: Float, val stroke: Float)

    @Volatile private var table: Map<String, Icon>? = null

    private fun load(context: Context): Map<String, Icon> = table ?: synchronized(this) {
        table ?: runCatching {
            val json = JSONObject(context.assets.open("craft-icons.json").bufferedReader().use { it.readText() })
            val size = json.optDouble("viewBox", 24.0).toFloat()
            val stroke = json.optDouble("strokeWidth", 2.0).toFloat()
            val icons = json.optJSONObject("icons") ?: JSONObject()
            val parsed = HashMap<String, Icon>()
            icons.keys().forEach { name -> parse(icons.optString(name))?.let { parsed[name] = Icon(it, size, stroke) } }
            parsed as Map<String, Icon>
        }.getOrElse { emptyMap() }.also { table = it }
    }

    private fun attributes(element: String): Map<String, String> =
        Regex("""([a-zA-Z-]+)="([^"]*)"""").findAll(element).associate { it.groupValues[1] to it.groupValues[2] }

    private fun number(value: String?): Float = value?.trim()?.toFloatOrNull() ?: 0f

    private fun parse(body: String): List<Shape>? = runCatching {
        Regex("""<(path|circle|rect|line|polyline|polygon|ellipse)\b([^>]*)/?>""").findAll(body).mapNotNull { match ->
            val tag = match.groupValues[1]
            val a = attributes(match.groupValues[2])
            val filled = a["fill"]?.let { it != "none" } == true && a["stroke"] == null
            val path = when (tag) {
                "path" -> androidx.core.graphics.PathParser.createPathFromPathData(a["d"] ?: return@mapNotNull null)
                "circle" -> android.graphics.Path().apply { addCircle(number(a["cx"]), number(a["cy"]), number(a["r"]), android.graphics.Path.Direction.CW) }
                "ellipse" -> android.graphics.Path().apply {
                    val cx = number(a["cx"]); val cy = number(a["cy"]); val rx = number(a["rx"]); val ry = number(a["ry"])
                    addOval(android.graphics.RectF(cx - rx, cy - ry, cx + rx, cy + ry), android.graphics.Path.Direction.CW)
                }
                "rect" -> android.graphics.Path().apply {
                    val x = number(a["x"]); val y = number(a["y"]); val w = number(a["width"]); val h = number(a["height"])
                    val rx = number(a["rx"] ?: a["ry"]); val ry = number(a["ry"] ?: a["rx"])
                    addRoundRect(android.graphics.RectF(x, y, x + w, y + h), rx, ry, android.graphics.Path.Direction.CW)
                }
                "line" -> android.graphics.Path().apply {
                    moveTo(number(a["x1"]), number(a["y1"]))
                    lineTo(number(a["x2"]), number(a["y2"]))
                }
                else -> android.graphics.Path().apply {
                    val points = (a["points"] ?: "").trim().split(Regex("[\\s,]+")).mapNotNull { it.toFloatOrNull() }
                    for (index in 0 until points.size / 2) {
                        if (index == 0) moveTo(points[0], points[1]) else lineTo(points[index * 2], points[index * 2 + 1])
                    }
                    if (tag == "polygon") close()
                }
            }
            Shape(path, filled)
        }.toList().takeIf { it.isNotEmpty() }
    }.getOrNull()

    /** The icon for `name` (the Iconify name) or `symbol` (the SF Symbol), in `color`; null when the app has no vector for it. */
    fun drawable(context: Context, name: String?, symbol: String?, color: Int): android.graphics.drawable.Drawable? {
        val icons = load(context)
        val bare = name?.removePrefix("i-lucide-")?.substringAfter("lucide:")
        val icon = (bare?.let(icons::get)) ?: symbol?.let(icons::get) ?: return null
        return Vector(icon, color)
    }

    private class Vector(private val icon: Icon, color: Int) : android.graphics.drawable.Drawable() {
        private val paint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
            this.color = color
            strokeCap = android.graphics.Paint.Cap.ROUND
            strokeJoin = android.graphics.Paint.Join.ROUND
        }
        private val matrix = android.graphics.Matrix()
        private val scaled = android.graphics.Path()

        override fun draw(canvas: android.graphics.Canvas) {
            val box = bounds
            if (box.isEmpty) return
            val scale = minOf(box.width(), box.height()) / icon.viewBox
            val left = box.left + (box.width() - icon.viewBox * scale) / 2f
            val top = box.top + (box.height() - icon.viewBox * scale) / 2f
            matrix.setScale(scale, scale)
            matrix.postTranslate(left, top)
            for (shape in icon.shapes) {
                scaled.reset()
                shape.path.transform(matrix, scaled)
                paint.style = if (shape.filled) android.graphics.Paint.Style.FILL else android.graphics.Paint.Style.STROKE
                paint.strokeWidth = icon.stroke * scale
                canvas.drawPath(scaled, paint)
            }
        }

        override fun setAlpha(alpha: Int) { paint.alpha = alpha; invalidateSelf() }
        override fun setColorFilter(colorFilter: android.graphics.ColorFilter?) { paint.colorFilter = colorFilter; invalidateSelf() }
        @Deprecated("Drawable API")
        override fun getOpacity(): Int = android.graphics.PixelFormat.TRANSLUCENT
    }
}
