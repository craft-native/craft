/**
 * The app around the native screens: what `nativeScreens`, `tabs`,
 * `nativeApp` and `shareStorage` in craft.config.json describe, the same
 * contract the iOS host reads (CraftNativeScreen.swift, CraftHybrid.swift).
 *
 * - [CraftNativeRoutes] turns an app path (`/m/workout/42?tab=files`) into
 *   the screen that draws it and its params, fixed segments before
 *   parameters, so `/m/store/library` is never taken for a product's slug.
 * - [CraftNativeStores] keeps what a screen reads synchronously on iOS
 *   (`craft.storage.getSync`, `craft.snapshots.get`,
 *   `craft.secureStorage.getSync`). Android's JavaScriptSandbox cannot call
 *   the host synchronously, so each isolate starts with a copy of these
 *   stores ([CraftNativeStores.preload]) and the host keeps every copy
 *   current: a write in one isolate reaches the others as `SYNC_UPDATE`.
 * - [CraftNativeHub] is every live isolate in the process (screens, the app
 *   script, a background refresh), so a change reaches all of them.
 * - [CraftNativeChrome] is the navigation bar above a screen and the tab bar
 *   below it, drawn with plain Android views.
 */
internal object CraftNativeHub {
    private val receivers = ConcurrentHashMap<String, (String, JSONObject) -> Unit>()
    private val main = Handler(Looper.getMainLooper())

    fun register(id: String, receiver: (String, JSONObject) -> Unit) {
        receivers[id] = receiver
    }

    fun unregister(id: String) {
        receivers.remove(id)
    }

    /** Sends to every registered isolate but `except`, on the main thread. */
    fun broadcast(type: String, payload: JSONObject, except: String? = null) {
        val deliver = {
            receivers.forEach { (id, receiver) ->
                if (id != except) runCatching { receiver(type, payload) }
                    .onFailure { Log.w("CraftNativeAndroid", "Broadcast $type to $id failed", it) }
            }
        }
        if (Looper.myLooper() == Looper.getMainLooper()) deliver() else main.post(deliver)
    }
}

/** A screen of the app found for a path. */
internal data class CraftNativeRouteMatch(val screen: String, val params: JSONObject, val path: String)

internal data class CraftNativeTab(
    val id: String, val title: String, val symbol: String,
    val selectedSymbol: String? = null, val selectedIconTint: String? = null, val selectedIconPulse: Boolean? = null,
)

internal data class CraftNativeTabBarAppearance(
