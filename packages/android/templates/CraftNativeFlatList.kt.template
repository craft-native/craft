package {{PACKAGE_NAME}}

import android.content.Context
import android.view.View
import android.view.ViewGroup
import android.widget.FrameLayout
import androidx.recyclerview.widget.DiffUtil
import androidx.recyclerview.widget.GridLayoutManager
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.recyclerview.widget.ListAdapter
import androidx.recyclerview.widget.RecyclerView
import org.json.JSONObject
import kotlin.math.ceil

internal typealias CraftNativeRenderItem = (node: JSONObject, identity: String, previous: View?) -> View

/** A stable-key RecyclerView host for stx native FlatList nodes. */
internal class CraftNativeFlatList(context: Context) : RecyclerView(context) {
    private data class Item(
        val identity: String,
        val node: JSONObject,
        val signature: String,
        val chrome: Boolean,
    )

    private class Holder(val host: FrameLayout) : ViewHolder(host) {
        var identity: String? = null
        val hostedView: View? get() = host.getChildAt(0)
    }

    private val listAdapter = object : ListAdapter<Item, Holder>(object : DiffUtil.ItemCallback<Item>() {
        override fun areItemsTheSame(oldItem: Item, newItem: Item) = oldItem.identity == newItem.identity
        override fun areContentsTheSame(oldItem: Item, newItem: Item) = oldItem.signature == newItem.signature
    }) {
        init { setHasStableIds(true) }

        override fun getItemId(position: Int): Long = stableId(getItem(position).identity)

        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int) = Holder(FrameLayout(parent.context).apply {
            layoutParams = LayoutParams(
                if (horizontal) LayoutParams.WRAP_CONTENT else LayoutParams.MATCH_PARENT,
                LayoutParams.WRAP_CONTENT,
            )
        })

        override fun onBindViewHolder(holder: Holder, position: Int) {
            val item = getItem(position)
            if (holder.identity != null && holder.identity != item.identity) release(holder)
            holder.host.layoutParams = holderLayoutParams()
            val view = renderItem?.invoke(item.node, item.identity, holder.hostedView) ?: View(holder.host.context)
            val renderedLayout = view.layoutParams
            val hostedLayout = FrameLayout.LayoutParams(
                renderedLayout?.width ?: LayoutParams.MATCH_PARENT,
                renderedLayout?.height ?: LayoutParams.WRAP_CONTENT,
            )
            if (renderedLayout is ViewGroup.MarginLayoutParams) {
                hostedLayout.setMargins(
                    renderedLayout.leftMargin,
                    renderedLayout.topMargin,
                    renderedLayout.rightMargin,
                    renderedLayout.bottomMargin,
                )
            }
            holder.identity = item.identity
            if (holder.hostedView !== view) {
                (view.parent as? ViewGroup)?.removeView(view)
                holder.host.removeAllViews()
                holder.host.addView(view, hostedLayout)
            }
            else view.layoutParams = hostedLayout
        }

        override fun onViewRecycled(holder: Holder) {
            release(holder)
            super.onViewRecycled(holder)
        }

        private fun release(holder: Holder) {
            holder.identity?.let { recycleItem?.invoke(it) }
            holder.host.removeAllViews()
            holder.identity = null
        }
    }

    private var renderItem: CraftNativeRenderItem? = null
    private var recycleItem: ((String) -> Unit)? = null
    private var endReached: (() -> Unit)? = null
    private var threshold = 0.1
    private var endReachedSignature: String? = null
    private var dataContentSignature = ""
    private var horizontal = false
    private var columns = 1
    private var keyboardShouldPersistTaps = "never"
    private var submissionGeneration = 0
    private var isSubmittingList = false
    private var pendingThemeRefresh = false
    var onScrollEvent: (() -> Unit)? = null
    var onScrollBeginDrag: (() -> Unit)? = null
    var onScrollEndDrag: (() -> Unit)? = null
    var onMomentumScrollBegin: (() -> Unit)? = null
    var onMomentumScrollEnd: (() -> Unit)? = null
    var onLayoutChanged: (() -> Unit)? = null

    private fun holderLayoutParams() = LayoutParams(
        if (horizontal) LayoutParams.WRAP_CONTENT else LayoutParams.MATCH_PARENT,
        LayoutParams.WRAP_CONTENT,
    )

    private fun updateVisibleHolderLayoutParams() {
        for (index in 0 until childCount) {
            (getChildViewHolder(getChildAt(index)) as? Holder)?.host?.layoutParams = holderLayoutParams()
        }
    }

    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
        super.onLayout(changed, left, top, right, bottom)
        onLayoutChanged?.invoke()
    }

    init {
        adapter = listAdapter
        itemAnimator = null
        addOnScrollListener(object : OnScrollListener() {
            private var dragging = false
            private var momentum = false

            override fun onScrolled(recyclerView: RecyclerView, dx: Int, dy: Int) {
                onScrollEvent?.invoke()
                onLayoutChanged?.invoke()
                evaluateEndReached()
            }

            override fun onScrollStateChanged(recyclerView: RecyclerView, newState: Int) {
                when (newState) {
                    RecyclerView.SCROLL_STATE_DRAGGING -> if (!dragging) {
                        dragging = true
                        onScrollBeginDrag?.invoke()
                    }
                    RecyclerView.SCROLL_STATE_SETTLING -> {
                        if (dragging) {
                            dragging = false
                            onScrollEndDrag?.invoke()
                        }
                        if (!momentum) {
                            momentum = true
                            onMomentumScrollBegin?.invoke()
                        }
                    }
                    RecyclerView.SCROLL_STATE_IDLE -> {
                        if (dragging) {
                            dragging = false
                            onScrollEndDrag?.invoke()
                        }
                        if (momentum) {
                            momentum = false
                            onMomentumScrollEnd?.invoke()
                        }
                    }
                }
            }
        })
    }

    fun setKeyboardDismissMode(mode: String, dismissKeyboard: () -> Unit) {
        if (mode !in setOf("on-drag", "interactive") && keyboardShouldPersistTaps == "always") {
            setOnTouchListener(null)
            return
        }
        var dismissed = false
        setOnTouchListener { _, event ->
            when (event.actionMasked) {
                android.view.MotionEvent.ACTION_DOWN -> dismissed = false
                android.view.MotionEvent.ACTION_MOVE -> if (!dismissed) {
                    dismissed = true
                    dismissKeyboard()
                }
                android.view.MotionEvent.ACTION_UP -> if (shouldDismissKeyboard(event)) dismissKeyboard()
            }
            false
        }
    }

    fun setKeyboardShouldPersistTaps(value: String?) {
        keyboardShouldPersistTaps = value?.takeIf { it in setOf("always", "handled", "never") } ?: "never"
    }

    private fun tapTarget(view: View, x: Float, y: Float): View? {
        if (x < 0 || y < 0 || x >= view.width || y >= view.height || view.visibility != View.VISIBLE) return null
        if (view is ViewGroup) {
            for (index in view.childCount - 1 downTo 0) {
                val child = view.getChildAt(index)
                tapTarget(child, x - child.left, y - child.top)?.let { return it }
            }
        }
        return view
    }

    private fun shouldDismissKeyboard(event: android.view.MotionEvent): Boolean {
        if (keyboardShouldPersistTaps == "always") return false
        if (keyboardShouldPersistTaps == "never") return true
        return tapTarget(this, event.x, event.y)?.isClickable != true
    }

    fun setContentContainerStyle(style: JSONObject?, density: Float) {
        val padding = (style?.optDouble("padding", 0.0) ?: 0.0) * density
        val horizontal = (style?.optDouble("paddingHorizontal", padding / density) ?: (padding / density)) * density
        val vertical = (style?.optDouble("paddingVertical", padding / density) ?: (padding / density)) * density
        setPadding(
            ((style?.optDouble("paddingLeft", horizontal / density) ?: (horizontal / density)) * density).toInt(),
            ((style?.optDouble("paddingTop", vertical / density) ?: (vertical / density)) * density).toInt(),
            ((style?.optDouble("paddingRight", horizontal / density) ?: (horizontal / density)) * density).toInt(),
            ((style?.optDouble("paddingBottom", vertical / density) ?: (vertical / density)) * density).toInt(),
        )
        clipToPadding = true
        requestLayout()
    }

    fun apply(
        nodes: List<JSONObject>,
        horizontal: Boolean,
        columns: Int,
        inverted: Boolean,
        endReachedThreshold: Double,
        renderItem: CraftNativeRenderItem,
        recycleItem: (String) -> Unit,
        endReached: (() -> Unit)?,
    ) {
        this.renderItem = renderItem
        this.recycleItem = recycleItem
        this.endReached = endReached
        threshold = endReachedThreshold.coerceAtLeast(0.0)

        val nextColumns = columns.coerceAtLeast(1)
        val layoutChanged = this.horizontal != horizontal || this.columns != nextColumns
        val retainedState = if (layoutChanged) null else layoutManager?.onSaveInstanceState()
        this.horizontal = horizontal
        this.columns = nextColumns
        if (layoutChanged || layoutManager == null) {
            configureLayoutManager()
            updateVisibleHolderLayoutParams()
        }

        val seen = mutableMapOf<String, Int>()
        val next = nodes.mapIndexed { index, node ->
            val base = identity(node) ?: "index:$index"
            val occurrence = seen.getOrDefault(base, 0)
            seen[base] = occurrence + 1
            val unique = if (occurrence == 0) base else "$base#$occurrence"
            val role = node.optJSONObject("props")?.optString("listRole").orEmpty()
            Item(unique, node, node.toString(), role.isNotBlank() && role != "item")
        }.let { if (inverted) it.reversed() else it }

        val oldIds = listAdapter.currentList.mapTo(mutableSetOf()) { it.identity }
        val nextIds = next.mapTo(mutableSetOf()) { it.identity }
        (oldIds - nextIds).forEach(recycleItem)
        val dataItems = next.filterNot { it.chrome }
        val contentSignature = dataItems.joinToString("") {
            "${it.identity.length}:${it.identity}${it.signature.length}:${it.signature}"
        }
        dataContentSignature = contentSignature
        if (contentSignature != endReachedSignature) endReachedSignature = null
        val generation = ++submissionGeneration
        isSubmittingList = true
        listAdapter.submitList(next) {
            if (generation != submissionGeneration) return@submitList
            retainedState?.let { layoutManager?.onRestoreInstanceState(it) }
            isSubmittingList = false
            if (pendingThemeRefresh) {
                pendingThemeRefresh = false
                refreshThemeDefaults()
            }
            evaluateEndReached()
        }
    }

    fun discardAll() {
        listAdapter.currentList.forEach { recycleItem?.invoke(it.identity) }
        val generation = ++submissionGeneration
        isSubmittingList = true
        pendingThemeRefresh = false
        listAdapter.submitList(emptyList()) {
            if (generation == submissionGeneration) isSubmittingList = false
        }
        renderItem = null
        recycleItem = null
        endReached = null
        dataContentSignature = ""
        onScrollEvent = null
        onScrollBeginDrag = null
        onScrollEndDrag = null
        onMomentumScrollBegin = null
        onMomentumScrollEnd = null
        onLayoutChanged = null
    }

    fun refreshThemeDefaults() {
        if (isSubmittingList) {
            pendingThemeRefresh = true
            return
        }
        if (listAdapter.itemCount > 0) listAdapter.notifyItemRangeChanged(0, listAdapter.itemCount)
    }

    private fun configureLayoutManager() {
        layoutManager = when {
            horizontal -> LinearLayoutManager(context, HORIZONTAL, false)
            columns > 1 -> GridLayoutManager(context, columns).also { grid ->
                grid.spanSizeLookup = object : GridLayoutManager.SpanSizeLookup() {
                    override fun getSpanSize(position: Int): Int =
                        if (listAdapter.currentList.getOrNull(position)?.chrome == true) columns else 1
                }
            }
            else -> LinearLayoutManager(context)
        }
    }

    private fun evaluateEndReached() {
        if (isSubmittingList) return
        val manager = layoutManager as? LinearLayoutManager ?: return
        val lastVisible = manager.findLastVisibleItemPosition()
        val dataPositions = listAdapter.currentList.indices.filter { !listAdapter.currentList[it].chrome }
        val lastDataOrdinal = dataPositions.indexOfLast { it <= lastVisible }
        if (dataPositions.isEmpty() || lastDataOrdinal < 0 || endReached == null) return
        val remaining = dataPositions.size - lastDataOrdinal - 1
        val thresholdItems = maxOf(1, ceil(dataPositions.size * threshold).toInt())
        if (remaining > thresholdItems) return
        val signature = dataContentSignature
        if (endReachedSignature == signature) return
        endReachedSignature = signature
        endReached?.invoke()
    }

    private fun identity(node: JSONObject): String? {
        val props = node.optJSONObject("props") ?: JSONObject()
        return listOf(node.optString("id"), node.optString("key"), props.optString("key"), props.optString("testID"))
            .firstOrNull { it.isNotBlank() }
    }

    private fun stableId(value: String): Long {
        var hash = -0x340d631b7bdddcdbL
        for (byte in value.encodeToByteArray()) {
            hash = hash xor (byte.toLong() and 0xff)
            hash *= 0x100000001b3L
        }
        return hash
    }
}
