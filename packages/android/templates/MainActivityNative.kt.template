private data class CraftNativeLayoutStyle(
    val width: Int? = null,
    val height: Int? = null,
    val minWidth: Int? = null,
    val maxWidth: Int? = null,
    val minHeight: Int? = null,
    val maxHeight: Int? = null,
    val position: String = "relative",
    val top: Int? = null,
    val right: Int? = null,
    val bottom: Int? = null,
    val left: Int? = null,
    val alignSelf: String? = null,
    val flexGrow: Double = 0.0,
    val flexShrink: Double = 0.0,
    val flexBasis: Int? = null,
) {
    companion object {
        fun from(raw: JSONObject, density: Float): CraftNativeLayoutStyle {
            fun number(name: String): Int? = if (raw.has(name)) (raw.optDouble(name) * density).toInt() else null
            return CraftNativeLayoutStyle(
                width = number("width"), height = number("height"),
                minWidth = number("minWidth"), maxWidth = number("maxWidth"),
                minHeight = number("minHeight"), maxHeight = number("maxHeight"),
                position = raw.optString("position", "relative"),
                top = number("top"), right = number("right"), bottom = number("bottom"), left = number("left"),
                alignSelf = raw.optString("alignSelf").takeIf { it.isNotBlank() },
                flexGrow = raw.optDouble("flexGrow", raw.optDouble("flex", 0.0)),
                flexShrink = raw.optDouble("flexShrink", 0.0),
                flexBasis = number("flexBasis"),
            )
        }
    }
}

private fun craftNativeGridColumnCount(value: Any?): Int {
    if (value is Number) return max(1, value.toInt())
    val text = value as? String ?: return 1
    val trimmed = text.trim()
    if (trimmed.startsWith("repeat(")) {
        val count = trimmed.removePrefix("repeat(").takeWhile { it.isDigit() }.toIntOrNull()
        if (count != null) return max(1, count)
    }
    return max(1, trimmed.split(Regex("\\s+")).count { it.isNotBlank() })
}

/** A deterministic flex-shaped container shared by normal views and scroll content. */
private class CraftNativeFlexLayout(context: Context) : LinearLayout(context) {
    var onLayoutChanged: (() -> Unit)? = null
    private val styles = mutableMapOf<View, CraftNativeLayoutStyle>()
    private var wrap = false
    private var alignItems = "stretch"
    private var justifyContent = "flex-start"
    private var rowGap = 0
    private var columnGap = 0
    private var grid = false
    private var gridColumns = 1
    private var gridAutoRows: Int? = null

    fun configure(style: JSONObject, density: Float) {
        orientation = if (style.optString("flexDirection") in setOf("row", "row-reverse")) HORIZONTAL else VERTICAL
        wrap = style.optString("flexWrap") == "wrap" || style.optBoolean("flexWrap", false)
        alignItems = style.optString("alignItems", "stretch")
        justifyContent = style.optString("justifyContent", "flex-start")
        val gap = (style.optDouble("gap", 0.0) * density).toInt()
        rowGap = (style.optDouble("rowGap", gap.toDouble() / density.toDouble()) * density).toInt()
        columnGap = (style.optDouble("columnGap", gap.toDouble() / density.toDouble()) * density).toInt()
        grid = style.optString("display") == "grid"
        gridColumns = craftNativeGridColumnCount(
            if (style.has("gridTemplateColumns")) style.opt("gridTemplateColumns") else style.opt("gridColumns")
        )
        gridAutoRows = if (style.has("gridAutoRows")) (style.optDouble("gridAutoRows") * density).toInt() else null
        val padding = (style.optDouble("padding", 0.0) * density).toInt()
        val horizontal = (style.optDouble("paddingHorizontal", padding.toDouble() / density.toDouble()) * density).toInt()
        val vertical = (style.optDouble("paddingVertical", padding.toDouble() / density.toDouble()) * density).toInt()
        setPadding(
            (style.optDouble("paddingLeft", horizontal.toDouble() / density.toDouble()) * density).toInt(),
            (style.optDouble("paddingTop", vertical.toDouble() / density.toDouble()) * density).toInt(),
            (style.optDouble("paddingRight", horizontal.toDouble() / density.toDouble()) * density).toInt(),
            (style.optDouble("paddingBottom", vertical.toDouble() / density.toDouble()) * density).toInt(),
        )
        requestLayout()
    }

    fun setChildStyle(view: View, style: JSONObject, density: Float) {
        styles[view] = CraftNativeLayoutStyle.from(style, density)
        requestLayout()
    }

    override fun onViewRemoved(child: View) {
        styles.remove(child)
        super.onViewRemoved(child)
    }

    private data class Entry(val view: View, val style: CraftNativeLayoutStyle, val width: Int, val height: Int)
    private data class Line(val entries: MutableList<Entry> = mutableListOf(), var main: Int = 0, var cross: Int = 0)
    private data class GridLayout(val rows: List<List<Entry>>, val absolute: List<Entry>, val cellWidth: Int, val rowHeights: List<Int>)

    private fun entries(width: Int, height: Int): Pair<List<Line>, List<Entry>> {
        val availableMain = if (orientation == HORIZONTAL) max(0, width - paddingLeft - paddingRight)
        else max(0, height - paddingTop - paddingBottom)
        val gap = if (orientation == HORIZONTAL) columnGap else rowGap
        val lines = mutableListOf<Line>()
        val absolute = mutableListOf<Entry>()
        var line = Line()
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            val childWidth = measureChildWidth(child, style, width - paddingLeft - paddingRight, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
            val entry = Entry(child, style, childWidth, childHeight)
            if (style.position == "absolute") { absolute += entry; continue }
            val childMain = (if (orientation == HORIZONTAL) childWidth + horizontalMargins else childHeight + verticalMargins)
            val childCross = (if (orientation == HORIZONTAL) childHeight + verticalMargins else childWidth + horizontalMargins)
            val next = if (line.entries.isEmpty()) childMain else line.main + gap + childMain
            if (wrap && line.entries.isNotEmpty() && next > availableMain) {
                lines += line
                line = Line()
            }
            line.entries += entry
            line.main = if (line.entries.size == 1) childMain else line.main + gap + childMain
            line.cross = max(line.cross, childCross)
        }
        if (line.entries.isNotEmpty()) lines += line
        return lines to absolute
    }

    private fun gridLayout(width: Int, height: Int): GridLayout {
        val availableWidth = max(0, width - paddingLeft - paddingRight)
        val gap = columnGap
        val cellWidth = max(0, (availableWidth - max(0, gridColumns - 1) * gap) / max(1, gridColumns))
        val rows = mutableListOf<MutableList<Entry>>()
        val absolute = mutableListOf<Entry>()
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            val childWidth = measureChildWidth(child, style, cellWidth, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
            val entry = Entry(child, style, childWidth, childHeight)
            if (style.position == "absolute") absolute += entry
            else {
                if (rows.isEmpty() || rows.last().size == gridColumns) rows.add(mutableListOf())
                rows.last() += entry
            }
        }
        val rowHeights = rows.map { row -> max(gridAutoRows ?: 0, row.maxOfOrNull { it.height } ?: 0) }
        return GridLayout(rows, absolute, cellWidth, rowHeights)
    }

    private fun gridIntrinsicSize(height: Int): Pair<Int, Int> {
        val columns = max(1, gridColumns)
        val columnWidths = IntArray(columns)
        val rowHeights = mutableListOf<Int>()
        var flowIndex = 0
        for (index in 0 until childCount) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            if (style.position == "absolute") continue
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            val childWidth = measureChildWidth(child, style, 1_000_000, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height, verticalMargins)
            val column = flowIndex % columns
            val row = flowIndex / columns
            while (rowHeights.size <= row) rowHeights += gridAutoRows ?: 0
            columnWidths[column] = max(columnWidths[column], childWidth + horizontalMargins)
            rowHeights[row] = max(rowHeights[row], childHeight + verticalMargins)
            flowIndex += 1
        }
        val cellWidth = columnWidths.maxOrNull() ?: 0
        val width = paddingLeft + paddingRight + cellWidth * columns + max(0, columns - 1) * columnGap
        val rowGapTotal = max(0, rowHeights.size - 1) * rowGap
        val measuredHeight = paddingTop + paddingBottom + rowHeights.sum() + rowGapTotal
        return width to measuredHeight
    }

    private fun measureChildWidth(child: View, style: CraftNativeLayoutStyle, available: Int, margins: Int): Int {
        val flexBasis = if (orientation == HORIZONTAL) style.flexBasis else null
        val explicit = style.width ?: flexBasis
            ?: (child.layoutParams?.width ?: ViewGroup.LayoutParams.WRAP_CONTENT).takeIf { it >= 0 }
        val target = explicit ?: max(0, available - margins)
        val spec = if (explicit != null) View.MeasureSpec.makeMeasureSpec(target, View.MeasureSpec.EXACTLY)
        else View.MeasureSpec.makeMeasureSpec(max(0, available - margins), View.MeasureSpec.AT_MOST)
        child.measure(spec, View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED))
        return clamp(if (explicit != null) target else child.measuredWidth, style.minWidth, style.maxWidth)
    }

    private fun measureChildHeight(child: View, style: CraftNativeLayoutStyle, available: Int, margins: Int): Int {
        val flexBasis = if (orientation == VERTICAL) style.flexBasis else null
        val explicit = style.height ?: flexBasis
            ?: (child.layoutParams?.height ?: ViewGroup.LayoutParams.WRAP_CONTENT).takeIf { it >= 0 }
        val target = explicit ?: max(0, available - margins)
        val spec = if (explicit != null) View.MeasureSpec.makeMeasureSpec(target, View.MeasureSpec.EXACTLY)
        else View.MeasureSpec.makeMeasureSpec(max(0, available - margins), View.MeasureSpec.AT_MOST)
        child.measure(child.measuredWidth.let { View.MeasureSpec.makeMeasureSpec(max(0, it), View.MeasureSpec.EXACTLY) }, spec)
        return clamp(if (explicit != null) target else child.measuredHeight, style.minHeight, style.maxHeight)
    }

    private fun clamp(value: Int, lower: Int?, upper: Int?): Int {
        var result = value
        if (lower != null) result = max(result, lower)
        if (upper != null) result = min(result, upper)
        return result
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val widthMode = View.MeasureSpec.getMode(widthMeasureSpec)
        val width = View.MeasureSpec.getSize(widthMeasureSpec).takeUnless { widthMode == View.MeasureSpec.UNSPECIFIED } ?: 1_000_000
        val height = View.MeasureSpec.getSize(heightMeasureSpec).takeUnless { View.MeasureSpec.getMode(heightMeasureSpec) == View.MeasureSpec.UNSPECIFIED } ?: 1_000_000
        if (grid) {
            if (widthMode == View.MeasureSpec.UNSPECIFIED) {
                val (intrinsicWidth, intrinsicHeight) = gridIntrinsicSize(height)
                setMeasuredDimension(
                    resolveSize(intrinsicWidth, widthMeasureSpec),
                    resolveSize(intrinsicHeight, heightMeasureSpec),
                )
                return
            }
            val layout = gridLayout(width, height)
            val desiredWidth = paddingLeft + paddingRight + layout.cellWidth * gridColumns + max(0, gridColumns - 1) * columnGap
            val desiredHeight = paddingTop + paddingBottom + layout.rowHeights.sum() + max(0, layout.rowHeights.size - 1) * rowGap
            setMeasuredDimension(resolveSize(desiredWidth, widthMeasureSpec), resolveSize(desiredHeight, heightMeasureSpec))
            return
        }
        val (lines, absolute) = entries(width, height)
        val main = lines.maxOfOrNull { it.main } ?: 0
        val cross = lines.sumOf { it.cross } + max(0, lines.size - 1) * (if (orientation == HORIZONTAL) rowGap else columnGap)
        val desiredWidth = if (orientation == HORIZONTAL) main else cross
        val desiredHeight = if (orientation == HORIZONTAL) cross else main
        val absWidth = absolute.maxOfOrNull { it.width } ?: 0
        val absHeight = absolute.maxOfOrNull { it.height } ?: 0
        setMeasuredDimension(
            resolveSize(max(desiredWidth + paddingLeft + paddingRight, absWidth + paddingLeft + paddingRight), widthMeasureSpec),
            resolveSize(max(desiredHeight + paddingTop + paddingBottom, absHeight + paddingTop + paddingBottom), heightMeasureSpec),
        )
    }

    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
        if (grid) {
            val layout = gridLayout(width, height)
            var rowTop = paddingTop
            for ((rowIndex, row) in layout.rows.withIndex()) {
                val rowHeight = layout.rowHeights[rowIndex]
                for ((column, entry) in row.withIndex()) {
                    val align = entry.style.alignSelf ?: alignItems
                    val childWidth = if (align == "stretch" && entry.style.width == null) layout.cellWidth else min(layout.cellWidth, entry.width)
                    val childHeight = if (align == "stretch" && entry.style.height == null) rowHeight else min(rowHeight, entry.height)
                    val x = paddingLeft + column * (layout.cellWidth + columnGap) + when (align) {
                        "center" -> (layout.cellWidth - childWidth) / 2
                        "flex-end" -> layout.cellWidth - childWidth
                        else -> 0
                    }
                    val y = rowTop + when (align) {
                        "center" -> (rowHeight - childHeight) / 2
                        "flex-end" -> rowHeight - childHeight
                        else -> 0
                    }
                    entry.view.layout(x, y, x + childWidth, y + childHeight)
                }
                rowTop += rowHeight + rowGap
            }
            val contentWidth = width - paddingLeft - paddingRight
            val contentHeight = height - paddingTop - paddingBottom
            for (entry in layout.absolute) {
                val childWidth = if (entry.style.left != null && entry.style.right != null) contentWidth - entry.style.left!! - entry.style.right!! else entry.width
                val childHeight = if (entry.style.top != null && entry.style.bottom != null) contentHeight - entry.style.top!! - entry.style.bottom!! else entry.height
                val x = paddingLeft + (entry.style.left ?: (entry.style.right?.let { contentWidth - it - childWidth } ?: 0))
                val y = paddingTop + (entry.style.top ?: (entry.style.bottom?.let { contentHeight - it - childHeight } ?: 0))
                entry.view.layout(x, y, x + max(0, childWidth), y + max(0, childHeight))
            }
            onLayoutChanged?.invoke()
            return
        }
        val contentWidth = width - paddingLeft - paddingRight
        val contentHeight = height - paddingTop - paddingBottom
        val (lines, absolute) = entries(width, height)
        val gap = if (orientation == HORIZONTAL) columnGap else rowGap
        val crossGap = if (orientation == HORIZONTAL) rowGap else columnGap
        val availableMain = if (orientation == HORIZONTAL) contentWidth else contentHeight
        var crossOffset = if (orientation == HORIZONTAL) paddingTop else paddingLeft
        for (line in lines) {
            val rawFree = availableMain - line.main
            val factors = line.entries.map { if (rawFree >= 0) it.style.flexGrow else it.style.flexShrink }
            val totalFactor = factors.sum()
            val distributedMain = line.entries.indices.sumOf { index ->
                val base = if (orientation == HORIZONTAL) line.entries[index].width else line.entries[index].height
                val primary = if (totalFactor > 0) max(0, (base + rawFree * factors[index] / totalFactor).toInt()) else base
                val lp = line.entries[index].view.layoutParams as? MarginLayoutParams
                val margins = if (orientation == HORIZONTAL) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                    else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                primary + margins
            } + max(0, line.entries.size - 1) * gap
            val free = max(0, availableMain - distributedMain)
            val (leading, between) = distribution(free, line.entries.size)
            var mainOffset = if (orientation == HORIZONTAL) paddingLeft else paddingTop
            mainOffset += leading
            for ((index, entry) in line.entries.withIndex()) {
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val marginStart = if (orientation == HORIZONTAL) lp?.leftMargin ?: 0 else lp?.topMargin ?: 0
                val marginEnd = if (orientation == HORIZONTAL) lp?.rightMargin ?: 0 else lp?.bottomMargin ?: 0
                val crossSize = if ((entry.style.alignSelf ?: alignItems) == "stretch" && (if (orientation == HORIZONTAL) entry.style.height else entry.style.width) == null)
                    max(0, line.cross - (if (orientation == HORIZONTAL) (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0) else (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)))
                else if (orientation == HORIZONTAL) entry.height else entry.width
                val align = entry.style.alignSelf ?: alignItems
                val crossPosition = when (align) {
                    "center" -> (line.cross - crossSize) / 2
                    "flex-end" -> line.cross - crossSize
                    else -> 0
                }
                val x = if (orientation == HORIZONTAL) mainOffset + marginStart else crossOffset + crossPosition + (lp?.leftMargin ?: 0)
                val y = if (orientation == HORIZONTAL) crossOffset + crossPosition + (lp?.topMargin ?: 0) else mainOffset + marginStart
                val primary = if (orientation == HORIZONTAL) entry.width else entry.height
                val distributedPrimary = if (totalFactor > 0) max(0, (primary + rawFree * factors[index] / totalFactor).toInt()) else primary
                val w = if (orientation == HORIZONTAL) distributedPrimary else crossSize
                val h = if (orientation == HORIZONTAL) crossSize else distributedPrimary
                entry.view.layout(x, y, x + w, y + h)
                mainOffset += distributedPrimary + marginStart + marginEnd + gap + between
            }
            crossOffset += line.cross + crossGap
        }
        for (entry in absolute) {
            val widthValue = if (entry.style.left != null && entry.style.right != null) contentWidth - entry.style.left!! - entry.style.right!! else entry.width
            val heightValue = if (entry.style.top != null && entry.style.bottom != null) contentHeight - entry.style.top!! - entry.style.bottom!! else entry.height
            val x = paddingLeft + (entry.style.left ?: (entry.style.right?.let { contentWidth - it - widthValue } ?: 0))
            val y = paddingTop + (entry.style.top ?: (entry.style.bottom?.let { contentHeight - it - heightValue } ?: 0))
            entry.view.layout(x, y, x + max(0, widthValue), y + max(0, heightValue))
        }
        onLayoutChanged?.invoke()
    }

    private fun distribution(free: Int, count: Int): Pair<Int, Int> = when (justifyContent) {
        "center" -> free / 2 to 0
        "flex-end" -> free to 0
        "space-between" -> 0 to if (count > 1) free / (count - 1) else 0
        "space-around" -> free / (count * 2) to free / count
        "space-evenly" -> free / (count + 1) to free / (count + 1)
        else -> 0 to 0
    }
}

private class CraftNativeScrollView(context: Context) : FrameLayout(context) {
    val content = CraftNativeFlexLayout(context)
    private val vertical = ScrollView(context)
    private val horizontal = HorizontalScrollView(context)
    private var horizontalMode: Boolean? = null

    init {
        vertical.isNestedScrollingEnabled = true
        horizontal.isNestedScrollingEnabled = true
        vertical.isFillViewport = true
        horizontal.isFillViewport = true
        setHorizontal(false)
    }

    fun setHorizontal(value: Boolean) {
        if (horizontalMode == value) return
        horizontalMode = value
        (content.parent as? ViewGroup)?.removeView(content)
        removeAllViews()
        val scroller: ViewGroup = if (value) horizontal else vertical
        scroller.removeAllViews()
        content.orientation = if (value) LinearLayout.HORIZONTAL else LinearLayout.VERTICAL
        scroller.addView(content, if (value)
            ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.MATCH_PARENT)
        else ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
        addView(scroller, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
    }

    fun setNativeNestedScrollingEnabled(value: Boolean) {
        vertical.isNestedScrollingEnabled = value
        horizontal.isNestedScrollingEnabled = value
    }

    fun setScrollEnabled(value: Boolean) {
        vertical.isEnabled = value
        horizontal.isEnabled = value
    }

    fun setScrollIndicators(verticalVisible: Boolean, horizontalVisible: Boolean) {
        vertical.isVerticalScrollBarEnabled = verticalVisible
        horizontal.isHorizontalScrollBarEnabled = horizontalVisible
    }

    fun setScrollListeners(
        onScroll: ((Int, Int) -> Unit)?,
        onBeginDrag: (() -> Unit)?,
        onEndDrag: (() -> Unit)?,
    ) {
        fun attach(scroller: View) {
            scroller.setOnScrollChangeListener { _, x, y, _, _ -> onScroll?.invoke(x, y) }
            scroller.setOnTouchListener { _, event ->
                when (event.actionMasked) {
                    android.view.MotionEvent.ACTION_DOWN -> onBeginDrag?.invoke()
                    android.view.MotionEvent.ACTION_UP, android.view.MotionEvent.ACTION_CANCEL -> onEndDrag?.invoke()
                }
                false
            }
        }
        attach(vertical)
        attach(horizontal)
    }
}

private class CraftNativeFlexSpacer(context: Context) : View(context)

private data class LayoutBounds(
    val x: Double,
    val y: Double,
    val width: Double,
    val height: Double,
)

/** WebView-free host for a compiled stx-native route bundle. */
class MainActivity : AppCompatActivity() {
    private class Screen(
        val route: String?,
        val params: JSONObject,
        val view: CraftNativeFlexLayout,
        val isolate: JavaScriptIsolate,
        val port: MessagePort?
    ) {
        val drafts = mutableMapOf<String, String>()
        val controls = mutableMapOf<String, View>()
        val handlers = mutableMapOf<View, String>()
        val scrollHandlers = mutableMapOf<View, String>()
        val scrollBeginHandlers = mutableMapOf<View, String>()
        val scrollEndHandlers = mutableMapOf<View, String>()
        val sliderCompleteHandlers = mutableMapOf<View, String>()
        val sliderSteps = mutableMapOf<View, Double>()
        val focusHandlers = mutableMapOf<View, String>()
        val blurHandlers = mutableMapOf<View, String>()
        val submitHandlers = mutableMapOf<View, String>()
        val imageLoadStartHandlers = mutableMapOf<ImageView, String>()
        val imageLoadHandlers = mutableMapOf<ImageView, String>()
        val imageLoadEndHandlers = mutableMapOf<ImageView, String>()
        val imageErrorHandlers = mutableMapOf<ImageView, String>()
        val layoutHandlers = mutableMapOf<View, String>()
        val lastLayoutBounds = mutableMapOf<View, LayoutBounds>()
        val flatListRows = mutableMapOf<CraftNativeFlatList, MutableMap<String, MutableMap<String, View>>>()
        val flatListOwners = mutableMapOf<String, String>()
        val flatListOwnerByView = mutableMapOf<CraftNativeFlatList, String>()
        val mutations = CraftNativeMutationDocument()
        val capabilityScope = UUID.randomUUID().toString()
        val pendingCapabilities = mutableSetOf<String>()
        val capabilityTimeouts = mutableMapOf<String, Runnable>()
        var active = true

        fun close() {
            active = false
            port?.close()
            isolate.close()
        }
    }

    private lateinit var root: FrameLayout
    private var sandbox: JavaScriptSandbox? = null
    private val screens = mutableListOf<Screen>()
    private var bundle = ""
    private lateinit var config: JSONObject
    private lateinit var capabilities: CraftNativeCapabilities
    private val capabilityHandler = Handler(Looper.getMainLooper())
    private var hapticsEnabled = false
    private var clipboardEnabled = false
    internal var nativeAppState = "inactive"
        private set
    private var deliveredInitialDeepLink = false
    private var initialDeepLink: Uri? = null
    private var initialDeepLinkClaimed = false
    private var defaultTextColor = Color.WHITE
    private var useMessagePorts = false
    private val imageExecutor = Executors.newFixedThreadPool(2)
    private val imageSources = mutableMapOf<ImageView, String>()
    private val imageJobs = mutableMapOf<ImageView, Future<*>>()
    private val imageErrors = mutableMapOf<ImageView, String>()
    private val inputHintDefaults = mutableMapOf<EditText, ColorStateList>()
    private val inputHighlightDefaults = mutableMapOf<EditText, Int>()
    private val defaultBackgrounds = mutableMapOf<View, Drawable?>()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        initialDeepLink = savedInstanceState?.getString("craft.initialDeepLink")?.let(Uri::parse) ?: intent?.data
        initialDeepLinkClaimed = savedInstanceState?.getBoolean("craft.initialDeepLinkClaimed", false) ?: false
        deliveredInitialDeepLink = savedInstanceState?.getBoolean("craft.deliveredInitialDeepLink", false) ?: false
        setContentView(R.layout.activity_main)
        root = findViewById(R.id.native_root)
        ViewCompat.setOnApplyWindowInsetsListener(root) { view, insets ->
            val safe = insets.getInsets(WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout())
            view.setPadding(safe.left, safe.top, safe.right, safe.bottom)
            insets
        }
        ViewCompat.requestApplyInsets(root)
        config = runCatching {
            assets.open("craft.config.json").bufferedReader().use {
                JSONObject(it.readText())
            }
        }.getOrDefault(JSONObject())
        hapticsEnabled = config.optBoolean("enableHaptics", false)
        clipboardEnabled = config.optBoolean("enableClipboard", false)
        capabilities = CraftNativeCapabilities(this, config)
        val background = ContextCompat.getColor(this, R.color.background)
        root.setBackgroundColor(background)
        defaultTextColor = if (Color.luminance(background) < 0.5) Color.WHITE else Color.BLACK
        bundle = runCatching {
            assets.open("native-screen.js").bufferedReader().use { it.readText() }
        }.getOrElse {
            showError("Missing native-screen.js. Build with --native-bundle after compiling STX.")
            return
        }
        if (!JavaScriptSandbox.isSupported()) {
            showError("Native STX requires Android JavaScriptSandbox, which is unavailable on this device.")
            return
        }
        val connection = synchronized(SANDBOX_LOCK) {
            sharedSandboxConnection ?: sharedSandbox?.let { existing ->
                sandbox = existing
                null
            } ?: JavaScriptSandbox.createConnectedInstanceAsync(applicationContext).also {
                sharedSandboxConnection = it
            }
        }
        if (connection == null) {
            sandbox?.let(::attachSandbox)
        } else {
            connection.addListener({
                try {
                    val engine = connection.get()
                    synchronized(SANDBOX_LOCK) {
                        sharedSandbox = engine
                    }
                    if (!isDestroyed) {
                        sandbox = engine
                        attachSandbox(engine)
                    }
                } catch (error: Exception) {
                    synchronized(SANDBOX_LOCK) { sharedSandboxConnection = null }
                    Log.e(TAG, "JavaScriptSandbox connection failed", error)
                    if (!isDestroyed) showError("Native STX JavaScript engine could not start: ${error.message}")
                }
            }, ContextCompat.getMainExecutor(this))
        }
    }

    private fun attachSandbox(engine: JavaScriptSandbox) {
        useMessagePorts = engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_MESSAGE_PORTS)
            && engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_PROMISE_RETURN)
        if (!useMessagePorts && !engine.isFeatureSupported(JavaScriptSandbox.JS_FEATURE_CONSOLE_MESSAGING)) {
            showError("Native STX requires JavaScript message ports or console messaging, unavailable on this device.")
            return
        }
        Log.i(TAG, "Native STX bridge: ${if (useMessagePorts) "message ports" else "console callback"}")
        openScreen(null)
    }

    private fun openScreen(route: String?, params: JSONObject = JSONObject()) {
        val engine = sandbox ?: return
        val isolate = engine.createIsolate()
        val view = CraftNativeFlexLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            layoutParams = FrameLayout.LayoutParams(-1, -1)
        }
        var screen: Screen? = null
        val executor = ContextCompat.getMainExecutor(this)
        val token = UUID.randomUUID().toString()
        val prefix = "CRAFT_STX_$token:"
        val port = if (useMessagePorts) {
            isolate.createMessageChannel("craft", executor, MessagePortClient { message ->
                val current = screen ?: return@MessagePortClient
                if (current.active && message.type == Message.TYPE_STRING) receiveSafely(current, message.string)
            })
        } else {
            isolate.setConsoleCallback(executor, JavaScriptConsoleCallback { entry ->
                val current = screen ?: return@JavaScriptConsoleCallback
                if (current.active && entry.message.startsWith(prefix)) {
                    receiveSafely(current, entry.message.removePrefix(prefix))
                }
            })
            null
        }
        val activeScreen = Screen(route, params, view, isolate, port)
        activeScreen.view.onLayoutChanged = {
            if (activeScreen.active) emitLayoutEvents(activeScreen)
        }
        screen = activeScreen
        screens.add(activeScreen)
        show(activeScreen)
        val routePrelude = """
            globalThis.__stxNativeRoute = ${route?.let { JSONObject.quote(it) } ?: "undefined"};
            globalThis.__stxNativeParams = ${params};
        """.trimIndent()
        val prelude = if (useMessagePorts) """
            (async function() {
              const port = await android.getNamedPort('craft');
              $routePrelude
              globalThis.__stxNativeBridge = {
                platform: 'android',
                mutationProtocolVersion: 1,
                capabilityProtocolVersion: $CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION,
                capabilityTimeoutMs: $CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS,
                capabilities: ${capabilities.names()},
                initialAppState: ${JSONObject.quote(nativeAppState)},
                postMessage: function(value) { port.postMessage(value); },
                onMessage: function(callback) { port.onmessage = function(event) { callback(event.data); }; }
              };
            })()
        """.trimIndent() else """
            $routePrelude
            globalThis.__stxNativeBridge = {
              platform: 'android',
              mutationProtocolVersion: 1,
              capabilityProtocolVersion: $CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION,
              capabilityTimeoutMs: $CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS,
              capabilities: ${capabilities.names()},
              initialAppState: ${JSONObject.quote(nativeAppState)},
              postMessage: function(value) { console.log(${JSONObject.quote(prefix)} + value); },
              onMessage: function(callback) { globalThis.__stxNativeCallback = callback; }
            };
        """.trimIndent()
        val setup = isolate.evaluateJavaScriptAsync(prelude)
        setup.addListener({
            if (!activeScreen.active) return@addListener
            try {
                setup.get()
                val load = isolate.evaluateJavaScriptAsync(bundle)
                load.addListener({
                    try {
                        load.get()
                        val launchLink = initialDeepLink
                        if (!deliveredInitialDeepLink
                            && config.optBoolean("enableDeepLinks")
                            && launchLink != null
                            && screens.lastOrNull() === activeScreen
                        ) {
                            deliveredInitialDeepLink = true
                            send(activeScreen, "DEEP_LINK", deepLinkData(launchLink).put("initial", true))
                        }
                    } catch (error: Exception) {
                        Log.e(TAG, "Native STX bundle failed", error)
                        if (activeScreen.active) showError("Native STX bundle failed: ${error.message}")
                    }
                }, executor)
            } catch (error: Exception) {
                Log.e(TAG, "Native STX bridge failed", error)
                showError("Native STX bridge failed: ${error.message}")
            }
        }, executor)
    }

    private fun show(screen: Screen) {
        root.removeAllViews()
        (screen.view.parent as? ViewGroup)?.removeView(screen.view)
        root.addView(screen.view)
    }

    override fun onSaveInstanceState(outState: Bundle) {
        outState.putString("craft.initialDeepLink", initialDeepLink?.toString())
        outState.putBoolean("craft.initialDeepLinkClaimed", initialDeepLinkClaimed)
        outState.putBoolean("craft.deliveredInitialDeepLink", deliveredInitialDeepLink)
        super.onSaveInstanceState(outState)
    }

    override fun onConfigurationChanged(newConfig: Configuration) {
        super.onConfigurationChanged(newConfig)
        if (!::root.isInitialized) return
        val background = ContextCompat.getColor(this, R.color.background)
        root.setBackgroundColor(background)
        defaultTextColor = if (Color.luminance(background) < 0.5) Color.WHITE else Color.BLACK
        ViewCompat.requestApplyInsets(root)
        refreshInputDefaultsForTraitChange()
        screens.lastOrNull()?.let { screen ->
            screen.mutations.node("root")?.let { renderCommitted(screen, it) }
        }
    }

    private fun refreshInputDefaultsForTraitChange() {
        if (inputHintDefaults.isEmpty() && inputHighlightDefaults.isEmpty()) return
        val probe = EditText(this)
        val hintColors = probe.hintTextColors
        val highlightColor = probe.highlightColor
        inputHintDefaults.keys.toList().forEach { inputHintDefaults[it] = hintColors }
        inputHighlightDefaults.keys.toList().forEach { inputHighlightDefaults[it] = highlightColor }
    }

    private fun receive(screen: Screen, raw: String) {
        val message = runCatching { JSONObject(raw) }.getOrNull() ?: return
        val payload = message.optJSONObject("payload") ?: JSONObject()
        Log.d(TAG, "Native STX ${message.optString("type")} (${raw.length} chars) for ${screen.route ?: "home"}")
        when (message.optString("type")) {
            "RENDER" -> payload.optJSONObject("document")?.let { render(screen, it) }
            "MUTATE" -> try {
                val result = applyMutation(screen, payload)
                send(screen, "MUTATION_ACK", JSONObject()
                    .put("batchId", result.batchId)
                    .put("revision", result.revision)
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION))
            }
            catch (failure: CraftNativeMutationFailure) {
                val error = JSONObject()
                    .put("batchId", payload.optString("batchId"))
                    .put("code", failure.code)
                    .put("message", failure.message)
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION)
                failure.operationIndex?.let { error.put("operationIndex", it) }
                send(screen, "MUTATION_ERROR", error)
            }
            catch (_: Exception) {
                send(screen, "MUTATION_ERROR", JSONObject()
                    .put("batchId", payload.optString("batchId"))
                    .put("code", "INVALID_BATCH")
                    .put("message", "mutation batch could not be applied")
                    .put("version", CRAFT_NATIVE_MUTATION_PROTOCOL_VERSION))
            }
            "NAVIGATE", "NAVIGATE_REPLACE" -> {
                if (screens.lastOrNull() !== screen) return
                val route = payload.optString("screen").takeIf { it.isNotBlank() } ?: return
                if (message.optString("type") == "NAVIGATE_REPLACE") {
                    closeScreen(screens.removeAt(screens.lastIndex))
                }
                openScreen(route, payload.optJSONObject("params") ?: JSONObject())
            }
            "NAVIGATE_BACK" -> if (screens.lastOrNull() === screen) back()
            "API_REQUEST" -> answerAPI(screen, message, payload)
            "API_CANCEL" -> {
                val id = payload.optString("requestId")
                if (id.isNotBlank()) {
                    val token = "${screen.capabilityScope}/$id"
                    screen.pendingCapabilities.remove(token)
                    screen.capabilityTimeouts.remove(token)?.let(capabilityHandler::removeCallbacks)
                    capabilities.cancel(token)
                }
            }
        }
    }

    private fun receiveSafely(screen: Screen, raw: String) {
        try {
            receive(screen, raw)
        }
        catch (error: Exception) {
            val route = screen.route ?: "home"
            Log.e(TAG, "Native STX message failed for $route", error)
            if (screen.active) showError("Native STX message failed for $route: ${error.message}")
        }
    }

    private fun render(screen: Screen, document: JSONObject) {
        screen.mutations.replace(document)
        renderCommitted(screen, document)
    }

    private fun applyMutation(screen: Screen, payload: JSONObject): CraftNativeMutationResult {
        val result = screen.mutations.apply(payload)
        if (!result.requiresFullRender && applyTargetedUpdates(screen, result.affectedNodeIds)) return result
        result.document?.let { renderCommitted(screen, it) } ?: clearRenderedTree(screen)
        return result
    }

    private fun applyTargetedUpdates(screen: Screen, ids: List<String>): Boolean {
        val applied = mutableSetOf<String>()
        for (id in ids) {
            val target = screen.flatListOwners[id] ?: id
            if (!applied.add(target)) continue
            val document = screen.mutations.node(target) ?: return false
            if (!screen.controls.containsKey("id:$target")) return false
            makeView(screen, document, target, screen.controls)
        }
        return true
    }

    private fun renderCommitted(screen: Screen, document: JSONObject) {
        // Keep live controls (especially the focused EditText) across renders.
        val next = mutableMapOf<String, View>()
        val tree = makeView(screen, document, "root", next)
        if (screen.view.getChildAt(0) !== tree) {
            (tree.parent as? ViewGroup)?.removeView(tree)
            screen.view.removeAllViews()
            screen.view.addView(tree)
        }
        releaseViewState(screen, screen.controls.values.filter { it !in next.values })
        screen.controls.clear()
        screen.controls.putAll(next)
        screen.handlers.keys.retainAll(retainedViews(screen))
        screen.view.setChildStyle(tree, document.optJSONObject("style") ?: JSONObject(), resources.displayMetrics.density)
    }

    private fun clearRenderedTree(screen: Screen) {
        releaseViewState(screen, retainedViews(screen).toList())
        screen.view.removeAllViews()
        screen.controls.clear()
        screen.handlers.clear()
        screen.flatListRows.clear()
        screen.flatListOwners.clear()
        screen.flatListOwnerByView.clear()
    }

    private fun makeView(
        screen: Screen,
        node: JSONObject,
        path: String,
        next: MutableMap<String, View>,
        previousControls: Map<String, View> = screen.controls,
    ): View {
        val type = node.optString("type", "View")
        val props = node.optJSONObject("props") ?: JSONObject()
        val style = node.optJSONObject("style") ?: JSONObject()
        val events = node.optJSONObject("events") ?: JSONObject()
        val children = node.optJSONArray("children") ?: JSONArray()
        val protocolId = node.optString("id").takeIf { it.isNotBlank() }
        val explicitKey = listOf(node.optString("key"), props.optString("key"), props.optString("testID"))
            .firstOrNull { it.isNotBlank() }
        val identity = protocolId?.let { "id:$it" }
            ?: explicitKey?.let { "${path.substringBeforeLast('.', "")}/$it" }
            ?: path
        val previous = previousControls[identity]
        val control = when (type) {
            "Text" -> ((previous as? TextView)?.takeUnless { it is Button || it is EditText } ?: TextView(this)).apply {
                configureText(this, childText(children), style)
            }
            "Link" -> (previous as? TextView ?: TextView(this)).apply {
                configureText(this, props.optString("title").ifBlank { childText(children) }, style)
                setTextColor(color(style.optString("color"), Color.rgb(33, 150, 243)))
                paintFlags = paintFlags or Paint.UNDERLINE_TEXT_FLAG
                isEnabled = !props.optBoolean("disabled", false)
                isClickable = true
                isFocusable = true
                val handler = events.optString("onPress").ifBlank { events.optString("onClick") }
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                setOnClickListener {
                    val current = screen.handlers[this] ?: return@setOnClickListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                }
            }
            "Button" -> (previous as? Button ?: Button(this)).apply {
                val title = props.optString("title").ifBlank { childText(children) }
                configureText(this, title, style)
                isEnabled = !props.optBoolean("disabled", false)
                val handler = events.optString("onPress").ifBlank { events.optString("onClick") }
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                setOnClickListener {
                    val current = screen.handlers[this] ?: return@setOnClickListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                }
            }
            "TextInput" -> (previous as? EditText ?: EditText(this)).apply {
                val defaultHintColors = inputHintDefaults.getOrPut(this) {
                    hintTextColors ?: ColorStateList.valueOf(Color.GRAY)
                }
                val defaultHighlightColor = inputHighlightDefaults.getOrPut(this) { highlightColor }
                hint = props.optString("placeholder")
                setHintTextColor(
                    props.optString("placeholderTextColor").takeIf { it.isNotBlank() }
                        ?.let { ColorStateList.valueOf(color(it, Color.GRAY)) }
                        ?: defaultHintColors,
                )
                highlightColor = props.optString("selectionColor").takeIf { it.isNotBlank() }
                    ?.let { color(it, defaultHighlightColor) }
                    ?: defaultHighlightColor
                val maxLength = props.optInt("maxLength", 0)
                filters = if (maxLength > 0) arrayOf(InputFilter.LengthFilter(maxLength)) else emptyArray()
                inputType = inputTypeFor(props)
                imeOptions = imeOptionsFor(props)
                val multiline = props.optBoolean("multiline", false)
                isSingleLine = !multiline
                maxLines = if (multiline) props.optInt("numberOfLines", Int.MAX_VALUE).coerceAtLeast(1) else 1
                isEnabled = props.optBoolean("editable", true)
                configureTextStyle(this, style)
                if (props.has("value") && text.toString() != props.optString("value")) setText(props.optString("value"))
                else if (this !== previous && screen.drafts.containsKey(identity)) setText(screen.drafts[identity])
                val handler = events.optString("onChange").ifBlank { events.optString("onChangeText") }
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                val onFocus = events.optString("onFocus")
                if (onFocus.isNotBlank()) screen.focusHandlers[this] = onFocus else screen.focusHandlers.remove(this)
                val onBlur = events.optString("onBlur").ifBlank { events.optString("onEndEditing") }
                if (onBlur.isNotBlank()) screen.blurHandlers[this] = onBlur else screen.blurHandlers.remove(this)
                val onSubmit = events.optString("onSubmitEditing")
                if (onSubmit.isNotBlank()) screen.submitHandlers[this] = onSubmit else screen.submitHandlers.remove(this)
                setOnFocusChangeListener { view, focused ->
                    val current = if (focused) screen.focusHandlers[view] else screen.blurHandlers[view]
                    if (current == null) return@setOnFocusChangeListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject().put("text", text.toString())))
                }
                setOnEditorActionListener { view, actionId, event ->
                    val submitted = actionId != EditorInfo.IME_ACTION_NONE || event?.keyCode == KeyEvent.KEYCODE_ENTER
                    if (!submitted) return@setOnEditorActionListener false
                    val current = screen.submitHandlers[view] ?: return@setOnEditorActionListener false
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject().put("text", text.toString())))
                    true
                }
                if (props.optBoolean("autoFocus", false)) post {
                    requestFocus()
                    (getSystemService(INPUT_METHOD_SERVICE) as? android.view.inputmethod.InputMethodManager)
                        ?.showSoftInput(this, android.view.inputmethod.InputMethodManager.SHOW_IMPLICIT)
                }
                if (this !== previous) addTextChangedListener(object : TextWatcher {
                    override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
                    override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
                        val updated = s?.toString().orEmpty()
                        screen.drafts[identity] = updated
                        val current = screen.handlers[this@apply] ?: return
                        send(screen, "EVENT", JSONObject()
                            .put("handlerName", current)
                            .put("nativeEvent", JSONObject().put("text", updated)))
                    }
                    override fun afterTextChanged(s: Editable?) {}
                })
            }
            "Switch" -> (previous as? Switch ?: Switch(this)).apply {
                setOnCheckedChangeListener(null)
                isChecked = when {
                    props.has("value") -> props.optBoolean("value")
                    else -> props.optBoolean("checked", false)
                }
                isEnabled = !props.optBoolean("disabled", false)
                props.optJSONObject("trackColor")?.let { track ->
                    val falseColor = color(track.optString("false"), Color.GRAY)
                    val trueColor = color(track.optString("true"), falseColor)
                    trackTintList = ColorStateList(
                        arrayOf(intArrayOf(android.R.attr.state_checked), intArrayOf()),
                        intArrayOf(trueColor, falseColor),
                    )
                } ?: run { trackTintList = null }
                thumbTintList = props.optString("thumbColor").takeIf { it.isNotBlank() }
                    ?.let { ColorStateList.valueOf(color(it, Color.WHITE)) }
                val handler = events.optString("onValueChange").ifBlank { events.optString("onChange") }
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                setOnCheckedChangeListener { _, checked ->
                    val current = screen.handlers[this] ?: return@setOnCheckedChangeListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject().put("value", checked)))
                }
            }
            "Slider" -> (previous as? SeekBar ?: SeekBar(this)).apply {
                val minimum = props.optDouble("minimumValue", 0.0)
                val maximumCandidate = props.optDouble("maximumValue", 1.0)
                val maximum = if (maximumCandidate > minimum) maximumCandidate else minimum + Double.MIN_VALUE
                max = 1000
                setOnSeekBarChangeListener(null)
                progress = (((props.optDouble("value", minimum) - minimum) / (maximum - minimum)) * max).toInt().coerceIn(0, max)
                val step = props.optDouble("step", 0.0).takeIf { it > 0 }
                if (step != null) screen.sliderSteps[this] = step else screen.sliderSteps.remove(this)
                progressTintList = props.optString("minimumTrackTintColor").takeIf { it.isNotBlank() }
                    ?.let { ColorStateList.valueOf(color(it, Color.WHITE)) }
                progressBackgroundTintList = props.optString("maximumTrackTintColor").takeIf { it.isNotBlank() }
                    ?.let { ColorStateList.valueOf(color(it, Color.GRAY)) }
                thumbTintList = props.optString("thumbTintColor").takeIf { it.isNotBlank() }
                    ?.let { ColorStateList.valueOf(color(it, Color.WHITE)) }
                isEnabled = !props.optBoolean("disabled", false)
                val handler = events.optString("onValueChange").ifBlank { events.optString("onChange") }
                if (handler.isNotBlank()) screen.handlers[this] = handler else screen.handlers.remove(this)
                val complete = events.optString("onSlidingComplete")
                if (complete.isNotBlank()) screen.sliderCompleteHandlers[this] = complete else screen.sliderCompleteHandlers.remove(this)
                setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
                    override fun onProgressChanged(seekBar: SeekBar, progress: Int, fromUser: Boolean) {
                        val current = screen.handlers[seekBar] ?: return
                        val raw = minimum + (maximum - minimum) * progress.toDouble() / max.toDouble()
                        val step = screen.sliderSteps[seekBar]
                        val value = if (step != null) minimum + ((raw - minimum) / step).roundToInt() * step else raw
                        send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject().put("value", value)))
                    }
                    override fun onStartTrackingTouch(seekBar: SeekBar) {}
                    override fun onStopTrackingTouch(seekBar: SeekBar) {
                        val current = screen.sliderCompleteHandlers[seekBar] ?: return
                        val raw = minimum + (maximum - minimum) * seekBar.progress.toDouble() / max.toDouble()
                        val step = screen.sliderSteps[seekBar]
                        val value = if (step != null) minimum + ((raw - minimum) / step).roundToInt() * step else raw
                        send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject().put("value", value)))
                    }
                })
            }
            "ActivityIndicator" -> (previous as? android.widget.ProgressBar ?: android.widget.ProgressBar(this)).apply {
                isIndeterminate = true
                visibility = if (props.optBoolean("animating", true)) View.VISIBLE else View.GONE
                indeterminateTintList = props.optString("color").takeIf { it.isNotBlank() }
                    ?.let { ColorStateList.valueOf(color(it, Color.WHITE)) }
            }
            "Image" -> (previous as? ImageView ?: ImageView(this)).apply {
                scaleType = when (style.optString("resizeMode").ifBlank { props.optString("resizeMode") }) {
                    "cover" -> ImageView.ScaleType.CENTER_CROP
                    "stretch" -> ImageView.ScaleType.FIT_XY
                    "center" -> ImageView.ScaleType.CENTER
                    else -> ImageView.ScaleType.CENTER_INSIDE
                }
                adjustViewBounds = false
                val onLoadStart = events.optString("onLoadStart")
                if (onLoadStart.isNotBlank()) screen.imageLoadStartHandlers[this] = onLoadStart else screen.imageLoadStartHandlers.remove(this)
                val onLoad = events.optString("onLoad")
                if (onLoad.isNotBlank()) screen.imageLoadHandlers[this] = onLoad else screen.imageLoadHandlers.remove(this)
                val onLoadEnd = events.optString("onLoadEnd")
                if (onLoadEnd.isNotBlank()) screen.imageLoadEndHandlers[this] = onLoadEnd else screen.imageLoadEndHandlers.remove(this)
                val onError = events.optString("onError")
                if (onError.isNotBlank()) screen.imageErrorHandlers[this] = onError else screen.imageErrorHandlers.remove(this)
                updateImage(screen, this, props.opt("source"))
            }
            "ScrollView" -> (previous as? CraftNativeScrollView ?: CraftNativeScrollView(this)).apply {
                val horizontal = props.optBoolean("horizontal", false) || style.optString("flexDirection") in setOf("row", "row-reverse")
                setHorizontal(horizontal)
                setNativeNestedScrollingEnabled(true)
                setScrollIndicators(
                    props.optBoolean("showsVerticalScrollIndicator", true),
                    props.optBoolean("showsHorizontalScrollIndicator", true),
                )
                setScrollEnabled(props.optBoolean("scrollEnabled", true))
                val onScroll = events.optString("onScroll")
                if (onScroll.isNotBlank()) screen.scrollHandlers[this] = onScroll else screen.scrollHandlers.remove(this)
                val onBegin = events.optString("onScrollBeginDrag")
                if (onBegin.isNotBlank()) screen.scrollBeginHandlers[this] = onBegin else screen.scrollBeginHandlers.remove(this)
                val onEnd = events.optString("onScrollEndDrag")
                if (onEnd.isNotBlank()) screen.scrollEndHandlers[this] = onEnd else screen.scrollEndHandlers.remove(this)
                val nativeScroll = this
                setScrollListeners(
                    onScroll = { scrollX, scrollY ->
                        screen.scrollHandlers[nativeScroll]?.let { current ->
                            val contentView = nativeScroll.content
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()
                                .put("contentOffset", JSONObject().put("x", scrollX).put("y", scrollY))
                                .put("contentSize", JSONObject().put("width", contentView.width).put("height", contentView.height))
                                .put("layoutMeasurement", JSONObject().put("width", nativeScroll.width).put("height", nativeScroll.height))))
                        }
                    },
                    onBeginDrag = {
                        screen.scrollBeginHandlers[nativeScroll]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                        }
                    },
                    onEndDrag = {
                        screen.scrollEndHandlers[nativeScroll]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                        }
                    },
                )
                configureContainer(content, style)
                reconcileChildren(screen, content, children, path, next, style, previousControls)
            }
            "FlatList" -> (previous as? CraftNativeFlatList ?: CraftNativeFlatList(this)).apply {
                reconcileFlatList(screen, this, children, path, protocolId ?: path, props, events)
            }
            "View", "SafeAreaView" -> (previous as? CraftNativeFlexLayout ?: CraftNativeFlexLayout(this)).apply {
                configureContainer(this, style)
                reconcileChildren(screen, this, children, path, next, style, previousControls)
            }
            else -> (previous as? CraftNativeFlexLayout ?: CraftNativeFlexLayout(this)).apply {
                configureContainer(this, style)
                reconcileChildren(screen, this, children, path, next, style, previousControls)
            }
        }
        if (type != "Button" && type != "Link" && type != "TextInput" && type != "Switch" && type != "Slider" && type != "ActivityIndicator") {
            val handler = events.optString("onPress").ifBlank { events.optString("onClick") }
            if (handler.isNotBlank()) {
                screen.handlers[control] = handler
                control.isClickable = true
                control.setOnClickListener {
                    val current = screen.handlers[control] ?: return@setOnClickListener
                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                }
            } else {
                screen.handlers.remove(control)
                control.isClickable = false
                control.setOnClickListener(null)
            }
        }
        applyAccessibility(control, props, type, explicitKey ?: protocolId ?: path)
        val layoutHandler = events.optString("onLayout")
        if (layoutHandler.isNotBlank()) {
            if (screen.layoutHandlers[control] != layoutHandler) screen.lastLayoutBounds.remove(control)
            screen.layoutHandlers[control] = layoutHandler
        } else {
            screen.layoutHandlers.remove(control)
            screen.lastLayoutBounds.remove(control)
        }
        if (control is ImageView) imageErrors[control]?.let { control.contentDescription = "${control.contentDescription}, $it" }
        next[identity] = control
        applyViewStyle(control, style)
        control.layoutParams = LinearLayout.LayoutParams(
            if (style.has("width")) dp(style.optDouble("width")) else ViewGroup.LayoutParams.WRAP_CONTENT,
            if (style.has("height")) dp(style.optDouble("height")) else ViewGroup.LayoutParams.WRAP_CONTENT
        ).apply {
            val margin = style.optDouble("margin", 0.0)
            val horizontal = style.optDouble("marginHorizontal", margin)
            val vertical = style.optDouble("marginVertical", margin)
            setMargins(
                dp(style.optDouble("marginLeft", horizontal)),
                dp(style.optDouble("marginTop", vertical)),
                dp(style.optDouble("marginRight", horizontal)),
                dp(style.optDouble("marginBottom", vertical))
            )
        }
        return control
    }

    private fun childText(children: JSONArray): String = buildString {
        for (index in 0 until children.length()) {
            val value = children.opt(index)
            if (value is String) append(value)
        }
    }

    private fun configureContainer(layout: CraftNativeFlexLayout, style: JSONObject) {
        layout.configure(style, resources.displayMetrics.density)
    }

    private fun reconcileChildren(
        screen: Screen,
        layout: CraftNativeFlexLayout,
        children: JSONArray,
        path: String,
        next: MutableMap<String, View>,
        style: JSONObject,
        previousControls: Map<String, View>,
    ) {
        for (index in layout.childCount - 1 downTo 0) {
            if (layout.getChildAt(index) is CraftNativeFlexSpacer) layout.removeViewAt(index)
        }
        val desired = mutableListOf<View>()
        for (index in 0 until children.length()) {
            val child = children.opt(index)
            val childView = when (child) {
                is JSONObject -> makeView(screen, child, "$path.$index", next, previousControls)
                is String -> TextView(this).apply { text = child; setTextColor(defaultTextColor) }
                else -> null
            }
            if (childView != null) desired.add(childView)
            if (childView != null && child is JSONObject) {
                layout.setChildStyle(childView, child.optJSONObject("style") ?: JSONObject(), resources.displayMetrics.density)
            }
        }
        if (style.optString("flexDirection").endsWith("-reverse")) desired.reverse()
        val desiredSet = desired.toSet()
        for ((index, childView) in desired.withIndex()) {
            if (layout.getChildAt(index) !== childView) {
                if (index < layout.childCount && layout.getChildAt(index) !in desiredSet) layout.removeViewAt(index)
                (childView.parent as? ViewGroup)?.removeView(childView)
                layout.addView(childView, index)
            }
            val params = childView.layoutParams as? LinearLayout.LayoutParams
                ?: LinearLayout.LayoutParams(childView.layoutParams?.width ?: -1, childView.layoutParams?.height ?: -2)
            childView.layoutParams = params
        }
        while (layout.childCount > desired.size) layout.removeViewAt(layout.childCount - 1)
        layout.requestLayout()
    }

    private fun reconcileFlatList(
        screen: Screen,
        list: CraftNativeFlatList,
        children: JSONArray,
        path: String,
        owner: String,
        props: JSONObject,
        events: JSONObject,
    ) {
        screen.flatListOwners.entries.removeAll { it.value == owner }
        screen.flatListOwnerByView[list] = owner
        val nodes = (0 until children.length()).mapNotNull { children.optJSONObject(it) }
        nodes.forEach { registerFlatListOwnership(screen, it, owner) }
        list.apply(
            nodes = nodes,
            horizontal = props.optBoolean("horizontal", false),
            columns = props.optInt("numColumns", 1),
            inverted = props.optBoolean("inverted", false),
            endReachedThreshold = when {
                props.has("onEndReachedThreshold") -> props.optDouble("onEndReachedThreshold", 0.1)
                else -> props.optDouble("threshold", 0.1)
            },
            renderItem = { node, itemIdentity, _ ->
                val rows = screen.flatListRows.getOrPut(list) { mutableMapOf() }
                val previous = rows[itemIdentity].orEmpty()
                val next = mutableMapOf<String, View>()
                val view = makeView(screen, node, "$path.$itemIdentity", next, previous)
                releaseViewState(screen, previous.values.filter { it !in next.values })
                rows[itemIdentity] = next
                view
            },
            recycleItem = { itemIdentity ->
                val controls = screen.flatListRows[list]?.remove(itemIdentity).orEmpty()
                releaseViewState(screen, controls.values.toList())
            },
            endReached = events.optString("onEndReached").takeIf { it.isNotBlank() }?.let { handler ->
                { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", JSONObject())) }
            },
        )
    }

    private fun registerFlatListOwnership(screen: Screen, node: JSONObject, owner: String) {
        val props = node.optJSONObject("props") ?: JSONObject()
        listOf(node.optString("id"), node.optString("key"), props.optString("key"), props.optString("testID"))
            .filter { it.isNotBlank() }
            .forEach { screen.flatListOwners[it] = owner }
        val children = node.optJSONArray("children") ?: JSONArray()
        for (index in 0 until children.length()) {
            children.optJSONObject(index)?.let { registerFlatListOwnership(screen, it, owner) }
        }
    }

    private fun addJustificationSpacers(layout: CraftNativeFlexLayout, value: String) { }

    private fun applyViewStyle(view: View, style: JSONObject) {
        view.alpha = style.optDouble("opacity", 1.0).toFloat()
        view.visibility = if (style.optString("display") == "none") View.GONE else View.VISIBLE
        view.elevation = dp(style.optDouble("elevation", 0.0)).toFloat()
        val background = style.has("backgroundColor")
        val border = style.optDouble("borderWidth", 0.0)
        val radius = style.optDouble("borderRadius", 0.0)
        val defaultBackground = if (defaultBackgrounds.containsKey(view)) {
            defaultBackgrounds[view]
        } else {
            view.background.also { defaultBackgrounds[view] = it }
        }
        if (background || border > 0 || radius > 0) {
            view.background = GradientDrawable().apply {
                setColor(color(style.optString("backgroundColor"), Color.TRANSPARENT))
                cornerRadius = dp(radius).toFloat()
                if (border > 0) setStroke(dp(border), color(style.optString("borderColor"), Color.TRANSPARENT))
            }
        } else view.background = defaultBackground
        view.clipToOutline = style.optString("overflow") == "hidden"
        if (view is ViewGroup) view.clipChildren = style.optString("overflow") == "hidden"
        if (view is ImageView) {
            if (style.has("tintColor")) view.setColorFilter(color(style.optString("tintColor"), Color.TRANSPARENT))
            else view.clearColorFilter()
        }
    }

    private fun configureText(view: TextView, value: String, style: JSONObject) {
        view.text = when (style.optString("textTransform")) {
            "uppercase" -> value.uppercase()
            "lowercase" -> value.lowercase()
            "capitalize" -> value.split(' ').joinToString(" ") { word -> word.replaceFirstChar(Char::uppercase) }
            else -> value
        }
        configureTextStyle(view, style)
    }

    private fun configureTextStyle(view: TextView, style: JSONObject) {
        view.setTextColor(color(style.optString("color"), defaultTextColor))
        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, style.optDouble("fontSize", 14.0).toFloat())
        val weight = when (style.optString("fontWeight")) {
            "bold" -> 700
            "100", "200", "300", "400", "500", "600", "700", "800", "900" -> style.optInt("fontWeight")
            else -> 400
        }
        val italic = style.optString("fontStyle") == "italic"
        val family = style.optString("fontFamily").takeIf { it.isNotBlank() }
        view.typeface = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            Typeface.create(Typeface.create(family, Typeface.NORMAL), weight, italic)
        } else Typeface.create(family, (if (weight >= 600) Typeface.BOLD else Typeface.NORMAL) or
            (if (italic) Typeface.ITALIC else Typeface.NORMAL))
        view.textAlignment = when (style.optString("textAlign")) {
            "left" -> View.TEXT_ALIGNMENT_TEXT_START
            "right" -> View.TEXT_ALIGNMENT_TEXT_END
            "center" -> View.TEXT_ALIGNMENT_CENTER
            "justify" -> View.TEXT_ALIGNMENT_VIEW_START
            else -> View.TEXT_ALIGNMENT_INHERIT
        }
        view.letterSpacing = if (style.has("letterSpacing") && view.textSize > 0)
            dp(style.optDouble("letterSpacing")).toFloat() / view.textSize else 0f
        view.setLineSpacing(
            if (style.has("lineHeight")) dp(style.optDouble("lineHeight")) - view.textSize else 0f,
            1f
        )
        view.paintFlags = view.paintFlags and Paint.UNDERLINE_TEXT_FLAG.inv() and Paint.STRIKE_THRU_TEXT_FLAG.inv()
        when (style.optString("textDecorationLine")) {
            "underline" -> view.paintFlags = view.paintFlags or Paint.UNDERLINE_TEXT_FLAG
            "line-through" -> view.paintFlags = view.paintFlags or Paint.STRIKE_THRU_TEXT_FLAG
            "underline line-through" -> view.paintFlags = view.paintFlags or
                Paint.UNDERLINE_TEXT_FLAG or Paint.STRIKE_THRU_TEXT_FLAG
        }
    }

    private fun updateImage(screen: Screen, view: ImageView, source: Any?) {
        val uri = when (source) {
            is String -> source
            is JSONObject -> source.optString("uri")
            else -> ""
        }
        if (uri.isBlank()) {
            imageJobs.remove(view)?.cancel(true)
            imageSources.remove(view)
            imageErrors[view] = "Image source is missing"
            view.setImageDrawable(null)
            imageFailure(screen, view, uri, "Image source is missing")
            return
        }
        if (imageSources[view] == uri) return
        imageJobs.remove(view)?.cancel(true)
        imageSources[view] = uri
        imageErrors.remove(view)
        view.setImageDrawable(null)
        emitImageEvent(screen, view, screen.imageLoadStartHandlers[view])

        if (uri.startsWith("data:image/") && uri.contains(',')) {
            val bytes = runCatching { Base64.decode(uri.substringAfter(','), Base64.DEFAULT) }.getOrNull()
            val bitmap = bytes?.let { BitmapFactory.decodeByteArray(it, 0, it.size) }
            if (bitmap != null) {
                view.setImageBitmap(bitmap)
                emitImageEvent(screen, view, screen.imageLoadHandlers[view])
                emitImageEvent(screen, view, screen.imageLoadEndHandlers[view])
            } else imageFailure(screen, view, uri, "Image data is invalid")
            return
        }
        if (!uri.contains(':')) {
            val bitmap = runCatching { assets.open(uri).use { BitmapFactory.decodeStream(it) } }.getOrNull()
            if (bitmap != null) {
                view.setImageBitmap(bitmap)
                emitImageEvent(screen, view, screen.imageLoadHandlers[view])
                emitImageEvent(screen, view, screen.imageLoadEndHandlers[view])
            } else imageFailure(screen, view, uri, "Bundled image was not found")
            return
        }
        if (!uri.startsWith("https://")) {
            imageFailure(screen, view, uri, "Unsupported image source")
            return
        }
        imageJobs[view] = imageExecutor.submit {
            val bitmap = runCatching {
                val connection = URL(uri).openConnection().apply {
                    connectTimeout = 10_000
                    readTimeout = 10_000
                }
                connection.getInputStream().use(BitmapFactory::decodeStream)
            }.getOrNull()
            runOnUiThread {
                if (imageSources[view] != uri) return@runOnUiThread
                imageJobs.remove(view)
                if (bitmap != null) {
                    view.setImageBitmap(bitmap)
                    emitImageEvent(screen, view, screen.imageLoadHandlers[view])
                    emitImageEvent(screen, view, screen.imageLoadEndHandlers[view])
                } else imageFailure(screen, view, uri, "Image download failed")
            }
        }
    }

    private fun imageFailure(screen: Screen, view: ImageView, uri: String, message: String) {
        imageErrors[view] = message
        view.setImageDrawable(null)
        view.contentDescription = "${view.tag ?: "Image"}, $message"
        emitImageEvent(screen, view, screen.imageErrorHandlers[view], JSONObject().put("error", JSONObject().put("message", message)))
        emitImageEvent(screen, view, screen.imageLoadEndHandlers[view])
        Log.e(TAG, "$message: $uri")
    }

    private fun emitImageEvent(screen: Screen, view: ImageView, handler: String?, nativeEvent: JSONObject = JSONObject()) {
        if (handler.isNullOrBlank()) return
        send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", nativeEvent))
    }

    private fun applyAccessibility(view: View, props: JSONObject, type: String, fallbackLabel: String) {
        view.tag = fallbackLabel
        view.contentDescription = props.optString("accessibilityLabel").ifBlank { fallbackLabel }
        props.opt("accessibilityValue")?.takeUnless { it == JSONObject.NULL }?.let { view.contentDescription = "${view.contentDescription}, $it" }
        props.optString("accessibilityHint").takeIf { it.isNotBlank() }?.let { view.tooltipText = it }
        val role = props.optString("accessibilityRole").ifBlank { type.lowercase() }
        val state = props.optJSONObject("accessibilityState")
        val disabled = state?.optBoolean("disabled", false) == true
        if (state != null && state.has("disabled")) view.isEnabled = !disabled
        ViewCompat.setAccessibilityDelegate(view, object : AccessibilityDelegateCompat() {
            override fun onInitializeAccessibilityNodeInfo(host: View, info: AccessibilityNodeInfoCompat) {
                super.onInitializeAccessibilityNodeInfo(host, info)
                info.className = when (role) {
                    "button" -> Button::class.java.name
                    "image" -> ImageView::class.java.name
                    "search" -> EditText::class.java.name
                    "scrollbar" -> ScrollView::class.java.name
                    else -> host.javaClass.name
                }
                info.isHeading = role == "header"
                info.roleDescription = role.takeIf { it !in setOf("view", "text", "textinput", "scrollview") }
                info.isEnabled = !disabled
                info.isSelected = state?.optBoolean("selected", false) == true
                info.isChecked = state?.optBoolean("checked", false) == true
            }
        })
        ViewCompat.setImportantForAccessibility(
            view,
            if (role == "none") ViewCompat.IMPORTANT_FOR_ACCESSIBILITY_NO else ViewCompat.IMPORTANT_FOR_ACCESSIBILITY_YES,
        )
    }

    private fun dp(value: Double) = (value * resources.displayMetrics.density).toInt()
    private fun color(raw: String, fallback: Int) = runCatching { Color.parseColor(raw) }.getOrDefault(fallback)

    private fun inputTypeFor(props: JSONObject): Int {
        val base = if (props.optBoolean("multiline", false)) InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE
        else InputType.TYPE_CLASS_TEXT
        val keyboard = when (props.optString("keyboardType")) {
            "email-address" -> InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS
            "url" -> InputType.TYPE_TEXT_VARIATION_URI
            "numeric" -> InputType.TYPE_CLASS_NUMBER
            "decimal-pad" -> InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_FLAG_DECIMAL
            "phone-pad" -> InputType.TYPE_CLASS_PHONE
            else -> 0
        }
        val capitalization = when (props.optString("autoCapitalize")) {
            "characters" -> InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS
            "words" -> InputType.TYPE_TEXT_FLAG_CAP_WORDS
            "sentences" -> InputType.TYPE_TEXT_FLAG_CAP_SENTENCES
            else -> 0
        }
        val correction = if (props.optBoolean("autoCorrect", true)) InputType.TYPE_TEXT_FLAG_AUTO_CORRECT else 0
        val secure = if (props.optBoolean("secureTextEntry", false)) InputType.TYPE_TEXT_VARIATION_PASSWORD else 0
        return (if (keyboard == 0) base else keyboard) or capitalization or correction or secure
    }

    private fun imeOptionsFor(props: JSONObject): Int = when (props.optString("returnKeyType")) {
        "done" -> EditorInfo.IME_ACTION_DONE
        "go" -> EditorInfo.IME_ACTION_GO
        "next" -> EditorInfo.IME_ACTION_NEXT
        "search" -> EditorInfo.IME_ACTION_SEARCH
        "send" -> EditorInfo.IME_ACTION_SEND
        else -> EditorInfo.IME_ACTION_NONE
    }

    private fun answerAPI(screen: Screen, message: JSONObject, payload: JSONObject) {
        val id = message.optString("id")
        if (id.isBlank()) return
        val args = payload.optJSONArray("args") ?: JSONArray()
        val token = "${screen.capabilityScope}/$id"
        screen.pendingCapabilities.add(token)
        val timeout = Runnable {
            if (!screen.active || !screen.pendingCapabilities.remove(token)) return@Runnable
            screen.capabilityTimeouts.remove(token)
            capabilities.cancel(token)
            send(screen, "API_ERROR", JSONObject()
                .put("version", CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION)
                .put("requestId", id)
                .put("code", "TIMEOUT")
                .put("message", "Native API request timed out"), id)
        }
        screen.capabilityTimeouts[token] = timeout
        capabilityHandler.postDelayed(timeout, CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS)
        capabilities.perform(
            token,
            payload.optInt("version", CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION),
            payload.optString("module"),
            payload.optString("method"),
            args,
        ) { result ->
            if (!screen.active || !screen.pendingCapabilities.remove(token)) return@perform
            screen.capabilityTimeouts.remove(token)?.let(capabilityHandler::removeCallbacks)
            val response = JSONObject()
                .put("version", CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION)
                .put("requestId", id)
            if (result.code == null) response.put("data", result.data ?: JSONObject.NULL)
            else response.put("code", result.code).put("message", result.message ?: "Native API failed")
            send(screen, if (result.code == null) "API_RESPONSE" else "API_ERROR", response, id)
        }
    }

    internal fun performImmediateCapability(module: String, method: String, args: JSONArray): CraftNativeCapabilityResult =
        when (module to method) {
            "Device" to "getInfo" -> CraftNativeCapabilityResult(data = JSONObject()
                .put("platform", "android")
                .put("osVersion", Build.VERSION.RELEASE)
                .put("model", Build.MODEL)
                .put("manufacturer", Build.MANUFACTURER)
                .put("deviceId", android.provider.Settings.Secure.getString(contentResolver, android.provider.Settings.Secure.ANDROID_ID))
                .put("isTablet", resources.configuration.smallestScreenWidthDp >= 600)
                .put("screen", JSONObject()
                    .put("width", resources.displayMetrics.widthPixels / resources.displayMetrics.density)
                    .put("height", resources.displayMetrics.heightPixels / resources.displayMetrics.density)
                    .put("scale", resources.displayMetrics.density)))
            "Clipboard" to "write" -> if (!clipboardEnabled) {
                CraftNativeCapabilityResult(code = "CAPABILITY_DISABLED", message = "Clipboard is disabled")
            } else if (args.opt(0) !is String) {
                CraftNativeCapabilityResult(code = "INVALID_ARGUMENT", message = "Clipboard.write needs text")
            } else {
                val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
                clipboard.setPrimaryClip(ClipData.newPlainText("", args.getString(0)))
                CraftNativeCapabilityResult(data = true)
            }
            "Clipboard" to "read" -> if (!clipboardEnabled) {
                CraftNativeCapabilityResult(code = "CAPABILITY_DISABLED", message = "Clipboard is disabled")
            } else {
                val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
                CraftNativeCapabilityResult(data = clipboard.primaryClip?.getItemAt(0)?.coerceToText(this)?.toString() ?: "")
            }
            "Haptics" to "impact" -> if (!hapticsEnabled) {
                CraftNativeCapabilityResult(code = "CAPABILITY_DISABLED", message = "Haptics are disabled")
            } else {
                val vibrator = getSystemService(Context.VIBRATOR_SERVICE) as Vibrator
                vibrator.vibrate(VibrationEffect.createOneShot(30, VibrationEffect.DEFAULT_AMPLITUDE))
                CraftNativeCapabilityResult(data = true)
            }
            else -> CraftNativeCapabilityResult(code = "UNKNOWN_ACTION", message = "Unsupported native API")
        }

    internal fun deepLinkData(uri: android.net.Uri): JSONObject = JSONObject()
        .put("url", uri.toString())
        .put("scheme", uri.scheme ?: "")
        .put("host", uri.host ?: "")
        .put("path", uri.path ?: "")
        .put("query", uri.query ?: "")
        .put("queryParams", JSONObject().apply {
            uri.queryParameterNames.forEach { name -> put(name, uri.getQueryParameter(name) ?: "") }
        })

    private fun publish(type: String, payload: JSONObject) {
        screens.lastOrNull()?.takeIf { it.active }?.let { send(it, type, payload) }
    }

    override fun onStart() {
        super.onStart()
        nativeAppState = "active"
        publish("APP_STATE", JSONObject().put("state", nativeAppState))
    }

    override fun onPause() {
        nativeAppState = "inactive"
        publish("APP_STATE", JSONObject().put("state", nativeAppState))
        super.onPause()
    }

    override fun onStop() {
        nativeAppState = "background"
        publish("APP_STATE", JSONObject().put("state", nativeAppState))
        super.onStop()
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        intent.data?.let { publish("DEEP_LINK", deepLinkData(it).put("initial", false)) }
    }

    internal fun consumeInitialDeepLink(): Uri? {
        if (initialDeepLinkClaimed) return null
        initialDeepLinkClaimed = true
        return initialDeepLink
    }

    private fun emitLayoutEvents(screen: Screen) {
        emitLayoutEvents(screen, screen.view)
    }

    private fun emitLayoutEvents(screen: Screen, view: View) {
        val handler = screen.layoutHandlers[view]
        if (handler != null && view.isShown) {
            val density = resources.displayMetrics.density
            val bounds = LayoutBounds(
                x = view.left.toDouble() / density.toDouble(),
                y = view.top.toDouble() / density.toDouble(),
                width = view.width.toDouble() / density.toDouble(),
                height = view.height.toDouble() / density.toDouble(),
            )
            if (screen.lastLayoutBounds[view] != bounds) {
                screen.lastLayoutBounds[view] = bounds
                send(screen, "EVENT", JSONObject()
                    .put("handlerName", handler)
                    .put("nativeEvent", JSONObject().put("layout", JSONObject()
                        .put("x", bounds.x)
                        .put("y", bounds.y)
                        .put("width", bounds.width)
                        .put("height", bounds.height))))
            }
        }
        if (view is ViewGroup) {
            for (index in 0 until view.childCount) emitLayoutEvents(screen, view.getChildAt(index))
        }
    }

    private fun send(screen: Screen, type: String, payload: JSONObject, correlationId: String? = null) {
        if (!screen.active) return
        val message = JSONObject().put("type", type).put("payload", payload)
        if (correlationId != null) message.put("correlationId", correlationId)
        if (screen.port != null) {
            screen.port.postMessage(Message.createStringMessage(message.toString()))
        } else {
            val script = "globalThis.__stxNativeCallback && globalThis.__stxNativeCallback(${JSONObject.quote(message.toString())})"
            screen.isolate.evaluateJavaScriptAsync(script)
        }
    }

    private fun back() {
        if (screens.size > 1) {
            closeScreen(screens.removeAt(screens.lastIndex))
            show(screens.last())
        } else {
            finish()
        }
    }

    private fun releaseImages(views: Collection<View>) {
        views.filterIsInstance<ImageView>().forEach { image ->
            imageJobs.remove(image)?.cancel(true)
            imageSources.remove(image)
            imageErrors.remove(image)
        }
    }

    private fun retainedViews(screen: Screen): MutableSet<View> = screen.controls.values.toMutableSet().apply {
        screen.flatListRows.values.forEach { rows -> rows.values.forEach { addAll(it.values) } }
    }

    private fun releaseViewState(screen: Screen, views: Collection<View>) {
        val released = views.toSet()
        released.filterIsInstance<CraftNativeFlatList>().forEach { list ->
            val owner = screen.flatListOwnerByView.remove(list)
            list.discardAll()
            screen.flatListRows.remove(list)?.values?.forEach { releaseViewState(screen, it.values) }
            if (owner != null) screen.flatListOwners.entries.removeAll { it.value == owner }
        }
        releaseImages(released)
        released.filterIsInstance<EditText>().forEach {
            inputHintDefaults.remove(it)
            inputHighlightDefaults.remove(it)
        }
        released.forEach(defaultBackgrounds::remove)
        screen.handlers.keys.removeAll(released)
        screen.layoutHandlers.keys.removeAll(released)
        screen.lastLayoutBounds.keys.removeAll(released)
        screen.scrollHandlers.keys.removeAll(released)
        screen.scrollBeginHandlers.keys.removeAll(released)
        screen.scrollEndHandlers.keys.removeAll(released)
        screen.sliderCompleteHandlers.keys.removeAll(released)
        screen.sliderSteps.keys.removeAll(released)
        screen.focusHandlers.keys.removeAll(released)
        screen.blurHandlers.keys.removeAll(released)
        screen.submitHandlers.keys.removeAll(released)
        screen.imageLoadStartHandlers.keys.removeAll(released)
        screen.imageLoadHandlers.keys.removeAll(released)
        screen.imageLoadEndHandlers.keys.removeAll(released)
        screen.imageErrorHandlers.keys.removeAll(released)
    }

    private fun closeScreen(screen: Screen) {
        screen.capabilityTimeouts.values.forEach(capabilityHandler::removeCallbacks)
        screen.capabilityTimeouts.clear()
        screen.pendingCapabilities.forEach(capabilities::cancel)
        screen.pendingCapabilities.clear()
        releaseViewState(screen, retainedViews(screen).toList())
        screen.controls.clear()
        screen.handlers.clear()
        screen.layoutHandlers.clear()
        screen.lastLayoutBounds.clear()
        screen.scrollHandlers.clear()
        screen.scrollBeginHandlers.clear()
        screen.scrollEndHandlers.clear()
        screen.sliderCompleteHandlers.clear()
        screen.sliderSteps.clear()
        screen.focusHandlers.clear()
        screen.blurHandlers.clear()
        screen.submitHandlers.clear()
        screen.imageLoadStartHandlers.clear()
        screen.imageLoadHandlers.clear()
        screen.imageLoadEndHandlers.clear()
        screen.imageErrorHandlers.clear()
        screen.flatListRows.clear()
        screen.flatListOwners.clear()
        screen.flatListOwnerByView.clear()
        screen.close()
    }

    @Deprecated("Uses the activity back callback for native route navigation")
    override fun onBackPressed() = back()

    private fun showError(message: String) {
        root.removeAllViews()
        root.addView(TextView(this).apply {
            text = message
            setTextColor(Color.RED)
            textSize = 16f
            setPadding(24, 24, 24, 24)
        })
        Log.e(TAG, message)
    }

    override fun onDestroy() {
        screens.forEach { closeScreen(it) }
        screens.clear()
        imageJobs.values.forEach { it.cancel(true) }
        imageJobs.clear()
        imageExecutor.shutdownNow()
        capabilities.close()
        super.onDestroy()
    }

    companion object {
        private const val TAG = "CraftNativeAndroid"
        private val SANDBOX_LOCK = Any()
        private var sharedSandbox: JavaScriptSandbox? = null
        private var sharedSandboxConnection: ListenableFuture<JavaScriptSandbox>? = null
    }
}
