                val pageHandler = craftNativeEventName(events, "onPageSelected").takeIf { it.isNotBlank() }
                configurePager(props.opt("pageIndex"), pageHandler?.let { handler ->
                    { index, count -> send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", JSONObject().put("index", index).put("count", count))) }
                })
                val refreshNode = (0 until children.length()).asSequence()
                    .mapNotNull { children.optJSONObject(it) }
                    .firstOrNull { canonicalType(it.optString("type")) == "RefreshControl" }
                val propRefresh = props.optJSONObject("refreshControl")
                val refreshProps = refreshNode?.optJSONObject("props") ?: propRefresh ?: JSONObject()
                val refreshEvents = refreshNode?.optJSONObject("events") ?: JSONObject()
                val refreshHandlerName = craftNativeEventName(refreshEvents, "onRefresh")
                    .takeIf { it.isNotBlank() }
                    ?: craftNativeEventName(events, "onRefresh").takeIf { it.isNotBlank() }
                val refreshHandler = refreshHandlerName?.let { handler ->
                    { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", JSONObject())) }
                }
                setRefreshHandler(refreshHandler, craftNativeBoolean(refreshProps.opt("refreshing"), craftNativeBoolean(props.opt("refreshing"))))
                setRefreshAppearance(refreshProps, resources.displayMetrics.density, refreshTintFallback(screen))
                val onScroll = craftNativeEventName(events, "onScroll")
                if (onScroll.isNotBlank()) screen.scrollHandlers[this] = onScroll else screen.scrollHandlers.remove(this)
                val onBegin = craftNativeEventName(events, "onScrollBeginDrag")
                if (onBegin.isNotBlank()) screen.scrollBeginHandlers[this] = onBegin else screen.scrollBeginHandlers.remove(this)
                val onEnd = craftNativeEventName(events, "onScrollEndDrag")
                if (onEnd.isNotBlank()) screen.scrollEndHandlers[this] = onEnd else screen.scrollEndHandlers.remove(this)
                val onMomentumBegin = craftNativeEventName(events, "onMomentumScrollBegin")
                if (onMomentumBegin.isNotBlank()) screen.scrollMomentumBeginHandlers[this] = onMomentumBegin else screen.scrollMomentumBeginHandlers.remove(this)
                val onMomentumEnd = craftNativeEventName(events, "onMomentumScrollEnd")
                if (onMomentumEnd.isNotBlank()) screen.scrollMomentumEndHandlers[this] = onMomentumEnd else screen.scrollMomentumEndHandlers.remove(this)
                val nativeScroll = this
                setScrollListeners(
                    onScroll = { scrollX, scrollY ->
                        screen.scrollHandlers[nativeScroll]?.let { current ->
                            val contentView = nativeScroll.content
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()
                                .put("contentOffset", JSONObject().put("x", scrollX).put("y", scrollY))
                                .put("contentSize", JSONObject().put("width", contentView.width).put("height", contentView.height))
                                .put("layoutMeasurement", JSONObject().put("width", nativeScroll.width).put("height", nativeScroll.height))))
                        }
                    },
                    onBeginDrag = {
                        screen.scrollBeginHandlers[nativeScroll]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                        }
                    },
                    onEndDrag = {
                        screen.scrollEndHandlers[nativeScroll]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                        }
                    },
                    onMomentumBegin = {
                        screen.scrollMomentumBeginHandlers[nativeScroll]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                        }
                    },
                    onMomentumEnd = {
                        screen.scrollMomentumEndHandlers[nativeScroll]?.let { current ->
                            send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                        }
                    },
                    keyboardDismissMode = craftNativeOptionalString(props.opt("keyboardDismissMode")).orEmpty(),
                    dismissKeyboard = {
                        (getSystemService(INPUT_METHOD_SERVICE) as? android.view.inputmethod.InputMethodManager)
                            ?.hideSoftInputFromWindow(nativeScroll.windowToken, 0)
                    },
                )
                val contentStyle = JSONObject(style.toString()).apply {
                    props.optJSONObject("contentContainerStyle")?.let { override ->
                        override.keys().forEach { key -> put(key, override.get(key)) }
                    }
                }
                configureContainer(content, contentStyle)
                // Content-style reconciliation configures the flex host again;
                // restore the scroll axis after it so horizontal children are
                // measured beyond the viewport rather than clamped to it.
                content.orientation = if (horizontal) LinearLayout.HORIZONTAL else LinearLayout.VERTICAL
                content.setUnboundedWidth(horizontal)
                val contentChildren = JSONArray()
                for (index in 0 until children.length()) {
                    val child = children.opt(index)
                    if (child !is JSONObject || canonicalType(child.optString("type")) != "RefreshControl") contentChildren.put(child)
                }
                reconcileChildren(screen, content, contentChildren, identity, next, contentStyle, previousControls)
                setStickyHeaderIndices(props.optJSONArray("stickyHeaderIndices"))
                setScrollTarget(props.opt("scrollTarget"))
            }
            "FlatList" -> (previous as? CraftNativeRefreshableFlatList ?: CraftNativeRefreshableFlatList(this)).apply {
                val nativeList = list
                val propRefresh = props.optJSONObject("refreshControl") ?: JSONObject()
                val propRefreshEvents = propRefresh.optJSONObject("events") ?: JSONObject()
                val refreshHandlerName = craftNativeEventName(propRefreshEvents, "onRefresh")
                    .takeIf { it.isNotBlank() }
                    ?: craftNativeEventName(events, "onRefresh").takeIf { it.isNotBlank() }
                configureRefresh(refreshHandlerName?.let { handler ->
                    { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", JSONObject())) }
                }, craftNativeBoolean(propRefresh.opt("refreshing"), craftNativeBoolean(props.opt("refreshing"))))
                setRefreshAppearance(propRefresh, refreshTintFallback(screen))
                nativeList.setKeyboardShouldPersistTaps(craftNativeOptionalString(props.opt("keyboardShouldPersistTaps")) ?: "never")
                nativeList.setContentContainerStyle(props.optJSONObject("contentContainerStyle"), resources.displayMetrics.density)
                nativeList.setKeyboardDismissMode(craftNativeOptionalString(props.opt("keyboardDismissMode")).orEmpty()) {
                    (getSystemService(INPUT_METHOD_SERVICE) as? android.view.inputmethod.InputMethodManager)
                        ?.hideSoftInputFromWindow(windowToken, 0)
                }
                reconcileFlatList(screen, nativeList, children, identity, protocolId ?: identity, props, events)
            }
            "View", "SafeAreaView" -> (previous as? CraftNativeFlexLayout ?: CraftNativeFlexLayout(this)).apply {
                configureContainer(this, style)
                if (type == "SafeAreaView") setSafeAreaEdges(props.optJSONArray("edges"))
                else setWindowSafeInsets(0, 0, 0, 0)
                reconcileChildren(screen, this, children, identity, next, style, previousControls)
            }
            "KeyboardAvoidingView" -> (previous as? CraftNativeKeyboardAvoidingView ?: CraftNativeKeyboardAvoidingView(this)).apply {
                configure(props, style, resources.displayMetrics.density)
                setKeyboardInset(keyboardInset)
                reconcileChildren(screen, content, children, identity, next, style, previousControls)
            }
            else -> (previous as? CraftNativeFlexLayout ?: CraftNativeFlexLayout(this)).apply {
                configureContainer(this, style)
                reconcileChildren(screen, this, children, identity, next, style, previousControls)
            }
        }
        if (control is CraftNativeFlexLayout) {
            control.configureCelebration(props.optJSONObject("celebration"), ((craftNativeNumber(style.opt("borderRadius")) ?: 0.0) * resources.displayMetrics.density).toFloat())
            control.onLayoutChanged = { if (screen.active) emitLayoutEvents(screen) }
        } else if (control is CraftNativeKeyboardAvoidingView) {
            control.content.onLayoutChanged = { if (screen.active) emitLayoutEvents(screen) }
        }
        val pressInHandler = craftNativeEventName(events, "onPressIn").takeIf { it.isNotBlank() }
        val pressOutHandler = craftNativeEventName(events, "onPressOut").takeIf { it.isNotBlank() }
        if (pressInHandler != null) screen.pressInHandlers[control] = pressInHandler else screen.pressInHandlers.remove(control)
        if (pressOutHandler != null) screen.pressOutHandlers[control] = pressOutHandler else screen.pressOutHandlers.remove(control)
        val underlayShowHandler = if (type == "TouchableHighlight") craftNativeEventName(events, "onShowUnderlay").takeIf { it.isNotBlank() } else null
        val underlayHideHandler = if (type == "TouchableHighlight") craftNativeEventName(events, "onHideUnderlay").takeIf { it.isNotBlank() } else null
        if (underlayShowHandler != null) screen.pressUnderlayShowHandlers[control] = underlayShowHandler else screen.pressUnderlayShowHandlers.remove(control)
        if (underlayHideHandler != null) screen.pressUnderlayHideHandlers[control] = underlayHideHandler else screen.pressUnderlayHideHandlers.remove(control)
        if (type != "Button" && type != "Link" && type != "Checkbox" && type != "TextInput" && type != "Picker" && type != "SegmentedControl" && type != "DatePicker" && type != "Modal" && type != "Switch" && type != "Slider" && type != "ActivityIndicator" && type != "KeyboardAvoidingView" && type != "StatusBar" && type != "RefreshControl" && type != "Map") {
            val handler = craftNativeEventName(events, "onPress", "onClick")
            val disabled = craftNativeBoolean(props.opt("disabled"))
            val target = listOf(props.opt("href"), props.opt("to"))
                .firstNotNullOfOrNull(::craftNativeOptionalString)
                ?.trim()
                ?.takeIf { !disabled && type in setOf("TouchableOpacity", "TouchableHighlight", "Pressable") }
            if (target != null) screen.linkTargets[control] = target else screen.linkTargets.remove(control)
            val hasUnderlay = type == "TouchableHighlight" && screen.pressUnderlayColors[control] != null
            val hasPressLifecycle = pressInHandler != null || pressOutHandler != null || hasUnderlay
            if ((handler.isNotBlank() || target != null || (type in setOf("TouchableOpacity", "TouchableHighlight", "Pressable") && hasPressLifecycle)) && !disabled) {
                if (handler.isNotBlank()) screen.handlers[control] = handler else screen.handlers.remove(control)
                control.isClickable = true
                if (type in setOf("TouchableOpacity", "TouchableHighlight", "Pressable")) {
                    control.setOnClickListener {
                        screen.linkTargets[it]?.let { target -> navigateOpen(target); return@setOnClickListener }
                        val current = screen.handlers[it] ?: return@setOnClickListener
                        send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                    }
                    control.setOnTouchListener { view, event ->
                        when (event.actionMasked) {
                            android.view.MotionEvent.ACTION_DOWN -> {
                                val active = screen.pressActiveOpacities[view] ?: 0.5f
                                val base = screen.pressBaseOpacities[view] ?: 1f
                                view.alpha = base * active
                                screen.pressUnderlayColors[view]?.let { view.background = ColorDrawable(it) }
                                screen.pressInHandlers[view]?.let { current ->
                                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                                }
                                screen.pressUnderlayShowHandlers[view]?.let { current ->
                                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                                }
                                true
                            }
                            android.view.MotionEvent.ACTION_UP, android.view.MotionEvent.ACTION_CANCEL -> {
                                view.alpha = screen.pressBaseOpacities[view] ?: 1f
                                if (screen.pressBaseBackgrounds.containsKey(view)) view.background = screen.pressBaseBackgrounds[view]
                                screen.pressOutHandlers[view]?.let { current ->
                                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                                }
                                screen.pressUnderlayHideHandlers[view]?.let { current ->
                                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                                }
                                if (event.actionMasked == android.view.MotionEvent.ACTION_UP) {
                                    screen.linkTargets[view]?.let { target -> navigateOpen(target); return@setOnTouchListener true }
                                    val current = screen.handlers[view] ?: return@setOnTouchListener true
                                    send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                                }
                                true
                            }
                            else -> true
                        }
                    }
                } else {
                    control.setOnTouchListener(null)
                    if (screen.pressBaseBackgrounds.containsKey(control)) control.background = screen.pressBaseBackgrounds[control]
                    control.setOnClickListener {
                        screen.linkTargets[control]?.let { target -> navigateOpen(target); return@setOnClickListener }
                        val current = screen.handlers[control] ?: return@setOnClickListener
                        send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                    }
                }
            } else {
                screen.handlers.remove(control)
                // Clearing a listener makes a View clickable again, so the
                // flag goes last: a clickable Text inside a pressable row
                // kept every tap from reaching the row.
                control.setOnClickListener(null)
                control.setOnTouchListener(null)
                control.isClickable = false
            }
            control.isEnabled = !disabled
        }
        val longPressDisabled = craftNativeBoolean(props.opt("disabled")) ||
            craftNativeBoolean(props.optJSONObject("accessibilityState")?.opt("disabled"))
        val longPressHandler = craftNativeEventName(events, "onLongPress").takeUnless { longPressDisabled } ?: ""
        if (longPressHandler.isNotBlank()) {
            screen.longPressHandlers[control] = longPressHandler
            control.setOnLongClickListener {
                val current = screen.longPressHandlers[control] ?: return@setOnLongClickListener false
                send(screen, "EVENT", JSONObject().put("handlerName", current).put("nativeEvent", JSONObject()))
                true
            }
        } else {
            screen.longPressHandlers.remove(control)
            control.setOnLongClickListener(null)
            control.isLongClickable = false
        }
        applyAccessibility(control, props, type, explicitKey ?: protocolId ?: path)
        // One element across an animated change (craft.animation.next).
        control.transitionName = craftNativeOptionalString(props.opt("transitionID"))?.takeIf { it.isNotBlank() }
        val layoutHandler = craftNativeEventName(events, "onLayout")
        if (layoutHandler.isNotBlank()) {
            if (screen.layoutHandlers[control] != layoutHandler) screen.lastLayoutBounds.remove(control)
            screen.layoutHandlers[control] = layoutHandler
            ensureLayoutListener(screen, control)
        } else {
            screen.layoutHandlers.remove(control)
            screen.lastLayoutBounds.remove(control)
            screen.layoutListeners.remove(control)?.let(control::removeOnLayoutChangeListener)
        }
        if (control is ImageView) imageErrors[control]?.let { message ->
            val current = control.contentDescription?.toString().orEmpty()
            if (!current.contains(message)) {
                control.contentDescription = listOf(current, message).filter { it.isNotBlank() }.joinToString(", ")
            }
        } else if (control is CraftNativeImageBackgroundView) imageErrors[control.image]?.let { message ->
            val current = control.contentDescription?.toString().orEmpty()
            if (!current.contains(message)) {
                control.contentDescription = listOf(current, message).filter { it.isNotBlank() }.joinToString(", ")
            }
        }
        protocolId?.let {
            screen.nodeViews[it] = control
            screen.nodePaths[it] = path
        }
        next[identity] = control
        protocolId?.let {
            next["id:$it"] = control
            screen.protocolIds[control] = it
        }
        applyViewStyle(control, style)
        if (type == "ActivityIndicator") {
            val animating = craftNativeBoolean(props.opt("animating"), true)
            val hidesWhenStopped = craftNativeBoolean(props.opt("hidesWhenStopped"), true)
            control.visibility = if (craftNativeOptionalString(style.opt("display")) == "none" || (!animating && hidesWhenStopped)) {
                View.GONE
            } else {
                View.VISIBLE
            }
        }
        val width = craftNativeFiniteDouble(style, "width", Double.NaN).takeUnless { it.isNaN() }?.let(::dp)
        val height = craftNativeFiniteDouble(style, "height", Double.NaN).takeUnless { it.isNaN() }?.let(::dp)
        control.layoutParams = LinearLayout.LayoutParams(
            width ?: ViewGroup.LayoutParams.WRAP_CONTENT,
            height ?: ViewGroup.LayoutParams.WRAP_CONTENT
        ).apply {
            val margin = craftNativeFiniteDouble(style, "margin", 0.0)
            val horizontal = craftNativeFiniteDouble(style, "marginHorizontal", margin)
            val vertical = craftNativeFiniteDouble(style, "marginVertical", margin)
            setMargins(
                dp(craftNativeFiniteDouble(style, "marginLeft", horizontal)),
                dp(craftNativeFiniteDouble(style, "marginTop", vertical)),
                dp(craftNativeFiniteDouble(style, "marginRight", horizontal)),
                dp(craftNativeFiniteDouble(style, "marginBottom", vertical))
            )
        }
        return control
    }

    private fun childText(children: JSONArray): String = buildString {
        for (index in 0 until children.length()) {
            val value = children.opt(index)
            if (value is String) append(value)
        }
    }

    private fun canonicalType(raw: String): String = when (raw.lowercase()) {
        "view" -> "View"
        "safeareaview" -> "SafeAreaView"
        "text" -> "Text"
        "button" -> "Button"
        "link" -> "Link"
        "checkbox" -> "Checkbox"
        "textinput", "input" -> "TextInput"
        "segmentedcontrol", "segmented-control" -> "SegmentedControl"
        "picker", "select" -> "Picker"
        "datepicker", "date-picker", "date" -> "DatePicker"
        "modal" -> "Modal"
        "switch" -> "Switch"
        "slider" -> "Slider"
        "activityindicator" -> "ActivityIndicator"
        "statusbar" -> "StatusBar"
        "refreshcontrol" -> "RefreshControl"
        "image" -> "Image"
        "imagebackground" -> "ImageBackground"
        "keyboardavoidingview" -> "KeyboardAvoidingView"
        "video" -> "Video"
        "map" -> "Map"
        "icon" -> "Icon"
        "scrollview" -> "ScrollView"
        "sectionlist" -> "SectionList"
        "flatlist" -> "FlatList"
        "svg" -> "Svg"
        "g" -> "G"
        "svgtext", "svg-text" -> "SvgText"
        "touchableopacity" -> "TouchableOpacity"
        "touchablehighlight" -> "TouchableHighlight"
        "pressable" -> "Pressable"
        else -> raw
    }

    private fun authoredKey(node: JSONObject, props: JSONObject): String? {
        val direct = listOf(node.optString("key"), props.optString("key"))
            .firstOrNull { it.isNotBlank() }
        if (direct != null) return direct
        return null
    }

    private fun configureContainer(layout: CraftNativeFlexLayout, style: JSONObject) {
        layout.configure(style, resources.displayMetrics.density)
    }

    private fun craftNativeResizeMode(style: JSONObject, props: JSONObject): String {
        return craftNativeOptionalString(style.opt("resizeMode"))
            ?: craftNativeOptionalString(props.opt("resizeMode")).orEmpty()
    }

    private fun flatListScrollEvent(list: CraftNativeFlatList): JSONObject = JSONObject()
        .put("contentOffset", JSONObject()
            .put("x", list.computeHorizontalScrollOffset())
            .put("y", list.computeVerticalScrollOffset()))
        .put("contentSize", JSONObject()
            .put("width", list.computeHorizontalScrollRange())
            .put("height", list.computeVerticalScrollRange()))
        .put("layoutMeasurement", JSONObject()
            .put("width", list.width)
            .put("height", list.height))

    private fun reconcileChildren(
        screen: Screen,
        layout: CraftNativeFlexLayout,
        children: JSONArray,
        path: String,
        next: MutableMap<String, View>,
        style: JSONObject,
        previousControls: Map<String, View>,
    ) {
        for (index in layout.childCount - 1 downTo 0) {
            if (layout.getChildAt(index) is CraftNativeFlexSpacer) layout.removeViewAt(index)
        }
        val desired = mutableListOf<View>()
        val desiredOrder = mutableMapOf<View, Int>()
        for (index in 0 until children.length()) {
            val child = children.opt(index)
            val childView = when (child) {
                is JSONObject -> makeView(screen, child, "$path.$index", next, previousControls)
                is String -> TextView(this).apply {
                    includeFontPadding = false
                    configureText(this, child, craftNativeTypography(style))
                }
                else -> null
            }
            if (childView != null) desired.add(childView)
            if (childView != null && child is JSONObject) {
                val childStyle = child.optJSONObject("style") ?: JSONObject()
                layout.setChildStyle(childView, childStyle, resources.displayMetrics.density)
                desiredOrder[childView] = craftNativeFiniteNumber(childStyle, "order", 0.0).toInt()
            }
        }
        desired.sortWith(compareBy { desiredOrder[it] ?: 0 })
        if (craftNativeOptionalString(style.opt("flexDirection"))?.endsWith("-reverse") == true) desired.reverse()
        val desiredSet = desired.toSet()
        for (index in layout.childCount - 1 downTo 0) {
            if (layout.getChildAt(index) !in desiredSet) layout.removeViewAt(index)
        }
        for (childView in desired) {
            if (childView.parent !== layout) {
                (childView.parent as? ViewGroup)?.removeView(childView)
                layout.addView(childView)
            }
            val params = childView.layoutParams as? LinearLayout.LayoutParams
                ?: LinearLayout.LayoutParams(childView.layoutParams?.width ?: -1, childView.layoutParams?.height ?: -2)
            childView.layoutParams = params
        }
        // Reorder attached children without removing their focused inputs.
        // Removing and adding an existing row clears Android's native focus.
        if (desired.indices.any { layout.getChildAt(it) !== desired[it] }) {
            desired.forEach(layout::bringChildToFront)
        }
        layout.requestLayout()
    }

    private fun reconcileFlatList(
        screen: Screen,
        list: CraftNativeFlatList,
        children: JSONArray,
        path: String,
        owner: String,
        props: JSONObject,
        events: JSONObject,
    ) {
        screen.flatListOwners.entries.removeAll { it.value == owner }
        screen.flatListOwnerByView[list] = owner
        list.onLayoutChanged = {
            if (screen.active) emitLayoutEvents(screen)
        }
        list.onContentSizeChanged = {
            if (screen.active) CraftNativeFlexLayout.invalidateMeasurementAncestors(list.parent)
        }
        val nodes = (0 until children.length()).mapNotNull { children.optJSONObject(it) }
        nodes.forEach { registerFlatListOwnership(screen, it, owner) }
        list.onScrollEvent = craftNativeEventName(events, "onScroll").takeIf { it.isNotBlank() }?.let { handler ->
            { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", flatListScrollEvent(list))) }
        }
        list.onScrollBeginDrag = craftNativeEventName(events, "onScrollBeginDrag").takeIf { it.isNotBlank() }?.let { handler ->
            { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", flatListScrollEvent(list))) }
        }
        list.onScrollEndDrag = craftNativeEventName(events, "onScrollEndDrag").takeIf { it.isNotBlank() }?.let { handler ->
            { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", flatListScrollEvent(list))) }
        }
        list.onMomentumScrollBegin = craftNativeEventName(events, "onMomentumScrollBegin").takeIf { it.isNotBlank() }?.let { handler ->
            { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", flatListScrollEvent(list))) }
        }
        list.onMomentumScrollEnd = craftNativeEventName(events, "onMomentumScrollEnd").takeIf { it.isNotBlank() }?.let { handler ->
            { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", flatListScrollEvent(list))) }
        }
        val threshold = craftNativeNonNegativeDouble(props, "threshold", 0.1)
        val authoredThreshold = craftNativeNonNegativeDouble(props, "onEndReachedThreshold", threshold)
        val horizontal = craftNativeBoolean(props.opt("horizontal"))
        list.apply(
            nodes = nodes,
            horizontal = horizontal,
            columns = craftNativeInt(props.opt("numColumns"), 1),
            inverted = craftNativeBoolean(props.opt("inverted")),
            endReachedThreshold = authoredThreshold,
            renderItem = { node, itemIdentity, _ ->
                val rows = screen.flatListRows.getOrPut(list) { mutableMapOf() }
                val previous = rows[itemIdentity].orEmpty()
                val next = mutableMapOf<String, View>()
                val view = makeView(screen, node, "$path.$itemIdentity", next, previous)
                releaseViewState(screen, previous.values.filter { it !in next.values })
                rows[itemIdentity] = next
                view
            },
            recycleItem = { itemIdentity ->
                val controls = screen.flatListRows[list]?.remove(itemIdentity).orEmpty()
                releaseViewState(screen, controls.values.toList(), preservingInputDrafts = true)
            },
            removeItem = { itemIdentity ->
                val controls = screen.flatListRows[list]?.remove(itemIdentity).orEmpty()
                releaseViewState(screen, controls.values.toList(), preservingInputDrafts = false)
            },
            endReached = craftNativeEventName(events, "onEndReached").takeIf { it.isNotBlank() }?.let { handler ->
                { send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", JSONObject())) }
            },
        )
        list.setScrollIndicators(
            craftNativeBoolean(props.opt("showsVerticalScrollIndicator"), true),
            craftNativeBoolean(props.opt("showsHorizontalScrollIndicator"), true),
        )
        list.setScrollEnabled(craftNativeBoolean(props.opt("scrollEnabled"), true))
        list.setPagingEnabled(craftNativeBoolean(props.opt("pagingEnabled")))
        list.setScrollTarget(props.opt("scrollTarget"))
        list.setBounceOptions(
            craftNativeBoolean(props.opt("bounces"), true),
            craftNativeBoolean(props.opt("alwaysBounceVertical"), !horizontal),
            craftNativeBoolean(props.opt("alwaysBounceHorizontal"), horizontal),
        )
    }

    private fun registerFlatListOwnership(screen: Screen, node: JSONObject, owner: String) {
        val props = node.optJSONObject("props") ?: JSONObject()
        listOf(node.optString("id"), node.optString("key"), props.optString("key"), props.optString("testID"))
            .filter { it.isNotBlank() }
            .forEach { screen.flatListOwners[it] = owner }
        val children = node.optJSONArray("children") ?: JSONArray()
        for (index in 0 until children.length()) {
            children.optJSONObject(index)?.let { registerFlatListOwnership(screen, it, owner) }
        }
    }

    private fun addJustificationSpacers(layout: CraftNativeFlexLayout, value: String) { }

    private fun applyViewStyle(view: View, style: JSONObject) {
        view.alpha = craftNativeFiniteFloat(style, "opacity", 1f)
        // A Text's padding (`px-4` on a line of text) is where its text
        // starts, as on iOS; containers and fields lay out their own.
        if (view is TextView && view !is EditText && view !is CraftNativeIconView) {
            val keys = listOf("padding", "paddingHorizontal", "paddingVertical", "paddingLeft", "paddingRight", "paddingTop", "paddingBottom")
            if (keys.any(style::has)) {
                val density = resources.displayMetrics.density
                val all = craftNativePadding(style, "padding", 0, density)
                val horizontal = craftNativePadding(style, "paddingHorizontal", all, density)
                val vertical = craftNativePadding(style, "paddingVertical", all, density)
                view.setPadding(
                    craftNativePadding(style, "paddingLeft", horizontal, density),
                    craftNativePadding(style, "paddingTop", vertical, density),
                    craftNativePadding(style, "paddingRight", horizontal, density),
                    craftNativePadding(style, "paddingBottom", vertical, density),
                )
            } else if (view.javaClass == TextView::class.java || view.javaClass == Button::class.java) {
                // Plain Android buttons start with zero padding in the native
                // contract. A keyed button may lose a reactive padding style;
                // clear that old value just as iOS reapplies its padding every
                // reconciliation.
                view.setPadding(0, 0, 0, 0)
            }
        }
        applyTransform(view, style.optJSONArray("transform"))
        if (view !is CraftNativeModalView) {
            view.visibility = if (craftNativeOptionalString(style.opt("display")) == "none") View.GONE else View.VISIBLE
        }
        view.elevation = dp(craftNativeNonNegativeDouble(style, "elevation", 0.0)).toFloat()
        view.z = craftNativeFiniteFloat(style, "zIndex", 0f)
        val background = style.has("backgroundColor") && !style.isNull("backgroundColor")
        // VideoView's Surface is behind this window. An opaque View
        // background paints over the decoded picture (only rounded corners
        // showed it). Keep the outline/borders, with a transparent fill.
        val backgroundColor = if (view is CraftNativeVideoView) Color.TRANSPARENT
            else color(craftNativeOptionalString(style.opt("backgroundColor")).orEmpty(), Color.TRANSPARENT)
        val border = craftNativeNonNegativeDouble(style, "borderWidth", 0.0)
        val radius = craftNativeNonNegativeDouble(style, "borderRadius", 0.0)
        val gradientDirection = craftNativeOptionalString(style.opt("gradientDirection"))
        val gradientFrom = craftNativeOptionalString(style.opt("gradientFrom"))
        val gradientVia = craftNativeOptionalString(style.opt("gradientVia"))
        val gradientTo = craftNativeOptionalString(style.opt("gradientTo"))
        val gradientColors = if (gradientDirection != null && gradientFrom != null && gradientTo != null) {
            listOfNotNull(
                color(gradientFrom, Color.TRANSPARENT),
                gradientVia?.let { color(it, Color.TRANSPARENT) },
                color(gradientTo, Color.TRANSPARENT),
            ).toIntArray()
        } else null
        val sideBorderKeys = listOf("borderTopWidth", "borderRightWidth", "borderBottomWidth", "borderLeftWidth")
        val hasSideBorders = (sideBorderKeys + listOf("borderTopColor", "borderRightColor", "borderBottomColor", "borderLeftColor")).any(style::has)
        val sideWidths = sideBorderKeys.map { dp(craftNativeNonNegativeDouble(style, it, border)) }.toIntArray()
        val cornerRadiusKeys = listOf("borderTopLeftRadius", "borderTopRightRadius", "borderBottomRightRadius", "borderBottomLeftRadius")
        val hasCornerRadii = cornerRadiusKeys.any(style::has)
        val cornerRadii = cornerRadiusKeys.flatMap { value ->
            val radius = dp(craftNativeNonNegativeDouble(style, value, radius)).toFloat()
            listOf(radius, radius)
        }.toFloatArray()
        val sideColors = listOf("borderTopColor", "borderRightColor", "borderBottomColor", "borderLeftColor")
            .map { color(craftNativeOptionalString(style.opt(it)) ?: craftNativeOptionalString(style.opt("borderColor")).orEmpty(), Color.TRANSPARENT) }
            .toIntArray()
        val defaultBackground = if (defaultBackgrounds.containsKey(view)) {
            defaultBackgrounds[view]
        } else {
            view.background.also { defaultBackgrounds[view] = it }
        }
        if (background || border > 0 || radius > 0 || hasSideBorders || gradientColors != null) {
            if (hasSideBorders) {
                view.background = CraftNativeSideBorderDrawable(
                    backgroundColor,
                    cornerRadii,
                    sideWidths,
                    sideColors,
                    craftNativeOptionalString(style.opt("borderStyle"))?.takeIf { it == "dashed" || it == "dotted" },
                    gradientDirection,
                    gradientColors,
                )
            } else {
                view.background = GradientDrawable().apply {
                    if (gradientColors != null) {
                        orientation = craftNativeGradientOrientation(gradientDirection)
                        colors = gradientColors
                    } else setColor(backgroundColor)
                    if (hasCornerRadii) setCornerRadii(cornerRadii) else cornerRadius = dp(radius).toFloat()
                    if (border > 0) {
                        val borderColor = color(craftNativeOptionalString(style.opt("borderColor")).orEmpty(), Color.TRANSPARENT)
                        when (craftNativeOptionalString(style.opt("borderStyle"))) {
                            "dashed" -> setStroke(dp(border), borderColor, dp(border * 3).toFloat(), dp(border * 2).toFloat())
                            "dotted" -> setStroke(dp(border), borderColor, dp(border).toFloat(), dp(border * 1.5).toFloat())
                            else -> setStroke(dp(border), borderColor)
                        }
                    }
                }
            }
        } else view.background = if (view is EditText && style.has("borderWidth")) {
            // `border-0` on a field: no Material underline either, as on iOS
            // and the web.
            null
        } else defaultBackground
        val overflow = craftNativeOptionalString(style.opt("overflow"))
        // A replaced image clips its own pixels to border-radius, including
        // when its surrounding layout permits visible overflow.
        view.clipToOutline = overflow == "hidden" || (view is ImageView && (radius > 0 || hasCornerRadii))
        if (view is ViewGroup) view.clipChildren = overflow == "hidden"
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P &&
            (style.has("shadowColor") || style.has("shadowOpacity") || style.has("shadowRadius"))
        ) {
            val shadowOpacity = craftNativeFiniteFloat(style, "shadowOpacity", 1f).coerceIn(0f, 1f)
            val shadow = color(craftNativeOptionalString(style.opt("shadowColor")).orEmpty(), Color.BLACK)
            val alphaShadow = Color.argb((Color.alpha(shadow) * shadowOpacity).roundToInt(), Color.red(shadow), Color.green(shadow), Color.blue(shadow))
            view.outlineAmbientShadowColor = alphaShadow
            view.outlineSpotShadowColor = alphaShadow
            val shadowRadius = craftNativeNonNegativeDouble(style, "shadowRadius", 0.0)
            view.elevation = max(view.elevation, dp(shadowRadius * 2.0).toFloat())
            val offset = style.optJSONObject("shadowOffset")
            val offsetX = dp(craftNativeFiniteDouble(offset, "width", 0.0))
            val offsetY = dp(craftNativeFiniteDouble(offset, "height", 0.0))
            val radius = dp(shadowRadius).toFloat()
            view.outlineProvider = object : ViewOutlineProvider() {
                override fun getOutline(target: View, outline: Outline) {
                    outline.setRoundRect(offsetX, offsetY, target.width + offsetX, target.height + offsetY, radius)
                }
            }
            view.invalidateOutline()
        } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            view.outlineProvider = ViewOutlineProvider.BACKGROUND
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                // A retained view may lose an authored shadow while keeping
                // its native object. Restore Android's default outline colors
                // too; otherwise a later elevation-only style inherits the
                // previous shadow's custom ambient/spot tint.
                view.outlineAmbientShadowColor = Color.BLACK
                view.outlineSpotShadowColor = Color.BLACK
                view.invalidateOutline()
            }
        }
        if (view is ImageView) {
            val tint = style.opt("tintColor") as? String
            val resolvedTint = tint
                ?.takeUnless { it.isBlank() || it == "null" || it == "undefined" }
                ?.let { runCatching { craftNativeColor(it) }.getOrNull() }
            if (resolvedTint == null) {
                view.clearColorFilter()
            } else {
                view.setColorFilter(resolvedTint)
            }
        }
    }

    private fun applyTransform(view: View, transforms: JSONArray?) {
        view.translationX = 0f
        view.translationY = 0f
        // Reconciliation reapplies transforms; start from the control's
        // intrinsic scale rather than erasing its authored indicator size.
        val intrinsicScale = (view as? CraftNativeActivityIndicator)?.indicatorScale ?: 1f
        view.scaleX = intrinsicScale
        view.scaleY = intrinsicScale
        view.rotation = 0f
        view.rotationX = 0f
        view.rotationY = 0f
        CraftNativeSkewTransforms.clear(view)
        if (transforms == null) return
        var skewX = 0f
        var skewY = 0f
        for (index in 0 until transforms.length()) {
            val transform = transforms.optJSONObject(index) ?: continue
            val key = transform.keys().asSequence().firstOrNull() ?: continue
            when (key) {
                "translateX" -> view.translationX += dp(craftNativeFiniteDouble(transform, key, 0.0)).toFloat()
                "translateY" -> view.translationY += dp(craftNativeFiniteDouble(transform, key, 0.0)).toFloat()
                "scale" -> craftNativeFiniteDouble(transform, key, 1.0).toFloat().let { view.scaleX *= it; view.scaleY *= it }
                "scaleX" -> view.scaleX *= craftNativeFiniteDouble(transform, key, 1.0).toFloat()
                "scaleY" -> view.scaleY *= craftNativeFiniteDouble(transform, key, 1.0).toFloat()
                "rotate", "rotateZ" -> view.rotation += angleDegrees(transform.opt(key))
                "rotateX" -> view.rotationX += angleDegrees(transform.opt(key))
                "rotateY" -> view.rotationY += angleDegrees(transform.opt(key))
                "skewX" -> skewX += skewFactor(transform.opt(key))
                "skewY" -> skewY += skewFactor(transform.opt(key))
            }
        }
        CraftNativeSkewTransforms.set(view, skewX, skewY)
    }

    private fun skewFactor(value: Any?): Float =
        kotlin.math.tan(angleDegrees(value).toDouble() * PI / 180.0).toFloat().takeIf { it.isFinite() } ?: 0f

    private fun angleDegrees(value: Any?): Float {
        val text = value?.toString()?.trim() ?: return 0f
        val result = when {
            text.endsWith("rad") -> Math.toDegrees(text.dropLast(3).toDoubleOrNull() ?: 0.0).toFloat()
            text.endsWith("deg") -> text.dropLast(3).toFloatOrNull() ?: 0f
            else -> text.toFloatOrNull() ?: 0f
        }
        return result.takeIf { it.isFinite() } ?: 0f
    }

    private fun ensureLayoutListener(screen: Screen, view: View) {
        if (screen.layoutListeners.containsKey(view)) return
        val listener = View.OnLayoutChangeListener { changed, left, top, right, bottom, _, _, _, _ ->
            if (screen.active) emitLayoutEvent(screen, changed, left, top, right, bottom)
        }
        screen.layoutListeners[view] = listener
        view.addOnLayoutChangeListener(listener)
    }

    private fun configureText(view: TextView, value: String, style: JSONObject) {
        view.text = when (craftNativeOptionalString(style.opt("textTransform"))) {
            "uppercase" -> value.uppercase()
            "lowercase" -> value.lowercase()
            "capitalize" -> value.split(' ').joinToString(" ") { word -> word.replaceFirstChar(Char::uppercase) }
            else -> value
        }
        configureTextStyle(view, style)
    }

    /**
     * Raw strings inside a native container are implicit Text nodes. Keep
     * their typography, but not the parent's padding or layout, just like
     * the iOS reconciler does for the same child shape.
     */
    private fun craftNativeTypography(style: JSONObject): JSONObject = JSONObject().also { typography ->
        listOf(
            "color", "letterSpacing", "lineHeight", "fontSize", "fontFamily",
            "fontWeight", "fontStyle", "textAlign", "textTransform",
            "textDecorationLine", "textDecorationStyle", "textDecorationColor",
            "textShadowColor", "textShadowRadius", "textShadowOffset",
        ).forEach { key ->
            if (style.has(key) && !style.isNull(key)) typography.put(key, style.opt(key))
        }
    }

    private fun configureIcon(view: CraftNativeIconView, props: JSONObject, style: JSONObject) {
        val symbol = craftNativeOptionalString(props.opt("symbol"))
            ?: craftNativeOptionalString(props.opt("name")).orEmpty()
        val size = craftNativeFiniteFloat(style, "fontSize", 20f).coerceAtLeast(1f)
        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, size)
        val foreground = craftNativeOptionalString(style.opt("color"))
            ?: craftNativeOptionalString(props.opt("color")).orEmpty()
        val tint = color(foreground, defaultTextColor)
        view.setTextColor(tint)
        // The app's own vector for it (craft-icons.json, the icon the web
        // shows), else the closest glyph Android's fonts have.
        val vector = CraftNativeIcons.drawable(
            this,
            craftNativeOptionalString(props.opt("name")).orEmpty(),
            craftNativeOptionalString(props.opt("symbol")).orEmpty(),
            tint,
        )
        view.vector = vector
        view.text = if (vector != null) "" else androidIconGlyph(symbol)
        val weight = when (craftNativeFontWeight(style.opt("fontWeight"))) {
            "100" -> 100
            "200" -> 200
            "300" -> 300
            "500" -> 500
            "600" -> 600
            "bold", "700" -> 700
            "800" -> 800
            "900" -> 900
            else -> 400
        }
        view.typeface = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            Typeface.create(Typeface.create("sans-serif", Typeface.NORMAL), weight, false)
        } else {
            Typeface.create("sans-serif", if (weight >= 600) Typeface.BOLD else Typeface.NORMAL)
        }
        val hasExplicitWidth = style.has("width") && !style.isNull("width")
        val hasExplicitHeight = style.has("height") && !style.isNull("height")
        if (!hasExplicitWidth && !hasExplicitHeight) {
            val box = dp(size.toDouble())
            view.minimumWidth = box
            view.minimumHeight = box
        } else {
            // A retained icon may move from the implicit square to an
            // explicitly sized layout. Do not let the old minimum constrain
            // the authored dimensions.
            view.minimumWidth = 0
            view.minimumHeight = 0
        }
    }

    private fun androidIconGlyph(symbol: String): String = when (symbol) {
        "arrow.left" -> "←"
        "arrow.right" -> "→"
        "arrow.up" -> "↑"
        "arrow.down" -> "↓"
        "chevron.left" -> "‹"
        "chevron.right" -> "›"
        "chevron.up" -> "⌃"
        "chevron.down" -> "⌄"
        "plus" -> "+"
        "minus" -> "−"
        "xmark" -> "×"
        "checkmark" -> "✓"
        "house", "house.fill" -> "⌂"
        "magnifyingglass" -> "⌕"
        "gear", "gearshape" -> "⚙"
        "heart" -> "♡"
        "heart.fill" -> "♥"
        "star" -> "☆"
        "star.fill" -> "★"
        "sun.max" -> "☼"
        "moon" -> "☾"
        "info.circle", "info.circle.fill" -> "ⓘ"
        "questionmark.circle", "questionmark.circle.fill" -> "?"
        "exclamationmark.triangle", "exclamationmark.triangle.fill" -> "⚠"
        "play", "play.fill" -> "▶"
        "pause", "pause.fill" -> "Ⅱ"
        "stop", "stop.fill" -> "■"
        "camera" -> "▣"
        "circle" -> "○"
        "circle.fill" -> "●"
        else -> "○"
    }

    private fun configureTextStyle(view: TextView, style: JSONObject) {
        view.setTextColor(color(craftNativeOptionalString(style.opt("color")).orEmpty(), defaultTextColor))
        view.setTextSize(TypedValue.COMPLEX_UNIT_SP, craftNativeFiniteFloat(style, "fontSize", 16f))
        val fontWeight = craftNativeFontWeight(style.opt("fontWeight"))
        val weight = when (fontWeight) {
            "bold" -> 700
            "100", "200", "300", "400", "500", "600", "700", "800", "900" -> style.optInt("fontWeight")
            else -> 400
        }
        val italic = craftNativeOptionalString(style.opt("fontStyle")) == "italic"
        val family = craftNativeOptionalString(style.opt("fontFamily"))?.takeIf { it.isNotBlank() }
        val base = craftNativeFontFamily(family, bundledFonts)
        view.typeface = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
            Typeface.create(base, weight, italic)
        } else Typeface.create(base, (if (weight >= 600) Typeface.BOLD else Typeface.NORMAL) or
            (if (italic) Typeface.ITALIC else Typeface.NORMAL))
        val textAlign = craftNativeOptionalString(style.opt("textAlign"))
        view.textAlignment = when (textAlign) {
            "left" -> View.TEXT_ALIGNMENT_TEXT_START
            "right" -> View.TEXT_ALIGNMENT_TEXT_END
            "center" -> View.TEXT_ALIGNMENT_CENTER
            "justify" -> View.TEXT_ALIGNMENT_VIEW_START
            else -> View.TEXT_ALIGNMENT_INHERIT
        }
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            view.justificationMode = if (textAlign == "justify") {
                Layout.JUSTIFICATION_MODE_INTER_WORD
            } else {
                Layout.JUSTIFICATION_MODE_NONE
            }
        }
        view.letterSpacing = craftNativeFiniteDouble(style, "letterSpacing", Double.NaN)
            .takeIf { it.isFinite() }
            ?.let { if (view.textSize > 0) dp(it).toFloat() / view.textSize else 0f }
            ?: 0f
        view.setLineSpacing(
            craftNativeFiniteDouble(style, "lineHeight", Double.NaN).takeIf { it.isFinite() }?.let { dp(it) - view.textSize } ?: 0f,
            1f
        )
        val shadowColor = craftNativeOptionalString(style.opt("textShadowColor"))?.takeIf { it.isNotBlank() }
        if (shadowColor == null) {
            view.paint.clearShadowLayer()
        } else {
            val offset = style.optJSONObject("textShadowOffset")
            view.setShadowLayer(
                dp(craftNativeFiniteDouble(style, "textShadowRadius", 0.0)).toFloat().coerceAtLeast(0f),
                dp(craftNativeFiniteDouble(offset, "width", 0.0)).toFloat(),
                dp(craftNativeFiniteDouble(offset, "height", 0.0)).toFloat(),
                color(shadowColor, Color.TRANSPARENT),
            )
        }
        view.paintFlags = view.paintFlags and Paint.UNDERLINE_TEXT_FLAG.inv() and Paint.STRIKE_THRU_TEXT_FLAG.inv()
        applyTextDecoration(view, style)
    }

    private fun applyTextDecoration(view: TextView, style: JSONObject) {
        val line = craftNativeOptionalString(style.opt("textDecorationLine")).orEmpty()
        if (view is EditText) {
            // A field's own text, spanned in place: replacing it would move
            // the caret to the start and tell the screen the text changed.
            val editable = view.text ?: return
            editable.getSpans(0, editable.length, CraftTextDecorationSpan::class.java).forEach(editable::removeSpan)
            if (line.isBlank() || line == "none" || editable.isEmpty()) return
            val fieldColor = craftNativeOptionalString(style.opt("textDecorationColor"))?.takeIf { it.isNotBlank() }?.let { color(it, Color.TRANSPARENT) }
            editable.setSpan(
                CraftTextDecorationSpan(line, craftNativeOptionalString(style.opt("textDecorationStyle")).orEmpty().ifBlank { "solid" }, fieldColor),
                0,
                editable.length,
                Spannable.SPAN_INCLUSIVE_INCLUSIVE,
            )
            return
        }
        val text = view.text?.toString() ?: return
        if (line.isBlank() || line == "none" || text.isEmpty()) {
            if (view.text is Spannable) view.text = text
            return
        }
        val decorationColor = craftNativeOptionalString(style.opt("textDecorationColor")).orEmpty()
            .takeIf { it.isNotBlank() }
            ?.let { color(it, Color.TRANSPARENT) }
        val decorated = SpannableString(text)
        decorated.setSpan(
            CraftTextDecorationSpan(
                line,
                craftNativeOptionalString(style.opt("textDecorationStyle")).orEmpty().ifBlank { "solid" },
                decorationColor,
            ),
            0,
            decorated.length,
            Spannable.SPAN_EXCLUSIVE_EXCLUSIVE,
        )
        view.text = decorated
    }

    /**
     * Match iOS image loading: HTTPS is allowed everywhere, while plain HTTP
     * is limited to loopback/development hosts. Android's generated manifest
     * enables cleartext traffic only for the corresponding dev-server or
     * local-network configurations.
     */
    private fun loadsImage(uri: Uri): Boolean {
        val scheme = uri.scheme?.lowercase() ?: return false
        if (scheme == "https") return true
        if (scheme != "http") return false
        val host = uri.host?.lowercase() ?: return false
        return host == "localhost" || host == "127.0.0.1" || host == "10.0.2.2" ||
            host == "::1" || host.endsWith(".localhost")
    }

    /** Resolve app paths against the configured site; bare names stay assets. */
    private fun imageURI(uri: String): String {
        if (!uri.startsWith("/")) return uri
        val base = config.optString("devServerURL").takeIf { it.isNotBlank() } ?: return uri
        return runCatching { URI(base).resolve(uri).toString() }.getOrDefault(uri)
    }

    private fun imageUri(source: Any?): String = when (source) {
        is String -> source
        is JSONObject -> craftNativeOptionalString(source.opt("uri")).orEmpty()
        else -> ""
    }

    private fun imageHeaders(source: Any?): Map<String, String> {
        val objectSource = source as? JSONObject ?: return emptyMap()
        val raw = objectSource.optJSONObject("headers") ?: return emptyMap()
        return linkedMapOf<String, String>().apply {
            raw.keys().forEach { name -> craftNativeOptionalString(raw.opt(name))?.let { put(name, it) } }
        }
    }

    private fun imageRequestKey(uri: String, headers: Map<String, String>): String =
        uri + "\u0000" + headers.toSortedMap().entries.joinToString("\u0000") { "${it.key}=${it.value}" }

    private fun immediateImage(uri: String): Bitmap? {
        if (uri.startsWith("data:image/") && uri.contains(',')) {
            val bytes = runCatching { Base64.decode(uri.substringAfter(','), Base64.DEFAULT) }.getOrNull()
            return bytes?.let { BitmapFactory.decodeByteArray(it, 0, it.size) }
        }
        if (!uri.contains(':')) return runCatching { assets.open(uri).use { BitmapFactory.decodeStream(it) } }.getOrNull()
        return null
    }

    private fun updateImage(screen: Screen, view: ImageView, source: Any?, defaultSource: Any? = null) {
        val uri = imageUri(source)
        val requestUri = imageURI(uri)
        val headers = imageHeaders(source)
        val requestKey = imageRequestKey(uri, headers)
        if (uri.isBlank()) {
            if (imageSources[view] == "") return
            imageJobs.remove(view)?.cancel(true)
            imageSources[view] = ""
            imageErrors[view] = "Image source is missing"
            view.setImageDrawable(null)
            imageDidChange(view)
            imageFailure(screen, view, uri, "Image source is missing")
            return
        }
        if (imageSources[view] == requestKey) return
        imageJobs.remove(view)?.cancel(true)
        imageSources[view] = requestKey
        imageErrors.remove(view)
        view.setImageDrawable(null)
        imageDidChange(view)
        immediateImage(imageUri(defaultSource))?.let(view::setImageBitmap)
        if (view.drawable != null) imageDidChange(view)
        emitImageEvent(screen, view, screen.imageLoadStartHandlers[view])

        if (uri.startsWith("data:image/") && uri.contains(',')) {
            val bytes = runCatching { Base64.decode(uri.substringAfter(','), Base64.DEFAULT) }.getOrNull()
            val bitmap = bytes?.let { BitmapFactory.decodeByteArray(it, 0, it.size) }
            if (bitmap != null) {
                view.setImageBitmap(bitmap)
                imageDidChange(view)
                emitImageEvent(screen, view, screen.imageLoadHandlers[view])
                emitImageEvent(screen, view, screen.imageLoadEndHandlers[view])
            } else imageFailure(screen, view, uri, "Image data is invalid")
            return
        }
        if (!uri.startsWith("/") && !uri.contains(':')) {
            val bitmap = runCatching { assets.open(uri).use { BitmapFactory.decodeStream(it) } }.getOrNull()
            if (bitmap != null) {
                view.setImageBitmap(bitmap)
                imageDidChange(view)
                emitImageEvent(screen, view, screen.imageLoadHandlers[view])
                emitImageEvent(screen, view, screen.imageLoadEndHandlers[view])
            } else imageFailure(screen, view, uri, "Bundled image was not found")
            return
        }
        if (!loadsImage(Uri.parse(requestUri))) {
            if (uri.startsWith("/")) imageFailure(screen, view, uri, "Relative image source requires devServerURL")
            else imageFailure(screen, view, uri, "Unsupported image source")
            return
        }
        imageJobs[view] = imageExecutor.submit {
            val bitmap = runCatching {
                val publicRequest = headers.isEmpty() && Uri.parse(requestUri).userInfo.isNullOrEmpty()
                if (publicRequest) {
                    val bytes = imageCache.read(requestUri)
                    if (bytes != null) {
                        val saved = BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
                        if (saved != null) return@runCatching saved
                        imageCache.remove(requestUri)
                    }
                }
                val connection = (URL(requestUri).openConnection() as HttpURLConnection).apply {
                    connectTimeout = 10_000
                    readTimeout = 10_000
                    // This loader owns its bounded public cache. Do not let
                    // an application's global ResponseCache retain requests.
                    useCaches = false
                    headers.forEach { (name, value) -> setRequestProperty(name, value) }
                }
                try {
                    val downloaded = connection.inputStream.use(BitmapFactory::decodeStream)
                    if (publicRequest) {
                        val responseHeaders = connection.headerFields.entries.filter { it.key != null }
                            .associate { it.key!! to it.value.orEmpty() }
                        val policy = if (connection.responseCode == HttpURLConnection.HTTP_OK)
                            craftNativeImagePolicy(headers, responseHeaders, System.currentTimeMillis()) else null
                        if (downloaded != null && policy != null) {
                            // Encode only after a complete decode, then commit
                            // before onLoad so a cold offline reopen is safe.
                            imageCache.write(requestUri, policy) { downloaded.compress(Bitmap.CompressFormat.PNG, 100, it) }
                        } else imageCache.remove(requestUri)
                    }
                    downloaded
                } finally { connection.disconnect() }
            }.getOrNull()
            runOnUiThread {
                if (imageSources[view] != requestKey) return@runOnUiThread
                imageJobs.remove(view)
                if (bitmap != null) {
                    view.setImageBitmap(bitmap)
                    imageDidChange(view)
                    emitImageEvent(screen, view, screen.imageLoadHandlers[view])
                    emitImageEvent(screen, view, screen.imageLoadEndHandlers[view])
                } else imageFailure(screen, view, uri, "Image download failed")
            }
        }
    }

    private fun imageFailure(screen: Screen, view: ImageView, uri: String, message: String) {
        imageErrors[view] = message
        view.setImageDrawable(null)
        imageDidChange(view)
        val current = view.contentDescription?.toString().orEmpty()
        if (!current.contains(message)) {
            view.contentDescription = listOf(
                current.ifBlank { view.tag?.toString() ?: "Image" },
                message,
            ).joinToString(", ")
        }
        emitImageEvent(screen, view, screen.imageErrorHandlers[view], JSONObject().put("error", JSONObject().put("message", message)))
        emitImageEvent(screen, view, screen.imageLoadEndHandlers[view])
        Log.e(TAG, "$message: $uri")
    }

    /**
     * An ImageView invalidates its own measure when its drawable changes, but
     * the native flex parent also memoizes intrinsic probes for the frame.
     * Clear that memo and walk through image-background wrappers so a source
     * swap can change an un-sized image's layout on the next pass.
     */
    private fun imageDidChange(view: ImageView) {
        view.invalidate()
        view.requestLayout()
        CraftNativeFlexLayout.invalidateMeasurementAncestors(view.parent)
    }

    private fun emitImageEvent(screen: Screen, view: ImageView, handler: String?, nativeEvent: JSONObject = JSONObject()) {
        if (handler.isNullOrBlank()) return
        send(screen, "EVENT", JSONObject().put("handlerName", handler).put("nativeEvent", nativeEvent))
    }

    private fun setTextPreservingSelection(field: EditText, value: String) {
        val start = field.selectionStart
        val end = field.selectionEnd
        field.setText(value)
        if (start < 0 || end < 0) {
            field.setSelection(value.length)
            return
        }
        val boundedStart = start.coerceIn(0, value.length)
        val boundedEnd = end.coerceIn(0, value.length)
        field.setSelection(minOf(boundedStart, boundedEnd), maxOf(boundedStart, boundedEnd))
    }

    private fun applyAccessibility(view: View, props: JSONObject, type: String, fallbackLabel: String) {
        val testId = craftNativeOptionalString(props.opt("testID"))
        view.tag = testId?.takeIf { it.isNotBlank() } ?: fallbackLabel
        val label = craftNativeOptionalString(props.opt("accessibilityLabel"))
            ?: craftNativeOptionalString(props.opt("alt"))?.takeIf { type == "Image" || type == "ImageBackground" }
        val value = craftNativeOptionalString(props.opt("accessibilityValue"))
        view.contentDescription = when {
            label != null && value != null -> "$label, $value"
            label != null -> label
            value != null -> value
            else -> null
        }
        view.tooltipText = craftNativeOptionalString(props.opt("accessibilityHint"))
        val hasLinkTarget = listOf("href", "to").any { key ->
            !craftNativeOptionalString(props.opt(key)).isNullOrBlank()
        }
        val linkedControl = type in setOf("Link", "TouchableOpacity", "TouchableHighlight", "Pressable") && hasLinkTarget
        val role = craftNativeOptionalString(props.opt("accessibilityRole")) ?: run {
            when {
                linkedControl -> "link"
                type in setOf("TouchableOpacity", "TouchableHighlight", "Pressable") -> "button"
                type == "Icon" -> "image"
                type in setOf("FlatList", "SectionList") -> "list"
                else -> type.lowercase()
            }
        }
        val state = props.optJSONObject("accessibilityState")
        val disabled = craftNativeBoolean(props.opt("disabled")) || craftNativeBoolean(state?.opt("disabled"))
        if (type !in setOf("Button", "Link", "Checkbox", "TextInput", "Picker", "SegmentedControl", "DatePicker", "Modal", "Switch", "Slider", "ActivityIndicator")) {
            view.isEnabled = !disabled
        } else if (disabled) {
            view.isEnabled = false
        }
        ViewCompat.setStateDescription(
            view,
            if (type == "Checkbox" && (props.opt("indeterminate") as? Boolean) == true) "mixed" else null,
        )
        ViewCompat.setAccessibilityDelegate(view, object : AccessibilityDelegateCompat() {
            override fun onInitializeAccessibilityNodeInfo(host: View, info: AccessibilityNodeInfoCompat) {
                super.onInitializeAccessibilityNodeInfo(host, info)
                // Expose STX test identities to Android's native automation
                // tree without replacing the label read by TalkBack.
                info.viewIdResourceName = testId
                info.className = when (role) {
                    "button" -> Button::class.java.name
                    "image" -> ImageView::class.java.name
                    "search" -> EditText::class.java.name
                    "scrollbar" -> ScrollView::class.java.name
                    else -> host.javaClass.name
                }
                info.isHeading = role == "header"
                info.roleDescription = role.takeIf { it !in setOf("view", "text", "textinput", "scrollview") }
                info.hintText = host.tooltipText
                info.isEnabled = host.isEnabled && !disabled
                // Keep the native widget state when no accessibilityState was
                // authored. Overwriting it with the strict false fallback
                // made a checked Switch/CheckBox announce as unchecked unless
                // the screen redundantly mirrored its value into metadata.
                if (state?.has("selected") == true) {
                    info.isSelected = craftNativeBoolean(state.opt("selected"))
                }
                if (state?.has("checked") == true) {
                    info.isChecked = craftNativeBoolean(state.opt("checked"))
                }
            }
        })
        ViewCompat.setImportantForAccessibility(
            view,
            if (role == "none") ViewCompat.IMPORTANT_FOR_ACCESSIBILITY_NO else ViewCompat.IMPORTANT_FOR_ACCESSIBILITY_YES,
        )
    }

    private fun dp(value: Double): Int {
        val pixels = value * resources.displayMetrics.density
        return if (pixels.isFinite()) pixels.toInt() else 0
    }
    private fun color(raw: String, fallback: Int) = runCatching { craftNativeColor(raw) }.getOrDefault(fallback)

    private fun inputTypeFor(props: JSONObject): Int {
        val base = if (craftNativeBoolean(props.opt("multiline"))) InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE
        else InputType.TYPE_CLASS_TEXT
        // Text variations do not carry their input class or multiline flag.
        // Preserve both when selecting an email, URL, or search keyboard.
        val keyboard = when (props.opt("keyboardType") as? String) {
            "email-address" -> base or InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS
            "url" -> base or InputType.TYPE_TEXT_VARIATION_URI
            "numeric", "number-pad" -> InputType.TYPE_CLASS_NUMBER
            "decimal-pad" -> InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_FLAG_DECIMAL
            "phone-pad" -> InputType.TYPE_CLASS_PHONE
            "web-search" -> base or InputType.TYPE_TEXT_VARIATION_WEB_EDIT_TEXT
            "visible-password" -> base or InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD
            else -> base
        }
        val capitalization = when (props.opt("autoCapitalize") as? String) {
            "characters" -> InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS
            "words" -> InputType.TYPE_TEXT_FLAG_CAP_WORDS
            "sentences" -> InputType.TYPE_TEXT_FLAG_CAP_SENTENCES
            else -> 0
        }
        val correction = if (craftNativeBoolean(props.opt("autoCorrect"), true)) InputType.TYPE_TEXT_FLAG_AUTO_CORRECT else 0
        val secure = if (craftNativeBoolean(props.opt("secureTextEntry"))) InputType.TYPE_TEXT_VARIATION_PASSWORD else 0
        return keyboard or capitalization or correction or secure
    }

    /// The autofill hint for `textContentType` (iOS's names) or `autoComplete`
    /// (HTML's), so a password manager fills the field.
    private fun autofillHintFor(props: JSONObject): String? {
        val raw = (props.opt("textContentType") as? String)?.takeIf { it.isNotBlank() }
            ?: (props.opt("autoComplete") as? String).orEmpty()
        return when (raw.replace("-", "").replace("_", "").lowercase()) {
            "username" -> View.AUTOFILL_HINT_USERNAME
            "nickname" -> "personNickname"
            "password", "currentpassword" -> View.AUTOFILL_HINT_PASSWORD
            "newpassword" -> "newPassword"
            "onetimecode" -> "smsOTPCode"
            "emailaddress", "email" -> View.AUTOFILL_HINT_EMAIL_ADDRESS
            "telephonenumber", "tel", "phone" -> View.AUTOFILL_HINT_PHONE
            "name" -> View.AUTOFILL_HINT_NAME
            "givenname", "firstname" -> "personGivenName"
            "middlename", "additionalname" -> "personMiddleName"
            "familyname", "lastname" -> "personFamilyName"
            "nameprefix", "honorificprefix" -> "personNamePrefix"
            "namesuffix", "honorificsuffix" -> "personNameSuffix"
            "organizationname", "organization" -> "organizationName"
            "jobtitle", "organizationtitle" -> "jobTitle"
            "url" -> "url"
            "postalcode" -> View.AUTOFILL_HINT_POSTAL_CODE
            "fullstreetaddress", "streetaddress" -> View.AUTOFILL_HINT_POSTAL_ADDRESS
            "streetaddressline1", "addressline1" -> "streetAddress"
            "streetaddressline2", "addressline2" -> "streetAddressLine2"
            "addresscity", "addresslevel2" -> "addressLocality"
            "addressstate", "addresslevel1" -> "addressRegion"
            "countryname", "country" -> "addressCountry"
            "location" -> "location"
            "creditcardnumber", "ccnumber" -> "creditCardNumber"
            else -> null
        }
    }

    private fun imeOptionsFor(props: JSONObject): Int = when (props.opt("returnKeyType") as? String) {
        "done" -> EditorInfo.IME_ACTION_DONE
        "go" -> EditorInfo.IME_ACTION_GO
        "next" -> EditorInfo.IME_ACTION_NEXT
        "search" -> EditorInfo.IME_ACTION_SEARCH
        "send" -> EditorInfo.IME_ACTION_SEND
        // Android has no separate JOIN, ROUTE, CONTINUE, or EMERGENCY_CALL
        // action. GO/NEXT are the closest platform actions and still expose
        // an actionable IME key instead of silently falling back to NONE.
        "join", "route", "emergency-call" -> EditorInfo.IME_ACTION_GO
        "continue" -> EditorInfo.IME_ACTION_NEXT
        else -> EditorInfo.IME_ACTION_NONE
    }

    private fun answerAPI(screen: Screen, message: JSONObject, payload: JSONObject) {
        val id = message.optString("id")
        if (id.isBlank()) return
        val args = payload.optJSONArray("args") ?: JSONArray()
        val token = "${screen.capabilityScope}/$id"
        screen.pendingCapabilities.add(token)
        val timeout = Runnable {
            if (!screen.active || !screen.pendingCapabilities.remove(token)) return@Runnable
            screen.capabilityTimeouts.remove(token)
            capabilities.cancel(token)
            send(screen, "API_ERROR", JSONObject()
                .put("version", CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION)
                .put("requestId", id)
                .put("code", "TIMEOUT")
                .put("message", "Native API request timed out"), id)
        }
        // A person answers some calls (a permission sheet, a dialog): those
        // are never timed out (`untimed`, the bridge's callPersonFacingAPI).
        if (!payload.optBoolean("untimed", false)) {
            screen.capabilityTimeouts[token] = timeout
            capabilityHandler.postDelayed(timeout, CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS)
        }
        val module = payload.optString("module")
        val method = payload.optString("method")
        val perform: ((CraftNativeCapabilityResult) -> Unit) -> Unit = if (module == "View") {
            { completion -> performView(screen, method, args, completion) }
        } else if (services.handles(module)) {
            { completion -> services.perform(module, method, args, completion) }
        } else {
            { completion ->
                capabilities.perform(
                    token,
                    payload.optInt("version", CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION),
                    module,
                    method,
                    args,
                    completion,
                )
            }
        }
        perform { result ->
            if ((!screen.active && !screen.closing) || !screen.pendingCapabilities.remove(token)) return@perform
            screen.capabilityTimeouts.remove(token)?.let(capabilityHandler::removeCallbacks)
            val response = JSONObject()
                .put("version", CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION)
                .put("requestId", id)
            if (result.code == null) response.put("data", result.data ?: JSONObject.NULL)
            else response.put("code", result.code).put("message", result.message ?: "Native API failed")
            send(screen, if (result.code == null) "API_RESPONSE" else "API_ERROR", response, id)
        }
    }

    /** View operations are screen-owned: node ids only exist while a route is mounted. */
    private fun performView(
        screen: Screen,
        method: String,
        args: JSONArray,
        completion: (CraftNativeCapabilityResult) -> Unit,
    ) {
        val options = args.optJSONObject(0)
        val nodeId = options?.optString("nodeId")?.takeIf { it.isNotBlank() } ?: args.optString(0)
        if (nodeId.isBlank()) {
            completion(CraftNativeCapabilityResult(code = "INVALID_ARGUMENT", message = "View.$method needs a nodeId"))
            return
        }
        val target = screen.nodeViews[nodeId]
        if (target == null) {
            completion(CraftNativeCapabilityResult(code = "VIEW_NOT_FOUND", message = "View.$method could not find mounted node $nodeId"))
            return
        }
        if (!target.isAttachedToWindow) {
            completion(CraftNativeCapabilityResult(code = "VIEW_NOT_MOUNTED", message = "View.$method requires a mounted node"))
            return
        }
        when (method) {
            "focus" -> when (options?.optString("mode") ?: args.optString(1, "keyboard")) {
                "keyboard" -> if (target is EditText) {
                    if (!target.requestFocus()) {
                        completion(CraftNativeCapabilityResult(code = "FOCUS_FAILED", message = "The mounted view refused keyboard focus"))
                    } else {
                        target.post {
                            (getSystemService(INPUT_METHOD_SERVICE) as? android.view.inputmethod.InputMethodManager)
                                ?.showSoftInput(target, android.view.inputmethod.InputMethodManager.SHOW_IMPLICIT)
                        }
                        completion(CraftNativeCapabilityResult(data = true))
                    }
                } else completion(CraftNativeCapabilityResult(code = "UNSUPPORTED_TARGET", message = "Keyboard focus is supported only for text inputs"))
                "accessibility" -> {
                    target.sendAccessibilityEvent(android.view.accessibility.AccessibilityEvent.TYPE_VIEW_FOCUSED)
                    completion(CraftNativeCapabilityResult(data = true))
                }
                else -> completion(CraftNativeCapabilityResult(code = "INVALID_ARGUMENT", message = "View.focus mode must be keyboard or accessibility"))
            }
            "measure" -> {
                screen.view.requestLayout()
                screen.view.measure(
                    View.MeasureSpec.makeMeasureSpec(screen.view.width, View.MeasureSpec.EXACTLY),
                    View.MeasureSpec.makeMeasureSpec(screen.view.height, View.MeasureSpec.EXACTLY),
                )
                val targetLocation = IntArray(2)
                val viewportLocation = IntArray(2)
                target.getLocationOnScreen(targetLocation)
                screen.view.getLocationOnScreen(viewportLocation)
                val density = resources.displayMetrics.density.coerceAtLeast(0.1f)
                completion(CraftNativeCapabilityResult(data = JSONObject()
                    .put("x", (targetLocation[0] - viewportLocation[0]) / density)
                    .put("y", (targetLocation[1] - viewportLocation[1]) / density)
                    .put("width", target.width / density)
                    .put("height", target.height / density)
                    .put("viewportWidth", screen.view.width / density)
                    .put("viewportHeight", screen.view.height / density)
                    .put("unit", "dp")
                    .put("coordinateSpace", "screenViewport")))
            }
            "scrollTo" -> {
                val scroll = target as? CraftNativeScrollView
                if (scroll == null) {
                    completion(CraftNativeCapabilityResult(code = "UNSUPPORTED_TARGET", message = "View.scrollTo is supported only for scroll views"))
                    return
                }
                val rawX = options?.opt("x")
                val rawY = options?.opt("y")
                val x = (rawX as? Number)?.toDouble()?.takeIf { it.isFinite() }
                val y = (rawY as? Number)?.toDouble()?.takeIf { it.isFinite() }
                if ((options?.has("x") == true && x == null) || (options?.has("y") == true && y == null)) {
                    completion(CraftNativeCapabilityResult(code = "INVALID_ARGUMENT", message = "View.scrollTo coordinates must be finite numbers"))
                    return
                }
                val density = resources.displayMetrics.density.coerceAtLeast(0.1f)
                val position = scroll.scrollTo(
                    x?.times(density)?.roundToInt(),
                    y?.times(density)?.roundToInt(),
                    options?.optBoolean("animated", false) == true,
                )
                completion(CraftNativeCapabilityResult(data = JSONObject()
                    .put("x", position.first / density)
                    .put("y", position.second / density)
                    .put("unit", "dp")))
            }
            else -> completion(CraftNativeCapabilityResult(code = "UNKNOWN_ACTION", message = "Unsupported View operation"))
        }
    }

    internal fun performImmediateCapability(module: String, method: String, args: JSONArray): CraftNativeCapabilityResult =
        when (module to method) {
            "Device" to "getInfo" -> CraftNativeCapabilityResult(data = JSONObject()
                .put("platform", "android")
                .put("osVersion", Build.VERSION.RELEASE)
                .put("model", Build.MODEL)
                .put("manufacturer", Build.MANUFACTURER)
                .put("deviceId", android.provider.Settings.Secure.getString(contentResolver, android.provider.Settings.Secure.ANDROID_ID))
                .put("isTablet", resources.configuration.smallestScreenWidthDp >= 600)
                .put("screen", JSONObject()
                    .put("width", resources.displayMetrics.widthPixels / resources.displayMetrics.density)
                    .put("height", resources.displayMetrics.heightPixels / resources.displayMetrics.density)
                    .put("scale", resources.displayMetrics.density)))
            "Clipboard" to "write" -> if (!clipboardEnabled) {
                CraftNativeCapabilityResult(code = "CAPABILITY_DISABLED", message = "Clipboard is disabled")
            } else if (args.opt(0) !is String) {
                CraftNativeCapabilityResult(code = "INVALID_ARGUMENT", message = "Clipboard.write needs text")
            } else {
                val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
                clipboard.setPrimaryClip(ClipData.newPlainText("", args.getString(0)))
                CraftNativeCapabilityResult(data = true)
            }
            "Clipboard" to "read" -> if (!clipboardEnabled) {
                CraftNativeCapabilityResult(code = "CAPABILITY_DISABLED", message = "Clipboard is disabled")
            } else {
                val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
                CraftNativeCapabilityResult(data = clipboard.primaryClip?.getItemAt(0)?.coerceToText(this)?.toString() ?: "")
            }
            // The iOS names (CraftNativeActions.swift): an impact weight, a
            // notification type or selection, through CraftNativeHaptics.
            // `prepare` warms nothing here, so it answers true at once.
            "Haptics" to "impact", "Haptics" to "notification", "Haptics" to "selection", "Haptics" to "prepare" -> if (!hapticsEnabled) {
                CraftNativeCapabilityResult(code = "CAPABILITY_DISABLED", message = "Haptics are disabled")
            } else {
                val style = CraftNativeHaptics.style(method, args.opt(0) as? String)
                CraftNativeCapabilityResult(data = style == null || CraftNativeHaptics.play(this, window?.decorView, style))
            }
            else -> CraftNativeCapabilityResult(code = "UNKNOWN_ACTION", message = "Unsupported native API")
        }

    internal fun deepLinkData(uri: android.net.Uri): JSONObject = JSONObject()
        .put("url", uri.toString())
        .put("scheme", uri.scheme ?: "")
        .put("host", uri.host ?: "")
        .put("path", uri.path ?: "")
        .put("query", uri.query ?: "")
        .put("queryParams", JSONObject().apply {
            uri.queryParameterNames.forEach { name -> put(name, uri.getQueryParameter(name) ?: "") }
        })

    /** App-wide news (the app's state, a link): every screen and the app script hear it. */
    private fun publish(type: String, payload: JSONObject) {
        allScreens().filter { it.active }.forEach { send(it, type, payload) }
    }

    override fun onStart() {
        super.onStart()
        if (!animationScaleObserverRegistered) {
            contentResolver.registerContentObserver(Settings.Global.getUriFor(Settings.Global.ANIMATOR_DURATION_SCALE), false, animationScaleObserver)
            contentResolver.registerContentObserver(Settings.Global.getUriFor(Settings.Global.TRANSITION_ANIMATION_SCALE), false, animationScaleObserver)
            animationScaleObserverRegistered = true
        }
        nativeAppState = "active"
        publish("APP_STATE", JSONObject().put("state", nativeAppState))
    }

    override fun onPause() {
        if (::services.isInitialized) services.pauseVoice()
        nativeAppState = "inactive"
        publish("APP_STATE", JSONObject().put("state", nativeAppState))
        super.onPause()
    }

    override fun onStop() {
        if (animationScaleObserverRegistered) {
            contentResolver.unregisterContentObserver(animationScaleObserver)
            animationScaleObserverRegistered = false
        }
        nativeAppState = "background"
        publish("APP_STATE", JSONObject().put("state", nativeAppState))
        super.onStop()
    }

    override fun onLowMemory() {
        mapViews().forEach { it.lowMemory() }
        super.onLowMemory()
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        notificationTap(intent)?.let { tap ->
            val app = appScreen
            if (app != null && app.active) send(app, "CRAFT_EVENT", JSONObject().put("event", "craftNotificationResponse").put("detail", tap))
            else pendingNotificationTap = tap
        }
        intent.data?.let { link ->
            if (::services.isInitialized && services.deepLink(link)) return
            if (CraftAppLinks.opensInBrowser(config, link)) {
                CraftAppLinks.openBrowser(this, link)
                return
            }
            publish("DEEP_LINK", deepLinkData(link).put("initial", false))
            if (::routes.isInitialized && !routes.isEmpty) routes.appPath(link.toString(), urlSchemes)?.let { navigateOpen(it, fromLink = true) }
        }
    }

    /**
     * The data of a push that was tapped (Firebase puts it in the launch
     * intent's extras, `google.message_id` among them), in the shape the iOS
     * host gives `craftNotificationResponse`: the payload's own keys.
     */
    private fun notificationTap(intent: Intent?): JSONObject? {
        val extras = intent?.extras ?: return null
        if (!extras.containsKey("google.message_id") && !extras.containsKey("craft.notification")) return null
        val detail = JSONObject()
        extras.keySet().forEach { key ->
            if (key.startsWith("google.") || key.startsWith("gcm.") || key == "from" || key == "collapse_key" || key == "craft.notification") return@forEach
            val value = extras.get(key)
            if (value is String || value is Number || value is Boolean) detail.put(key, value)
        }
        return detail
    }

    override fun onResume() {
        super.onResume()
        if (::services.isInitialized) services.resumed()
    }

    override fun onRequestPermissionsResult(requestCode: Int, permissions: Array<out String>, grantResults: IntArray) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults)
        if (::capabilities.isInitialized) { capabilities.onBluetoothPermissions(requestCode); capabilities.onNotificationPermissions(requestCode) }
        if (::services.isInitialized) services.onRequestPermissionsResult(requestCode)
    }

    internal fun consumeInitialDeepLink(): Uri? {
        if (initialDeepLinkClaimed) return null
        initialDeepLinkClaimed = true
        return initialDeepLink
    }

    private fun emitLayoutEvents(screen: Screen) {
        emitLayoutEvents(screen, screen.view)
    }

    private fun updateKeyboardAvoidingViews() {
        fun visit(view: View) {
            (view as? CraftNativeKeyboardAvoidingView)?.setKeyboardInset(keyboardInset)
            if (view is ViewGroup) for (index in 0 until view.childCount) visit(view.getChildAt(index))
        }
        if (::root.isInitialized) visit(root)
    }

    private fun emitLayoutEvents(screen: Screen, view: View) {
        emitLayoutEvent(screen, view, view.left, view.top, view.right, view.bottom)
        if (view is ViewGroup) {
            for (index in 0 until view.childCount) emitLayoutEvents(screen, view.getChildAt(index))
        }
    }

    private fun emitLayoutEvent(screen: Screen, view: View, left: Int, top: Int, right: Int, bottom: Int) {
        val handler = screen.layoutHandlers[view]
        if (handler != null && view.isShown) {
            val density = resources.displayMetrics.density
            val bounds = LayoutBounds(
                x = left.toDouble() / density.toDouble(),
                y = top.toDouble() / density.toDouble(),
                width = (right - left).toDouble() / density.toDouble(),
                height = (bottom - top).toDouble() / density.toDouble(),
            )
            if (screen.lastLayoutBounds[view] != bounds) {
                screen.lastLayoutBounds[view] = bounds
                send(screen, "EVENT", JSONObject()
                    .put("handlerName", handler)
                    .put("nativeEvent", JSONObject().put("layout", JSONObject()
                        .put("x", bounds.x)
                        .put("y", bounds.y)
                        .put("width", bounds.width)
                        .put("height", bounds.height))))
            }
        }
    }

    private fun send(screen: Screen, type: String, payload: JSONObject, correlationId: String? = null) {
        if (!screen.active) return
        val message = JSONObject().put("type", type).put("payload", payload)
        if (correlationId != null) message.put("correlationId", correlationId)
        if (screen.port != null) {
            screen.port.postMessage(Message.createStringMessage(message.toString()))
        } else {
            val script = "globalThis.__stxNativeCallback && globalThis.__stxNativeCallback(${JSONObject.quote(message.toString())})"
            reportJavaScriptFailure(screen, screen.isolate.evaluateJavaScriptAsync(script))
        }
    }

    /**
     * An error JavaScript threw and nothing caught, to the crash reporter. A
     * sandbox has no global error event: an uncaught error surfaces only as
     * the evaluation's future failing, so every evaluation that runs a
     * screen's code reports through here.
     */
    private fun reportJavaScriptFailure(screen: Screen, future: com.google.common.util.concurrent.ListenableFuture<String>) {
        if (!CraftCrashReporter.enabled) return
        future.addListener({
            try {
                future.get()
            } catch (error: Exception) {
                reportJavaScriptError(screen, error)
            }
        }, java.util.concurrent.Executor { command -> command.run() })
    }

    private fun reportJavaScriptError(screen: Screen, error: Throwable) {
        val cause = (error as? java.util.concurrent.ExecutionException)?.cause ?: error
        if (cause is java.util.concurrent.CancellationException || cause is androidx.javascriptengine.IsolateTerminatedException) return
        val text = cause.message ?: cause.javaClass.simpleName
        // JavaScriptSandbox reports "Uncaught TypeError: message" and, when it
        // has one, the stack after a newline.
        val firstLine = text.lineSequence().firstOrNull()?.removePrefix("Uncaught ")?.trim() ?: text
        val name = Regex("^([A-Z][A-Za-z]*Error|Error):").find(firstLine)?.groupValues?.get(1)
        val message = if (name != null) firstLine.removePrefix("$name:").trim() else firstLine
        val stack = text.lineSequence().drop(1).joinToString("\n").ifBlank { null }
        CraftCrashReporter.captureJavaScript(name, message, stack, screen.route ?: "home", screen.headless)
    }

    /** Back to the first screen in one move. */
    private fun popToRoot() {
        interruptTabSwipe()
        val stack = screens
        val removed = mutableListOf<Screen>()
        while (stack.size > 1) removed.add(stack.removeAt(stack.lastIndex))
        val target = stack.lastOrNull()
        closeScreens(removed) {
            if (target != null && screens === stack && stack.lastOrNull() === target) show(target)
        }
    }

    /** Back: the screen below in this tab, then the first tab, then out of the app. */
    private fun back() {
        interruptTabSwipe()
        // A previous back is still draining its screen's teardown messages.
        if (visibleScreen == null) return
        if (screens.size > 1) {
            val stack = screens
            val removed = stack.removeAt(stack.lastIndex)
            val target = stack.last()
            closeScreen(removed) {
                if (screens === stack && stack.lastOrNull() === target) show(target)
            }
        } else if (chrome != null && currentTab != 0) {
            selectTab(0)
        } else {
            moveTaskToBack(true)
        }
    }

    private fun imageViews(views: Collection<View>): Set<ImageView> = buildSet {
        fun collect(view: View) {
            if (view is ImageView) add(view)
            if (view is ViewGroup) for (index in 0 until view.childCount) collect(view.getChildAt(index))
        }
        views.forEach(::collect)
    }

    private fun releaseImages(views: Collection<View>) {
        imageViews(views).forEach { image ->
            imageJobs.remove(image)?.cancel(true)
            imageSources.remove(image)
            imageErrors.remove(image)
        }
    }

    private fun retainedViews(screen: Screen): MutableSet<View> = screen.controls.values.toMutableSet().apply {
        screen.flatListRows.values.forEach { rows -> rows.values.forEach { addAll(it.values) } }
    }

    private fun mapViews(): Set<CraftNativeMapView> = allScreens()
        .flatMap { retainedViews(it) }
        .filterIsInstance<CraftNativeMapView>()
        .toSet()

    // MARK: Animated changes

    /**
     * `craft.animation.next(options)`: the screen's next change animates,
     * views that stay moving to their new places, new ones fading in and
     * removed ones fading out, and two with the same `transitionID` moving as
     * one. Android's own transitions, which follow the person's animation
     * scale: with animations off it is a cut, as the system's own are.
     */
    private fun animateNextChange(screen: Screen, payload: JSONObject) {
        val seconds = payload.optDouble("duration", 0.35).takeIf { it.isFinite() } ?: 0.35
        val curve = payload.optString("curve", "spring")
        val transition = TransitionSet()
        transition.setOrdering(TransitionSet.ORDERING_TOGETHER)
        listOf(ChangeBounds(), ChangeTransform(), Fade()).forEach { part ->
            part.setMatchOrder(Transition.MATCH_NAME, Transition.MATCH_INSTANCE)
            transition.addTransition(part)
        }
        transition.setDuration((seconds.coerceIn(0.1, 1.0) * 1000).toLong())
        transition.setInterpolator(
            when (curve) {
                "linear" -> LinearInterpolator()
                "easeInOut" -> PathInterpolator(0.42f, 0f, 0.58f, 1f)
                // A spring with no bounce reads as a decelerating curve.
                else -> PathInterpolator(0.2f, 0f, 0f, 1f)
            },
        )
        TransitionManager.beginDelayedTransition(screen.view, transition)
    }

    // MARK: Picture in Picture

    /** The floating window's own surface, over everything while it shows. */
    private var pictureInPictureLayer: FrameLayout? = null
    private var pictureInPictureVideo: CraftNativeVideoView? = null

    /** A video that asked for Picture in Picture and is playing on a screen in view. */
    private fun floatingVideo(): CraftNativeVideoView? = allScreens()
        .filter { !it.headless }
        .flatMap { retainedViews(it) }
        .filterIsInstance<CraftNativeVideoView>()
        .firstOrNull { it.pictureInPicture && it.playing && it.isShown }

    private fun pictureInPictureAllowed(): Boolean =
        packageManager.hasSystemFeature(PackageManager.FEATURE_PICTURE_IN_PICTURE)

    /**
     * Picture in Picture follows the playing video: on Android 12 and later
     * the system floats it by itself as the person leaves the app (gesture
     * navigation included); before that `onUserLeaveHint` asks.
     */
    private fun updatePictureInPicture() {
        if (!pictureInPictureAllowed() || isInPictureInPictureMode) return
        val video = floatingVideo()
        val params = PictureInPictureParams.Builder()
        video?.aspectRatio()?.let { params.setAspectRatio(it) }
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) params.setAutoEnterEnabled(video != null)
        runCatching { setPictureInPictureParams(params.build()) }
    }

    override fun onUserLeaveHint() {
        super.onUserLeaveHint()
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S || !pictureInPictureAllowed()) return
        val video = floatingVideo() ?: return
        val params = PictureInPictureParams.Builder()
        video.aspectRatio()?.let { params.setAspectRatio(it) }
        runCatching { enterPictureInPictureMode(params.build()) }
    }

    override fun onPictureInPictureModeChanged(isInPictureInPictureMode: Boolean, newConfig: Configuration) {
        super.onPictureInPictureModeChanged(isInPictureInPictureMode, newConfig)
        if (isInPictureInPictureMode) {
            floatingVideo()?.notifyPictureInPicture(true)
            showVideoAlone()
        } else {
            pictureInPictureVideo?.notifyPictureInPicture(false)
            putVideoBack()
        }
    }

    /**
     * The floating window shows the whole activity, so the video is drawn
     * alone on a surface over it, black around it. The video keeps playing
     * through the change: only where its frames go moves.
     */
    private fun showVideoAlone() {
        val video = floatingVideo() ?: return
        val host = window.decorView as? ViewGroup ?: return
        val surface = SurfaceView(this).apply {
            setZOrderMediaOverlay(true)
            holder.addCallback(object : SurfaceHolder.Callback {
                override fun surfaceCreated(holder: SurfaceHolder) { video.showOn(holder) }
                override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) = Unit
                override fun surfaceDestroyed(holder: SurfaceHolder) { video.showOn(null) }
            })
        }
        val layer = FrameLayout(this).apply {
            setBackgroundColor(Color.BLACK)
            addView(surface, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT, Gravity.CENTER))
        }
        host.addView(layer, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
        pictureInPictureLayer = layer
        pictureInPictureVideo = video
    }

    /** Back in the app: the video draws in its place again. */
    private fun putVideoBack() {
        pictureInPictureVideo?.showOn(null)
        pictureInPictureVideo = null
        pictureInPictureLayer?.let { (it.parent as? ViewGroup)?.removeView(it) }
        pictureInPictureLayer = null
        updatePictureInPicture()
    }

    private fun releaseFlatList(
        screen: Screen,
        list: CraftNativeFlatList,
        preservingInputDrafts: Boolean,
    ) {
        val owner = screen.flatListOwnerByView.remove(list)
        list.resetForTeardown()
        screen.flatListRows.remove(list)?.values?.forEach {
            releaseViewState(screen, it.values, preservingInputDrafts)
        }
        if (owner != null) screen.flatListOwners.entries.removeAll { it.value == owner }
    }

    private fun releaseViewState(
        screen: Screen,
        views: Collection<View>,
        preservingInputDrafts: Boolean = false,
    ) {
        val released = views.toMutableSet()
        val releasedImages = imageViews(released)
        val refreshableLists = released.filterIsInstance<CraftNativeRefreshableFlatList>()
        val nestedLists = refreshableLists.map { it.list }.toSet()
        released.addAll(nestedLists)
        refreshableLists.forEach {
            releaseFlatList(screen, it.list, preservingInputDrafts)
        }
        released.filterIsInstance<CraftNativeFlatList>().filterNot { nestedLists.contains(it) }.forEach {
            releaseFlatList(screen, it, preservingInputDrafts)
        }
        released.filterIsInstance<CraftNativeModalView>().forEach { it.resetForTeardown() }
        released.filterIsInstance<CraftNativeDatePickerView>().forEach { it.resetForTeardown() }
        released.filterIsInstance<CraftNativeRefreshableFlatList>().forEach { it.resetForTeardown() }
        released.filterIsInstance<CraftNativeVideoView>().forEach { it.stop() }
        released.filterIsInstance<CraftNativeMapView>().forEach { it.destroy() }
        released.filterIsInstance<CraftNativeFlexLayout>().forEach { it.onLayoutChanged = null }
        released.filterIsInstance<CraftNativeKeyboardAvoidingView>().forEach { it.content.onLayoutChanged = null }
        released.filterIsInstance<CraftNativeScrollView>().forEach {
            it.setRefreshHandler(null, false)
            it.clearScrollListeners()
        }
        releaseImages(released)
        // Clearing the handler maps is not enough: Android Views retain the
        // listener objects themselves. Detach every interaction callback from
        // released/recycled rows so a later identity cannot inherit a closure
        // that still captures the previous row's screen state.
        released.forEach {
            // Modals are promoted out of their logical layout into the
            // screen overlay. Removing the logical node therefore does not
            // remove the native view through ordinary child reconciliation;
            // detach every released view so an open popup cannot survive as
            // an orphan after its owner unmounts.
            (it.parent as? ViewGroup)?.removeView(it)
            // AdapterView (including Spinner, our native Picker) rejects
            // setOnClickListener altogether. Its selection callback is
            // detached below; ordinary Views still need their click target
            // cleared here.
            if (it !is android.widget.AdapterView<*>) it.setOnClickListener(null)
            it.setOnTouchListener(null)
            it.setOnLongClickListener(null)
            it.setOnFocusChangeListener(null)
            it.isClickable = false
            it.isLongClickable = false
        }
        released.filterIsInstance<android.widget.CompoundButton>().forEach { it.setOnCheckedChangeListener(null) }
        released.filterIsInstance<SeekBar>().forEach { it.setOnSeekBarChangeListener(null) }
        released.filterIsInstance<Spinner>().forEach { it.onItemSelectedListener = null }
        released.filterIsInstance<EditText>().forEach { it.setOnEditorActionListener(null) }
        released.filterIsInstance<EditText>().forEach {
            screen.inputWatchers.remove(it)?.let(it::removeTextChangedListener)
            inputHintDefaults.remove(it)
            inputHighlightDefaults.remove(it)
            inputPaddingDefaults.remove(it)
            screen.suppressedTextChanges.remove(it)
            screen.inputEchoes.remove(it)
            val identity = screen.inputIdentities.remove(it)
            if (!preservingInputDrafts) identity?.let(screen.drafts::remove)
        }
        released.forEach(defaultBackgrounds::remove)
        screen.linkTargets.keys.removeAll(released)
        screen.protocolIds.keys.removeAll(released)
        screen.handlers.keys.removeAll(released)
        screen.pressInHandlers.keys.removeAll(released)
        screen.pressOutHandlers.keys.removeAll(released)
        screen.pressUnderlayShowHandlers.keys.removeAll(released)
        screen.pressUnderlayHideHandlers.keys.removeAll(released)
        screen.pressUnderlayColors.keys.removeAll(released)
        screen.pressBaseBackgrounds.keys.removeAll(released)
        screen.longPressHandlers.keys.removeAll(released)
        screen.layoutHandlers.keys.removeAll(released)
        screen.layoutListeners.forEach { (view, listener) ->
            if (view in released) view.removeOnLayoutChangeListener(listener)
        }
        screen.layoutListeners.keys.removeAll(released)
        screen.lastLayoutBounds.keys.removeAll(released)
        screen.scrollHandlers.keys.removeAll(released)
        screen.scrollBeginHandlers.keys.removeAll(released)
        screen.scrollEndHandlers.keys.removeAll(released)
        screen.scrollMomentumBeginHandlers.keys.removeAll(released)
        screen.scrollMomentumEndHandlers.keys.removeAll(released)
        screen.sliderCompleteHandlers.keys.removeAll(released)
        screen.sliderSteps.keys.removeAll(released)
        screen.focusHandlers.keys.removeAll(released)
        screen.blurHandlers.keys.removeAll(released)
        screen.endEditingHandlers.keys.removeAll(released)
        screen.submitHandlers.keys.removeAll(released)
        screen.imageLoadStartHandlers.keys.removeAll(releasedImages)
        screen.imageLoadHandlers.keys.removeAll(releasedImages)
        screen.imageLoadEndHandlers.keys.removeAll(releasedImages)
        screen.imageErrorHandlers.keys.removeAll(releasedImages)
        screen.pressActiveOpacities.keys.removeAll(released)
        screen.pressBaseOpacities.keys.removeAll(released)
        screen.pressUnderlayColors.keys.removeAll(released)
        screen.pressBaseBackgrounds.keys.removeAll(released)
        screen.modalVisibility.keys.removeAll(released)
        screen.modalCloseHandlers.keys.removeAll(released)
    }

    private fun closeScreens(screens: List<Screen>, done: () -> Unit) {
        val iterator = screens.iterator()
        fun next() {
            if (iterator.hasNext()) closeScreen(iterator.next()) { next() }
            else done()
        }
        next()
    }

    private fun closeScreen(screen: Screen, done: () -> Unit = {}) {
        if (!screen.active) { screen.close(done); return }
        CraftNativeHub.unregister(screen.capabilityScope)
        screen.timers.values.forEach(capabilityHandler::removeCallbacks)
        screen.timers.clear()
        if (visibleScreen === screen) visibleScreen = null
        screen.capabilityTimeouts.values.forEach(capabilityHandler::removeCallbacks)
        screen.capabilityTimeouts.clear()
        screen.pendingCapabilities.forEach(capabilities::cancel)
        screen.pendingCapabilities.clear()
        releaseViewState(screen, retainedViews(screen).toList())
        screen.inputWatchers.forEach { (input, watcher) -> input.removeTextChangedListener(watcher) }
        screen.inputWatchers.clear()
        screen.controls.clear()
        screen.nodeViews.clear()
        screen.nodePaths.clear()
        screen.protocolIds.clear()
        screen.handlers.clear()
        screen.pressInHandlers.clear()
        screen.pressOutHandlers.clear()
        screen.pressUnderlayShowHandlers.clear()
        screen.pressUnderlayHideHandlers.clear()
        screen.pressUnderlayColors.clear()
        screen.pressBaseBackgrounds.clear()
        screen.layoutHandlers.clear()
        screen.lastLayoutBounds.clear()
        screen.scrollHandlers.clear()
        screen.scrollBeginHandlers.clear()
        screen.scrollEndHandlers.clear()
        screen.scrollMomentumBeginHandlers.clear()
        screen.scrollMomentumEndHandlers.clear()
        screen.sliderCompleteHandlers.clear()
        screen.sliderSteps.clear()
        screen.focusHandlers.clear()
        screen.blurHandlers.clear()
        screen.endEditingHandlers.clear()
        screen.submitHandlers.clear()
        screen.imageLoadStartHandlers.clear()
        screen.imageLoadHandlers.clear()
        screen.imageLoadEndHandlers.clear()
        screen.imageErrorHandlers.clear()
        screen.flatListRows.clear()
        screen.flatListOwners.clear()
        screen.flatListOwnerByView.clear()
        screen.close {
            screen.capabilityTimeouts.values.forEach(capabilityHandler::removeCallbacks)
            screen.capabilityTimeouts.clear()
            screen.pendingCapabilities.forEach(capabilities::cancel)
            screen.pendingCapabilities.clear()
            done()
        }
    }

    @Deprecated("Uses the activity back callback for native route navigation")
    override fun onBackPressed() = handleNativeBack()

    private fun handleNativeBack() {
        val screen = screens.lastOrNull() ?: return back()
        val modal = screen.modalVisibility.entries.lastOrNull { (view, visible) -> visible && view.visibility == View.VISIBLE }
        if (modal != null) {
            (modal.key as? CraftNativeModalView)?.requestClose(reason = "back")
            return
        }
        back()
    }

    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        if (::capabilities.isInitialized && capabilities.onActivityResult(requestCode, resultCode, data)) return
        if (::services.isInitialized && services.onActivityResult(requestCode, resultCode, data)) return
        super.onActivityResult(requestCode, resultCode, data)
    }

    private fun showError(message: String) {
        root.removeAllViews()
        root.addView(TextView(this).apply {
            text = message
            setTextColor(Color.RED)
            textSize = 16f
            setPadding(24, 24, 24, 24)
        })
        Log.e(TAG, message)
    }

    override fun onDestroy() {
        interruptTabSwipe()
        if (animationScaleObserverRegistered) contentResolver.unregisterContentObserver(animationScaleObserver)
        CraftNativeBackground.foreground = null
        backgroundWaiters.values.forEach { it(false) }
        backgroundWaiters.clear()
        allScreens().forEach { closeScreen(it) }
        screens.clear()
        tabStacks.clear()
        appScreen = null
        if (::services.isInitialized) services.close()
        imageJobs.values.forEach { it.cancel(true) }
        imageJobs.clear()
        imageExecutor.shutdownNow()
        capabilities.close()
        super.onDestroy()
    }

    companion object {
        private const val TAG = "CraftNativeAndroid"
    }
}
