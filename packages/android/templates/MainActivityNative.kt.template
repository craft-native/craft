/** A finite celebration owned by a View, never by the JavaScript frame loop. */
internal class CraftNativeCelebration(private val view: View) {
    private var request: Pair<Double, Boolean>? = null
    private var pending = false
    private var animator: ValueAnimator? = null
    private var decoration: Drawable? = null
    private var root: View? = null
    private var radius = 0f
    var starts = 0
        private set
    val isRunning: Boolean get() = animator != null

    fun configure(raw: JSONObject?, radius: Float) {
        val replay = craftNativeNumber(raw?.opt("replay"))?.takeIf { it >= 0 }
        val next = replay?.let { it to (raw?.opt("enabled") != false) }
        this.radius = radius
        if (next == request) return
        stop()
        request = next
        pending = next?.second == true
        view.requestLayout()
    }

    fun stop() {
        pending = false
        animator?.removeAllUpdateListeners()
        animator?.removeAllListeners()
        animator?.cancel()
        animator = null
        decoration?.let { root?.overlay?.remove(it) }
        decoration = null
        root = null
        view.clearAnimation()
    }

    fun layout(animationsEnabled: Boolean = ValueAnimator.areAnimatorsEnabled()) {
        if (!pending || !view.isAttachedToWindow || !view.isShown || view.width <= 0 || view.height <= 0) return
        pending = false
        if (!animationsEnabled) return
        starts += 1
        val root = view.rootView
        this.root = root
        val at = IntArray(2)
        val origin = IntArray(2)
        view.getLocationInWindow(at)
        root.getLocationInWindow(origin)
        val frame = RectF((at[0] - origin[0]).toFloat(), (at[1] - origin[1]).toFloat(), (at[0] - origin[0] + view.width).toFloat(), (at[1] - origin[1] + view.height).toFloat())
        val density = view.resources.displayMetrics.density
        var progress = 0f
        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
        val colors = intArrayOf(Color.rgb(59, 130, 246), Color.rgb(153, 246, 228), Color.rgb(230, 196, 140), Color.WHITE)
        val decoration = object : Drawable() {
            override fun draw(canvas: Canvas) {
                for (index in 0 until 52) {
                    val side = if (index % 2 == 0) -1f else 1f
                    val spread = (index * 37 % 101) / 100f
                    val t = ((progress * 3f - (index % 7) * .018f) / (2.2f + spread * .45f)).coerceIn(0f, 1f)
                    if (t <= 0 || t >= 1) continue
                    val startX = frame.centerX() + side * frame.width() * .42f
                    val startY = frame.top + 28 * density
                    val endX = frame.centerX() + side * (35 * density + spread * root.width * .7f)
                    val endY = root.height + 30 * density
                    val x = startX + (endX - startX) * t
                    val y = startY + (endY - startY) * t * t - (70 + spread * 100) * density * 4 * t * (1 - t)
                    val saved = canvas.save()
                    canvas.translate(x, y)
                    canvas.rotate(side * (index * 30f + t * (400 + spread * 600)))
                    paint.shader = null
                    paint.color = colors[index % colors.size]
                    paint.alpha = (255 * min(1f, min(t / .04f, (1 - t) / .3f))).roundToInt()
                    canvas.drawRoundRect(RectF(-3 * density, -5 * density, (if (index % 3 == 0) 1 else 4) * density, 6 * density), density, density, paint)
                    canvas.restoreToCount(saved)
                }
                val light = (progress * 3f - .55f) / 1.15f
                if (light > 0 && light < 1) {
                    val saved = canvas.save()
                    val mask = Path().apply { addRoundRect(frame, radius, radius, Path.Direction.CW) }
                    canvas.clipPath(mask)
                    val x = frame.left - frame.width() + light * frame.width() * 3
                    paint.alpha = 255
                    paint.shader = LinearGradient(x - frame.width() * .25f, frame.top, x + frame.width() * .25f, frame.bottom, intArrayOf(Color.TRANSPARENT, 0x33ffffff, Color.TRANSPARENT), null, Shader.TileMode.CLAMP)
                    canvas.drawRect(frame, paint)
                    paint.shader = null
                    canvas.restoreToCount(saved)
                }
            }
            override fun setAlpha(alpha: Int) {}
            override fun setColorFilter(colorFilter: ColorFilter?) {}
            @Deprecated("Deprecated in Java")
            override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
        }
        decoration.setBounds(0, 0, root.width, root.height)
        this.decoration = decoration
        root.overlay.add(decoration)
        // Classic view animations leave authored transform properties intact.
        val entrance = android.view.animation.AnimationSet(true).apply {
            addAnimation(android.view.animation.ScaleAnimation(.86f, 1f, .86f, 1f, android.view.animation.Animation.RELATIVE_TO_SELF, .5f, android.view.animation.Animation.RELATIVE_TO_SELF, .5f))
            addAnimation(android.view.animation.TranslateAnimation(0f, 0f, 34 * density, 0f))
            addAnimation(android.view.animation.RotateAnimation(-2.6f, 0f, android.view.animation.Animation.RELATIVE_TO_SELF, .5f, android.view.animation.Animation.RELATIVE_TO_SELF, .5f))
            duration = 950
            interpolator = android.view.animation.OvershootInterpolator(.65f)
        }
        view.startAnimation(entrance)
        val clock = ValueAnimator.ofFloat(0f, 1f)
        animator = clock
        clock.apply {
            duration = 3000
            interpolator = LinearInterpolator()
            addUpdateListener {
                if (!ValueAnimator.areAnimatorsEnabled()) { stop(); return@addUpdateListener }
                progress = it.animatedValue as Float
                decoration.invalidateSelf()
            }
            addListener(object : android.animation.AnimatorListenerAdapter() {
                override fun onAnimationEnd(animation: android.animation.Animator) { stop() }
            })
            start()
        }
    }
}

/** A deterministic flex-shaped container shared by normal views and scroll content. */
internal class CraftNativeFlexLayout(context: Context) : LinearLayout(context) {
    private var celebration: CraftNativeCelebration? = null
    fun configureCelebration(raw: JSONObject?, radius: Float) {
        if (raw != null && celebration == null) celebration = CraftNativeCelebration(this)
        celebration?.configure(raw, radius)
    }
    override fun onDetachedFromWindow() {
        celebration?.stop()
        super.onDetachedFromWindow()
    }
    override fun onVisibilityChanged(changedView: View, visibility: Int) {
        super.onVisibilityChanged(changedView, visibility)
        if (visibility != View.VISIBLE) celebration?.stop()
    }
    override fun onWindowVisibilityChanged(visibility: Int) {
        super.onWindowVisibilityChanged(visibility)
        if (visibility != View.VISIBLE) celebration?.stop()
    }
    var pageViewport: Pair<Int, Int>? = null
    var onLayoutChanged: (() -> Unit)? = null
    private val styles = mutableMapOf<View, CraftNativeLayoutStyle>()
    private var wrap = false
    private var alignItems = "stretch"
    private var alignContent = "flex-start"
    private var justifyContent = "flex-start"
    private var rowGap = 0f
    private var columnGap = 0f
    private var grid = false
    private var gridColumns = 1
    private var gridRows: Int? = null
    private var gridAutoRows: CraftNativeLength? = null
    private var reverse = false
    private var wrapReverse = false
    private var unboundedWidth = false
    private var authoredPadding = intArrayOf(0, 0, 0, 0)
    private var safeAreaPadding = intArrayOf(0, 0, 0, 0)
    private var applyingPadding = false
    private var safeAreaEdges = setOf("top", "right", "bottom", "left")
    private var shieldedModalTouch = false
    private var dismissibleModalTouch: CraftNativeModalView? = null

    override fun dispatchTouchEvent(event: MotionEvent): Boolean {
        if (event.actionMasked == MotionEvent.ACTION_DOWN) {
            val x = event.x.roundToInt()
            val y = event.y.roundToInt()
            dismissibleModalTouch = (childCount - 1 downTo 0).asSequence()
                .map { getChildAt(it) }
                .filterIsInstance<CraftNativeModalView>()
                .firstOrNull { child ->
                    child.dismissOnOutsideTap && child.visibility == View.VISIBLE && child.alpha > 0.01f
                        && (x < child.left || x >= child.right || y < child.top || y >= child.bottom)
                }
            shieldedModalTouch = (childCount - 1 downTo 0).any { index ->
                val child = getChildAt(index)
                child is CraftNativeModalView && !child.blocksBackground && child.visibility == View.VISIBLE
                    && (x < child.left || x >= child.right || y < child.top || y >= child.bottom)
                    && child.hasBlockingModalBelow()
            }
        }
        dismissibleModalTouch?.let { modal ->
            if (event.actionMasked == MotionEvent.ACTION_UP) {
                modal.requestClose(reason = "backdrop")
                dismissibleModalTouch = null
            } else if (event.actionMasked == MotionEvent.ACTION_CANCEL) {
                dismissibleModalTouch = null
            }
            return true
        }
        if (shieldedModalTouch) {
            if (event.actionMasked == MotionEvent.ACTION_UP || event.actionMasked == MotionEvent.ACTION_CANCEL) shieldedModalTouch = false
            return true
        }
        return super.dispatchTouchEvent(event)
    }

    override fun setPadding(left: Int, top: Int, right: Int, bottom: Int) {
        if (!applyingPadding) authoredPadding = intArrayOf(left, top, right, bottom)
        applyingPadding = true
        super.setPadding(
            left + safeAreaPadding[0],
            top + safeAreaPadding[1],
            right + safeAreaPadding[2],
            bottom + safeAreaPadding[3],
        )
        applyingPadding = false
    }

    fun setSafeAreaEdges(raw: JSONArray?) {
        safeAreaEdges = if (raw == null) {
            setOf("top", "right", "bottom", "left")
        } else {
            (0 until raw.length()).mapNotNull { raw.optString(it).takeIf { edge -> edge in setOf("top", "right", "bottom", "left") } }.toSet()
        }
        applySafeAreaPadding()
        invalidateMeasurements()
    }

    fun setWindowSafeInsets(left: Int, top: Int, right: Int, bottom: Int) {
        val insets = intArrayOf(left, top, right, bottom)
        safeAreaPadding = intArrayOf(
            if ("left" in safeAreaEdges) insets[0] else 0,
            if ("top" in safeAreaEdges) insets[1] else 0,
            if ("right" in safeAreaEdges) insets[2] else 0,
            if ("bottom" in safeAreaEdges) insets[3] else 0,
        )
        applySafeAreaPadding()
        invalidateMeasurements()
    }

    private fun applySafeAreaPadding() {
        setPadding(authoredPadding[0], authoredPadding[1], authoredPadding[2], authoredPadding[3])
    }

    /**
     * What a child measures at a pair of specs, remembered for the frame.
     * `entries` asks each child up to three times (max-content, its target
     * width, its height) and again when laying out; every child doing the
     * same to its own made a deep screen (the Calendar) exponential, and the
     * app stopped responding. Views only change between frames, so within
     * one (the animation clock is locked for a frame's traversal) the same
     * question has the same answer.
     */
    /**
     * Whether this container's width is fixed while it measures (an EXACTLY
     * spec, or a laid-out frame): only then does a column stretch its
     * children to it. Measured for its content width (AT_MOST, a chip in a
     * row), it is as wide as its widest child.
     */
    private var widthDefinite = false

    private class MeasureMemo(var clock: Long = Long.MIN_VALUE, val results: HashMap<Long, Long> = HashMap())
    private val memos = WeakHashMap<View, MeasureMemo>()

    private fun probe(child: View, widthSpec: Int, heightSpec: Int): Long {
        val clock = android.view.animation.AnimationUtils.currentAnimationTimeMillis()
        val memo = memos.getOrPut(child) { MeasureMemo() }
        if (memo.clock != clock) {
            memo.clock = clock
            memo.results.clear()
        }
        val key = (widthSpec.toLong() shl 32) or (heightSpec.toLong() and 0xffffffffL)
        memo.results[key]?.let {
            lastProbe[child] = it
            return it
        }
        child.measure(widthSpec, heightSpec)
        val size = (child.measuredWidth.toLong() shl 32) or (child.measuredHeight.toLong() and 0xffffffffL)
        memo.results[key] = size
        lastProbe[child] = size
        return size
    }
    private val lastProbe = WeakHashMap<View, Long>()
    private fun probedWidth(size: Long): Int = (size shr 32).toInt()
    private fun probedHeight(size: Long): Int = size.toInt()

    /**
     * Reactive style and inset mutations can arrive during one frame. The
     * memo is intentionally frame-scoped for performance, but a mutation
     * must invalidate it immediately or the next layout can reuse a child's
     * old intrinsic width/height.
     */
    private fun invalidateMeasurements() {
        memos.clear()
        lastProbe.clear()
        forceLayout()
        requestLayout()
    }

    companion object {
        /** Clears the memoized measurements of every flex host above `start`. The activity calls it too (an image whose source changed). */
        fun invalidateMeasurementAncestors(start: ViewParent?) {
            var ancestor = start
            while (ancestor != null) {
                when (ancestor) {
                    is CraftNativeFlexLayout -> ancestor.invalidateMeasurements()
                    is CraftNativeKeyboardAvoidingView -> ancestor.content.invalidateMeasurements()
                    is CraftNativeScrollView -> ancestor.invalidateContentLayout()
                }
                ancestor = (ancestor as? View)?.parent
            }
        }
    }

    /**
     * Lays a child out at its final frame, measuring it again at exactly
     * that size first when the measure pass left it another size (a
     * stretched or flex-grown child). A container such as the scroll view's
     * SwipeRefreshLayout lays its own children out from its measured size,
     * so a frame it was never measured at left its content 0 tall.
     */
    private fun place(child: View, left: Int, top: Int, right: Int, bottom: Int) {
        val width = max(0, right - left)
        val height = max(0, bottom - top)
        if (child.measuredWidth != width || child.measuredHeight != height) {
            child.measure(
                View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
                View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY),
            )
        }
        child.layout(left, top, right, bottom)
    }

    /**
     * Resolve an absolute child against the parent's content box before it is
     * placed. In particular, left+right anchors define the child's width; an
     * aspect-ratio child must be measured again at that width or Android can
     * retain the parent's intrinsic height from its first, wider probe.
     */
    private fun absoluteSize(entry: Entry, contentWidth: Int, contentHeight: Int): Pair<Int, Int> {
        val style = entry.style
        val anchoredWidth = style.left != null && style.right != null
        val anchoredHeight = style.top != null && style.bottom != null
        var width = when {
            anchoredWidth -> contentWidth - style.left!! - style.right!!
            style.width != null -> style.width.resolve(contentWidth) ?: entry.width
            style.aspectRatio != null && style.height != null ->
                ((style.height.resolve(contentHeight) ?: entry.height) * style.aspectRatio).roundToInt()
            else -> entry.width
        }
        var height = if (anchoredHeight) contentHeight - style.top!! - style.bottom!! else entry.height
        width = clamp(width, style.minWidth?.resolve(contentWidth), style.maxWidth?.resolve(contentWidth))
        if (!anchoredHeight) {
            height = when {
                style.height != null -> measureChildHeight(entry.view, style, contentHeight, 0, width)
                anchoredWidth && style.aspectRatio != null && style.aspectRatio > 0 ->
                    clamp((width / style.aspectRatio).roundToInt(), style.minHeight?.resolve(contentHeight), style.maxHeight?.resolve(contentHeight))
                else -> measureChildHeight(entry.view, style, contentHeight, 0, width)
            }
        }
        height = clamp(height, style.minHeight?.resolve(contentHeight), style.maxHeight?.resolve(contentHeight))
        return max(0, width) to max(0, height)
    }

    override fun drawChild(canvas: Canvas, child: View, drawingTime: Long): Boolean {
        val skew = CraftNativeSkewTransforms.matrix(child) ?: return super.drawChild(canvas, child, drawingTime)
        val save = canvas.save()
        canvas.concat(skew)
        val drawn = super.drawChild(canvas, child, drawingTime)
        canvas.restoreToCount(save)
        return drawn
    }

    fun configure(style: JSONObject, density: Float) {
        val flexDirection = craftNativeOptionalString(style.opt("flexDirection")).orEmpty()
        orientation = if (flexDirection in setOf("row", "row-reverse")) HORIZONTAL else VERTICAL
        reverse = flexDirection.endsWith("-reverse")
        val flexWrap = craftNativeOptionalString(style.opt("flexWrap")).orEmpty()
        wrap = flexWrap == "wrap" || flexWrap == "wrap-reverse" || craftNativeBoolean(style.opt("flexWrap"))
        wrapReverse = flexWrap == "wrap-reverse"
        alignItems = craftNativeOptionalString(style.opt("alignItems")) ?: "stretch"
        alignContent = craftNativeOptionalString(style.opt("alignContent")) ?: "flex-start"
        justifyContent = craftNativeOptionalString(style.opt("justifyContent")) ?: "flex-start"
        fun spacing(name: String, fallback: Float): Float {
            val value = craftNativeNumber(style.opt(name)) ?: Double.NaN
            val pixels = value * density
            val narrowed = pixels.toFloat()
            return if (value.isFinite() && value >= 0 && pixels.isFinite() && narrowed.isFinite()) narrowed else fallback
        }
        val gap = spacing("gap", 0f)
        rowGap = spacing("rowGap", gap)
        columnGap = spacing("columnGap", gap)
        grid = craftNativeOptionalString(style.opt("display")) == "grid"
        gridColumns = craftNativeGridColumnCount(
            if (style.has("gridTemplateColumns")) style.opt("gridTemplateColumns") else style.opt("gridColumns")
        )
        gridRows = craftNativeGridRowCount(style.opt("gridTemplateRows"))
        gridAutoRows = CraftNativeLength.from(style.opt("gridAutoRows"), density)
