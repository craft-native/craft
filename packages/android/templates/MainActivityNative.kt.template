        val horizontal = craftNativePadding(style, "paddingHorizontal", all, density)
        val vertical = craftNativePadding(style, "paddingVertical", all, density)
        setPadding(
            craftNativePadding(style, "paddingLeft", horizontal, density),
            craftNativePadding(style, "paddingTop", vertical, density),
            craftNativePadding(style, "paddingRight", horizontal, density),
            craftNativePadding(style, "paddingBottom", vertical, density),
        )
        invalidateMeasurements()
    }

    /** A horizontal scroll host measures its content beyond the viewport. */
    fun setUnboundedWidth(value: Boolean) {
        if (unboundedWidth == value) return
        unboundedWidth = value
        invalidateMeasurements()
    }

    private var viewportChild: View? = null

    fun setViewportChild(view: View?) {
        viewportChild = view
        invalidateMeasurements()
    }

    fun setChildStyle(view: View, style: JSONObject, density: Float) {
        val effective = if (view === viewportChild) craftNativeScreenRootStyle(style) else style
        styles[view] = CraftNativeLayoutStyle.from(effective, density)
        invalidateMeasurements()
        invalidateMeasurementAncestors(parent)
    }

    override fun onViewRemoved(child: View) {
        val parentBeforeRemoval = parent
        if (child === viewportChild) viewportChild = null
        styles.remove(child)
        super.onViewRemoved(child)
        invalidateMeasurements()
        invalidateMeasurementAncestors(parentBeforeRemoval)
    }

    override fun onViewAdded(child: View) {
        super.onViewAdded(child)
        invalidateMeasurements()
        invalidateMeasurementAncestors(parent)
    }

    /** Flex/grid order with Kotlin's stable sort retaining source order for ties. */
    private fun orderedChildIndices(): List<Int> = (0 until childCount).sortedWith(
        compareBy<Int> { styles[getChildAt(it)]?.order ?: 0 }.thenBy { it },
    )

    private data class Entry(val view: View, val style: CraftNativeLayoutStyle, val width: Int, val height: Int)
    private data class Line(val entries: MutableList<Entry> = mutableListOf(), var main: Float = 0f, var cross: Float = 0f)
    private data class GridLayout(val rows: List<List<Entry>>, val absolute: List<Entry>, val cellWidth: Float, val rowHeights: List<Float>)

    private fun entries(width: Int, height: Int): Pair<List<Line>, List<Entry>> {
        val availableMain = if (orientation == HORIZONTAL) max(0, width - paddingLeft - paddingRight)
        else max(0, height - paddingTop - paddingBottom)
        val gap = if (orientation == HORIZONTAL) columnGap else rowGap
        val lines = mutableListOf<Line>()
        val absolute = mutableListOf<Entry>()
        val pending = mutableListOf<Entry>()
        for (index in orderedChildIndices()) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            if (child is CraftNativeModalView) {
                if (child.blocksBackground) {
                    val modalWidth = max(0, width - paddingLeft - paddingRight)
                    val modalHeight = max(0, height - paddingTop - paddingBottom)
                    child.measure(
                        View.MeasureSpec.makeMeasureSpec(modalWidth, View.MeasureSpec.EXACTLY),
                        View.MeasureSpec.makeMeasureSpec(modalHeight, View.MeasureSpec.EXACTLY),
                    )
                    absolute += Entry(child, style, modalWidth, modalHeight)
                } else {
                    // A non-modal popup is still promoted to the screen root,
                    // but its authored absolute style controls its viewport
                    // frame instead of turning it into a full-screen child.
                    // The root content box is the same screenViewport origin
                    // returned by View.measure; safe-area padding is not
                    // injected a second time here.
                    val childWidth = measureChildWidth(child, style, width - paddingLeft - paddingRight, horizontalMargins)
                    val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
                    absolute += Entry(child, style, childWidth, childHeight)
                }
                continue
            }
            val childWidth = measureChildWidth(child, style, width - paddingLeft - paddingRight, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
            val entry = Entry(child, style, childWidth, childHeight)
            if (style.position == "absolute") { absolute += entry; continue }
            pending += entry
        }
        if (pending.isNotEmpty()) {
            val basis = pending.map { entry ->
                if (orientation == HORIZONTAL) entry.width.toFloat() else entry.height.toFloat()
            }.toFloatArray()
            val margins = pending.flatMap { entry ->
                val lp = entry.view.layoutParams as? MarginLayoutParams
                if (orientation == HORIZONTAL) listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat())
                else listOf((lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
            }.toFloatArray()
            val sharedLineIds = CraftNative.flexLines(availableMain.toFloat(), gap.toFloat(), wrap, basis, margins)
            val lineIds = sharedLineIds?.takeIf { ids ->
                ids.size >= pending.size && ids.firstOrNull() == 0 &&
                    ids.indices.drop(1).all { index -> ids[index] >= ids[index - 1] }
            }
            var line = Line()
            pending.forEachIndexed { index, entry ->
                val childMain = if (orientation == HORIZONTAL) entry.width.toFloat() + margins[index * 2] + margins[index * 2 + 1]
                else entry.height.toFloat() + margins[index * 2] + margins[index * 2 + 1]
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val crossMargins = if (orientation == HORIZONTAL) (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                else (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                val childCross = if (orientation == HORIZONTAL) entry.height + crossMargins else entry.width + crossMargins
                if (index > 0 && lineIds != null && lineIds[index] != lineIds[index - 1]) {
                    lines += line
                    line = Line()
                } else if (index > 0 && lineIds == null && wrap && line.entries.isNotEmpty() && line.main + gap + childMain > availableMain + 0.5f * (line.entries.size + 1)) {
                    // Each size is rounded to whole pixels, up to half a pixel
                    // over: two 60-point items fill a 120-point row exactly
                    // in points, and at 2.625 pixels per point (157.5 + 157.5
                    // in 315) rounding alone must not wrap the second.
                    lines += line
                    line = Line()
                }
                line.entries += entry
                line.main = if (line.entries.size == 1) childMain else line.main + gap + childMain
                line.cross = max(line.cross, childCross.toFloat())
            }
            if (line.entries.isNotEmpty()) lines += line
        }
        // A row's items take their widths from the line (`flex-1` starts
        // from a zero basis), and text wraps to the width it gets: measured
        // at its basis, a `flex-1` column of text was a word per line and
        // thousands of pixels tall. Heights are measured again at the width
        // each item will have.
        if (orientation == HORIZONTAL && width < 500_000) {
            for (line in lines) {
                val widths = fallbackFlexWidths(line, availableMain, gap)
                for (index in line.entries.indices) {
                    val entry = line.entries[index]
                    val given = widths.getOrNull(index) ?: continue
                    if (given == entry.width || entry.style.height != null) continue
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                    val remeasured = measureChildHeight(entry.view, entry.style, height - paddingTop - paddingBottom, verticalMargins, max(0, given))
                    line.entries[index] = entry.copy(height = remeasured)
                }
                line.cross = line.entries.maxOfOrNull { entry ->
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    (entry.height + (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)).toFloat()
                } ?: 0f
            }
        }
        // Reconciliation reverses the child order so the main axis runs in
        // the requested direction. With wrapping, that also reverses the
        // line order; flexbox keeps wrap lines in cross-axis order, so restore
        // the groups while retaining the reversed entries inside each line.
        if (reverse && wrap && lines.size > 1) lines.reverse()
        return lines to absolute
    }

    private fun gridLayout(width: Int, height: Int): GridLayout {
        val availableWidth = max(0, width - paddingLeft - paddingRight)
        val gap = columnGap
        val cellWidth = max(0f, (availableWidth.toFloat() - max(0, gridColumns - 1) * gap) / max(1, gridColumns).toFloat())
        val rows = mutableListOf<MutableList<Entry>>()
        val absolute = mutableListOf<Entry>()
        for (index in orderedChildIndices()) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            if (child is CraftNativeModalView) {
                if (child.blocksBackground) {
                    val modalWidth = max(0, width - paddingLeft - paddingRight)
                    val modalHeight = max(0, height - paddingTop - paddingBottom)
                    child.measure(
                        View.MeasureSpec.makeMeasureSpec(modalWidth, View.MeasureSpec.EXACTLY),
                        View.MeasureSpec.makeMeasureSpec(modalHeight, View.MeasureSpec.EXACTLY),
                    )
                    absolute += Entry(child, style, modalWidth, modalHeight)
                } else {
                    val childWidth = measureChildWidth(child, style, width - paddingLeft - paddingRight, horizontalMargins)
                    val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
                    absolute += Entry(child, style, childWidth, childHeight)
                }
                continue
            }
            val childWidth = measureChildWidth(child, style, cellWidth.roundToInt(), horizontalMargins)
            val childHeight = measureChildHeight(child, style, height - paddingTop - paddingBottom, verticalMargins)
            val entry = Entry(child, style, childWidth, childHeight)
            if (style.position == "absolute") absolute += entry
            else {
                if (rows.isEmpty() || rows.last().size == gridColumns) rows.add(mutableListOf())
                rows.last() += entry
            }
        }
        val naturalRowHeights = rows.map { row ->
            max((gridAutoRows?.resolve(height - paddingTop - paddingBottom) ?: 0).toFloat(), row.maxOfOrNull { entry ->
                val lp = entry.view.layoutParams as? MarginLayoutParams
                (entry.height + (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)).toFloat()
            } ?: 0f)
        }
        val rowHeights = if (gridRows != null) {
            val count = max(gridRows ?: 0, naturalRowHeights.size)
            while (rows.size < count) rows.add(mutableListOf())
            val available = max(0f, (height - paddingTop - paddingBottom).toFloat() - max(0, count - 1) * rowGap)
            val equal = available / max(1, count).toFloat()
            (naturalRowHeights + List(count - naturalRowHeights.size) { 0f })
                .map { max(it, equal) }
        } else naturalRowHeights
        return GridLayout(rows, absolute, cellWidth, rowHeights)
    }

    private fun gridIntrinsicSize(height: Int): Pair<Int, Int> {
        val columns = max(1, gridColumns)
        val columnWidths = IntArray(columns)
        val rowHeights = mutableListOf<Int>()
        var flowIndex = 0
        for (index in orderedChildIndices()) {
            val child = getChildAt(index)
            if (child.visibility == GONE) continue
            val style = styles[child] ?: CraftNativeLayoutStyle()
            if (style.position == "absolute" || child is CraftNativeModalView) continue
            val lp = child.layoutParams as? MarginLayoutParams
            val horizontalMargins = (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            val verticalMargins = (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            val childWidth = measureChildWidth(child, style, 1_000_000, horizontalMargins)
            val childHeight = measureChildHeight(child, style, height, verticalMargins)
            val column = flowIndex % columns
            val row = flowIndex / columns
            while (rowHeights.size <= row) rowHeights += gridAutoRows?.resolve(null) ?: 0
            columnWidths[column] = max(columnWidths[column], childWidth + horizontalMargins)
            rowHeights[row] = max(rowHeights[row], childHeight + verticalMargins)
            flowIndex += 1
        }
        val cellWidth = columnWidths.maxOrNull() ?: 0
        val width = paddingLeft + paddingRight + cellWidth * columns + (max(0, columns - 1) * columnGap).roundToInt()
        val rowGapTotal = max(0, rowHeights.size - 1) * rowGap
        val measuredHeight = paddingTop + paddingBottom + rowHeights.sum() + rowGapTotal.roundToInt()
        return width to measuredHeight
    }

    private fun measureChildWidth(child: View, style: CraftNativeLayoutStyle, available: Int, margins: Int): Int {
        val base = max(0, available - margins)
        val flexBasis = if (orientation == HORIZONTAL) style.flexBasis?.resolve(base) else null
        // The STX style is authoritative. A reused View may still carry a
        // previous fixed LayoutParams width after a reactive width is removed;
        // using that value here prevents intrinsic sizing from being restored.
        val authored = style.width?.resolve(base)
        val explicit = authored ?: style.aspectRatio?.let { ratio -> style.height?.resolve(base)?.times(ratio)?.roundToInt() } ?: flexBasis
        if (explicit != null) {
            probe(
                child,
                View.MeasureSpec.makeMeasureSpec(explicit, View.MeasureSpec.EXACTLY),
                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
            )
            return clamp(explicit, style.minWidth?.resolve(base), style.maxWidth?.resolve(base))
        }
        // A column of a definite width stretches its children across
        // (`align-items: stretch`, the default): they are as wide as the
        // column, not as wide as their content, and what they hold wraps to that width. Measured at their
        // content width, a row with a `flex-1` text column measured as a word
        // per line and stayed that tall once stretched.
        if (orientation == VERTICAL && widthDefinite && style.position != "absolute" && (style.alignSelf ?: alignItems) == "stretch" && base < 500_000 && child !is CraftNativeModalView) {
            val stretched = clamp(base, style.minWidth?.resolve(base), style.maxWidth?.resolve(base))
            probe(
                child,
                View.MeasureSpec.makeMeasureSpec(stretched, View.MeasureSpec.EXACTLY),
                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
            )
            return stretched
        }
        // Measure text and nested flex containers at max-content first. An
        // AT_MOST spec equal to the available room can make Android report the
        // longest-word (min-content) width for a wrapping TextView, collapsing
        // shrink-to-fit bubbles and pills before the parent can clamp them.
        val intrinsicSpec = if (child is TextView && child !is EditText) 1_000_000 else base
        val intrinsic = probe(
            child,
            View.MeasureSpec.makeMeasureSpec(intrinsicSpec, View.MeasureSpec.AT_MOST),
            View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
        )
        val target = clamp(min(base, probedWidth(intrinsic)), style.minWidth?.resolve(base), style.maxWidth?.resolve(base))
        probe(
            child,
            View.MeasureSpec.makeMeasureSpec(target, View.MeasureSpec.AT_MOST),
            View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED),
        )
        return target
    }

    private fun measureChildHeight(child: View, style: CraftNativeLayoutStyle, available: Int, margins: Int, widthOverride: Int? = null): Int {
        val base = max(0, available - margins)
        val flexBasis = if (orientation == VERTICAL) style.flexBasis?.resolve(base) else null
        // Match width measurement: do not let stale native LayoutParams keep
        // a removed reactive height fixed.
        val authored = style.height?.resolve(base)
        val explicit = authored ?: style.aspectRatio?.let { ratio -> style.width?.resolve(base)?.div(ratio)?.roundToInt() } ?: flexBasis
        val target = explicit ?: base
        val spec = if (explicit != null) View.MeasureSpec.makeMeasureSpec(target, View.MeasureSpec.EXACTLY)
        else View.MeasureSpec.makeMeasureSpec(base, View.MeasureSpec.AT_MOST)
        val width = widthOverride ?: lastProbe[child]?.let(::probedWidth) ?: child.measuredWidth
        val size = probe(child, View.MeasureSpec.makeMeasureSpec(max(0, width), View.MeasureSpec.EXACTLY), spec)
        return clamp(if (explicit != null) target else probedHeight(size), style.minHeight?.resolve(base), style.maxHeight?.resolve(base))
    }

    private fun clamp(value: Int, lower: Int?, upper: Int?): Int {
        var result = value
        if (lower != null) result = max(result, lower)
        if (upper != null) result = min(result, upper)
        return result
    }

    private fun defaultFlexShrink(view: View, horizontal: Boolean = orientation == HORIZONTAL): Double = when {
        view is ScrollView || view is HorizontalScrollView -> 1.0
        view is TextView && view !is Button && view !is EditText && horizontal -> 1.0
        else -> 0.0
    }

    private fun sharedAlignItemsCode(value: String): Int = when (value) {
        "center" -> 1
        "flex-end" -> 2
        "stretch" -> 3
        "baseline" -> 4
        else -> 0
    }

    private fun sharedAlignSelfCode(value: String?): Int = when (value) {
        "flex-start" -> 1
        "center" -> 2
        "flex-end" -> 3
        "stretch" -> 4
        "baseline" -> 5
        else -> 0
    }

    private fun sharedLength(value: CraftNativeLength?, base: Int?): Float = value?.resolve(base)?.toFloat() ?: Float.NaN

    /** A measured node in the host-neutral tree ABI, retaining its native view
     * so the returned absolute frames can be mounted back into the hierarchy. */
    private data class SharedTreeNode(
        val view: View?,
        val style: CraftNativeLayoutStyle,
        val intrinsicWidth: Float,
        val intrinsicHeight: Float,
        val baseline: Float,
        val direction: Int,
        val gap: Float,
        val rowGap: Float,
        val columnGap: Float,
        val wrap: Boolean,
        val justify: String,
        val alignItems: String,
        val alignContent: String,
        val padding: IntArray,
        val margins: IntArray,
        val grid: Boolean,
        val gridColumns: Int,
        val gridAutoRows: CraftNativeLength?,
        val gridRows: Int?,
        val reverse: Boolean,
        val wrapReverse: Boolean,
        val children: List<SharedTreeNode>,
    )

    private data class SharedTreeResult(
        val nodes: List<SharedTreeNode>,
        val parents: IntArray,
        val frames: FloatArray,
    )

    /** Flatten a flex or equal-track grid subtree for the shared ABI. */
    private fun sharedTreeChildren(width: Int, height: Int): List<Entry>? {
        if (grid) {
            val layout = gridLayout(width, height)
            if (layout.absolute.isNotEmpty()) return null
            return layout.rows.flatten()
        }
        val (lines, absolute) = entries(width, height)
        if (absolute.isNotEmpty()) return null
        return lines.flatMap { it.entries }
    }

    private fun sharedTreeNode(entry: Entry): SharedTreeNode? {
        val nested = entry.view as? CraftNativeFlexLayout
        val children = if (nested == null) {
            emptyList()
        } else {
            nested.sharedTreeChildren(entry.width, entry.height) ?: return null
        }
        val lp = entry.view.layoutParams as? MarginLayoutParams
        return SharedTreeNode(
            view = entry.view,
            style = entry.style,
            intrinsicWidth = entry.width.toFloat(),
            intrinsicHeight = entry.height.toFloat(),
            baseline = baselineOffset(entry.view, entry.height).toFloat(),
            direction = nested?.let { if (it.orientation == HORIZONTAL) 0 else 1 } ?: 0,
            gap = nested?.let { if (it.orientation == HORIZONTAL) it.columnGap else it.rowGap } ?: 0f,
            rowGap = nested?.rowGap ?: 0f,
            columnGap = nested?.columnGap ?: 0f,
            wrap = nested?.wrap ?: false,
            justify = nested?.justifyContent ?: "flex-start",
            alignItems = nested?.alignItems ?: "stretch",
            alignContent = nested?.alignContent ?: "flex-start",
            padding = nested?.let { intArrayOf(it.paddingLeft, it.paddingRight, it.paddingTop, it.paddingBottom) }
                ?: intArrayOf(0, 0, 0, 0),
            margins = intArrayOf(lp?.leftMargin ?: 0, lp?.rightMargin ?: 0, lp?.topMargin ?: 0, lp?.bottomMargin ?: 0),
            grid = nested?.grid ?: false,
            gridColumns = nested?.gridColumns ?: 1,
            gridAutoRows = nested?.gridAutoRows,
            gridRows = nested?.gridRows,
            reverse = nested?.reverse ?: false,
            wrapReverse = nested?.wrapReverse ?: false,
            children = children.map { child -> sharedTreeNode(child) ?: return null },
        )
    }

    private fun sharedTreeFrames(entries: List<Entry>, width: Int, height: Int): SharedTreeResult? {
        if (entries.isEmpty() || width < 0 || height < 0) return null
        val children = entries.map { sharedTreeNode(it) ?: return null }
        val root = SharedTreeNode(
            view = null,
            style = CraftNativeLayoutStyle(),
            intrinsicWidth = 0f,
            intrinsicHeight = 0f,
            baseline = 0f,
            direction = if (orientation == HORIZONTAL) 0 else 1,
            gap = if (orientation == HORIZONTAL) columnGap else rowGap,
            rowGap = rowGap,
            columnGap = columnGap,
            wrap = wrap,
            justify = justifyContent,
            alignItems = alignItems,
            alignContent = alignContent,
            padding = intArrayOf(paddingLeft, paddingRight, paddingTop, paddingBottom),
            margins = intArrayOf(0, 0, 0, 0),
            grid = grid,
            gridColumns = gridColumns,
            gridAutoRows = gridAutoRows,
            gridRows = gridRows,
            reverse = reverse,
            wrapReverse = wrapReverse,
            children = children,
        )
        val nodes = mutableListOf<SharedTreeNode>()
        val parents = mutableListOf<Int>()
        fun append(node: SharedTreeNode, parent: Int) {
            val index = nodes.size
            nodes += node
            parents += parent
            node.children.forEach { child -> append(child, index) }
        }
        append(root, -1)
        val reverseAware = nodes.any { it.reverse || it.wrapReverse }
        val wrapReverseAware = nodes.any { it.wrapReverse }
        val autoRowsAware = nodes.any { it.gridAutoRows != null }
        val explicitRowsAware = nodes.any { it.gridRows != null }
        val fields = when {
            explicitRowsAware -> 35
            autoRowsAware -> 34
            reverseAware -> 33
            else -> 32
        }
        val nodeData = FloatArray(nodes.size * fields) { Float.NaN }
        val treeMeta = FloatArray(nodes.size * 2)
        fun enumBits(value: Int): Float = Float.fromBits(value)
        fun put(base: Int, index: Int, value: Float) { nodeData[base + index] = value }
        fun putEnum(base: Int, index: Int, value: Int) { put(base, index, enumBits(value)) }
        var cursor = 0
        fun write(node: SharedTreeNode, parentWidth: Int, parentHeight: Int, rootNode: Boolean, parentDirection: Int) {
            val index = cursor++
            val base = index * fields
            val measuredWidth = if (rootNode) width else node.style.width?.resolve(parentWidth) ?: node.intrinsicWidth.roundToInt()
            val measuredHeight = if (rootNode) height else node.style.height?.resolve(parentHeight) ?: node.intrinsicHeight.roundToInt()
            val contentWidth = max(0, measuredWidth - node.padding[0] - node.padding[1])
            val contentHeight = max(0, measuredHeight - node.padding[2] - node.padding[3])
            val mainSize = if (node.direction == 0) contentWidth else contentHeight
            putEnum(base, 0, node.direction)
            put(base, 1, if (rootNode) width.toFloat() else sharedLength(node.style.width, parentWidth))
            put(base, 2, if (rootNode) height.toFloat() else sharedLength(node.style.height, parentHeight))
            put(base, 3, if (rootNode) Float.NaN else node.intrinsicWidth)
            put(base, 4, if (rootNode) Float.NaN else node.intrinsicHeight)
            put(base, 5, if (rootNode) Float.NaN else node.baseline)
            put(base, 6, node.style.aspectRatio?.toFloat() ?: Float.NaN)
            put(base, 7, sharedLength(node.style.flexBasis, mainSize))
            put(base, 8, if (rootNode) 0f else node.style.flexGrow.toFloat().coerceAtLeast(0f))
            put(base, 9, if (rootNode) 0f else (node.style.flexShrink ?: node.view?.let { defaultFlexShrink(it, parentDirection == 0) } ?: 0.0).toFloat().coerceAtLeast(0f))
            put(base, 10, sharedLength(node.style.minWidth, contentWidth))
            put(base, 11, sharedLength(node.style.maxWidth, contentWidth))
            put(base, 12, sharedLength(node.style.minHeight, contentHeight))
            put(base, 13, sharedLength(node.style.maxHeight, contentHeight))
            put(base, 14, node.gap)
            putEnum(base, 15, sharedJustifyCode(node.justify))
            putEnum(base, 16, sharedAlignItemsCode(node.alignItems))
            putEnum(base, 17, if (rootNode) 0 else sharedAlignSelfCode(node.style.alignSelf))
            putEnum(base, 18, if (node.wrap) 1 else 0)
            putEnum(base, 19, sharedAlignContentCode(node.alignContent))
            put(base, 20, node.margins[2].toFloat())
            put(base, 21, node.margins[1].toFloat())
            put(base, 22, node.margins[3].toFloat())
            put(base, 23, node.margins[0].toFloat())
            put(base, 24, node.padding[2].toFloat())
            put(base, 25, node.padding[1].toFloat())
            put(base, 26, node.padding[3].toFloat())
            put(base, 27, node.padding[0].toFloat())
            putEnum(base, 28, if (node.grid) 1 else 0)
            putEnum(base, 29, node.gridColumns)
            put(base, 30, node.rowGap)
            put(base, 31, node.columnGap)
            if (fields >= 33) putEnum(base, 32, (if (node.reverse) 1 else 0) or (if (node.wrapReverse) 2 else 0))
            if (autoRowsAware) put(base, 33, sharedLength(node.gridAutoRows, contentHeight))
            if (explicitRowsAware) putEnum(base, 34, node.gridRows ?: 0)
            val firstChild = cursor
            node.children.forEach { child -> write(child, contentWidth, contentHeight, false, node.direction) }
            treeMeta[index * 2] = firstChild.toFloat()
            treeMeta[index * 2 + 1] = (cursor - firstChild).toFloat()
        }
        write(root, width, height, true, root.direction)
        val frames = (if (explicitRowsAware) {
            CraftNative.layoutTreeV5(width.toFloat(), height.toFloat(), nodeData, treeMeta)
        } else if (autoRowsAware) {
            CraftNative.layoutTreeV4(width.toFloat(), height.toFloat(), nodeData, treeMeta)
        } else if (wrapReverseAware) {
            CraftNative.layoutTreeV3(width.toFloat(), height.toFloat(), nodeData, treeMeta)
        } else if (reverseAware) {
            CraftNative.layoutTreeV2(width.toFloat(), height.toFloat(), nodeData, treeMeta)
        } else {
            CraftNative.layoutTree(width.toFloat(), height.toFloat(), nodeData, treeMeta)
        }) ?: return null
        return SharedTreeResult(nodes, parents.toIntArray(), frames)
    }

    /**
     * Use the host-neutral tree ABI when platform measurements are complete:
     * definite direct-child containers, including wrapped flows, equal-track
     * grids, independent row and column gaps, and grid-auto-rows. Absolute
     * children, missing runtimes, and malformed results deliberately fall
     * through to the established Kotlin layout below.
     */
    private fun sharedDirectFrames(entries: List<Entry>, width: Int, height: Int): FloatArray? {
        if (entries.isEmpty() || width < 0 || height < 0 || grid || reverse || wrapReverse || gridAutoRows != null) return null
        val count = entries.size + 1
        val fields = 32
        val nodeData = FloatArray(count * fields) { Float.NaN }
        val treeMeta = FloatArray(count * 2)
        fun enumBits(value: Int): Float = Float.fromBits(value)
        fun put(base: Int, index: Int, value: Float) { nodeData[base + index] = value }
        fun putEnum(base: Int, index: Int, value: Int) { put(base, index, enumBits(value)) }
        val contentWidth = max(0, width - paddingLeft - paddingRight)
        val contentHeight = max(0, height - paddingTop - paddingBottom)
        val mainSize = if (orientation == HORIZONTAL) contentWidth else contentHeight
        fun writeStyle(
            base: Int,
            style: CraftNativeLayoutStyle,
            intrinsicWidth: Float,
            intrinsicHeight: Float,
            baseline: Float,
            margins: IntArray,
            direction: Int,
            padding: IntArray,
            gap: Float,
            rowGapValue: Float,
            columnGapValue: Float,
            root: Boolean,
            view: View?,
        ) {
            putEnum(base, 0, direction)
            put(base, 1, if (root) width.toFloat() else sharedLength(style.width, contentWidth))
            put(base, 2, if (root) height.toFloat() else sharedLength(style.height, contentHeight))
            put(base, 3, if (root) Float.NaN else intrinsicWidth)
            put(base, 4, if (root) Float.NaN else intrinsicHeight)
            put(base, 5, if (root) Float.NaN else baseline)
            put(base, 6, style.aspectRatio?.toFloat() ?: Float.NaN)
            put(base, 7, sharedLength(style.flexBasis, mainSize))
            put(base, 8, if (root) 0f else style.flexGrow.toFloat().coerceAtLeast(0f))
            put(base, 9, if (root) 0f else (style.flexShrink ?: view?.let { defaultFlexShrink(it) } ?: 0.0).toFloat().coerceAtLeast(0f))
            put(base, 10, sharedLength(style.minWidth, contentWidth))
            put(base, 11, sharedLength(style.maxWidth, contentWidth))
            put(base, 12, sharedLength(style.minHeight, contentHeight))
            put(base, 13, sharedLength(style.maxHeight, contentHeight))
            put(base, 14, if (root) gap else 0f)
            putEnum(base, 15, if (root) justifyCode() else 0)
            putEnum(base, 16, if (root) sharedAlignItemsCode(alignItems) else 3)
            putEnum(base, 17, if (root) 0 else sharedAlignSelfCode(style.alignSelf))
            putEnum(base, 18, if (root && wrap) 1 else 0)
            putEnum(base, 19, if (root) alignContentCode() else 5)
            put(base, 20, margins[2].toFloat())
            put(base, 21, margins[1].toFloat())
            put(base, 22, margins[3].toFloat())
            put(base, 23, margins[0].toFloat())
            put(base, 24, padding[2].toFloat())
            put(base, 25, padding[1].toFloat())
            put(base, 26, padding[3].toFloat())
            put(base, 27, padding[0].toFloat())
            putEnum(base, 28, 0)
            putEnum(base, 29, 1)
            put(base, 30, if (root) rowGapValue else 0f)
            put(base, 31, if (root) columnGapValue else 0f)
        }

        treeMeta[0] = 1f
        treeMeta[1] = entries.size.toFloat()
        val rootMargins = intArrayOf(0, 0, 0, 0)
        val rootPadding = intArrayOf(paddingLeft, paddingRight, paddingTop, paddingBottom)
        val mainGap = if (orientation == HORIZONTAL) columnGap else rowGap
        writeStyle(
            0, CraftNativeLayoutStyle(), 0f, 0f, 0f, rootMargins,
            if (orientation == HORIZONTAL) 0 else 1, rootPadding, mainGap, rowGap, columnGap, true, null,
        )
        entries.forEachIndexed { index, entry ->
            val base = (index + 1) * fields
            val lp = entry.view.layoutParams as? MarginLayoutParams
            val margins = intArrayOf(lp?.leftMargin ?: 0, lp?.rightMargin ?: 0, lp?.topMargin ?: 0, lp?.bottomMargin ?: 0)
            treeMeta[(index + 1) * 2] = 0f
            treeMeta[(index + 1) * 2 + 1] = 0f
            writeStyle(
                base, entry.style, entry.width.toFloat(), entry.height.toFloat(), baselineOffset(entry.view, entry.height).toFloat(),
                margins, 0, intArrayOf(0, 0, 0, 0), 0f, 0f, 0f, false, entry.view,
            )
        }
        return CraftNative.layoutTree(width.toFloat(), height.toFloat(), nodeData, treeMeta)
    }

    private fun justifyCode(): Int = when (justifyContent) {
        "center" -> 1
        "flex-end" -> 2
        "space-between" -> 3
        "space-around" -> 4
        "space-evenly" -> 5
        else -> 0
    }

    private fun sharedJustifyCode(value: String): Int = when (value) {
        "center" -> 1
        "flex-end" -> 2
        "space-between" -> 3
        "space-around" -> 4
        "space-evenly" -> 5
        else -> 0
    }

    private fun alignContentCode(): Int = when (alignContent) {
        "center" -> 1
        "flex-end" -> 2
        "space-between" -> 3
        "space-around" -> 4
        "stretch" -> 5
        "space-evenly" -> 6
        else -> 0
    }

    private fun sharedAlignContentCode(value: String): Int = when (value) {
        "center" -> 1
        "flex-end" -> 2
        "space-between" -> 3
        "space-around" -> 4
        "stretch" -> 5
        "space-evenly" -> 6
        else -> 0
    }

    /** Keep the old-runtime shim on the same bounded-flex water-fill rule as the Zig bridge. */
    private fun fallbackFlexWidths(line: Line, available: Int, gap: Float): IntArray {
        val horizontal = orientation == HORIZONTAL
        val hypothetical = line.entries.sumOf { entry ->
            val lp = entry.view.layoutParams as? MarginLayoutParams
            val margins = if (horizontal) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
            else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
            ((if (horizontal) entry.width else entry.height) + margins).toDouble()
        } + max(0, line.entries.size - 1) * gap.toDouble()
        val free = available.toDouble() - hypothetical
        val growTotal = line.entries.sumOf { it.style.flexGrow }
        val shrinkTotal = line.entries.sumOf {
            (it.style.flexShrink ?: defaultFlexShrink(it.view)) * (if (horizontal) it.width else it.height)
        }
        val growing = free > 0 && growTotal > 0
        val shrinking = free < 0 && shrinkTotal > 0
        val widths = IntArray(line.entries.size) { index -> if (horizontal) line.entries[index].width else line.entries[index].height }
        if (!growing && !shrinking) return widths

        val frozen = BooleanArray(widths.size)
        repeat(widths.size + 1) {
            var fixed = max(0, widths.size - 1) * gap.toDouble()
            var activeBasis = 0.0
            var factor = 0.0
            for ((index, entry) in line.entries.withIndex()) {
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val margins = if (horizontal) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                fixed += margins
                if (frozen[index]) fixed += widths[index]
                else {
                    val basis = if (horizontal) entry.width else entry.height
                    activeBasis += basis
                    factor += if (growing) entry.style.flexGrow
                    else (entry.style.flexShrink ?: defaultFlexShrink(entry.view)) * basis
                }
            }
            if (factor <= 0) return@repeat
            val remaining = available.toDouble() - fixed - activeBasis
            var froze = false
            for ((index, entry) in line.entries.withIndex()) {
                if (frozen[index]) continue
                val basis = (if (horizontal) entry.width else entry.height).toDouble()
                val share = if (growing) remaining * entry.style.flexGrow / factor
                else -remaining * (entry.style.flexShrink ?: defaultFlexShrink(entry.view)) * basis / factor
                val raw = if (growing) basis + share else basis - share
                val lower = (if (horizontal) entry.style.minWidth else entry.style.minHeight)?.resolve(if (horizontal) width - paddingLeft - paddingRight else height - paddingTop - paddingBottom)
                val upper = (if (horizontal) entry.style.maxWidth else entry.style.maxHeight)?.resolve(if (horizontal) width - paddingLeft - paddingRight else height - paddingTop - paddingBottom)
                var bounded = raw
                if (lower != null) bounded = max(bounded, lower.toDouble())
                if (upper != null) bounded = min(bounded, upper.toDouble())
                widths[index] = bounded.roundToInt().coerceAtLeast(0)
                if (bounded != raw) {
                    frozen[index] = true
                    froze = true
                }
            }
            if (!froze) return@repeat
        }
        return widths
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        pageViewport?.let { (pageWidth, pageHeight) ->
            val pages = (0 until childCount).map { getChildAt(it) }.filter { it.visibility != View.GONE }
            pages.forEach { it.measure(MeasureSpec.makeMeasureSpec(pageWidth, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(pageHeight, MeasureSpec.EXACTLY)) }
            setMeasuredDimension(pageWidth * pages.size, pageHeight)
            return
        }
        val unboundedHorizontal = unboundedWidth && orientation == HORIZONTAL
        val widthMode = if (unboundedHorizontal) View.MeasureSpec.UNSPECIFIED else View.MeasureSpec.getMode(widthMeasureSpec)
        widthDefinite = widthMode == View.MeasureSpec.EXACTLY
        val width = View.MeasureSpec.getSize(widthMeasureSpec).takeUnless { widthMode == View.MeasureSpec.UNSPECIFIED } ?: 1_000_000
        val height = View.MeasureSpec.getSize(heightMeasureSpec).takeUnless { View.MeasureSpec.getMode(heightMeasureSpec) == View.MeasureSpec.UNSPECIFIED } ?: 1_000_000
        if (grid) {
            if (widthMode == View.MeasureSpec.UNSPECIFIED) {
                val (intrinsicWidth, intrinsicHeight) = gridIntrinsicSize(height)
                setMeasuredDimension(
                    resolveSize(intrinsicWidth, widthMeasureSpec),
                    resolveSize(intrinsicHeight, heightMeasureSpec),
                )
                return
            }
            val layout = gridLayout(width, height)
            val desiredWidth = paddingLeft + paddingRight + (layout.cellWidth * gridColumns + max(0, gridColumns - 1) * columnGap).roundToInt()
            val desiredHeight = paddingTop + paddingBottom + layout.rowHeights.sum().roundToInt() + (max(0, layout.rowHeights.size - 1) * rowGap).roundToInt()
            setMeasuredDimension(resolveSize(desiredWidth, widthMeasureSpec), resolveSize(desiredHeight, heightMeasureSpec))
            return
        }
        val (lines, absolute) = entries(width, height)
        val main = lines.maxOfOrNull { it.main } ?: 0f
        val cross = lines.sumOf { it.cross.toDouble() } + max(0, lines.size - 1) * (if (orientation == HORIZONTAL) rowGap else columnGap).toDouble()
        val desiredWidth = if (orientation == HORIZONTAL) main.roundToInt() else cross.roundToInt()
        val desiredHeight = if (orientation == HORIZONTAL) cross.roundToInt() else main.roundToInt()
        val absWidth = absolute.maxOfOrNull { it.width } ?: 0
        val absHeight = absolute.maxOfOrNull { it.height } ?: 0
        setMeasuredDimension(
            if (unboundedHorizontal) max(desiredWidth + paddingLeft + paddingRight, absWidth + paddingLeft + paddingRight)
            else resolveSize(max(desiredWidth + paddingLeft + paddingRight, absWidth + paddingLeft + paddingRight), widthMeasureSpec),
            resolveSize(max(desiredHeight + paddingTop + paddingBottom, absHeight + paddingTop + paddingBottom), heightMeasureSpec),
        )
    }

    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
        celebration?.layout()
        pageViewport?.let { (pageWidth, pageHeight) ->
            val pages = (0 until childCount).map { getChildAt(it) }.filter { it.visibility != View.GONE }
            pages.forEachIndexed { index, child -> child.layout(index * pageWidth, 0, (index + 1) * pageWidth, pageHeight) }
            onLayoutChanged?.invoke()
            return
        }
        widthDefinite = true
        if (grid) {
            val layout = gridLayout(width, height)
            val contentWidth = width - paddingLeft - paddingRight
            val contentHeight = height - paddingTop - paddingBottom
            val flow = layout.rows.flatten()
            // Older runtimes return null for the optional symbol; the local
            // layout below remains the compatibility path in that case.
            val sharedFrames = if (gridRows == null) CraftNative.grid(
                contentWidth.toFloat(), contentHeight.toFloat(), gridColumns, columnGap, rowGap,
                flow.map { it.width.toFloat() }.toFloatArray(), flow.map { it.height.toFloat() }.toFloatArray(),
                flow.map { it.style.width?.resolve(layout.cellWidth.roundToInt())?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.height?.resolve(contentHeight)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.minWidth?.resolve(layout.cellWidth.roundToInt())?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.maxWidth?.resolve(layout.cellWidth.roundToInt())?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.minHeight?.resolve(contentHeight)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.map { it.style.maxHeight?.resolve(contentHeight)?.toFloat() ?: Float.NaN }.toFloatArray(),
                flow.flatMap {
                    val lp = it.view.layoutParams as? MarginLayoutParams
                    listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat(), (lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
                }.toFloatArray(),
                flow.flatMap {
                    val align = it.style.alignSelf ?: alignItems
                    listOf(if (align == "stretch") 1f else 0f, if (align == "center") 1f else if (align == "flex-end") 2f else 0f)
                }.toFloatArray(),
                gridAutoRows?.resolve(contentHeight)?.toFloat(),
                alignContentCode(),
            ) else null
            if (sharedFrames != null) {
                for ((index, entry) in flow.withIndex()) {
                    val offset = index * 4
                    val x = paddingLeft + sharedFrames[offset].roundToInt()
                    val y = paddingTop + sharedFrames[offset + 1].roundToInt()
                    val childWidth = sharedFrames[offset + 2].roundToInt()
                    val childHeight = sharedFrames[offset + 3].roundToInt()
                    place(entry.view, x, y, x + childWidth, y + childHeight)
                }
            } else {
                val totalRows = layout.rowHeights.sum()
                val rowGaps = max(0, layout.rowHeights.size - 1) * rowGap.toFloat()
                val freeRows = max(0f, contentHeight.toFloat() - totalRows - rowGaps)
                val rowCount = max(1, layout.rowHeights.size)
                var rowLeading = 0f
                var rowBetween = rowGap.toFloat()
                var rowExtra = 0f
                when (alignContentCode()) {
                    1 -> rowLeading = freeRows / 2f
                    2 -> rowLeading = freeRows
                    3 -> if (rowCount > 1) rowBetween += freeRows / (rowCount - 1).toFloat()
                    4 -> {
                        rowLeading = freeRows / (rowCount * 2).toFloat()
                        rowBetween += freeRows / rowCount.toFloat()
                    }
                    6 -> {
                        rowLeading = freeRows / (rowCount + 1).toFloat()
                        rowBetween += freeRows / (rowCount + 1).toFloat()
                    }
                    5 -> rowExtra = freeRows / rowCount.toFloat()
                }
                var rowTop = paddingTop.toFloat() + rowLeading
                for ((rowIndex, row) in layout.rows.withIndex()) {
                    val rowHeight = layout.rowHeights[rowIndex].toFloat() + rowExtra
                    for ((column, entry) in row.withIndex()) {
                        val align = entry.style.alignSelf ?: alignItems
                        val lp = entry.view.layoutParams as? MarginLayoutParams
                        val marginLeft = lp?.leftMargin ?: 0
                        val marginRight = lp?.rightMargin ?: 0
                        val marginTop = lp?.topMargin ?: 0
                        val marginBottom = lp?.bottomMargin ?: 0
                        val availableWidth = max(0f, layout.cellWidth - marginLeft - marginRight)
                        val availableHeight = max(0, (rowHeight - marginTop - marginBottom).roundToInt())
                        val childWidth = if (align == "stretch" && entry.style.width == null) availableWidth.roundToInt() else min(availableWidth.roundToInt(), entry.width)
                        val childHeight = if (align == "stretch" && entry.style.height == null) availableHeight else min(availableHeight, entry.height)
                        val x = (paddingLeft + column * (layout.cellWidth + columnGap) + marginLeft + when (align) {
                            "center" -> (availableWidth - childWidth) / 2f
                            "flex-end" -> availableWidth - childWidth
                            else -> 0f
                        }).roundToInt()
                        val y = (rowTop + marginTop + when (align) {
                            "center" -> (availableHeight - childHeight) / 2
                            "flex-end" -> availableHeight - childHeight
                            else -> 0
                        }).roundToInt()
                        place(entry.view, x, y, x + childWidth, y + childHeight)
                    }
                    rowTop += rowHeight + rowBetween
                }
            }
            for (entry in layout.absolute) {
                if (entry.view is CraftNativeModalView && entry.view.visibility == View.VISIBLE) entry.view.bringToFront()
                val (childWidth, childHeight) = absoluteSize(entry, contentWidth, contentHeight)
                val x = paddingLeft + (entry.style.left ?: (entry.style.right?.let { contentWidth - it - childWidth } ?: 0))
                val y = paddingTop + (entry.style.top ?: (entry.style.bottom?.let { contentHeight - it - childHeight } ?: 0))
                place(entry.view, x, y, x + childWidth, y + childHeight)
            }
            onLayoutChanged?.invoke()
            return
        }
        val contentWidth = width - paddingLeft - paddingRight
        val contentHeight = height - paddingTop - paddingBottom
        val (lines, absolute) = entries(width, height)
        if (absolute.isEmpty() && lines.isNotEmpty() && (lines.size == 1 || wrap)) {
            val sharedEntries = if (wrap) lines.flatMap { it.entries } else lines[0].entries
            val sharedTree = sharedTreeFrames(sharedEntries, width, height)
            if (sharedTree != null && (sharedTree.nodes.size > sharedEntries.size + 1 || grid || reverse || wrapReverse || gridAutoRows != null || gridRows != null)) {
                for (index in 1 until sharedTree.nodes.size) {
                    val view = sharedTree.nodes[index].view ?: continue
                    val offset = index * 4
                    val parentOffset = sharedTree.parents[index] * 4
                    val parentX = sharedTree.frames[parentOffset]
                    val parentY = sharedTree.frames[parentOffset + 1]
                    val x = (sharedTree.frames[offset] - parentX).roundToInt()
                    val y = (sharedTree.frames[offset + 1] - parentY).roundToInt()
                    val childWidth = sharedTree.frames[offset + 2].roundToInt()
                    val childHeight = sharedTree.frames[offset + 3].roundToInt()
                    place(view, x, y, x + childWidth, y + childHeight)
                }
                onLayoutChanged?.invoke()
                return
            }
            val sharedFrames = sharedDirectFrames(sharedEntries, width, height)
            if (sharedFrames != null) {
                for ((index, entry) in sharedEntries.withIndex()) {
                    val offset = (index + 1) * 4
                    val x = sharedFrames[offset].roundToInt()
                    val y = sharedFrames[offset + 1].roundToInt()
                    val childWidth = sharedFrames[offset + 2].roundToInt()
                    val childHeight = sharedFrames[offset + 3].roundToInt()
                    place(entry.view, x, y, x + childWidth, y + childHeight)
                }
                onLayoutChanged?.invoke()
                return
            }
        }
        val gap = if (orientation == HORIZONTAL) columnGap else rowGap
        val crossGap = if (orientation == HORIZONTAL) rowGap else columnGap
        val availableMain = if (orientation == HORIZONTAL) contentWidth else contentHeight
        val availableCross = if (orientation == HORIZONTAL) contentHeight else contentWidth
        val totalCross = lines.sumOf { it.cross.toDouble() }.toFloat() + max(0, lines.size - 1) * crossGap
        val crossFree = max(0f, availableCross.toFloat() - totalCross)
        var crossLeading = 0f
        var crossBetween = crossGap
        val sharedCross = if (wrap && lines.size > 1) {
            CraftNative.flexLineDistribution(
                availableCross.toFloat(), crossGap, alignContentCode(), lines.map { it.cross }.toFloatArray()
            )
        } else null
        sharedCross?.second?.forEachIndexed { index, size -> lines[index].cross = size }
        if (wrap && lines.size > 1) {
            if (sharedCross == null) when (alignContent) {
                "center" -> crossLeading = crossFree / 2f
                "flex-end" -> crossLeading = crossFree
                "space-between" -> crossBetween = crossFree / (lines.size - 1).toFloat() + crossGap
                "space-around" -> {
                    crossBetween = crossFree / lines.size.toFloat() + crossGap
                    crossLeading = crossFree / (lines.size * 2).toFloat()
                }
                "space-evenly" -> {
                    crossBetween = crossFree / (lines.size + 1).toFloat() + crossGap
                    crossLeading = crossFree / (lines.size + 1).toFloat()
                }
            }
        }
        val stretchExtra = if (sharedCross == null && wrap && lines.size > 1 && alignContent == "stretch")
            crossFree / lines.size.toFloat()
        else 0f
        var crossOffset = (if (orientation == HORIZONTAL) paddingTop else paddingLeft).toFloat() + crossLeading
            val crossOrigin = (if (orientation == HORIZONTAL) paddingTop else paddingLeft).toFloat()
            val crossExtent = availableCross.toFloat()
        for ((lineIndex, line) in lines.withIndex()) {
            // A single-line container's one line is as tall (or wide) as the
            // container itself, as in CSS: `h-12 items-center` centres its
            // children in the 48 points, not in the tallest child.
            val lineCross = if (!wrap) max(line.cross.toFloat(), availableCross.toFloat())
            else line.cross.toFloat() + stretchExtra
                val lineOffset = sharedCross?.first?.get(lineIndex)?.let { crossOrigin + it } ?: crossOffset
                val physicalLineOffset = if (wrapReverse && wrap) crossOrigin + crossExtent - (lineOffset - crossOrigin) - lineCross else lineOffset
            val fallbackWidths = fallbackFlexWidths(line, availableMain, gap)
            val sharedPrimary = CraftNative.flexRow(
                availableMain.toFloat(),
                gap,
                justifyCode(),
                line.entries.map { entry -> if (orientation == HORIZONTAL) entry.width.toFloat() else entry.height.toFloat() }.toFloatArray(),
                line.entries.map { it.style.flexGrow.toFloat() }.toFloatArray(),
                line.entries.map { (it.style.flexShrink ?: defaultFlexShrink(it.view)).toFloat() }.toFloatArray(),
                line.entries.map {
                    (if (orientation == HORIZONTAL) it.style.minWidth?.resolve(contentWidth) else it.style.minHeight?.resolve(contentHeight))?.toFloat()
                        ?: Float.NaN
                }.toFloatArray(),
                line.entries.map {
                    (if (orientation == HORIZONTAL) it.style.maxWidth?.resolve(contentWidth) else it.style.maxHeight?.resolve(contentHeight))?.toFloat()
                        ?: Float.NaN
                }.toFloatArray(),
                line.entries.flatMap { entry ->
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    if (orientation == HORIZONTAL) listOf((lp?.leftMargin ?: 0).toFloat(), (lp?.rightMargin ?: 0).toFloat())
                    else listOf((lp?.topMargin ?: 0).toFloat(), (lp?.bottomMargin ?: 0).toFloat())
                }.toFloatArray(),
            )
            val sharedPositions = sharedPrimary?.takeIf { it.size == line.entries.size * 2 }
            val distributedMain = if (sharedPrimary != null) {
                line.entries.indices.sumOf { index ->
                    val lp = line.entries[index].view.layoutParams as? MarginLayoutParams
                    val margins = if (orientation == HORIZONTAL) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                    else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                    sharedPrimary[index].toDouble() + margins
                } + max(0, line.entries.size - 1) * gap.toDouble()
            } else {
                line.entries.indices.sumOf { index ->
                    val constrained = fallbackWidths[index]
                    val lp = line.entries[index].view.layoutParams as? MarginLayoutParams
                    val margins = if (orientation == HORIZONTAL) (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0)
                        else (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0)
                    constrained + margins
                }.toDouble() + max(0, line.entries.size - 1) * gap.toDouble()
            }
            val free = max(0f, availableMain.toFloat() - distributedMain.toFloat())
            val (leading, between) = distribution(free, line.entries.size)
            var mainOffset = (if (orientation == HORIZONTAL) paddingLeft else paddingTop).toFloat() + leading
            val baseline = if (orientation == HORIZONTAL) {
                line.entries.filter { (it.style.alignSelf ?: alignItems) == "baseline" }.maxOfOrNull { entry ->
                    val lp = entry.view.layoutParams as? MarginLayoutParams
                    (lp?.topMargin ?: 0) + baselineOffset(entry.view, entry.height)
                }
            } else null
            for ((index, entry) in line.entries.withIndex()) {
                val lp = entry.view.layoutParams as? MarginLayoutParams
                val marginStart = if (orientation == HORIZONTAL) lp?.leftMargin ?: 0 else lp?.topMargin ?: 0
                val marginEnd = if (orientation == HORIZONTAL) lp?.rightMargin ?: 0 else lp?.bottomMargin ?: 0
                val crossSize = if ((entry.style.alignSelf ?: alignItems) == "stretch" && (if (orientation == HORIZONTAL) entry.style.height else entry.style.width) == null)
                    max(0, (lineCross - (if (orientation == HORIZONTAL) (lp?.topMargin ?: 0) + (lp?.bottomMargin ?: 0) else (lp?.leftMargin ?: 0) + (lp?.rightMargin ?: 0))).roundToInt())
                else if (orientation == HORIZONTAL) entry.height else entry.width
                val align = entry.style.alignSelf ?: alignItems
                val crossLeading = (if (orientation == HORIZONTAL) lp?.topMargin ?: 0 else lp?.leftMargin ?: 0).toFloat()
                val crossTrailing = (if (orientation == HORIZONTAL) lp?.bottomMargin ?: 0 else lp?.rightMargin ?: 0).toFloat()
                val crossPosition = if (align == "baseline" && baseline != null) {
                    val childBaseline = baselineOffset(entry.view, crossSize).toFloat()
                    CraftNative.crossAxisPosition(
                        baseline.toFloat(), childBaseline, crossLeading, crossTrailing, 3
                    ) ?: max(crossLeading, baseline.toFloat() - childBaseline)
                } else {
                    val alignment = when (align) {
                        "center" -> 1
                        "flex-end" -> 2
                        else -> 0
                    }
                    CraftNative.crossAxisPosition(
                        lineCross, crossSize.toFloat(), crossLeading, crossTrailing, alignment
                    ) ?: when (alignment) {
                        1 -> crossLeading + (lineCross - crossLeading - crossTrailing - crossSize) / 2f
                        2 -> lineCross - crossTrailing - crossSize
                        else -> crossLeading
                    }
                }
                val physicalCrossPosition = if (wrapReverse && wrap) lineCross - crossPosition - crossSize else crossPosition
                // Shared positions cover every non-reverse justification; the
                // local main-axis rule remains the fallback for old runtimes
                // that return widths only.
                // The shared result stores widths in the first half and
                // main-axis positions in the second half.
                val sharedPosition = if (!reverse) sharedPositions?.get(line.entries.size + index) else null
                val positionedMain = sharedPosition?.let { (if (orientation == HORIZONTAL) paddingLeft else paddingTop).toFloat() + it }
                    ?: mainOffset + marginStart
                val x = if (orientation == HORIZONTAL) positionedMain.roundToInt() else (physicalLineOffset + physicalCrossPosition).roundToInt()
                val y = if (orientation == HORIZONTAL) (physicalLineOffset + physicalCrossPosition).roundToInt() else positionedMain.roundToInt()
                val distributedPrimary = sharedPrimary?.get(index)?.roundToInt() ?: fallbackWidths[index]
                val w = if (orientation == HORIZONTAL) distributedPrimary else crossSize
                val h = if (orientation == HORIZONTAL) crossSize else distributedPrimary
                place(entry.view, x, y, x + w, y + h)
                if (sharedPosition == null) mainOffset += distributedPrimary + marginStart + marginEnd + gap + between
            }
            if (sharedCross == null) crossOffset += lineCross + crossBetween
        }
        for (entry in absolute) {
            if (entry.view is CraftNativeModalView && entry.view.visibility == View.VISIBLE) entry.view.bringToFront()
            val (widthValue, heightValue) = absoluteSize(entry, contentWidth, contentHeight)
            val x = paddingLeft + (entry.style.left ?: (entry.style.right?.let { contentWidth - it - widthValue } ?: 0))
            val y = paddingTop + (entry.style.top ?: (entry.style.bottom?.let { contentHeight - it - heightValue } ?: 0))
            place(entry.view, x, y, x + widthValue, y + heightValue)
        }
        onLayoutChanged?.invoke()
    }

    private fun distribution(free: Float, count: Int): Pair<Float, Float> {
        val available = free
        return when (justifyContent) {
            "center" -> available / 2f to 0f
            "flex-end" -> available to 0f
            "space-between" -> 0f to if (count > 1) available / (count - 1).toFloat() else 0f
            "space-around" -> available / (count * 2).toFloat() to available / count.toFloat()
            "space-evenly" -> available / (count + 1).toFloat() to available / (count + 1).toFloat()
            else -> 0f to 0f
        }
    }

    /** First text baseline in pixels; non-text views align by their bottom. */
    private fun baselineOffset(view: View, cross: Int): Int = view.baseline.takeIf { it >= 0 }?.coerceIn(0, cross) ?: cross
}

/** An image-backed flex container with ordinary native children over the image. */
private class CraftNativeImageBackgroundView(context: Context) : FrameLayout(context) {
    val image = ImageView(context)
    val content = CraftNativeFlexLayout(context)

    init {
        clipChildren = true
        image.scaleType = ImageView.ScaleType.CENTER_CROP
        image.isClickable = false
        addView(image, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
        addView(content, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
    }
}

/** A flex container that responds to the activity's IME inset. */
private class CraftNativeKeyboardAvoidingView(context: Context) : FrameLayout(context) {
    val content = CraftNativeFlexLayout(context)
    private var behavior = "padding"
    private var keyboardVerticalOffset = 0
    private var keyboardInset = 0
    private var basePadding = intArrayOf(0, 0, 0, 0)

    init {
        addView(content, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
    }

    fun configure(props: JSONObject, style: JSONObject, density: Float) {
        behavior = craftNativeOptionalString(props.opt("behavior"))?.takeIf { it in setOf("height", "position", "padding") } ?: "padding"
        val authoredOffset = craftNativeFiniteDouble(props, "keyboardVerticalOffset", 0.0)
        val pixelOffset = (authoredOffset * density.toDouble()).takeIf { it.isFinite() } ?: 0.0
        keyboardVerticalOffset = pixelOffset.roundToInt()
        content.configure(style, density)
        basePadding = intArrayOf(content.paddingLeft, content.paddingTop, content.paddingRight, content.paddingBottom)
        applyKeyboardInset()
    }

    fun setKeyboardInset(inset: Int) {
        if (keyboardInset == inset) return
        keyboardInset = max(0, inset)
        applyKeyboardInset()
    }

    private fun effectiveInset(): Int = max(0, keyboardInset - keyboardVerticalOffset)

    private fun applyKeyboardInset() {
        val inset = effectiveInset()
        translationY = if (behavior == "position") -inset.toFloat() else 0f
        val bottom = if (behavior == "padding") basePadding[3] + inset else basePadding[3]
        content.setPadding(basePadding[0], basePadding[1], basePadding[2], bottom)
        requestLayout()
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val inset = effectiveInset()
        val adjustedHeight = if (behavior == "height" && inset > 0 && MeasureSpec.getMode(heightMeasureSpec) != MeasureSpec.UNSPECIFIED) {
            MeasureSpec.makeMeasureSpec(max(0, MeasureSpec.getSize(heightMeasureSpec) - inset), MeasureSpec.getMode(heightMeasureSpec))
        } else {
            heightMeasureSpec
        }
        super.onMeasure(widthMeasureSpec, adjustedHeight)
    }
}

/** CSS family fallback order, using bundled app fonts before platform families. */
internal fun craftNativeFontFamily(family: String?, bundledFonts: Map<String, Typeface> = emptyMap()): Typeface =
    family?.split(',')?.asSequence()?.map { it.trim().trim('"', '\'') }?.mapNotNull { name ->
        bundledFonts[name] ?: when (name.lowercase()) {
            "monospace", "ui-monospace" -> Typeface.MONOSPACE
            "serif", "ui-serif" -> Typeface.SERIF
            "sans-serif", "ui-sans-serif", "system-ui", "-apple-system" -> Typeface.SANS_SERIF
            else -> Typeface.create(name, Typeface.NORMAL).takeUnless { it == Typeface.DEFAULT }
        }
    }?.firstOrNull() ?: Typeface.DEFAULT

internal class CraftNativeScrollView(context: Context) : SwipeRefreshLayout(context) {
    val content = CraftNativeFlexLayout(context)
    // Keep one refresh target across axis changes. Replacing all children of
    // SwipeRefreshLayout would also detach its own animated indicator.
    private val scrollContainer = FrameLayout(context)
    private val vertical = object : ScrollView(context) {
        override fun onInterceptTouchEvent(event: MotionEvent): Boolean = isEnabled && super.onInterceptTouchEvent(event)
        override fun onTouchEvent(event: MotionEvent): Boolean = isEnabled && super.onTouchEvent(event)
    }
    private val horizontal = object : HorizontalScrollView(context) {
        override fun onInterceptTouchEvent(event: MotionEvent): Boolean = isEnabled && super.onInterceptTouchEvent(event)
        override fun onTouchEvent(event: MotionEvent): Boolean = isEnabled && super.onTouchEvent(event)
    }
    private var horizontalMode: Boolean? = null
    private var pagingEnabled = false
    private var authoredPageIndex: Int? = null
    private var pendingPageIndex: Int? = null
    private var currentPageIndex = 0
    private var reportedPage: Pair<Int, Int>? = null
    private var pageHandler: ((Int, Int) -> Unit)? = null
    private var pageSettleGeneration = 0
    private var pageDragging = false
    private var pageInMotion = false

    private fun schedulePageSettle(scroller: View) {
        val generation = ++pageSettleGeneration
        scroller.postDelayed({
            if (generation == pageSettleGeneration && !pageDragging) {
                pageInMotion = false
                settlePage()
            }
        }, 80L)
    }

    fun configurePager(value: Any?, onSelect: ((Int, Int) -> Unit)?) {
        val next = (value as? Number)?.toDouble()?.takeIf { it.isFinite() }?.coerceIn(0.0, (Int.MAX_VALUE / 2).toDouble())?.toInt()
        if (next != authoredPageIndex) pendingPageIndex = next
        authoredPageIndex = next
        pageHandler = onSelect
        if (next == null) { content.pageViewport = null; reportedPage = null }
        requestLayout()
    }

    private fun settlePage() {
        if (authoredPageIndex == null || horizontal.width <= 0 || pageDragging || pageInMotion) return
        val pages = (0 until content.childCount).map { content.getChildAt(it) }.filter { it.visibility != View.GONE }
        val index = (horizontal.scrollX.toFloat() / horizontal.width).roundToInt().coerceIn(0, max(0, pages.size - 1))
        val target = index * horizontal.width
        if (horizontal.scrollX != target) {
            // ACTION_UP can start native motion after our touch listener's snap.
            // A rounded index is not settled until that viewport is fully shown.
            pageInMotion = true
            horizontal.smoothScrollTo(target, 0)
            schedulePageSettle(horizontal)
            return
        }
        currentPageIndex = index
        pages.forEachIndexed { i, page -> page.importantForAccessibility = if (i == index) View.IMPORTANT_FOR_ACCESSIBILITY_AUTO else View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS }
        val report = index to pages.size
        if (report != reportedPage) { reportedPage = report; pageHandler?.invoke(index, pages.size) }
    }

    override fun onLayout(changed: Boolean, left: Int, top: Int, right: Int, bottom: Int) {
        val oldWidth = horizontal.width
        super.onLayout(changed, left, top, right, bottom)
        if (authoredPageIndex != null && horizontalMode == true && horizontal.width > 0) {
            val count = (0 until content.childCount).count { content.getChildAt(it).visibility != View.GONE }
            val index = (pendingPageIndex ?: currentPageIndex).coerceIn(0, max(0, count - 1))
            if (pendingPageIndex != null || oldWidth != horizontal.width || index != currentPageIndex) horizontal.scrollTo(index * horizontal.width, 0)
            pendingPageIndex = null
            currentPageIndex = index
            settlePage()
        }
    }

    private var bounces = true
    private var alwaysBounceVertical = true
    private var alwaysBounceHorizontal = true
    private var keyboardShouldPersistTaps = "never"
    private var refreshHandler: (() -> Unit)? = null
    private var authoredRefreshing: Boolean? = null
    private val defaultProgressStart = progressViewStartOffset
    private val defaultProgressEnd = progressViewEndOffset
    private var configuredProgressOffset: Int? = null
    private var stickyIndices = emptyList<Int>()
    private var scrollTargetKey: String? = null
    private var pendingScrollTarget: Pair<String, Boolean>? = null
    private var scrollListenerGeneration = 0

    init {
        vertical.isNestedScrollingEnabled = true
        horizontal.isNestedScrollingEnabled = true
        vertical.isFillViewport = true
        horizontal.isFillViewport = true
        addView(scrollContainer, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
        setOnChildScrollUpCallback { _, _ -> horizontalMode != true && vertical.canScrollVertically(-1) }
        setOnRefreshListener { refreshHandler?.invoke() }
        // The outer refresh host must stay touch-enabled so its real scroll
        // child can receive gestures even when no pull-to-refresh handler is
        // configured. Interception is gated below instead.
        isEnabled = true
        setHorizontal(false)
        // Paging is owned by this native control even before an Activity
        // supplies optional bridge callbacks. Its normal configuration may
        // replace these listeners without changing gesture ownership.
        setScrollListeners(null, null, null, null, null, "none", null)
    }

    override fun onInterceptTouchEvent(event: MotionEvent): Boolean {
        if (refreshHandler == null) return false
        return super.onInterceptTouchEvent(event)
    }

    /**
     * Along an axis its parent does not fix, a scroll view is as big as its
     * content (up to what the parent allows): a horizontal strip is as tall
     * as its row, a vertical scroll with room to spare as tall as what it
     * holds. SwipeRefreshLayout alone takes all of an AT_MOST size, which
     * made a strip in a column a million pixels tall.
     */
    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val widthMode = MeasureSpec.getMode(widthMeasureSpec)
        val heightMode = MeasureSpec.getMode(heightMeasureSpec)
        val widthSize = MeasureSpec.getSize(widthMeasureSpec)
        val heightSize = MeasureSpec.getSize(heightMeasureSpec)
        // Even when the viewport itself is exact, a horizontal scroll must
        // measure its content with an unspecified width. Returning straight
        // to SwipeRefreshLayout here makes HorizontalScrollView remeasure the
        // content at the viewport width, erasing overflow and disabling the
        // nested carousel gesture.
        val sideways = horizontalMode == true
        val unspecified = MeasureSpec.makeMeasureSpec(0, MeasureSpec.UNSPECIFIED)
        val horizontalPadding = paddingLeft + paddingRight
        val verticalPadding = paddingTop + paddingBottom
        content.pageViewport = if (authoredPageIndex != null && sideways) max(0, widthSize - horizontalPadding) to max(0, heightSize - verticalPadding) else null
        content.measure(
            if (sideways || widthMode == MeasureSpec.UNSPECIFIED) unspecified
            else MeasureSpec.makeMeasureSpec(max(0, widthSize - horizontalPadding), MeasureSpec.EXACTLY),
            if (!sideways || heightMode == MeasureSpec.UNSPECIFIED) unspecified
            else MeasureSpec.makeMeasureSpec(max(0, heightSize - verticalPadding), MeasureSpec.AT_MOST),
        )
        if (sideways) {
            // HorizontalScrollView may turn a WRAP_CONTENT child into an
            // AT_MOST viewport measurement during its own pass. Preserve the
            // intrinsic width we just measured as the child's layout width so
            // the second pass cannot collapse a carousel back to the viewport.
            val params = content.layoutParams ?: ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.WRAP_CONTENT,
                ViewGroup.LayoutParams.MATCH_PARENT,
            )
            params.width = if (authoredPageIndex != null) content.measuredWidth else max(params.width, content.measuredWidth)
            content.layoutParams = params
        }
        fun fit(mode: Int, size: Int, wanted: Int): Int = when (mode) {
            MeasureSpec.EXACTLY -> size
            MeasureSpec.AT_MOST -> min(size, wanted)
            else -> wanted
        }
        val width = fit(widthMode, widthSize, content.measuredWidth + horizontalPadding)
        val height = fit(heightMode, heightSize, content.measuredHeight + verticalPadding)
        super.onMeasure(
            MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY),
            MeasureSpec.makeMeasureSpec(height, MeasureSpec.EXACTLY),
        )
    }

    fun setRefreshHandler(handler: (() -> Unit)?, refreshing: Boolean) {
        refreshHandler = handler
        isEnabled = true
        val requested = handler != null && refreshing
        // An unchanged false prop must not cancel a native pull before its
        // onRefresh callback has reached the script.
        if (handler == null || authoredRefreshing != requested) {
            authoredRefreshing = requested
            isRefreshing = requested
        }
    }

    fun setRefreshAppearance(props: JSONObject, density: Float, fallback: Int) {
        val tint = craftNativeOptionalString(props.opt("tintColor"))
        setColorSchemeColors(tint?.let { runCatching { craftNativeColor(it) }.getOrNull() } ?: fallback)
        val background = craftNativeOptionalString(props.opt("progressBackgroundColor"))
        setProgressBackgroundColorSchemeColor(
            background?.let { runCatching { craftNativeColor(it) }.getOrNull() } ?: Color.TRANSPARENT,
        )
        val offset = props.optDouble("progressViewOffset", Double.NaN)
        val requested = if (offset.isFinite()) (offset * density).roundToInt() else null
        if (configuredProgressOffset != requested) {
            val wasRefreshing = isRefreshing
            val shift = requested ?: 0
            setProgressViewOffset(false, defaultProgressStart + shift, defaultProgressEnd + shift)
            configuredProgressOffset = requested
            if (wasRefreshing) isRefreshing = true
        }
    }

    override fun onAttachedToWindow() {
        super.onAttachedToWindow()
        // Navigation may detach and reattach a retained screen. Its handler
        // belongs to the screen; releaseViewState clears it on disposal.
        if (authoredRefreshing == true) isRefreshing = true
    }

    fun setHorizontal(value: Boolean) {
        if (horizontalMode == value) return
        horizontalMode = value
        (content.parent as? ViewGroup)?.removeView(content)
        scrollContainer.removeAllViews()
        val scroller: ViewGroup = if (value) horizontal else vertical
        scroller.removeAllViews()
        content.orientation = if (value) LinearLayout.HORIZONTAL else LinearLayout.VERTICAL
        content.setUnboundedWidth(value)
        scroller.addView(content, if (value)
            ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.MATCH_PARENT)
        else ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
        scrollContainer.addView(scroller, FrameLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
    }

    /**
     * A targeted mutation can change a child's size without reconciling the
     * scroll content tree. Invalidate both the custom content layout and the
     * platform scroller so its measured content range is recomputed too.
     */
    fun invalidateContentLayout() {
        content.forceLayout()
        content.requestLayout()
        val scroller = if (horizontalMode == true) horizontal else vertical
        scroller.forceLayout()
        scroller.requestLayout()
        forceLayout()
        requestLayout()
    }

    fun setNativeNestedScrollingEnabled(value: Boolean) {
        vertical.isNestedScrollingEnabled = value
        horizontal.isNestedScrollingEnabled = value
    }

    fun scrollTo(x: Int?, y: Int?, animated: Boolean): Pair<Int, Int> {
        val scroller: View = if (horizontalMode == true) horizontal else vertical
        val maxX = max(0, content.width - horizontal.width)
        val maxY = max(0, content.height - vertical.height)
        val targetX = (x ?: scroller.scrollX).coerceIn(0, maxX)
        val targetY = (y ?: scroller.scrollY).coerceIn(0, maxY)
        if (animated) {
            if (scroller is HorizontalScrollView) scroller.smoothScrollTo(targetX, targetY)
            else (scroller as ScrollView).smoothScrollTo(targetX, targetY)
        } else {
            scroller.scrollTo(targetX, targetY)
        }
        return targetX to targetY
    }

    fun setScrollEnabled(value: Boolean) {
        vertical.isEnabled = value
        horizontal.isEnabled = value
    }

    fun setKeyboardShouldPersistTaps(value: String?) {
        keyboardShouldPersistTaps = value?.takeIf { it in setOf("always", "handled", "never") } ?: "never"
    }

    fun setBounces(value: Boolean) {
        bounces = value
        applyBounceModes()
    }

    fun setAlwaysBounce(vertical: Boolean, horizontal: Boolean) {
        alwaysBounceVertical = vertical
        alwaysBounceHorizontal = horizontal
        applyBounceModes()
    }

    private fun applyBounceModes() {
        vertical.overScrollMode = if (bounces && alwaysBounceVertical) View.OVER_SCROLL_ALWAYS else View.OVER_SCROLL_NEVER
        horizontal.overScrollMode = if (bounces && alwaysBounceHorizontal) View.OVER_SCROLL_ALWAYS else View.OVER_SCROLL_NEVER
    }

    private fun tapTarget(view: View, x: Float, y: Float): View? {
        if (x < 0 || y < 0 || x >= view.width || y >= view.height || view.visibility != View.VISIBLE) return null
        if (view is ViewGroup) {
            for (index in view.childCount - 1 downTo 0) {
                val child = view.getChildAt(index)
                tapTarget(child, x - child.left, y - child.top)?.let { return it }
            }
        }
        return view
    }

    private fun shouldDismissKeyboard(scroller: View, event: android.view.MotionEvent): Boolean {
        if (keyboardShouldPersistTaps == "always") return false
        return when (keyboardShouldPersistTaps) {
            "handled" -> (scroller as? ViewGroup)?.let { tapTarget(it, event.x, event.y)?.isClickable != true } ?: true
            else -> true
        }
    }

    fun setPagingEnabled(value: Boolean) {
        pagingEnabled = value
    }

    private fun snapToPage(scroller: View) {
        val horizontal = horizontalMode == true
        val pageSize = if (horizontal) scroller.width else scroller.height
        if (pageSize <= 0) return
        val offset = if (horizontal) scroller.scrollX else scroller.scrollY
        val target = (offset.toFloat() / pageSize).roundToInt() * pageSize
        if (horizontal) {
            (scroller as HorizontalScrollView).smoothScrollTo(target, 0)
        } else {
            (scroller as ScrollView).smoothScrollTo(0, target)
        }
    }

    fun setScrollIndicators(verticalVisible: Boolean, horizontalVisible: Boolean) {
        vertical.isVerticalScrollBarEnabled = verticalVisible
        horizontal.isHorizontalScrollBarEnabled = horizontalVisible
    }

    /** Keep vertical ScrollView headers pinned while preserving their layout slots. */
    fun setStickyHeaderIndices(value: JSONArray?) {
        stickyIndices.forEach { index ->
            content.getChildAt(index)?.apply {
                translationY = 0f
                translationZ = 0f
            }
        }
        stickyIndices = if (value == null) {
            emptyList()
        } else {
            (0 until value.length()).mapNotNull { value.optInt(it, -1).takeIf { index -> index >= 0 } }.distinct().sorted()
        }
        post { updateStickyHeaders() }
    }

    /** Scroll a child identified by its native testID/id after reconciliation. */
    fun setScrollTarget(value: Any?) {
        val target: String
        val animated: Boolean
        val key: String
        when (value) {
            is String -> {
                target = value.trim()
                animated = true
                key = target
            }
            is JSONObject -> {
                target = craftNativeOptionalString(value.opt("id")).orEmpty().trim()
                animated = value.optBoolean("animated", true)
                key = value.toString()
            }
            else -> {
                scrollTargetKey = null
                pendingScrollTarget = null
                return
            }
        }
        if (target.isBlank()) {
            scrollTargetKey = null
            pendingScrollTarget = null
            return
        }
        if (key == scrollTargetKey) return
        scrollTargetKey = key
        pendingScrollTarget = target to animated
        post { scrollToPendingTarget(0) }
    }

    private fun updateStickyHeaders() {
        if (horizontalMode == true) {
            stickyIndices.forEach { index ->
                content.getChildAt(index)?.apply {
                    translationY = 0f
                    translationZ = 0f
                }
            }
            return
        }
        val scrollY = vertical.scrollY
        // Keep sticky content below the ScrollView's authored top inset,
        // matching the native content viewport instead of pinning it to the
        // raw window edge.
        var pinnedBottom = content.paddingTop
        stickyIndices.forEachIndexed { position, index ->
            val header = content.getChildAt(index)
            if (header == null || header.visibility != View.VISIBLE || header.height <= 0) return@forEachIndexed
            val nextTop = stickyIndices.drop(position + 1)
                .firstNotNullOfOrNull { next -> content.getChildAt(next)?.takeIf { it.visibility == View.VISIBLE }?.top }
                ?: Int.MAX_VALUE
            val desired = max(0, scrollY + pinnedBottom - header.top)
            val limit = if (nextTop == Int.MAX_VALUE) Int.MAX_VALUE else max(0, nextTop - header.bottom)
            val translation = min(desired, limit)
            header.translationY = translation.toFloat()
            header.translationZ = if (translation > 0) 1f else 0f
            if (translation > 0) pinnedBottom = header.top - scrollY + translation + header.height
        }
    }

    private fun findDescendant(view: View, id: String): View? {
        if (view.tag?.toString() == id || view.contentDescription?.toString() == id) return view
        if (view is ViewGroup) {
            for (index in 0 until view.childCount) findDescendant(view.getChildAt(index), id)?.let { return it }
        }
        return null
    }

    private fun scrollToPendingTarget(attempt: Int) {
        val target = pendingScrollTarget ?: return
        val scroller: View = if (horizontalMode == true) horizontal else vertical
        val view = findDescendant(content, target.first)
        if (view == null || view.width <= 0 || view.height <= 0 || scroller.width <= 0 || scroller.height <= 0) {
            if (attempt < 4) postDelayed({ scrollToPendingTarget(attempt + 1) }, 16L)
            return
        }
        val targetLocation = IntArray(2)
        val scrollerLocation = IntArray(2)
        view.getLocationOnScreen(targetLocation)
        scroller.getLocationOnScreen(scrollerLocation)
        val current = if (horizontalMode == true) horizontal.scrollX else vertical.scrollY
        val stickyHeight = if (horizontalMode == true) 0 else {
            val contentLocation = IntArray(2)
            content.getLocationOnScreen(contentLocation)
            val targetContentTop = targetLocation[1] - contentLocation[1] + vertical.scrollY
            stickyIndices.mapNotNull { index -> content.getChildAt(index) }
                .lastOrNull { it.visibility == View.VISIBLE && it.top <= targetContentTop }
                ?.height ?: 0
        }
        val desired = if (horizontalMode == true) {
            current + targetLocation[0] - scrollerLocation[0]
        } else {
            current + targetLocation[1] - scrollerLocation[1] - stickyHeight
        }
        val maximum = if (horizontalMode == true) {
            max(0, content.measuredWidth - scroller.width)
        } else {
            max(0, content.measuredHeight - scroller.height)
        }
        val bounded = desired.coerceIn(0, maximum)
        if (target.second) {
            if (horizontalMode == true) horizontal.smoothScrollTo(bounded, 0) else vertical.smoothScrollTo(0, bounded)
        } else if (horizontalMode == true) {
            horizontal.scrollTo(bounded, 0)
        } else {
            vertical.scrollTo(0, bounded)
        }
        pendingScrollTarget = null
        updateStickyHeaders()
    }

    fun setScrollListeners(
        onScroll: ((Int, Int) -> Unit)?,
        onBeginDrag: (() -> Unit)?,
        onEndDrag: (() -> Unit)?,
        onMomentumBegin: (() -> Unit)?,
        onMomentumEnd: (() -> Unit)?,
        keyboardDismissMode: String,
        dismissKeyboard: (() -> Unit)?,
    ) {
        val generation = ++scrollListenerGeneration
        fun attach(scroller: View) {
            var dismissed = false
            var moved = false
            var momentumActive = false
            var lastX = 0
            var lastY = 0

            fun pollMomentum() {
                if (generation != scrollListenerGeneration || !momentumActive) return
                val x = scroller.scrollX
                val y = scroller.scrollY
                if (x == lastX && y == lastY) {
                    momentumActive = false
                    onMomentumEnd?.invoke()
                } else {
                    lastX = x
                    lastY = y
                    scroller.postDelayed({ pollMomentum() }, 16L)
                }
            }

            scroller.setOnScrollChangeListener { _, x, y, _, _ ->
                if (horizontalMode != true) updateStickyHeaders()
                if (authoredPageIndex != null) {
                    pageInMotion = true
                    schedulePageSettle(scroller)
                }
                onScroll?.invoke(x, y)
            }
            scroller.setOnTouchListener { _, event ->
                when (event.actionMasked) {
                    android.view.MotionEvent.ACTION_DOWN -> {
                        pageDragging = true
                        pageInMotion = false
                        pageSettleGeneration += 1
                        if (momentumActive) {
                            momentumActive = false
                            onMomentumEnd?.invoke()
                        }
                        dismissed = false
                        moved = false
                        onBeginDrag?.invoke()
                    }
                    android.view.MotionEvent.ACTION_MOVE -> {
                        moved = true
                        if (!dismissed && keyboardDismissMode in setOf("on-drag", "interactive")) {
                            dismissed = true
                            dismissKeyboard?.invoke()
                        }
                    }
                    android.view.MotionEvent.ACTION_UP, android.view.MotionEvent.ACTION_CANCEL -> {
                        if (event.actionMasked == android.view.MotionEvent.ACTION_UP && shouldDismissKeyboard(scroller, event)) {
                            dismissKeyboard?.invoke()
                        }
                        onEndDrag?.invoke()
                        if (pagingEnabled) snapToPage(scroller)
                        pageDragging = false
                        if (authoredPageIndex != null) schedulePageSettle(scroller)
                        if (moved && !momentumActive) {
                            momentumActive = true
                            lastX = scroller.scrollX
                            lastY = scroller.scrollY
                            onMomentumBegin?.invoke()
                            scroller.postDelayed({ pollMomentum() }, 16L)
                        }
                    }
                }
                false
            }
        }
        attach(vertical)
        attach(horizontal)
    }

    fun clearScrollListeners() {
        scrollListenerGeneration += 1
        pageSettleGeneration += 1
        pageDragging = false
        pageInMotion = false
        pageHandler = null
        vertical.setOnScrollChangeListener(null)
        vertical.setOnTouchListener(null)
        horizontal.setOnScrollChangeListener(null)
        horizontal.setOnTouchListener(null)
    }
}

private class CraftNativeFlexSpacer(context: Context) : View(context)

/**
 * A small, dependency-free native icon surface for Android.
 *
 * STX resolves Iconify names to the SF Symbol name that iOS draws. Android
 * does not ship SF Symbols, so the maintained host uses the corresponding
 * Unicode glyph for the common cross-platform symbols and a hollow circle for
 * an unknown symbol. Keeping this as a TextView gives the glyph the same
 * intrinsic measurement, tint, accessibility, and reconciliation behavior as
 * the other native leaf controls without adding an icon-font dependency.
 */
private class CraftNativeIconView(context: Context) : TextView(context) {
    /** The app's vector for the icon (CraftNativeIcons), drawn in place of the glyph. */
    var vector: Drawable? = null
        set(value) {
            field = value
            invalidate()
        }

    init {
        includeFontPadding = false
        gravity = Gravity.CENTER
        setPadding(0, 0, 0, 0)
        isSingleLine = true
    }

    override fun onDraw(canvas: Canvas) {
        val icon = vector ?: return super.onDraw(canvas)
        // A single-line TextView keeps a horizontal scroll from centring its
        // text in a max-content measure (half a million pixels): the canvas
        // arrives scrolled, so the box is placed where the view is.
        icon.setBounds(scrollX + paddingLeft, scrollY + paddingTop, scrollX + width - paddingRight, scrollY + height - paddingBottom)
        icon.draw(canvas)
    }
}

/** A platform EditText with the native end clear affordance and TalkBack action. */
private class CraftNativeTextField(context: Context) : EditText(context) {
    companion object { val CLEAR_ACTION_ID = View.generateViewId() }
    var clearButtonMode = "never"
    var onClearRequest: (() -> Unit)? = null
    private var clearPressed = false
    private fun showsClear() = isEnabled && keyListener != null && text?.isNotEmpty() == true && when (clearButtonMode) {
        "always" -> true
        "while-editing" -> isFocused
        "unless-editing" -> !isFocused
        else -> false
    }
    fun refreshClearButton() {
        val icon = if (showsClear()) context.getDrawable(android.R.drawable.ic_menu_close_clear_cancel)?.mutate() else null
        icon?.setTint(currentHintTextColor)
        setCompoundDrawablesRelativeWithIntrinsicBounds(null, null, icon, null)
    }
    override fun onTextChanged(text: CharSequence?, start: Int, lengthBefore: Int, lengthAfter: Int) {
        super.onTextChanged(text, start, lengthBefore, lengthAfter)
        refreshClearButton()
    }
    override fun onFocusChanged(focused: Boolean, direction: Int, previouslyFocusedRect: android.graphics.Rect?) {
        super.onFocusChanged(focused, direction, previouslyFocusedRect)
        refreshClearButton()
    }
    override fun onTouchEvent(event: MotionEvent): Boolean {
        val inClear = showsClear() && if (layoutDirection == View.LAYOUT_DIRECTION_RTL) event.x <= compoundPaddingLeft else event.x >= width - compoundPaddingRight
        if (event.actionMasked == MotionEvent.ACTION_DOWN && inClear) { clearPressed = true; return true }
        if (clearPressed) {
            if (event.actionMasked == MotionEvent.ACTION_UP) { clearPressed = false; if (inClear) onClearRequest?.invoke(); return true }
            if (event.actionMasked == MotionEvent.ACTION_CANCEL) clearPressed = false
            return true
        }
        return super.onTouchEvent(event)
    }
    override fun onInitializeAccessibilityNodeInfo(info: android.view.accessibility.AccessibilityNodeInfo) {
        super.onInitializeAccessibilityNodeInfo(info)
        if (showsClear()) info.addAction(android.view.accessibility.AccessibilityNodeInfo.AccessibilityAction(CLEAR_ACTION_ID, "Clear text"))
    }
    override fun performAccessibilityAction(action: Int, arguments: Bundle?): Boolean {
        if (action == CLEAR_ACTION_ID && showsClear()) { onClearRequest?.invoke(); return true }
        return super.performAccessibilityAction(action, arguments)
    }
}

private class CraftNativeModalView(context: Context) : FrameLayout(context) {
    val content = CraftNativeFlexLayout(context)
    private val blocker = View(context)
    private var renderedVisible = false
    private var animationGeneration = 0
    var focusToRestore: View? = null
    var onRequestClose: ((String) -> Unit)? = null
    var viewportStyle = JSONObject()
    var declarationPath = ""
    var sheetFraction: Float? = null

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val fraction = sheetFraction
        val params = content.layoutParams as LayoutParams
        params.height = if (fraction == null) LayoutParams.MATCH_PARENT else (View.MeasureSpec.getSize(heightMeasureSpec) * fraction).toInt()
        params.gravity = Gravity.BOTTOM
        content.layoutParams = params
        super.onMeasure(widthMeasureSpec, heightMeasureSpec)
    }

    var transparent: Boolean = false
        set(value) {
            field = value
            blocker.setBackgroundColor(if (value) Color.TRANSPARENT else Color.argb(82, 0, 0, 0))
        }

    /** Existing Modal nodes block by default; non-modal popups let outside taps through. */
    var blocksBackground: Boolean = true
        set(value) {
            field = value
            isClickable = value
            blocker.isClickable = value
            blocker.isEnabled = value
        }

    /** A non-modal popup may opt into consuming an outside tap for dismissal. */
    var dismissOnOutsideTap: Boolean = false

    init {
        isClickable = true
        blocker.isClickable = true
        blocker.setOnTouchListener { _, event ->
            if (event.action == MotionEvent.ACTION_UP) requestClose(reason = "backdrop")
            true
        }
        blocker.setBackgroundColor(Color.argb(82, 0, 0, 0))
        addView(blocker, LayoutParams(-1, -1))
        addView(content, LayoutParams(-1, -1))
    }

    fun requestClose(reason: String = "backdrop") {
        if (!blocksBackground && !dismissOnOutsideTap) return
        val handler = onRequestClose ?: return
        isClickable = false
        blocker.isEnabled = false
        handler(reason)
    }

    fun setVisible(visible: Boolean, opacity: Float, animationType: String?) {
        if (visible) {
            isClickable = blocksBackground
            blocker.isEnabled = blocksBackground
        }
        if (renderedVisible == visible && visibility == if (visible) View.VISIBLE else View.GONE) {
            if (visible && alpha != opacity) alpha = opacity
            return
        }
        val wasVisible = renderedVisible && visibility == View.VISIBLE
        renderedVisible = visible
        animationGeneration += 1
        val generation = animationGeneration
        animate().cancel()
        if (!visible) {
            if (animationType == "slide" && wasVisible) {
                val distance = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
                animate().translationY(distance).alpha(0f).setDuration(240L).withEndAction {
                    if (animationGeneration != generation) return@withEndAction
                    visibility = View.GONE
                    translationY = 0f
                    alpha = 0f
                }.start()
            } else {
                alpha = 0f
                translationY = 0f
                visibility = View.GONE
            }
            return
        }
        visibility = View.VISIBLE
        if (animationType == "none") {
            translationY = 0f
            alpha = opacity
        } else if (animationType == "slide") {
            alpha = opacity
            translationY = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
            post {
                if (animationGeneration != generation || visibility != View.VISIBLE) return@post
                val distance = max(height, (parent as? View)?.height ?: resources.displayMetrics.heightPixels).toFloat()
                translationY = distance
                animate().translationY(0f).setDuration(240L).start()
            }
        } else {
            translationY = 0f
            alpha = 0f
            animate().alpha(opacity).setDuration(180L).start()
        }
    }

    fun resetForTeardown() {
        animationGeneration += 1
        animate().cancel()
        visibility = View.GONE
        translationY = 0f
        alpha = 0f
        isClickable = true
        blocksBackground = true
        dismissOnOutsideTap = false
        blocker.isEnabled = true
        onRequestClose = null
    }

    override fun onTouchEvent(event: MotionEvent): Boolean {
        if (!blocksBackground) {
            if (dismissOnOutsideTap && event.action == MotionEvent.ACTION_UP) {
                requestClose(reason = "backdrop")
                return true
            }
            // Do not let an outside popup tap fall through to a blocking modal
            // below it; a normal non-modal popup remains pass-through.
            return hasBlockingModalBelow()
        }
        return super.onTouchEvent(event)
    }

    fun hasBlockingModalBelow(): Boolean {
        val group = parent as? ViewGroup ?: return false
        val index = group.indexOfChild(this)
        return index > 0 && (0 until index).any { siblingIndex ->
            val sibling = group.getChildAt(siblingIndex)
            sibling is CraftNativeModalView && sibling.blocksBackground && sibling.visibility == View.VISIBLE && sibling.alpha > 0.01f
        }
    }
}

private data class LayoutBounds(
    val x: Double,
    val y: Double,
    val width: Double,
    val height: Double,
)

/**
 * Android's default spinner style is indeterminate-only, so assigning
 * `isIndeterminate = false` to it is silently ignored. Use a determinate
 * ProgressBar style and carry over the platform spinner drawable instead;
 * that preserves the native look while allowing `animating={false}` to be a
 * genuinely stopped control.
 */
private class CraftNativeActivityIndicator(context: Context) :
    android.widget.ProgressBar(context, null, android.R.attr.progressBarStyleHorizontal) {
    var indicatorScale = 1f

    init {
        val spinner = android.widget.ProgressBar(context).indeterminateDrawable
        indeterminateDrawable = spinner
        progressDrawable = spinner?.constantState?.newDrawable()?.mutate() ?: spinner
    }
}

/** Android counterpart to iOS's UIDatePicker-backed native DatePicker. */
private class CraftNativeDatePickerView(context: Context) : FrameLayout(context) {
    private enum class PickerMode { DATE, TIME, DATE_TIME, COUNTDOWN }
    private val maxCountdownSeconds = 23 * 3600 + 59 * 60 + 59

    private var pickerMode: PickerMode? = null
    private var datePicker: DatePicker? = null
    private var timePicker: TimePicker? = null
    private var defaultDateBounds: Pair<Long, Long>? = null
    private var minuteInterval = 1
    private var countdownSecond = 0
    private var suppressChanges = true
    var onValueChanged: (() -> Unit)? = null

    init {
        isFocusable = true
    }

    fun configure(props: JSONObject) {
        val requestedMode = when (props.opt("mode") as? String) {
            "time" -> PickerMode.TIME
            "datetime", "dateAndTime", "datetime-local" -> PickerMode.DATE_TIME
            "countdown" -> PickerMode.COUNTDOWN
            else -> PickerMode.DATE
        }
        if (pickerMode != requestedMode) {
            pickerMode = requestedMode
            datePicker = null
            timePicker = null
            removeAllViews()
            val content = LinearLayout(context).apply {
                orientation = LinearLayout.VERTICAL
                gravity = Gravity.CENTER
            }
            if (requestedMode == PickerMode.DATE || requestedMode == PickerMode.DATE_TIME) {
                datePicker = DatePicker(context).also { picker ->
                    defaultDateBounds = picker.minDate to picker.maxDate
                    val today = Calendar.getInstance()
                    picker.init(today.get(Calendar.YEAR), today.get(Calendar.MONTH), today.get(Calendar.DAY_OF_MONTH)) { _, _, _, _ -> changed() }
                    content.addView(picker, LinearLayout.LayoutParams(
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                    ))
                }
            }
            if (requestedMode != PickerMode.DATE) {
                timePicker = TimePicker(context).also { picker ->
                    picker.setIs24HourView(true)
                    picker.setOnTimeChangedListener { _, _, _ -> changed() }
                    content.addView(picker, LinearLayout.LayoutParams(
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                        ViewGroup.LayoutParams.WRAP_CONTENT,
                    ))
                }
            }
            addView(content, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
        }

        suppressChanges = true
        minuteInterval = craftNativeInt(props.opt("minuteInterval"), 1).takeIf { it in 1..30 && 60 % it == 0 } ?: 1
        val defaults = defaultDateBounds
        datePicker?.minDate = pickerDate(props.opt("minimumDate"))?.timeInMillis ?: defaults?.first ?: datePicker?.minDate ?: 0L
        datePicker?.maxDate = pickerDate(props.opt("maximumDate"))?.timeInMillis ?: defaults?.second ?: datePicker?.maxDate ?: Long.MAX_VALUE
        if (requestedMode == PickerMode.COUNTDOWN) {
            countdownSecond = 0
            countdownSeconds(props.opt("value"))?.let { applyCountdown(it) }
        } else {
            pickerDate(props.opt("value"))?.let { applyDate(it) }
        }
        val enabled = !craftNativeBoolean(props.opt("disabled"))
        isEnabled = enabled
        datePicker?.isEnabled = enabled
        timePicker?.isEnabled = enabled
        for (index in 0 until childCount) getChildAt(index).isEnabled = enabled
        suppressChanges = false
    }

    fun event(): JSONObject {
        if (pickerMode == PickerMode.COUNTDOWN) {
            val seconds = currentCountdownSeconds()
            return JSONObject()
                .put("value", formatCountdown(seconds))
                .put("iso", "PT${seconds}S")
                .put("timestamp", seconds * 1000L)
        }
        val current = currentDate()
        val valueFormat = when (pickerMode) {
            PickerMode.DATE -> "yyyy-MM-dd"
            PickerMode.TIME -> "HH:mm"
            else -> "yyyy-MM-dd'T'HH:mm"
        }
        val value = SimpleDateFormat(valueFormat, Locale.US).apply { isLenient = false }.format(current.time)
        val iso = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX", Locale.US).format(current.time)
        return JSONObject().put("value", value).put("iso", iso).put("timestamp", current.timeInMillis)
    }

    fun resetForTeardown() {
        suppressChanges = true
        onValueChanged = null
    }

    private fun changed() {
        if (suppressChanges) return
        // A date-only picker has no time half to snap, but its change is
        // still the screen's to hear.
        timePicker?.let { picker ->
            val snapped = ((picker.minute + minuteInterval / 2) / minuteInterval * minuteInterval).coerceAtMost(59)
            if (snapped != picker.minute) {
                suppressChanges = true
                picker.minute = snapped
                suppressChanges = false
            }
        }
        onValueChanged?.invoke()
    }

    private fun applyDate(value: Calendar) {
        datePicker?.updateDate(value.get(Calendar.YEAR), value.get(Calendar.MONTH), value.get(Calendar.DAY_OF_MONTH))
        timePicker?.hour = value.get(Calendar.HOUR_OF_DAY)
        timePicker?.minute = value.get(Calendar.MINUTE)
    }

    private fun applyCountdown(seconds: Int) {
        countdownSecond = seconds % 60
        timePicker?.hour = (seconds / 3600).coerceIn(0, 23)
        timePicker?.minute = (seconds % 3600 / 60).coerceIn(0, 59)
    }

    private fun currentCountdownSeconds(): Int = timePicker?.let { it.hour * 3600 + it.minute * 60 + countdownSecond } ?: 0

    private fun formatCountdown(seconds: Int): String = "%02d:%02d:%02d".format(
        Locale.US,
        seconds / 3600,
        seconds % 3600 / 60,
        seconds % 60,
    )

    private fun currentDate(): Calendar = Calendar.getInstance().also { current ->
        datePicker?.let {
            current.set(Calendar.YEAR, it.year)
            current.set(Calendar.MONTH, it.month)
            current.set(Calendar.DAY_OF_MONTH, it.dayOfMonth)
        }
        timePicker?.let {
            current.set(Calendar.HOUR_OF_DAY, it.hour)
            current.set(Calendar.MINUTE, it.minute)
            current.set(Calendar.SECOND, 0)
            current.set(Calendar.MILLISECOND, 0)
        }
    }

    private fun pickerDate(value: Any?): Calendar? {
        if (value is Number && value !is Boolean) {
            val milliseconds = value.toDouble()
            if (!milliseconds.isFinite()) return null
            return runCatching { Calendar.getInstance().apply { timeInMillis = milliseconds.toLong() } }.getOrNull()
        }
        val text = value?.toString()?.trim().orEmpty()
        if (text.isBlank() || text == JSONObject.NULL.toString()) return null
        val formats = listOf(
            "HH:mm", "HH:mm:ss", "yyyy-MM-dd", "yyyy-MM-dd'T'HH:mm",
            "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss.SSS",
            "yyyy-MM-dd'T'HH:mm:ss.SSSXXX", "yyyy-MM-dd'T'HH:mm:ssX",
        )
        formats.firstNotNullOfOrNull { format ->
            runCatching {
                SimpleDateFormat(format, Locale.US).apply { isLenient = false }.parse(text)
            }.getOrNull()
        }?.let { parsed ->
            return Calendar.getInstance().apply { time = parsed }
        }
        return null
    }

    private fun countdownSeconds(value: Any?): Int? {
        if (value is Number && value !is Boolean) {
            val seconds = value.toDouble()
            if (!seconds.isFinite()) return null
            return seconds.coerceIn(0.0, maxCountdownSeconds.toDouble()).roundToInt()
        }
        val text = value?.toString()?.trim().orEmpty()
        if (text.isBlank() || text == JSONObject.NULL.toString()) return null
        text.toDoubleOrNull()?.takeIf { it.isFinite() }?.let { return it.coerceIn(0.0, maxCountdownSeconds.toDouble()).roundToInt() }
        val parts = text.split(':')
        if (parts.size != 2 && parts.size != 3) return null
        val hours = parts[0].toDoubleOrNull() ?: return null
        val minutes = parts[1].toDoubleOrNull() ?: return null
        val seconds = if (parts.size == 3) parts[2].toDoubleOrNull() ?: return null else 0.0
        if (!hours.isFinite() || !minutes.isFinite() || !seconds.isFinite() ||
            hours < 0 || minutes !in 0.0..<60.0 || seconds !in 0.0..<60.0) return null
        return (hours * 3600 + minutes * 60 + seconds).coerceIn(0.0, maxCountdownSeconds.toDouble()).roundToInt()
    }
}

/** A field's pending native edits and the props acknowledged by the screen. */
internal class CraftNativeInputEcho {
    private val pending = ArrayDeque<String>()
    private var rendered: String? = null
    private var initialized = false

    private var eventCount = 0

    fun record(value: String): Int {
        pending.addLast(value)
        while (pending.size > 64) pending.removeFirst()
        return ++eventCount
    }

    fun accept(value: String?, nativeValue: String, acknowledged: Int? = null): Boolean {
        if (value == null) {
            initialized = false
            rendered = null
            pending.clear()
            return false
        }
        if (acknowledged != null && acknowledged >= 0) {
            if (acknowledged < eventCount) return false
            pending.clear()
            initialized = true
            rendered = value
            return nativeValue != value
        }
        // A retained field can render the same prop more than once, after
        // its echo was consumed. That repeated prop must not overwrite a
        // keystroke that has not made the native/JS round trip yet.
        val changed = !initialized || rendered != value
        initialized = true
        rendered = value
        if (!changed) return false
        val index = pending.indexOf(value)
        if (index >= 0) repeat(index + 1) { pending.removeFirst() }
        return nativeValue != value && index < 0
    }
}

/**
 * A native screen's `<Video>`: the platform's VideoView.
 *
 * It plays without taking audio focus, so the person's music carries on
 * under it, as on iOS. `onLoadStart`, `onLoad`, `onLoadEnd`, `onPlay`,
 * `onPause`, `onEnd` and `onError`
 * reach the screen in the web's names, from the controls as well as from
 * props. With `pictureInPicture` the activity takes it into a floating
 * window when the person leaves the app while it plays (MainActivity
 * `updatePictureInPicture`), drawn there on a surface of the activity's own
 * while this view keeps its place.
 */
private class CraftNativeVideoView(context: Context) : VideoView(context) {
    private var sourceUri = ""
    private var shouldLoop = false
    private var shouldPlay = false
    private var playIntent: Boolean? = null
    private var userPaused = false
    private var ended = false
    private var muted = false
    private var resizeMode = "contain"
    private var requestedTimeSeconds: Double? = null
    private var pendingSeekSeconds: Double? = null
    private var preparedPlayer: MediaPlayer? = null
    /** The screen's handlers by event name, and how an event reaches them. */
    var handlers: JSONObject = JSONObject()
    var emit: ((handler: String, nativeEvent: JSONObject) -> Unit)? = null
    /** May float in Picture in Picture while it plays. */
    var pictureInPicture = false
        private set
    /** Playing now, by the controls or by props. */
    var playing = false
        private set
    /** Playback started or stopped, or the choice changed: the activity's PiP params follow. */
    var onPictureInPictureChanged: (() -> Unit)? = null
    private val progressHandler = Handler(Looper.getMainLooper())
    private val progressTick = object : Runnable {
        override fun run() {
            if (!playing) return
            fire("onProgress", JSONObject()
                .put("currentTime", currentPosition.coerceAtLeast(0) / 1000.0)
                .put("duration", duration.coerceAtLeast(0) / 1000.0))
            progressHandler.postDelayed(this, 500L)
        }
    }

    init {
        // Mixed with the music rather than pausing it.
        setAudioFocusRequest(AudioManager.AUDIOFOCUS_NONE)
    }

    private fun applyPendingSeek() {
        val target = pendingSeekSeconds ?: return
        if (preparedPlayer == null) return
        val current = currentPosition.coerceAtLeast(0) / 1000.0
        pendingSeekSeconds = null
        if (kotlin.math.abs(current - target) > 0.25) seekTo((target * 1000.0).roundToInt().coerceAtLeast(0))
    }

    fun configure(source: Any?, autoplay: Boolean, paused: Boolean, loop: Boolean, muted: Boolean, currentTime: Any?, controls: Boolean, resizeMode: String?, pictureInPicture: Boolean = false) {
        val uri = when (source) {
            is String -> source
            is JSONObject -> craftNativeOptionalString(source.opt("uri")).orEmpty()
            else -> ""
        }
        val nextTime = craftNativeNumber(currentTime)?.takeIf { it.isFinite() && it >= 0.0 }
        if (nextTime != requestedTimeSeconds) {
            requestedTimeSeconds = nextTime
            pendingSeekSeconds = nextTime
        }
        shouldLoop = loop
        val nextShouldPlay = autoplay && !paused
        if (playIntent != nextShouldPlay) {
            userPaused = false
            ended = false
        }
        playIntent = nextShouldPlay
        shouldPlay = nextShouldPlay
        this.muted = muted
        val floating = pictureInPicture && !muted
        if (floating != this.pictureInPicture) {
            this.pictureInPicture = floating
            onPictureInPictureChanged?.invoke()
        }
        this.resizeMode = resizeMode?.lowercase()?.takeIf { it in setOf("cover", "contain", "stretch", "center") } ?: "contain"
        applyScalingMode()
        setMediaController(if (controls) MediaController(context).also { it.setAnchorView(this) } else null)
        if (uri != sourceUri) {
            sourceUri = uri
            pendingSeekSeconds = requestedTimeSeconds
            userPaused = false
            ended = false
            stopPlayback()
            setPlaying(false)
            preparedPlayer = null
            if (uri.isBlank()) return
            // A copy kept on the phone (craft.media.keep) plays in place of
            // the address: offline in a gym with no signal.
            val kept = CraftNativeMedia.local(context, uri)
            fire("onLoadStart")
            setVideoURI(if (kept != null) Uri.fromFile(kept) else Uri.parse(uri))
            setOnPreparedListener { mediaPlayer ->
                preparedPlayer = mediaPlayer
                applyScalingMode()
                mediaPlayer.isLooping = shouldLoop
                val volume = if (this.muted) 0f else 1f
                mediaPlayer.setVolume(volume, volume)
                applyPendingSeek()
                fire("onLoad", JSONObject().put("duration", duration / 1000.0))
                fire("onLoadEnd")
                if (shouldPlay) start()
            }
            setOnCompletionListener {
                if (shouldLoop && !isPlaying) start()
                else {
                    ended = true
                    setPlaying(false)
                }
                fire("onEnd")
            }
            setOnErrorListener { _, what, extra ->
                setPlaying(false)
                fire("onError", JSONObject().put("message", "The video could not be played ($what, $extra)"))
                true
            }
        }
        if (uri.isBlank()) return
        applyPendingSeek()
        runCatching {
            if (shouldPlay && !isPlaying && !userPaused && !ended) start()
            else if (!shouldPlay && isPlaying) pause()
        }
    }

    override fun start() {
        super.start()
        userPaused = false
        ended = false
        // VideoView accepts start() before its MediaPlayer is prepared. Do
        // not announce playback until the player reports that it is actually
        // running; iOS follows the same rule through AVPlayer's time status.
        if (runCatching { isPlaying }.getOrDefault(false)) setPlaying(true)
    }

    override fun pause() {
        super.pause()
        userPaused = true
        setPlaying(false)
    }

    private fun setPlaying(value: Boolean) {
        if (playing == value) return
        playing = value
        fire(if (value) "onPlay" else "onPause")
        progressHandler.removeCallbacks(progressTick)
        if (value) progressHandler.post(progressTick)
        onPictureInPictureChanged?.invoke()
    }

    private fun fire(event: String, nativeEvent: JSONObject = JSONObject()) {
        val handler = craftNativeEventName(handlers, event)
        if (handler.isNotBlank()) emit?.invoke(handler, nativeEvent)
    }

    /** Its width over height once known, inside what Picture in Picture allows. */
    fun aspectRatio(): Rational? {
        val player = preparedPlayer ?: return null
        val width = runCatching { player.videoWidth }.getOrDefault(0)
        val height = runCatching { player.videoHeight }.getOrDefault(0)
        if (width <= 0 || height <= 0) return null
        val ratio = (width.toDouble() / height).coerceIn(1 / 2.39, 2.39)
        return Rational((ratio * 1000).roundToInt(), 1000)
    }

    /** Draws on `holder` (the floating window's surface), or back on its own with null. */
    fun showOn(holder: SurfaceHolder?): Boolean {
        val player = preparedPlayer ?: return false
        return runCatching { player.setDisplay(holder ?: this.holder) }.isSuccess
    }

    fun notifyPictureInPicture(active: Boolean) {
        fire(if (active) "onPictureInPictureStart" else "onPictureInPictureStop")
    }

    fun stop() {
        // Released with its screen: nothing more is told to it.
        emit = null
        // VideoView otherwise keeps these listener objects until its media
        // player is replaced. Clear them before stopping so an asynchronous
        // prepare/completion/error callback cannot outlive the native node.
        setOnPreparedListener(null)
        setOnCompletionListener(null)
        setOnErrorListener(null)
        progressHandler.removeCallbacks(progressTick)
        stopPlayback()
        setPlaying(false)
        sourceUri = ""
        requestedTimeSeconds = null
        pendingSeekSeconds = null
        playIntent = null
        userPaused = false
        ended = false
        preparedPlayer = null
        if (pictureInPicture) {
            pictureInPicture = false
            onPictureInPictureChanged?.invoke()
        }
        onPictureInPictureChanged = null
        handlers = JSONObject()
    }

    private fun applyScalingMode() {
        preparedPlayer?.setVideoScalingMode(
            if (resizeMode == "cover") MediaPlayer.VIDEO_SCALING_MODE_SCALE_TO_FIT_WITH_CROPPING
            else MediaPlayer.VIDEO_SCALING_MODE_SCALE_TO_FIT,
        )
    }
}

/**
 * The native-screen Web Audio graph. Android renders the same useful graph
 * shape as iOS: oscillators and buffer sources can pass through gain, filter,
 * delay, compressor, and convolver nodes before reaching the destination.
 * Effects deliberately remain conservative in this first Android renderer;
 * the graph and its timing are native, while the existing WebView remains the
 * fallback for unsupported media decoding.
 */
private class CraftNativeAudio {
    private data class ParameterEvent(val time: Double, val value: Double, val mode: String)

    private class Parameter(initial: Double) {
        private var current = initial
        private val events = mutableListOf<ParameterEvent>()

        @Synchronized fun set(value: Double) {
            current = value
            events.clear()
        }

        @Synchronized fun schedule(value: Double, time: Double, mode: String) {
            events += ParameterEvent(time.coerceAtLeast(0.0), value, mode)
            events.sortBy { it.time }
        }

        @Synchronized fun valueAt(time: Double): Double {
            var previousTime = 0.0
            var previousValue = current
            for (event in events) {
                if (time < event.time) {
                    if (event.time <= previousTime) return previousValue
                    val fraction = (time - previousTime) / (event.time - previousTime)
                    return when (event.mode) {
                        "exponential" -> {
                            val start = previousValue.takeIf { it > 0 } ?: 0.000001
                            val end = event.value.takeIf { it > 0 } ?: 0.000001
                            start * (end / start).pow(fraction)
                        }
                        "target" -> {
                            previousValue + (event.value - previousValue) * (1 - exp(-fraction * 5))
                        }
                        "linear" -> previousValue + (event.value - previousValue) * fraction
                        else -> previousValue
                    }
                }
                previousTime = event.time
                previousValue = event.value
            }
            return previousValue
        }
    }

    private class NodeState(
        val contextId: String,
        val id: String,
        val kind: String,
    ) {
        val frequency = Parameter(440.0)
        val detune = Parameter(0.0)
        val gain = Parameter(1.0)
        val playbackRate = Parameter(1.0)
        var waveform = 0
        var bufferId: String? = null
        var bufferLoop = false
        var loopStart = 0.0
        var loopEnd = 0.0
        var startOffset = 0.0
        var startAt = Double.POSITIVE_INFINITY
        var stopAt = Double.POSITIVE_INFINITY
    }

    private data class BufferSpec(
        val length: Int,
        val sampleRate: Double,
        val channels: List<FloatArray> = emptyList(),
    )

    private val nodes = mutableMapOf<String, NodeState>()
    private val inputs = mutableMapOf<String, MutableSet<String>>()
    private val buffers = mutableMapOf<String, BufferSpec>()
    private val contextStarts = mutableMapOf<String, Double>()
    private val suspended = mutableSetOf<String>()
    private var track: AudioTrack? = null
    @Volatile private var running = false
    private var renderThread: Thread? = null

    private fun key(contextId: String, nodeId: String): String = "$contextId:$nodeId"

    private fun node(contextId: String, nodeId: String): NodeState? = nodes[key(contextId, nodeId)]

    @Synchronized fun handle(payload: JSONObject) {
        val contextId = payload.optString("contextId")
        when (payload.optString("action")) {
            "createContext" -> {
                contextId.takeIf { it.isNotBlank() }?.let {
                    contextStarts[it] = System.nanoTime() / 1_000_000_000.0
                    suspended.remove(it)
                }
            }
            "createOscillator", "createGain", "createBufferSource", "createBiquadFilter",
            "createDelay", "createDynamicsCompressor", "createConvolver" -> {
                val id = payload.optString("nodeId")
                if (contextId.isBlank() || id.isBlank()) return
                val state = NodeState(contextId, id, payload.optString("action").removePrefix("create"))
                state.frequency.set(payload.optDouble("frequency", 440.0).coerceAtLeast(0.0))
                state.gain.set(payload.optDouble("gain", 1.0).coerceAtLeast(0.0))
                nodes[key(contextId, id)] = state
            }
            "createBuffer" -> {
                val id = payload.optString("bufferId")
                if (id.isNotBlank()) {
                    val length = payload.optInt("length", 1).coerceAtLeast(1)
                    val channelCount = payload.optInt("channels", 1).coerceIn(1, 2)
                    buffers[id] = BufferSpec(
                        length,
                        payload.optDouble("sampleRate", 44_100.0).coerceAtLeast(3_000.0),
                        List(channelCount) { FloatArray(length) },
                    )
                }
            }
            "bufferData" -> {
                val id = payload.optString("bufferId")
                val existing = buffers[id] ?: return
                val rawChannels = payload.optJSONArray("channels") ?: return
                val channels = (0 until min(existing.channels.size, rawChannels.length())).map { channelIndex ->
                    val raw = rawChannels.optJSONArray(channelIndex)
                    FloatArray(existing.length) { sampleIndex ->
                        val value = raw?.optDouble(sampleIndex, 0.0) ?: 0.0
                        value.takeIf { it.isFinite() }?.toFloat()?.coerceIn(-1f, 1f) ?: 0f
                    }
                }
                buffers[id] = existing.copy(channels = channels)
            }
            "connect" -> {
                val source = payload.optString("sourceId")
                val destination = payload.optString("destinationId", "destination")
                if (contextId.isNotBlank() && source.isNotBlank()) {
                    inputs.getOrPut(key(contextId, destination)) { mutableSetOf() }.add(key(contextId, source))
                }
            }
            "connectParam" -> {
                // Parameter modulation is accepted by the protocol. The
                // Android renderer keeps the target's scheduled value stable
                // rather than dropping the graph connection or throwing.
            }
            "type" -> node(contextId, payload.optString("nodeId"))?.waveform = payload.optInt("value", 0)
            "buffer" -> node(contextId, payload.optString("nodeId"))?.bufferId = payload.optString("bufferId").takeIf { it.isNotBlank() }
            "loop" -> node(contextId, payload.optString("nodeId"))?.let {
                it.bufferLoop = payload.optBoolean("loop", false)
                it.loopStart = payload.optDouble("loopStart", 0.0).coerceAtLeast(0.0)
                it.loopEnd = payload.optDouble("loopEnd", 0.0).coerceAtLeast(0.0)
            }
            "frequency", "gain", "detune", "playbackRate" -> {
                val state = node(contextId, payload.optString("nodeId")) ?: return
                parameter(state, payload.optString("action"))?.set(payload.optDouble("value", 0.0))
            }
            "frequencyAtTime", "frequencyRampToTime", "frequencyExponentialRampToTime",
            "gainAtTime", "gainRampToTime", "gainExponentialRampToTime",
            "detuneAtTime", "detuneRampToTime", "detuneExponentialRampToTime",
            "playbackRateAtTime", "playbackRateRampToTime", "playbackRateExponentialRampToTime",
            "gainTargetAtTime" -> {
                val state = node(contextId, payload.optString("nodeId")) ?: return
                val action = payload.optString("action")
                val parameterName = when {
                    action.contains("TargetAtTime") -> action.substringBefore("TargetAtTime")
                    action.contains("ExponentialRampToTime") -> action.substringBefore("ExponentialRampToTime")
                    action.contains("RampToTime") -> action.substringBefore("RampToTime")
                    else -> action.substringBefore("AtTime")
                }
                parameter(state, parameterName)?.schedule(
                    payload.optDouble("value", 0.0), payload.optDouble("time", 0.0),
                    when {
                        action.contains("Exponential") -> "exponential"
                        action.contains("Target") -> "target"
                        action.contains("Ramp") -> "linear"
                        else -> "set"
                    },
                )
            }
            "start" -> {
                val state = node(contextId, payload.optString("nodeId")) ?: return
                ensureTrack()
                val now = contextTime(contextId)
                state.startAt = now + payload.optDouble("delay", 0.0).coerceAtLeast(0.0)
                state.startOffset = payload.optDouble("offset", 0.0).coerceAtLeast(0.0)
                val duration = payload.optDouble("duration", -1.0)
                if (duration > 0) state.stopAt = state.startAt + duration
            }
            "stop" -> {
                val state = node(contextId, payload.optString("nodeId")) ?: return
                state.stopAt = contextTime(contextId) + payload.optDouble("delay", 0.0).coerceAtLeast(0.0)
            }
            "state" -> when (payload.optString("state")) {
                "suspended" -> suspended.add(contextId)
                "running" -> suspended.remove(contextId)
                "closed" -> closeContext(contextId)
            }
            "close" -> close()
        }
    }

    private fun parameter(state: NodeState, name: String): Parameter? = when (name) {
        "frequency" -> state.frequency
        "gain" -> state.gain
        "detune" -> state.detune
        "playbackRate" -> state.playbackRate
        else -> null
    }

    private fun contextTime(contextId: String): Double {
        return (System.nanoTime() / 1_000_000_000.0) - (contextStarts[contextId] ?: return 0.0)
    }

    private fun closeContext(contextId: String) {
        val prefix = "$contextId:"
        nodes.keys.removeAll { it.startsWith(prefix) }
        inputs.keys.removeAll { it.startsWith(prefix) }
        inputs.values.forEach { it.removeAll { source -> source.startsWith(prefix) } }
        contextStarts.remove(contextId)
        suspended.remove(contextId)
    }

    @Synchronized fun close() {
        nodes.clear()
        inputs.clear()
        buffers.clear()
        contextStarts.clear()
        suspended.clear()
        running = false
        renderThread?.interrupt()
        renderThread = null
        track?.let { output ->
            runCatching {
                output.pause()
                output.flush()
                output.release()
            }
        }
        track = null
    }

    @Synchronized private fun ensureTrack() {
        if (track != null) return
        val sampleRate = 44_100
        val minBuffer = AudioTrack.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_OUT_STEREO, AudioFormat.ENCODING_PCM_16BIT)
        val format = AudioFormat.Builder()
            .setSampleRate(sampleRate)
            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
            .setChannelMask(AudioFormat.CHANNEL_OUT_STEREO)
            .build()
        val attributes = AudioAttributes.Builder()
            .setUsage(AudioAttributes.USAGE_MEDIA)
            .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
            .build()
        val created = AudioTrack.Builder()
            .setAudioAttributes(attributes)
            .setAudioFormat(format)
            .setBufferSizeInBytes(max(minBuffer, sampleRate / 4))
            .setTransferMode(AudioTrack.MODE_STREAM)
            .build()
        track = created
        running = true
        created.play()
        renderThread = Thread({ render(created, sampleRate) }, "craft-native-audio").also { it.start() }
    }

    private fun render(output: AudioTrack, sampleRate: Int) {
        val buffer = ShortArray(1024 * 2)
        val stereo = DoubleArray(2)
        while (running && !Thread.currentThread().isInterrupted) {
            for (frame in 0 until 1024) {
                synchronized(this) {
                    stereo[0] = contextStarts.keys.sumOf { contextId ->
                        if (contextId in suspended) 0.0
                        else renderNode(key(contextId, "destination"), contextTime(contextId) + frame.toDouble() / sampleRate, 0, mutableSetOf())
                    }
                    stereo[1] = contextStarts.keys.sumOf { contextId ->
                        if (contextId in suspended) 0.0
                        else renderNode(key(contextId, "destination"), contextTime(contextId) + frame.toDouble() / sampleRate, 1, mutableSetOf())
                    }
                }
                buffer[frame * 2] = (stereo[0].coerceIn(-1.0, 1.0) * Short.MAX_VALUE).toInt().toShort()
                buffer[frame * 2 + 1] = (stereo[1].coerceIn(-1.0, 1.0) * Short.MAX_VALUE).toInt().toShort()
            }
            if (output.write(buffer, 0, buffer.size, AudioTrack.WRITE_BLOCKING) < 0) break
        }
    }

    private fun renderNode(nodeKey: String, time: Double, channel: Int, visited: MutableSet<String>): Double {
        if (!visited.add(nodeKey)) return 0.0
        val state = nodes[nodeKey]
        var value = 0.0
        if (state == null || state.kind == "destination" || state.kind == "Gain" || state.kind == "BiquadFilter" || state.kind == "Delay" || state.kind == "DynamicsCompressor" || state.kind == "Convolver") {
            for (source in inputs[nodeKey].orEmpty()) value += renderNode(source, time, channel, visited)
        } else if (state.kind == "Oscillator") {
            if (time >= state.startAt && time < state.stopAt) {
                val elapsed = (time - state.startAt).coerceAtLeast(0.0)
                val frequency = (state.frequency.valueAt(time) * 2.0.pow(state.detune.valueAt(time) / 1200.0)).coerceAtLeast(0.0)
                val phase = (elapsed * frequency) % 1.0
                value = when (state.waveform) {
                    1 -> if (phase < 0.5) 1.0 else -1.0
                    2 -> 2.0 * phase - 1.0
                    3 -> 1.0 - 4.0 * kotlin.math.abs(phase - 0.5)
                    else -> sin(phase * 2.0 * PI)
                }
            }
        } else if (state.kind == "BufferSource") {
            val buffer = state.bufferId?.let(buffers::get)
            if (buffer != null && time >= state.startAt && time < state.stopAt) {
                val elapsed = (time - state.startAt) * state.playbackRate.valueAt(time).coerceAtLeast(0.01)
                val length = buffer.length.toDouble() / buffer.sampleRate
                val loopEnd = if (state.loopEnd > state.loopStart) state.loopEnd else length
                val position = if (state.bufferLoop && loopEnd > state.loopStart) {
                    state.loopStart + ((elapsed + state.startOffset - state.loopStart) % (loopEnd - state.loopStart))
                } else elapsed + state.startOffset
                if (state.bufferLoop || position < length) {
                    val sampleIndex = (position * buffer.sampleRate).toLong().coerceAtLeast(0)
                    value = (buffer.channels.getOrNull(channel) ?: buffer.channels.firstOrNull())
                        ?.getOrNull(sampleIndex.toInt())
                        ?.toDouble()
                        ?: 0.0
                }
            }
        }
        if (state?.kind == "Gain") value *= state.gain.valueAt(time).coerceAtLeast(0.0)
        visited.remove(nodeKey)
        return value
    }
}

private class CraftTextDecorationSpan(
    private val line: String,
    private val style: String,
    private val decorationColor: Int?,
) : ReplacementSpan() {
    override fun getSize(paint: Paint, text: CharSequence, start: Int, end: Int, fm: Paint.FontMetricsInt?): Int {
        return ceil(paint.measureText(text, start, end).toDouble()).toInt()
    }

    override fun draw(
        canvas: Canvas,
        text: CharSequence,
        start: Int,
        end: Int,
        x: Float,
        top: Int,
        y: Int,
        bottom: Int,
        paint: Paint,
    ) {
        val originalColor = paint.color
        val originalStyle = paint.style
        val originalStrokeWidth = paint.strokeWidth
        val originalPathEffect = paint.pathEffect
        val originalStrokeCap = paint.strokeCap
        paint.style = Paint.Style.FILL
        paint.pathEffect = null
        canvas.drawText(text, start, end, x, y.toFloat(), paint)

        val width = paint.measureText(text, start, end)
        val thickness = max(1f, paint.textSize / 16f)
        val underlineY = y + max(1f, paint.descent() * 0.15f)
        val strikeY = y - paint.textSize * 0.3f
        val decoration = decorationColor ?: originalColor
        paint.color = decoration
        paint.style = Paint.Style.STROKE
        paint.strokeWidth = thickness
        paint.strokeCap = if (style == "dotted") Paint.Cap.ROUND else Paint.Cap.BUTT
        paint.pathEffect = when (style) {
            "dashed" -> DashPathEffect(floatArrayOf(paint.textSize * 0.35f, paint.textSize * 0.25f), 0f)
            "dotted" -> DashPathEffect(floatArrayOf(thickness, paint.textSize * 0.22f), 0f)
            else -> null
        }

        fun drawLine(position: Float) {
            canvas.drawLine(x, position, x + width, position, paint)
        }
        if (line == "underline" || line == "underline line-through") {
            drawLine(underlineY)
            if (style == "double") drawLine(underlineY + thickness * 2.5f)
        }
        if (line == "line-through" || line == "underline line-through") {
            drawLine(strikeY)
            if (style == "double") drawLine(strikeY + thickness * 2.5f)
        }

        paint.color = originalColor
        paint.style = originalStyle
        paint.strokeWidth = originalStrokeWidth
        paint.pathEffect = originalPathEffect
        paint.strokeCap = originalStrokeCap
    }
}

private fun craftNativeGradientOrientation(direction: String?): GradientDrawable.Orientation = when (direction) {
    "to-t" -> GradientDrawable.Orientation.BOTTOM_TOP
    "to-tr" -> GradientDrawable.Orientation.BL_TR
    "to-r" -> GradientDrawable.Orientation.LEFT_RIGHT
    "to-br" -> GradientDrawable.Orientation.TL_BR
    "to-bl" -> GradientDrawable.Orientation.TR_BL
    "to-l" -> GradientDrawable.Orientation.RIGHT_LEFT
    "to-tl" -> GradientDrawable.Orientation.BR_TL
    else -> GradientDrawable.Orientation.TOP_BOTTOM
}

private class CraftNativeSideBorderDrawable(
    private val fillColor: Int,
    private val radii: FloatArray,
    private val widths: IntArray,
    private val colors: IntArray,
    private val borderStyle: String?,
    private val gradientDirection: String?,
    private val gradientColors: IntArray?,
) : Drawable() {
    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)

    private fun gradient(bounds: RectF): Shader? {
        val colors = gradientColors ?: return null
        val points = when (gradientDirection) {
            "to-t" -> floatArrayOf(0.5f, 1f, 0.5f, 0f)
            "to-tr" -> floatArrayOf(0f, 1f, 1f, 0f)
            "to-r" -> floatArrayOf(0f, 0.5f, 1f, 0.5f)
            "to-br" -> floatArrayOf(0f, 0f, 1f, 1f)
            "to-bl" -> floatArrayOf(1f, 0f, 0f, 1f)
            "to-l" -> floatArrayOf(1f, 0.5f, 0f, 0.5f)
            "to-tl" -> floatArrayOf(1f, 1f, 0f, 0f)
            else -> floatArrayOf(0.5f, 0f, 0.5f, 1f)
        }
        return LinearGradient(
            bounds.left + bounds.width() * points[0],
            bounds.top + bounds.height() * points[1],
            bounds.left + bounds.width() * points[2],
            bounds.top + bounds.height() * points[3],
            colors,
            null,
            Shader.TileMode.CLAMP,
        )
    }

    override fun draw(canvas: Canvas) {
        val bounds = RectF(this.bounds)
        paint.style = Paint.Style.FILL
        paint.color = fillColor
        paint.shader = gradient(bounds)
        if (paint.shader != null || Color.alpha(fillColor) > 0) {
            val path = Path().apply { addRoundRect(bounds, radii, Path.Direction.CW) }
            canvas.drawPath(path, paint)
        }
        paint.shader = null
        val top = widths.getOrElse(0) { 0 }
        val right = widths.getOrElse(1) { 0 }
        val bottom = widths.getOrElse(2) { 0 }
        val left = widths.getOrElse(3) { 0 }
        if (borderStyle == "dashed" || borderStyle == "dotted") {
            paint.style = Paint.Style.STROKE
            paint.strokeCap = if (borderStyle == "dotted") Paint.Cap.ROUND else Paint.Cap.BUTT
            paint.pathEffect = null
            fun drawEdge(index: Int, width: Int, startX: Float, startY: Float, endX: Float, endY: Float) {
                if (width <= 0) return
                paint.color = colors.getOrElse(index) { Color.TRANSPARENT }
                paint.strokeWidth = width.toFloat()
                paint.pathEffect = if (borderStyle == "dotted") {
                    DashPathEffect(floatArrayOf(width.toFloat(), width * 1.5f), 0f)
                } else {
                    DashPathEffect(floatArrayOf(width * 3f, width * 2f), 0f)
                }
                canvas.drawLine(startX, startY, endX, endY, paint)
            }
            drawEdge(0, top, bounds.left, bounds.top + top / 2f, bounds.right, bounds.top + top / 2f)
            drawEdge(1, right, bounds.right - right / 2f, bounds.top, bounds.right - right / 2f, bounds.bottom)
            drawEdge(2, bottom, bounds.left, bounds.bottom - bottom / 2f, bounds.right, bounds.bottom - bottom / 2f)
            drawEdge(3, left, bounds.left + left / 2f, bounds.top, bounds.left + left / 2f, bounds.bottom)
            paint.pathEffect = null
        } else {
            paint.style = Paint.Style.FILL
            if (top > 0) { paint.color = colors.getOrElse(0) { Color.TRANSPARENT }; canvas.drawRect(bounds.left, bounds.top, bounds.right, bounds.top + top, paint) }
            if (right > 0) { paint.color = colors.getOrElse(1) { Color.TRANSPARENT }; canvas.drawRect(bounds.right - right, bounds.top, bounds.right, bounds.bottom, paint) }
            if (bottom > 0) { paint.color = colors.getOrElse(2) { Color.TRANSPARENT }; canvas.drawRect(bounds.left, bounds.bottom - bottom, bounds.right, bounds.bottom, paint) }
            if (left > 0) { paint.color = colors.getOrElse(3) { Color.TRANSPARENT }; canvas.drawRect(bounds.left, bounds.top, bounds.left + left, bounds.bottom, paint) }
        }
    }

    override fun setAlpha(alpha: Int) { paint.alpha = alpha; invalidateSelf() }
    override fun setColorFilter(colorFilter: ColorFilter?) { paint.colorFilter = colorFilter; invalidateSelf() }
    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
}

/** Protects only the native three-button region; content keeps its authored background. */
private class CraftNativeNavigationBarProtection : Drawable() {
    private val paint = Paint()
    private var left = 0
    private var right = 0
    private var bottom = 0

    fun update(color: Int, left: Int, right: Int, bottom: Int) {
        if (paint.color == color && this.left == left && this.right == right && this.bottom == bottom) return
        paint.color = color
        this.left = left
        this.right = right
        this.bottom = bottom
        invalidateSelf()
    }

    override fun draw(canvas: Canvas) {
        if (left > 0) canvas.drawRect(bounds.left.toFloat(), bounds.top.toFloat(), (bounds.left + left).toFloat(), bounds.bottom.toFloat(), paint)
        if (right > 0) canvas.drawRect((bounds.right - right).toFloat(), bounds.top.toFloat(), bounds.right.toFloat(), bounds.bottom.toFloat(), paint)
        if (bottom > 0) canvas.drawRect(bounds.left.toFloat(), (bounds.bottom - bottom).toFloat(), bounds.right.toFloat(), bounds.bottom.toFloat(), paint)
    }

    override fun setAlpha(alpha: Int) { paint.alpha = alpha; invalidateSelf() }
    override fun setColorFilter(filter: ColorFilter?) { paint.colorFilter = filter; invalidateSelf() }
    @Suppress("DEPRECATION")
    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
}

/** WebView-free host for a route bundle compiled by `stx native compile`. */
class MainActivity : AppCompatActivity() {
    private class Screen(
        val route: String?,
        val params: JSONObject,
        val props: JSONObject,
        val view: CraftNativeFlexLayout,
        val isolate: JavaScriptIsolate,
        val port: MessagePort?,
        /** The app script (`nativeApp`): runs beside the screens and draws nothing. */
        val headless: Boolean = false,
    ) {
