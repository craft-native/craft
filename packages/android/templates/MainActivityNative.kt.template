private const val CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS = 30_000L

internal fun craftNativeOptionalString(value: Any?): String? = value
    ?.takeUnless { it == JSONObject.NULL }
    ?.toString()
    ?.takeUnless { it == "null" || it == "undefined" }
    ?.takeIf { it.isNotBlank() }

private fun craftNativeBoolean(value: Any?, fallback: Boolean = false): Boolean = (value as? Boolean) ?: fallback

private fun craftNativeInt(value: Any?, fallback: Int): Int = (value as? Number)?.toInt() ?: fallback

private fun craftNativePickerValue(value: Any?): String? = when (value) {
    is String -> value.takeIf { it.isNotEmpty() }
    is Number -> value.toDouble().takeIf { it.isFinite() }?.toString()
    else -> null
}

private fun craftNativeEventName(events: JSONObject, vararg names: String): String =
    names.firstNotNullOfOrNull { name -> craftNativeOptionalString(events.opt(name)) }.orEmpty()

private fun craftNativeNumber(value: Any?): Double? = (value as? Number)
    ?.toDouble()
    ?.takeIf { it.isFinite() }

private fun craftNativeFontWeight(value: Any?): String? = when (value) {
    is String -> value
    is Number -> value.toDouble().takeIf { it.isFinite() && it % 1.0 == 0.0 }?.toInt()?.toString()
    else -> null
}

internal fun craftNativePadding(style: JSONObject?, name: String, fallback: Int, density: Float): Int {
    val value = craftNativeNumber(style?.opt(name)) ?: Double.NaN
    val pixels = value * density
    return if (value.isFinite() && value >= 0 && pixels.isFinite()) pixels.roundToInt() else fallback
}

internal fun craftNativeFiniteFloat(style: JSONObject?, name: String, fallback: Float): Float {
    val value = craftNativeNumber(style?.opt(name)) ?: Double.NaN
    val narrowed = value.toFloat()
    return if (value.isFinite() && narrowed.isFinite()) narrowed else fallback
}

internal fun craftNativeFiniteDouble(style: JSONObject?, name: String, fallback: Double): Double {
    val value = craftNativeNumber(style?.opt(name)) ?: Double.NaN
    return value.takeIf { it.isFinite() } ?: fallback
}

internal fun craftNativeFiniteNumber(props: JSONObject?, name: String, fallback: Double): Double {
    val value = (props?.opt(name) as? Number)?.toDouble() ?: Double.NaN
    return value.takeIf { it.isFinite() } ?: fallback
}

internal fun craftNativeNonNegativeDouble(style: JSONObject?, name: String, fallback: Double): Double {
    val value = craftNativeFiniteDouble(style, name, Double.NaN)
    return if (value.isFinite() && value >= 0) value else fallback
}

private data class CraftNativeLength(
    val points: Int? = null,
    val fraction: Double? = null,
) {
    fun resolve(base: Int?): Int? = points?.coerceAtLeast(0) ?: fraction?.let { value -> base?.let { max(0, (it * value).roundToInt()) } }

    companion object {
        fun from(value: Any?, density: Float): CraftNativeLength? {
            if (value == null || value == JSONObject.NULL) return null
            if (value is Number) {
                val points = value.toDouble() * density
                return points.takeIf { it.isFinite() }?.let { CraftNativeLength(points = it.roundToInt()) }
            }
            val text = value.toString().trim()
            if (text.endsWith('%')) return text.dropLast(1).toDoubleOrNull()?.takeIf { it.isFinite() }?.let { CraftNativeLength(fraction = it / 100) }
            if (text.endsWith("px")) return text.dropLast(2).toDoubleOrNull()?.takeIf { it.isFinite() }?.let { CraftNativeLength(points = (it * density).roundToInt()) }
            return text.toDoubleOrNull()?.takeIf { it.isFinite() }?.let { CraftNativeLength(points = (it * density).roundToInt()) }
        }
    }
}

/** A screen root owns its viewport unless the document explicitly sizes it.
 * Keep this parent constraint out of the protocol document, and apply it to
 * targeted style updates too. An unstyled fragment with flex children would
 * otherwise measure at their zero flex bases and collapse the entire screen. */
internal fun craftNativeScreenRootStyle(style: JSONObject): JSONObject {
    val rootStyle = JSONObject()
    val keys = style.keys()
    while (keys.hasNext()) {
        val key = keys.next()
        rootStyle.put(key, style.opt(key))
    }
    if (rootStyle.isNull("height")) {
        if (rootStyle.isNull("flex")) rootStyle.put("flex", 1)
        rootStyle.put("height", "100%")
    }
    return rootStyle
}

private data class CraftNativeLayoutStyle(
    val width: CraftNativeLength? = null,
    val height: CraftNativeLength? = null,
    val aspectRatio: Double? = null,
    val minWidth: CraftNativeLength? = null,
    val maxWidth: CraftNativeLength? = null,
    val minHeight: CraftNativeLength? = null,
    val maxHeight: CraftNativeLength? = null,
    val position: String = "relative",
    val top: Int? = null,
    val right: Int? = null,
    val bottom: Int? = null,
    val left: Int? = null,
    val alignSelf: String? = null,
    /** CSS/Yoga order; Kotlin's stable sort preserves source order for ties. */
    val order: Int = 0,
    val flexGrow: Double = 0.0,
    val flexShrink: Double? = null,
    val flexBasis: CraftNativeLength? = null,
) {
    companion object {
        fun from(raw: JSONObject, density: Float): CraftNativeLayoutStyle {
            fun length(name: String): CraftNativeLength? = CraftNativeLength.from(raw.opt(name), density)
            fun numeric(name: String): Double? {
                if (!raw.has(name) || raw.isNull(name)) return null
                return (raw.opt(name) as? Number)?.toDouble()?.takeIf { it.isFinite() }
            }
            fun number(name: String): Int? {
                return numeric(name)?.let { points ->
                    (points * density).takeIf { it.isFinite() }?.roundToInt()
                }
            }
            fun decimal(name: String): Double? = numeric(name)
            val flex = decimal("flex")
            return CraftNativeLayoutStyle(
                width = length("width"), height = length("height"),
                aspectRatio = decimal("aspectRatio")?.takeIf { it.isFinite() && it > 0.0 },
                minWidth = length("minWidth"), maxWidth = length("maxWidth"),
                minHeight = length("minHeight"), maxHeight = length("maxHeight"),
                position = craftNativeOptionalString(raw.opt("position")) ?: "relative",
                top = number("top"), right = number("right"), bottom = number("bottom"), left = number("left"),
                alignSelf = craftNativeOptionalString(raw.opt("alignSelf"))?.takeUnless { it == "auto" },
                order = decimal("order")?.toInt() ?: 0,
                flexGrow = decimal("flexGrow") ?: flex?.coerceAtLeast(0.0) ?: 0.0,
                flexShrink = decimal("flexShrink") ?: flex?.let { if (it != 0.0) 1.0 else 0.0 },
                flexBasis = length("flexBasis")
                    ?: flex?.takeIf { it > 0.0 }?.let { CraftNativeLength(points = 0) },
            )
        }
    }
}

private fun craftNativeGridColumnCount(value: Any?): Int {
    if (value is Number) return max(1, value.toInt())
    val text = value as? String ?: return 1
    val trimmed = text.trim()
    if (trimmed.startsWith("repeat(")) {
        val count = trimmed.removePrefix("repeat(").takeWhile { it.isDigit() }.toIntOrNull()
        if (count != null) return max(1, count)
    }
    return max(1, trimmed.split(Regex("\\s+")).count { it.isNotBlank() })
}

private fun craftNativeGridRowCount(value: Any?): Int? {
    if (value is Number) return max(1, value.toInt())
    val text = value as? String ?: return null
    val trimmed = text.trim()
    if (trimmed.isEmpty()) return null
    if (trimmed.startsWith("repeat(")) {
        val count = trimmed.removePrefix("repeat(").takeWhile { it.isDigit() }.toIntOrNull()
        if (count != null) return max(1, count)
    }
    return max(1, trimmed.split(Regex("\\s+")).count { it.isNotBlank() })
}

/**
 * A CSS colour as Android's ARGB. STX writes `#RRGGBBAA` (and `#RGBA`) for a
 * colour with alpha, where Android's parser reads `#AARRGGBB`: a translucent
 * grey fill (`#7676801f`) came out olive. Also `rgb()`/`rgba()` and
 * `transparent`; anything else goes to Android's parser (named colours).
 */
internal fun craftNativeColor(raw: String): Int {
    val value = raw.trim()
    if (value.equals("transparent", ignoreCase = true)) return Color.TRANSPARENT
    if (value.startsWith("#")) {
        val hex = value.substring(1)
        fun channel(text: String) = text.toInt(16)
        return when (hex.length) {
            3 -> Color.rgb(channel("${hex[0]}${hex[0]}"), channel("${hex[1]}${hex[1]}"), channel("${hex[2]}${hex[2]}"))
            4 -> Color.argb(channel("${hex[3]}${hex[3]}"), channel("${hex[0]}${hex[0]}"), channel("${hex[1]}${hex[1]}"), channel("${hex[2]}${hex[2]}"))
            6 -> Color.rgb(channel(hex.substring(0, 2)), channel(hex.substring(2, 4)), channel(hex.substring(4, 6)))
            8 -> Color.argb(channel(hex.substring(6, 8)), channel(hex.substring(0, 2)), channel(hex.substring(2, 4)), channel(hex.substring(4, 6)))
            else -> throw IllegalArgumentException("Unknown color $raw")
        }
    }
    val functional = Regex("""^rgba?\(\s*([\d.]+)[\s,]+([\d.]+)[\s,]+([\d.]+)(?:[\s,/]+([\d.]+%?))?\s*\)$""", RegexOption.IGNORE_CASE).find(value)
    if (functional != null) {
        val (r, g, b, a) = functional.destructured
        val alpha = when {
            a.isBlank() -> 1.0
            a.endsWith("%") -> a.dropLast(1).toDouble() / 100.0
            else -> a.toDouble()
        }
        return Color.argb((alpha.coerceIn(0.0, 1.0) * 255).roundToInt(), r.toDouble().roundToInt(), g.toDouble().roundToInt(), b.toDouble().roundToInt())
    }
    return Color.parseColor(value)
}

/** Android View has no skew setters before API 29; draw the shared skew around the view's center. */
private object CraftNativeSkewTransforms {
    private val values = WeakHashMap<View, Pair<Float, Float>>()

    fun set(view: View, x: Float, y: Float) {
        if (x == 0f && y == 0f) values.remove(view) else values[view] = x to y
        view.invalidate()
    }

    fun clear(view: View) {
        values.remove(view)
        view.invalidate()
    }

    fun matrix(view: View): Matrix? {
        val (x, y) = values[view] ?: return null
        val pivotX = view.width / 2f
        val pivotY = view.height / 2f
        return Matrix().apply {
            setTranslate(-pivotX, -pivotY)
            postSkew(x, y)
            postTranslate(pivotX, pivotY)
        }
    }
}

/** A DOM-free SVG surface for the geometry emitted by the shared STX native protocol. */
private class CraftNativeSvgView(context: Context) : View(context) {
    var drawing: JSONObject = JSONObject()
        set(value) {
            field = value
            animates = hasAnimation(value.optJSONArray("children"))
            invalidate()
            requestLayout()
            updateFrames()
        }

    /** Whether a shape carries keyframes (SMIL `<animate attributeName="d">`, stx's `Animate`). */
    private var animates = false
    /** When this drawing's repetition began (System.nanoTime), 0 while still. */
    private var animationStart = 0L
    private var frameScheduled = false
    private val frameCallback = android.view.Choreographer.FrameCallback { nextFrame() }

    /** Moving now: shown, and animations are on (off is Android's reduced motion). */
    val isAnimating: Boolean
        get() = animates && isAttachedToWindow && isShown && ValueAnimator.areAnimatorsEnabled()

    override fun onAttachedToWindow() {
        super.onAttachedToWindow()
        updateFrames()
    }

    override fun onDetachedFromWindow() {
        super.onDetachedFromWindow()
        updateFrames()
    }

    override fun onVisibilityChanged(changedView: View, visibility: Int) {
        super.onVisibilityChanged(changedView, visibility)
        updateFrames()
    }

    /** One frame at a time from the display (Choreographer) while moving; none while still or away. */
    private fun updateFrames() {
        if (isAnimating) {
            if (animationStart == 0L) animationStart = System.nanoTime()
            if (!frameScheduled) {
                frameScheduled = true
                android.view.Choreographer.getInstance().postFrameCallback(frameCallback)
            }
        } else {
            animationStart = 0L
            if (frameScheduled) {
                frameScheduled = false
                android.view.Choreographer.getInstance().removeFrameCallback(frameCallback)
            }
        }
    }

    private fun nextFrame() {
        frameScheduled = false
        if (!isAnimating) return updateFrames()
        // Drawn only while some of it is on screen; a row scrolled away keeps its time.
        if (getLocalVisibleRect(android.graphics.Rect())) invalidate()
        frameScheduled = true
        android.view.Choreographer.getInstance().postFrameCallback(frameCallback)
    }

    private fun hasAnimation(children: JSONArray?): Boolean {
        if (children == null) return false
        return (0 until children.length()).any { index ->
            val node = children.optJSONObject(index) ?: return@any false
            if (node.optString("type") == "Animate") node.optJSONObject("props")?.has("frames") == true
            else hasAnimation(node.optJSONArray("children"))
        }
    }

    /** A shape's outline now: between its keyframes while moving, else its own. */
    private fun outline(node: JSONObject): List<Float>? {
        if (isAnimating && animationStart != 0L) {
            val children = node.optJSONArray("children")
            val animate = children?.let { list -> (0 until list.length()).mapNotNull { list.optJSONObject(it) }.firstOrNull { it.optString("type") == "Animate" } }
            animate?.optJSONObject("props")?.let { keyframe(it, (System.nanoTime() - animationStart) / 1e9) }?.let { return it }
        }
        val geometry = node.optJSONObject("props")?.optJSONArray("geometry") ?: return null
        return (0 until geometry.length()).map { craftNativeNumber(geometry.opt(it))?.toFloat() ?: Float.NaN }
    }

    companion object {
        /**
         * The outline `elapsed` seconds into an `Animate`'s repetitions, between
         * the keyframes either side of now (SMIL's linear `calcMode`); null when
         * it does not animate path data or its repetitions are over.
         */
        fun keyframe(props: JSONObject, elapsed: Double): List<Float>? {
            if (props.optString("attributeName") != "d" || elapsed < 0) return null
            val duration = craftNativeNumber(props.opt("duration"))?.takeIf { it.isFinite() && it > 0 } ?: return null
            val raw = props.optJSONArray("frames") ?: return null
            val frames = (0 until raw.length()).mapNotNull { index ->
                raw.optJSONArray(index)?.let { frame -> (0 until frame.length()).map { craftNativeNumber(frame.opt(it))?.toFloat() ?: Float.NaN } }
            }
            if (frames.size < 2 || frames.size != raw.length()) return null
            craftNativeNumber(props.opt("repeatCount"))?.let { if (it.isFinite() && elapsed >= it * duration) return null }
            val given = props.optJSONArray("frameTimes")?.let { times -> (0 until times.length()).mapNotNull { craftNativeNumber(times.opt(it)) } }.orEmpty()
            val times = if (given.size == frames.size) given else frames.indices.map { it.toDouble() / (frames.size - 1) }
            val phase = (elapsed % duration) / duration
            var index = 0
            while (index < frames.size - 2 && times[index + 1] <= phase) index++
            val span = times[index + 1] - times[index]
            val share = if (span > 0) ((phase - times[index]) / span).coerceIn(0.0, 1.0).toFloat() else 0f
            return interpolate(frames[index], frames[index + 1], share)
        }

        /** Two outlines with the same commands, a share of the way between; the first when they differ. */
        fun interpolate(from: List<Float>, to: List<Float>, share: Float): List<Float> {
            if (from.size != to.size || share <= 0f) return from
            val out = from.toMutableList()
            var index = 0
            while (index < from.size) {
                if (to[index] != from[index]) return from
                val count = when (from[index].toInt()) {
                    0, 1 -> 2
                    2 -> 6
                    3 -> 4
                    4 -> 0
                    else -> return from
                }
                if (index + count >= from.size) return from
                for (offset in 1..count) out[index + offset] = from[index + offset] + (to[index + offset] - from[index + offset]) * share
                index += count + 1
            }
            return out
        }
    }

    private data class SvgPaint(
        val fill: String? = "#000000",
        val stroke: String? = null,
        val strokeWidth: Float = 1f,
        val color: String = "#000000",
        val opacity: Float = 1f,
        val fillOpacity: Float = 1f,
        val strokeOpacity: Float = 1f,
        val strokeDashoffset: Float = 0f,
        val strokeMiterlimit: Float = 4f,
        val fillRule: String = "nonzero",
        val typeface: Typeface = Typeface.DEFAULT,
        val strokeLinecap: String? = null,
        val strokeLinejoin: String? = null,
        val strokeDasharray: List<Float> = emptyList(),
        val vectorEffect: String? = null,
        val dominantBaseline: String? = null,
    ) {
        private fun svgTypeface(weight: String?, inherited: Typeface): Typeface = when (weight?.lowercase()) {
            "500" -> Typeface.create("sans-serif-medium", Typeface.NORMAL)
            "600" -> Typeface.create("sans-serif", Typeface.BOLD)
            "bold", "700", "800", "900" -> Typeface.DEFAULT_BOLD
            "normal", "100", "200", "300", "400" -> Typeface.DEFAULT
            else -> inherited
        }

        fun merge(node: JSONObject): SvgPaint {
            val props = node.optJSONObject("props") ?: JSONObject()
            val style = node.optJSONObject("style") ?: JSONObject()
            fun value(name: String): String? = craftNativeOptionalString(style.opt(name))
                ?: craftNativeOptionalString(props.opt(name))
            fun raw(name: String): Any? = when {
                style.has(name) && !style.isNull(name) -> style.opt(name)
                props.has(name) && !props.isNull(name) -> props.opt(name)
                else -> null
            }
            fun dashes(rawValue: Any?): List<Float>? {
                val values = rawValue as? JSONArray ?: return null
                return (0 until values.length()).mapNotNull {
                    craftNativeNumber(values.opt(it))?.toFloat()?.takeIf { value -> value.isFinite() && value >= 0 }
                }
            }
            // Keep the cascade explicit: computed style wins over a raw prop
            // when both provide the same SVG paint value.
            val weight = value("fontWeight")
            val ownOpacity = value("opacity")?.toFloatOrNull()?.takeIf { it.isFinite() } ?: 1f
            fun number(name: String): Float? = value(name)?.toFloatOrNull()?.takeIf { it.isFinite() }
            return copy(
                fill = value("fill") ?: fill,
                stroke = value("stroke") ?: stroke,
                strokeWidth = value("strokeWidth")?.toFloatOrNull()?.takeIf { it.isFinite() } ?: strokeWidth,
                color = value("color") ?: color,
                opacity = ownOpacity * opacity,
                fillOpacity = number("fillOpacity") ?: fillOpacity,
                strokeOpacity = number("strokeOpacity") ?: strokeOpacity,
                strokeDashoffset = number("strokeDashoffset") ?: strokeDashoffset,
                strokeMiterlimit = number("strokeMiterlimit")?.takeIf { it > 0 } ?: strokeMiterlimit,
                fillRule = value("fillRule") ?: fillRule,
                typeface = svgTypeface(weight, typeface),
                strokeLinecap = value("strokeLinecap") ?: strokeLinecap,
                strokeLinejoin = value("strokeLinejoin") ?: strokeLinejoin,
                strokeDasharray = dashes(raw("strokeDasharray")) ?: strokeDasharray,
                vectorEffect = value("vectorEffect") ?: vectorEffect,
                dominantBaseline = value("dominantBaseline") ?: dominantBaseline,
            )
        }
    }

    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
        val width = MeasureSpec.getSize(widthMeasureSpec)
        val box = viewBox()
        val naturalHeight = if (box != null && box.second > 0) (width * box.second / box.first).roundToInt() else 0
        val height = when (MeasureSpec.getMode(heightMeasureSpec)) {
            MeasureSpec.EXACTLY -> MeasureSpec.getSize(heightMeasureSpec)
            MeasureSpec.AT_MOST -> min(naturalHeight, MeasureSpec.getSize(heightMeasureSpec))
            else -> naturalHeight
        }
        setMeasuredDimension(resolveSize(width, widthMeasureSpec), resolveSize(height, heightMeasureSpec))
    }

    /** viewBox units to the view's pixels, set by each draw. */
    private val viewTransform = Matrix()
    private val inverseTransform = Matrix()

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val box = viewBox() ?: return
        if (box.first <= 0 || box.second <= 0) return
        // Centred at one scale (SVG's default, `xMidYMid meet`), or each axis
        // stretched to fill (`preserveAspectRatio="none"`).
        val stretch = drawing.optJSONObject("props")?.optString("preserveAspectRatio")?.trim() == "none"
        var sx = width.toFloat() / box.first
        var sy = height.toFloat() / box.second
        var dx = 0f
        var dy = 0f
        if (!stretch) {
            val scale = min(sx, sy)
            sx = scale
            sy = scale
            dx = (width - box.first * scale) / 2f
            dy = (height - box.second * scale) / 2f
        }
        if (!sx.isFinite() || !sy.isFinite() || sx <= 0f || sy <= 0f) return
        viewTransform.reset()
        viewTransform.postTranslate(-box.third, -box.fourth)
        viewTransform.postScale(sx, sy)
        viewTransform.postTranslate(dx, dy)
        viewTransform.invert(inverseTransform)
        canvas.save()
        canvas.concat(viewTransform)
        drawNodes(canvas, drawing.optJSONArray("children") ?: JSONArray(), SvgPaint().merge(drawing))
        canvas.restore()
    }

    private fun viewBox(): Quadruple<Float, Float, Float, Float>? {
        val values = drawing.optJSONObject("props")?.optJSONArray("viewBox") ?: return null
        if (values.length() != 4) return null
        val x = craftNativeNumber(values.opt(0))?.toFloat() ?: Float.NaN
        val y = craftNativeNumber(values.opt(1))?.toFloat() ?: Float.NaN
        val width = craftNativeNumber(values.opt(2))?.toFloat() ?: Float.NaN
        val height = craftNativeNumber(values.opt(3))?.toFloat() ?: Float.NaN
        if (!x.isFinite() || !y.isFinite() || !width.isFinite() || !height.isFinite() || width <= 0f || height <= 0f) return null
        return Quadruple(width, height, x, y)
    }

    private fun drawNodes(canvas: Canvas, children: JSONArray, inherited: SvgPaint) {
        for (index in 0 until children.length()) {
            val node = children.optJSONObject(index) ?: continue
            val style = node.optJSONObject("style") ?: JSONObject()
            if (craftNativeOptionalString(style.opt("display")) == "none") continue
            val paint = inherited.merge(node)
            when (node.optString("type")) {
                "G" -> drawNodes(canvas, node.optJSONArray("children") ?: JSONArray(), paint)
                "SvgText" -> drawText(canvas, node, paint)
                "Animate" -> Unit
                else -> drawPath(canvas, node, paint)
