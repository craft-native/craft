        val pressBaseOpacities = mutableMapOf<View, Float>()
        val pressUnderlayColors = mutableMapOf<View, Int>()
        val pressBaseBackgrounds = mutableMapOf<View, Drawable?>()
        val modalVisibility = mutableMapOf<View, Boolean>()
        val modalCloseHandlers = mutableMapOf<View, String>()
        val layoutHandlers = mutableMapOf<View, String>()
        val layoutListeners = mutableMapOf<View, View.OnLayoutChangeListener>()
        val lastLayoutBounds = mutableMapOf<View, LayoutBounds>()
        val flatListRows = mutableMapOf<CraftNativeFlatList, MutableMap<String, MutableMap<String, View>>>()
        val flatListOwners = mutableMapOf<String, String>()
        val flatListOwnerByView = mutableMapOf<CraftNativeFlatList, String>()
        val mutations = CraftNativeMutationDocument()
        val capabilityScope = UUID.randomUUID().toString()
        val pendingCapabilities = mutableSetOf<String>()
        val capabilityTimeouts = mutableMapOf<String, Runnable>()
        val audio = CraftNativeAudio()
        var active = true
        var closing = false
            private set
        private var closed = false
        private val closeWaiters = mutableListOf<() -> Unit>()
        private val closeHandler = Handler(Looper.getMainLooper())
        private val closeDeadline = Runnable { finishClose() }

        fun close(done: () -> Unit = {}) {
            if (closed) { done(); return }
            closeWaiters.add(done)
            if (closing) return
            active = false
            closing = true
            audio.close()
            // Evaluation completion does not mean its outbound messages have
            // reached the host. Close only after the ordered channel barrier,
            // so onDestroy's final writes run before navigation continues.
            closeHandler.postDelayed(closeDeadline, CRAFT_NATIVE_CAPABILITY_TIMEOUT_MS)
            val teardown = runCatching {
                isolate.evaluateJavaScriptAsync(
                    """
                    (function() {
                      var bridge = globalThis.__stxNativeBridge;
                      if (!bridge || typeof bridge.postMessage !== 'function') return 'unavailable';
                      try { globalThis.__stxNativeUnmount && globalThis.__stxNativeUnmount(); }
                      catch (error) { console.error('Screen teardown failed: ' + error); }
                      bridge.postMessage(JSON.stringify({ type: 'SCREEN_DISPOSED', payload: {} }));
                      return 'sent';
                    })()
                    """.trimIndent()
                )
            }.getOrNull()
            if (teardown == null) {
                finishClose()
                return
            }
            teardown.addListener({
                runCatching { teardown.get() }
                    .onSuccess { if (it == "unavailable") finishClose() }
                    .onFailure { finishClose() }
            }, ContextCompat.getMainExecutor(view.context))
        }

        fun finishClose() {
            if (!closing) return
            closing = false
            closed = true
            closeHandler.removeCallbacks(closeDeadline)
            port?.close()
            isolate.close()
            val waiters = closeWaiters.toList()
            closeWaiters.clear()
            waiters.forEach { it() }
        }
    }

    private lateinit var root: FrameLayout
    private var sandbox: JavaScriptSandbox? = null
    /** The stack on screen: the current tab's, or the only one in an app without tabs. */
