private fun craftLocationFix(location: android.location.Location): JSONObject = JSONObject()
    .put("latitude", location.latitude)
    .put("longitude", location.longitude)
    .put("altitude", location.altitude)
    .put("accuracy", location.accuracy.toDouble())
    .put("speed", location.speed.toDouble())
    .put("heading", location.bearing.toDouble())
    .put("timestamp", location.time.toDouble())

/**
 * The capabilities a native screen asks for beyond Craft's core set
 * (CraftNativeCapabilities): the system's dialogs, the in-app browser, the
 * share sheet, other apps (`Linking`), push, Health Connect (`Health`,
 * CraftNativeHealth.kt), keeping the screen awake, its brightness, the
 * status bar, speech, and the answer to a background refresh. The same
 * module and method names as the iOS host (CraftNativeActions.swift), so a
 * screen's `craft.dialog`, `craft.browser`, `craft.share`, `craft.push`,
 * `craft.health`... work unchanged.
 *
 * `activity` is null in a background worker, where nothing a person
 * answers can be shown: those calls fail with `NEEDS_ACTIVITY`.
 */
internal class CraftNativeServices(
    private val context: Context,
    private val config: JSONObject,
    private val activity: () -> Activity?,
) {
    private val main = Handler(Looper.getMainLooper())
    private val heartRateEnabled = config.optBoolean("enableHeartRate")
    private val health: CraftNativeHealth? = if (config.optBoolean("enableHealthConnect")) {
        CraftNativeHealth(context, activity, config.optBoolean("enableHealthConnectBackground"), config.optBoolean("enableHealthConnectHistory")) { detail ->
            CraftNativeHub.broadcast("CRAFT_EVENT", JSONObject().put("event", "craftHealthWorkout").put("detail", detail))
        }
    } else null
    private val healthServices: CraftHealthServices? = if (config.optBoolean("enableHealthServices")) {
        CraftHealthServices(context, activity, health?.let { healthApi ->
            { method: String, args: JSONArray, completion: (CraftNativeCapabilityResult) -> Unit ->
                healthApi.perform(method, args, completion)
            }
        })
    } else null
    private var pendingPushPermission: ((CraftNativeCapabilityResult) -> Unit)? = null
    private var pendingBrowser: Pair<String?, (CraftNativeCapabilityResult) -> Unit>? = null
    private var browserOpened = false
    private var speech: TextToSpeech? = null
    private var speechReady = false
    private val speechQueue = mutableListOf<() -> Unit>()
    private val speeches = mutableMapOf<String, (CraftNativeCapabilityResult) -> Unit>()
{{NATIVE_WALLET_FIELDS}}

    init {
        prepareVoiceFiles(context, config.optBoolean("enableAudioRecording"))
        if (config.optBoolean("enableGeolocation") || config.optBoolean("enableBackgroundLocation")) {
            // Native screens must also hear a recording started by the page.
            // Keep this process sink independent from the page's listener.
            com.craft.runtime.CraftLocationRecordingStore.nativeListener = { location, id ->
                CraftNativeHub.broadcast("CRAFT_EVENT", JSONObject().put("event", "craftLocationUpdate").put("detail", craftLocationFix(location).put("recordingId", id)))
            }
        }
        if (heartRateEnabled) {
            // The strap's readings and connection changes reach every screen
            // and the app script as `craftHeartRate`, as on iOS. One sink for
            // the process: each host sets the same one.
            CraftHeartRate.get(context).sinks["native"] = { detail ->
                CraftNativeHub.broadcast("CRAFT_EVENT", JSONObject().put("event", "craftHeartRate").put("detail", detail))
            }
        }
    }

    /** `background.complete(ok, id)`: who is waiting for a background refresh's answer. */
    var onBackgroundComplete: ((Boolean, String?) -> Unit)? = null

    /** What this host adds to the capability names the screen sees. */
    fun names(): List<String> = buildList {
        // `craft.animation.next`: the screen's next change animates (MainActivity).
        add("animation")
        add("dialog")
        add("browser")
        add("linking")
        add("brightness")
        add("statusBar")
        add("speech")
        if (config.optBoolean("enableAudioRecording")) add("audioRecording")
        // Videos kept on the phone for offline (CraftNativeMedia).
        add("media")
        if (config.optBoolean("enableShare")) add("share")
        if (config.optBoolean("enablePushNotifications")) add("push")
        if (health != null || healthServices != null) {
            add("health")
            // Health Connect may need installing or updating, and its grants
            // are managed in its own screen: `health.availability()`,
            // `health.grantedTypes()` and `health.openSettings()`.
            add("healthAvailability")
        }
        if (healthServices != null) add("healthServices")
        if (config.optBoolean("enableWallet")) add("wallet")
        if (config.optBoolean("enableKeepAwake")) add("keepAwake")
        if (config.optBoolean("enableGeolocation") || config.optBoolean("enableBackgroundLocation")) {
            add("geolocation")
            if (CraftNative.supportsRecordingOwnership()) add("locationRecordingOwnership")
            if (CraftNative.supportsRecordingIntentIdentity()) add("locationRecordingIntentIdentity")
        }
        if (config.optJSONObject("backgroundRefresh")?.optBoolean("enabled") == true || config.optBoolean("enablePushNotifications")) add("background")
        // A Bluetooth heart-rate strap (CraftHeartRate.kt), the app's own
        // service: one connection and one recording for every screen.
        if (heartRateEnabled) addAll(listOf("heartRate", "heartRateRecordingOwnership", "heartRateRecordingIntentIdentity"))
        // craft.crashReporter: the app's crash and error reporter (bughq).
        if (CraftCrashReporter.enabled) add("crashReporter")
    }

    fun handles(module: String): Boolean = module in setOf(
        "Dialog", "Browser", "Linking", "Share", "Push", "Health", "KeepAwake", "Brightness", "StatusBar", "Speech", "Background",
        "Location", "Media", "CrashReporter", "HeartRate", "AudioRecording",
        "Wallet",
    )

    fun perform(module: String, method: String, args: JSONArray, completion: (CraftNativeCapabilityResult) -> Unit) {
        val done: (CraftNativeCapabilityResult) -> Unit = { result ->
            if (Looper.myLooper() == Looper.getMainLooper()) completion(result) else main.post { completion(result) }
        }
        try {
            when (module) {
                "Dialog" -> dialog(method, args.optJSONObject(0) ?: JSONObject(), done)
                "Browser" -> browser(args.optString(0), args.optJSONObject(1) ?: JSONObject(), done)
                "Linking" -> linking(method, args.optString(0), done)
                "Share" -> share(args.optJSONObject(0) ?: JSONObject(), done)
                "Push" -> push(method, done)
                "Health" -> if (healthServices != null && method in setOf("startWorkout", "pauseWorkout", "resumeWorkout", "endWorkout")) {
                    healthServices.perform(method, args, done)
                } else health?.perform(method, args, done) ?: done(failure("CAPABILITY_DISABLED", "Health is not enabled for this app"))
                "Wallet" -> wallet(method, args, done)
                "KeepAwake" -> keepAwake(args.optBoolean(0, true), done)
                "Brightness" -> brightness(method, args, done)
                "StatusBar" -> statusBar(args.optString(0, "default"), done)
                "Speech" -> speech(method, args, done)
                "AudioRecording" -> main.post { voiceRecording(method, args, done) }
                "Location" -> location(method, args, done)
                "HeartRate" -> heartRate(method, args, done)
                "Media" -> when (method) {
                    "keep" -> CraftNativeMedia.keep(context, args.optString(0), args.optJSONObject(1)?.optJSONObject("headers") ?: JSONObject(), args.optJSONObject(1)?.optBoolean("cellular", true) ?: true, done)
                    "path" -> done(success(CraftNativeMedia.local(context, args.optString(0))?.absolutePath ?: JSONObject.NULL))
                    "prune" -> {
                        val keep = args.optJSONArray(0) ?: JSONArray()
                        done(success(CraftNativeMedia.prune(context, (0 until keep.length()).map { keep.optString(it) })))
                    }
                    "usage" -> done(success(CraftNativeMedia.usage(context)))
                    "clear" -> done(success(CraftNativeMedia.clear(context)))
                    else -> done(failure("UNKNOWN_ACTION", "Unsupported Media method"))
                }
                "Background" -> {
                    onBackgroundComplete?.invoke(args.optBoolean(0, true), args.opt(1) as? String)
                    done(success(true))
                }
                "CrashReporter" -> crashReporter(method, args, done)
                else -> done(failure("UNKNOWN_ACTION", "Unsupported native API"))
            }
        } catch (error: com.craft.runtime.CraftRecordingException) {
            done(failure(error.code, error.message ?: "Recording failed"))
        } catch (error: Exception) {
            Log.e("CraftNativeAndroid", "$module.$method failed", error)
            done(failure("CRAFT_ERROR", error.message ?: "$module.$method failed"))
        }
    }

