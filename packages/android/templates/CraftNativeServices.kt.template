                    return
                }
                val address = source.optString("url").trim()
                if (!address.startsWith("https://")) return done(failure("INVALID_ARGUMENT", "Android Wallet.add needs an HTTPS save URL"))
                val host = activity() ?: return done(failure("NEEDS_ACTIVITY", "No screen is showing to open Wallet"))
                val intent = Intent(Intent.ACTION_VIEW, Uri.parse(address))
                if (intent.resolveActivity(host.packageManager) == null) return done(failure("UNAVAILABLE", "Google Wallet cannot open this save URL"))
                runCatching { host.startActivity(intent) }
                    .onSuccess { done(success(true)) }
                    .onFailure { done(failure("PRESENTATION_FAILED", it.message ?: "Google Wallet could not open")) }
            }
            "has" -> done(failure("UNSUPPORTED", "Google Wallet pass lookup is not available through the save-link API"))
            else -> done(failure("UNKNOWN_ACTION", "Unsupported Wallet method"))
        }
    }
