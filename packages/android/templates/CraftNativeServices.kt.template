    // MARK: Dialogs

    private fun dialog(method: String, options: JSONObject, done: (CraftNativeCapabilityResult) -> Unit) {
        val host = activity() ?: return done(failure("NEEDS_ACTIVITY", "No screen is showing to ask on"))
        val builder = AlertDialog.Builder(host)
        options.optString("title").takeIf { it.isNotBlank() }?.let(builder::setTitle)
        options.optString("message").takeIf { it.isNotBlank() }?.let(builder::setMessage)
        var answered = false
        fun answer(result: CraftNativeCapabilityResult) {
            if (answered) return
            answered = true
            done(result)
        }
        when (method) {
            "alert" -> {
                builder.setPositiveButton(options.optString("okLabel").ifBlank { host.getString(android.R.string.ok) }) { _, _ -> answer(success(JSONObject.NULL)) }
                builder.setOnDismissListener { answer(success(JSONObject.NULL)) }
            }
            "confirm" -> {
                builder.setPositiveButton(options.optString("confirmLabel").ifBlank { host.getString(android.R.string.ok) }) { _, _ -> answer(success(true)) }
                builder.setNegativeButton(options.optString("cancelLabel").ifBlank { host.getString(android.R.string.cancel) }) { _, _ -> answer(success(false)) }
                builder.setOnDismissListener { answer(success(false)) }
            }
            "actionSheet" -> {
                val actions = options.optJSONArray("actions") ?: JSONArray()
                val choices = mutableListOf<Pair<String, String>>()
                var cancelTitle: String? = null
                for (index in 0 until actions.length()) {
                    val action = actions.optJSONObject(index) ?: continue
                    val title = action.optString("title")
                    if (action.optString("style") == "cancel") cancelTitle = title
                    else choices.add((action.optString("id").ifBlank { title }) to title)
                }
                // A message and a list cannot share an AlertDialog: the message
                // goes under the title instead.
                options.optString("message").takeIf { it.isNotBlank() }?.let { message ->
                    builder.setMessage(null)
                    builder.setTitle(listOfNotNull(options.optString("title").takeIf { it.isNotBlank() }, message).joinToString("\n"))
                }
                builder.setItems(choices.map { it.second }.toTypedArray()) { _, which -> answer(success(choices[which].first)) }
                builder.setNegativeButton(cancelTitle ?: host.getString(android.R.string.cancel)) { _, _ -> answer(success(JSONObject.NULL)) }
                builder.setOnDismissListener { answer(success(JSONObject.NULL)) }
            }
            else -> return done(failure("UNKNOWN_ACTION", "Unsupported Dialog method"))
        }
        val shown = builder.show()
        if (method == "confirm" && options.optBoolean("destructive")) {
            shown.getButton(AlertDialog.BUTTON_POSITIVE)?.setTextColor(android.graphics.Color.parseColor("#FF3B30"))
        }
    }

    // MARK: The in-app browser

    /**
     * A page in a Custom Tab over the app. `mode: 'auth'` waits for the
     * address the sign-in returns to (`callbackScheme`), which reaches the
     * activity as a deep link and is handed here ([deepLink]). Otherwise
     * the answer comes when the person is back in the app.
     */
    private fun browser(url: String, options: JSONObject, done: (CraftNativeCapabilityResult) -> Unit) {
        val host = activity() ?: return done(failure("NEEDS_ACTIVITY", "No screen is showing to open a page over"))
        val uri = runCatching { Uri.parse(url) }.getOrNull()
        if (uri == null || uri.scheme?.lowercase() !in setOf("http", "https")) return done(failure("INVALID_ARGUMENT", "browser.open needs an http or https URL"))
        pendingBrowser?.second?.invoke(success(JSONObject().put("cancelled", true)))
        val callback = options.optString("callbackScheme").takeIf { options.optString("mode") == "auth" && it.isNotBlank() }
        pendingBrowser = callback to done
        browserOpened = true
        try {
            CraftAppLinks.openBrowser(host, uri)
        } catch (_: ActivityNotFoundException) {
            host.startActivity(Intent(Intent.ACTION_VIEW, uri))
        }
    }

    /** A deep link arrived; true when it was the answer to an auth browser (and is not the app's to route). */
    fun deepLink(uri: Uri): Boolean {
        val pending = pendingBrowser ?: return false
        val scheme = pending.first ?: return false
        if (!uri.scheme.equals(scheme, ignoreCase = true)) return false
        pendingBrowser = null
        browserOpened = false
        pending.second(success(JSONObject().put("cancelled", false).put("url", uri.toString())))
        return true
    }

    /** The activity is in front again: a page that was open was closed. */
    fun resumed() {
        if (!browserOpened) return
        browserOpened = false
        main.postDelayed({
            // A sign-in's deep link resumes the activity too; it answers first.
            val pending = pendingBrowser ?: return@postDelayed
            pendingBrowser = null
            pending.second(success(JSONObject().put("cancelled", true)))
        }, 400)
    }

    // MARK: Other apps

    private fun linking(method: String, url: String, done: (CraftNativeCapabilityResult) -> Unit) {
        val intent = intentFor(url) ?: return done(success(false))
        when (method) {
            "canOpenURL" -> done(success(intent.resolveActivity(context.packageManager) != null || url.startsWith("http")))
            "openURL" -> {
                val host = activity()
                if (host == null) intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                done(success(runCatching { (host ?: context).startActivity(intent) }.isSuccess))
            }
            else -> done(failure("UNKNOWN_ACTION", "Unsupported Linking method"))
        }
    }

    /** `app-settings:` is this app's page in Settings, as on iOS; anything else is a view intent. */
    private fun intentFor(url: String): Intent? {
        if (url.isBlank()) return null
        if (url.startsWith("app-settings:")) {
            return Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.fromParts("package", context.packageName, null))
        }
        val uri = runCatching { Uri.parse(url) }.getOrNull() ?: return null
        return Intent(Intent.ACTION_VIEW, uri)
    }

    // MARK: Share

    private fun share(options: JSONObject, done: (CraftNativeCapabilityResult) -> Unit) {
        val host = activity() ?: return done(failure("NEEDS_ACTIVITY", "No screen is showing to share from"))
        val text = listOfNotNull(
            options.optString("text").takeIf { it.isNotBlank() },
            options.optString("url").takeIf { it.isNotBlank() },
        ).joinToString("\n")
        val files = mutableListOf<Uri>()
        val paths = options.optJSONArray("files") ?: JSONArray()
        for (index in 0 until paths.length()) {
            val path = paths.optString(index).removePrefix("file://")
            val file = File(path)
            if (!file.exists()) continue
            files.add(FileProvider.getUriForFile(context, "${context.packageName}.craftfiles", file))
        }
        val intent = when {
            files.size > 1 -> Intent(Intent.ACTION_SEND_MULTIPLE).apply {
                putParcelableArrayListExtra(Intent.EXTRA_STREAM, ArrayList(files))
                type = "*/*"
            }
            files.size == 1 -> Intent(Intent.ACTION_SEND).apply {
                putExtra(Intent.EXTRA_STREAM, files.first())
                type = context.contentResolver.getType(files.first()) ?: "*/*"
            }
            else -> Intent(Intent.ACTION_SEND).apply { type = "text/plain" }
        }
        if (text.isNotBlank()) intent.putExtra(Intent.EXTRA_TEXT, text)
        options.optString("title").takeIf { it.isNotBlank() }?.let {
            intent.putExtra(Intent.EXTRA_SUBJECT, it)
            intent.putExtra(Intent.EXTRA_TITLE, it)
        }
        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        host.startActivity(Intent.createChooser(intent, options.optString("title").ifBlank { null }))
        // Android does not say whether something was shared; the sheet opened.
        done(success(true))
    }

    // MARK: Push

    private fun push(method: String, done: (CraftNativeCapabilityResult) -> Unit) {
        if (!config.optBoolean("enablePushNotifications")) return done(failure("CAPABILITY_DISABLED", "Push notifications are disabled"))
        when (method) {
            "getPermissionStatus" -> done(success(pushStatus()))
            "requestPermission" -> requestPushPermission(done)
            "register" -> requestPushPermission { status ->
                if (status.data != "granted") done(failure("PERMISSION_DENIED", "Notifications are not allowed"))
                else registerPush(done)
            }
            "openSettings" -> {
                val intent = Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS).putExtra(Settings.EXTRA_APP_PACKAGE, context.packageName)
                val host = activity()
                if (host == null) intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                done(success(runCatching { (host ?: context).startActivity(intent) }.isSuccess))
            }
            else -> done(failure("UNKNOWN_ACTION", "Unsupported Push method"))
        }
    }

    private fun pushStatus(): String {
        val enabled = NotificationManagerCompat.from(context).areNotificationsEnabled()
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return if (enabled) "granted" else "denied"
        if (ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED) return "granted"
        val asked = context.getSharedPreferences("craft-native-push", Context.MODE_PRIVATE).getBoolean("asked", false)
        return if (asked) "denied" else "undetermined"
    }

    private fun requestPushPermission(done: (CraftNativeCapabilityResult) -> Unit) {
        val status = pushStatus()
        if (status != "undetermined" || Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return done(success(status))
        val host = activity() ?: return done(success(status))
        pendingPushPermission?.invoke(success(status))
        pendingPushPermission = done
        context.getSharedPreferences("craft-native-push", Context.MODE_PRIVATE).edit().putBoolean("asked", true).apply()
        ActivityCompat.requestPermissions(host, arrayOf(Manifest.permission.POST_NOTIFICATIONS), PUSH_PERMISSION_REQUEST)
    }

    fun onRequestPermissionsResult(requestCode: Int): Boolean {
        if (requestCode == 7134) {
            val pending = pendingVoicePermission
            pendingVoicePermission = null
            pending?.invoke(ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED)
            return true
        }
        if (heartRateEnabled && CraftHeartRate.get(context).onPermissions(requestCode)) return true
        if (requestCode == LOCATION_PERMISSION_REQUEST) {
            val pending = pendingLocationPermission
            pendingLocationPermission = null
            pending?.invoke(hasLocation())
            return true
        }
        if (requestCode != PUSH_PERMISSION_REQUEST) return false
        val pending = pendingPushPermission ?: return true
        pendingPushPermission = null
        pending(success(pushStatus()))
        return true
    }

