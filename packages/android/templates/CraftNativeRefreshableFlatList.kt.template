package {{PACKAGE_NAME}}

import android.content.Context
import android.view.MotionEvent
import org.json.JSONObject
import androidx.swiperefreshlayout.widget.SwipeRefreshLayout

/** Swipe-to-refresh host for a native FlatList. */
internal class CraftNativeRefreshableFlatList(context: Context) : SwipeRefreshLayout(context) {
    override fun dispatchTouchEvent(event: MotionEvent): Boolean =
        CraftNativePointers.dispatch(this, event) { super.dispatchTouchEvent(it) }

    override fun onInterceptTouchEvent(event: MotionEvent): Boolean =
        CraftNativePointers.ownsTouch(this) && super.onInterceptTouchEvent(event)
    override fun onTouchEvent(event: MotionEvent): Boolean =
        (event.actionMasked == MotionEvent.ACTION_CANCEL || CraftNativePointers.ownsTouch(this)) && super.onTouchEvent(event)

    val list = CraftNativeFlatList(context)
    private var refreshHandler: (() -> Unit)? = null

    init {
        addView(list, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
        setOnRefreshListener { refreshHandler?.invoke() }
        isEnabled = false
    }

    fun configureRefresh(handler: (() -> Unit)?, refreshing: Boolean) {
        refreshHandler = handler
        isEnabled = handler != null
        isRefreshing = handler != null && refreshing
        if (handler == null) isRefreshing = false
    }

    fun resetForTeardown() {
        refreshHandler = null
        isRefreshing = false
        isEnabled = false
    }

    fun setRefreshAppearance(props: JSONObject, fallback: Int) {
        val tint = props.optString("tintColor").takeIf { it.isNotBlank() }
        val resolved = tint?.let { runCatching { craftNativeColor(it) }.getOrNull() } ?: fallback
        setColorSchemeColors(resolved)
    }

    override fun onDetachedFromWindow() {
        resetForTeardown()
        super.onDetachedFromWindow()
    }
}
