private const val CRAFT_NATIVE_FETCH_MAX_RESPONSE_BYTES = 8 * 1024 * 1024
private const val CRAFT_NATIVE_FETCH_TIMEOUT_MS = 30_000
private const val CRAFT_NATIVE_FILE_PICK_FIRST = 0x4000
private const val CRAFT_NATIVE_FILE_PICK_LAST = 0xffff
private const val CRAFT_NATIVE_FILE_PICK_STATE = "craft.filePicker.nextCode"
private const val CRAFT_NATIVE_NOTIFICATION_PERMISSION_REQUEST = 4102
private const val CRAFT_NATIVE_FILE_DEFAULT_MAX_PIXELS = 2048
private const val CRAFT_NATIVE_FILE_LARGEST_MAX_PIXELS = 8192
private const val CRAFT_NATIVE_FILE_DEFAULT_QUALITY = 0.85
private const val CRAFT_NATIVE_FILE_ERROR_BODY_BYTES = 64 * 1024

internal const val CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION = 1

internal data class CraftNativeCapabilityResult(
    val data: Any? = null,
    val code: String? = null,
    val message: String? = null,
)

/** Never recycle a code while an old Activity result could still arrive. */
internal class CraftNativePickerCodes(private var next: Int = CRAFT_NATIVE_FILE_PICK_FIRST) {
    @Synchronized fun allocate(): Int? = if (next <= CRAFT_NATIVE_FILE_PICK_LAST) next++ else null
    @Synchronized fun snapshot(): Int = next
    @Synchronized fun restore(value: Int) {
        next = maxOf(next, value.coerceIn(CRAFT_NATIVE_FILE_PICK_FIRST, CRAFT_NATIVE_FILE_PICK_LAST + 1))
    }
}

/** Injectable platform boundary; result matching and file IO stay in the host. */
internal interface CraftNativePickerHost {
    fun launch(intent: Intent, requestCode: Int)
    fun dismiss(requestCode: Int)
}

/** Process-wide persistence and OS services shared by every native route. */
internal class CraftNativeCapabilities(
    private val context: Context,
    private val config: JSONObject,
    private val pickerHost: CraftNativePickerHost? = (context as? MainActivity)?.let { host ->
        object : CraftNativePickerHost {
            override fun launch(intent: Intent, requestCode: Int) { host.startActivityForResult(intent, requestCode) }
            override fun dismiss(requestCode: Int) { host.finishActivity(requestCode) }
        }
    },
) {
    companion object {
        private val pickerCodes = CraftNativePickerCodes()
    }

    fun savePickerState(state: android.os.Bundle) { state.putInt(CRAFT_NATIVE_FILE_PICK_STATE, pickerCodes.snapshot()) }
    fun restorePickerState(state: android.os.Bundle?) {
        pickerCodes.restore(state?.getInt(CRAFT_NATIVE_FILE_PICK_STATE, CRAFT_NATIVE_FILE_PICK_FIRST) ?: CRAFT_NATIVE_FILE_PICK_FIRST)
    }

    /** The screen's activity; null in a background refresh, where nothing can be shown. */
    private val activity: MainActivity? get() = context as? MainActivity
    private val bluetooth by lazy { CraftBluetooth(context) }
    fun onBluetoothPermissions(requestCode: Int) { if (config.optBoolean("enableBluetooth")) bluetooth.onPermissions(requestCode) }
    private val mainHandler = android.os.Handler(android.os.Looper.getMainLooper())
    private val storage = context.getSharedPreferences("craft-native-storage", Context.MODE_PRIVATE)
    // The typed native renderer has no CraftNative Zig holder. Keep its
    // values encrypted at rest with AndroidX's AES-256 GCM/SIV preferences.
    private val encryptedSecureStorage by lazy {
        val masterKey = MasterKey.Builder(context)
            .setKeyScheme(MasterKey.KeyScheme.AES256_GCM)
            .build()
        EncryptedSharedPreferences.create(
            context,
            "craft_secure_prefs",
            masterKey,
            EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
            EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM,
        )
    }
    private val notificationStorage = context.getSharedPreferences("craft-native-notifications", Context.MODE_PRIVATE)
    private val databaseExecutor = Executors.newSingleThreadExecutor()
    private val networkExecutor = Executors.newCachedThreadPool()
    private val cancelled = ConcurrentHashMap.newKeySet<String>()
    private val closed = AtomicBoolean(false)
    private val fetchConnections = ConcurrentHashMap<String, HttpURLConnection>()
    private val fileRoot by lazy { File(context.cacheDir, "craft-files").apply { mkdirs() } }
    private var pendingFilePick: PendingFilePick? = null
    private var pendingNotificationPermission: ((Boolean) -> Unit)? = null
    private var database: SQLiteDatabase? = null
    private val biometricPrompts = ConcurrentHashMap<String, BiometricPrompt>()

    /**
     * Hears each change to `Storage` and `SecureStorage` (store, key or null
     * for a clear, the new value or null), so every isolate's synchronous
     * copy follows it (CraftNativeStores).
     */
    var storeObserver: ((String, String?, String?) -> Unit)? = null

    private data class PendingFilePick(
        val requestToken: String,
        val source: String,
        val maxPixels: Int,
        val quality: Float,
        val completion: (CraftNativeCapabilityResult) -> Unit,
        val videoLimit: Long = 0,
        val selectionLimit: Int = 1,
        val fileLimit: Long = 0,
        val requestCode: Int = -1,
    )

    private val connectivity = context.getSystemService(Context.CONNECTIVITY_SERVICE) as ConnectivityManager
    private val networkWatch = object : ConnectivityManager.NetworkCallback() {
        private fun changed() {
            if (!closed.get()) CraftNativeHub.broadcast("CRAFT_EVENT", JSONObject().put("event", "craftNetworkChange").put("detail", networkStatus()))
        }
        override fun onAvailable(network: Network) = changed()
        override fun onLost(network: Network) = changed()
        override fun onCapabilitiesChanged(network: Network, capabilities: NetworkCapabilities) = changed()
    }

    private fun networkStatus(): JSONObject {
        val capabilities = connectivity.getNetworkCapabilities(connectivity.activeNetwork)
        val connected = capabilities?.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) == true
        val type = when {
            !connected -> "none"
            capabilities?.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) == true -> "wifi"
            capabilities?.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR) == true -> "cellular"
            capabilities?.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET) == true -> "ethernet"
            else -> "unknown"
        }
        return JSONObject().put("isConnected", connected).put("type", type)
    }

    init {
        connectivity.registerDefaultNetworkCallback(networkWatch)
        restoreNotifications()
        sweepFiles()
    }

    fun names(): JSONArray = JSONArray().apply {
        listOf("device", "clipboard", "haptics", "storage", "lifecycle", "fetch", "files").forEach(::put)
        put("network")
        put("storageCompareAndSet")
        put("storageSetIfAbsent")
        put("crypto")
        if (config.optBoolean("enableBluetooth")) put("bluetooth")
        if (config.optBoolean("enableBiometric")) put("biometric")
        if (config.optBoolean("enableSecureStorage")) put("secureStorage")
        if (config.optBoolean("enableLocalDatabase")) put("database")
        if (config.optBoolean("enableDeepLinks")) put("deepLinks")
        if (config.optBoolean("enableLocalNotifications")) put("notifications")
    }

    fun perform(
        requestToken: String,
        version: Int,
        module: String,
        method: String,
        args: JSONArray,
        completion: (CraftNativeCapabilityResult) -> Unit,
    ) {
        if (closed.get()) {
            mainHandler.post { completion(failure("HOST_CLOSED", "The native capability host is closed")) }
            return
        }
        cancelled.remove(requestToken)
        if (version != CRAFT_NATIVE_CAPABILITY_PROTOCOL_VERSION) {
            complete(requestToken, failure("UNSUPPORTED_VERSION", "Unsupported native capability protocol version"), completion)
            return
        }
        when (module) {
            "Crypto" -> {
                if (method == "randomUUID") complete(requestToken, success(UUID.randomUUID().toString()), completion)
                else complete(requestToken, failure("UNKNOWN_ACTION", "Unsupported Crypto method"), completion)
            }
            "Bluetooth" -> {
                if (!config.optBoolean("enableBluetooth")) complete(requestToken, failure("CAPABILITY_DISABLED", "Bluetooth is disabled"), completion)
                else bluetooth.perform(method, args) { complete(requestToken, it, completion) }
            }
            "Storage" -> mainHandler.post {
                if (cancelled.remove(requestToken) || closed.get()) return@post
                val answer = runCatching { storage(method, args) }
                    .getOrElse { failure("STORAGE_ERROR", it.message ?: "Storage operation failed") }
                complete(requestToken, answer, completion)
            }
            "SecureStorage" -> {
                if (!config.optBoolean("enableSecureStorage")) complete(requestToken, failure("CAPABILITY_DISABLED", "Secure storage is disabled"), completion)
                else complete(requestToken, secureStorage(method, args), completion)
            }
            "Biometrics" -> biometrics(requestToken, method, args, completion)
            "Database" -> {
                if (!config.optBoolean("enableLocalDatabase")) {
                    complete(requestToken, failure("CAPABILITY_DISABLED", "Local database is disabled"), completion)
                }
                else databaseExecutor.execute {
                    complete(requestToken, database(method, args), completion)
                }
            }
            "Lifecycle" -> complete(requestToken, if (method == "getState") success(activity?.nativeAppState ?: "background")
                else failure("UNKNOWN_ACTION", "Unsupported Lifecycle method"), completion)
            "DeepLinks" -> complete(requestToken, deepLinks(method), completion)
            "Notifications" -> notifications(requestToken, method, args, completion)
            "Network" -> {
                if (method == "getStatus") {
                    complete(requestToken, success(networkStatus()), completion)
                } else if (method != "fetch") {
                    complete(requestToken, failure("UNKNOWN_ACTION", "Unsupported Network method"), completion)
                } else networkExecutor.execute {
                    complete(requestToken, fetch(requestToken, args), completion)
                }
            }
            "Files" -> when (method) {
                "pickImage" -> pickImage(requestToken, args, completion)
                "pickVideo" -> pickVideo(requestToken, args, completion)
                "pickFile" -> pickFile(requestToken, args, completion)
                "download", "write", "remove" -> networkExecutor.execute {
                    completeFile(requestToken, files(requestToken, method, args), completion)
                }
                else -> complete(requestToken, failure("UNKNOWN_ACTION", "Unsupported Files method"), completion)
            }
            else -> complete(requestToken, activity?.performImmediateCapability(module, method, args)
                ?: failure("NEEDS_ACTIVITY", "$module.$method needs a screen"), completion)
        }
    }

    fun cancel(requestToken: String) {
        cancelled.add(requestToken)
        fetchConnections.remove(requestToken)?.disconnect()
        onMain {
            if (pendingFilePick?.requestToken == requestToken) {
                dismissFilePick()
                cancelled.remove(requestToken)
            }
        }
        biometricPrompts.remove(requestToken)?.cancelAuthentication()
    }

    fun close() {
        if (!closed.compareAndSet(false, true)) return
        runCatching { connectivity.unregisterNetworkCallback(networkWatch) }
        cancelled.clear()
        if (config.optBoolean("enableBluetooth")) bluetooth.disconnect()
        databaseExecutor.shutdownNow()
        networkExecutor.shutdownNow()
        fetchConnections.values.forEach(HttpURLConnection::disconnect)
        fetchConnections.clear()
        onMain { dismissFilePick() }
        database?.close()
        database = null
        biometricPrompts.values.forEach { it.cancelAuthentication() }
        biometricPrompts.clear()
    }

    private fun onMain(work: () -> Unit) {
        if (android.os.Looper.myLooper() == android.os.Looper.getMainLooper()) work()
        else mainHandler.post { work() }
    }

    private fun dismissFilePick() {
        val pending = pendingFilePick ?: return
        pendingFilePick = null
        // Clear ownership first: finishActivity may immediately return a result.
        runCatching { pickerHost?.dismiss(pending.requestCode) }
    }

    private fun launchFilePick(host: CraftNativePickerHost, intent: Intent, pending: PendingFilePick) {
        val code = pickerCodes.allocate()
        if (code == null) {
            complete(pending.requestToken, failure("PICKER_UNAVAILABLE", "Picker request codes exhausted; start a new Activity session"), pending.completion)
            return
        }
        pendingFilePick = pending.copy(requestCode = code)
        try { host.launch(intent, code) }
        catch (error: Exception) {
            if (pendingFilePick?.requestCode == code) {
                pendingFilePick = null
                complete(pending.requestToken, failure("PICKER_UNAVAILABLE", error.message ?: "Picker could not be opened"), pending.completion)
            }
        }
    }

    /** The same bounded text-only fetch contract as the maintained iOS host. */
    private fun fetch(requestToken: String, args: JSONArray): CraftNativeCapabilityResult {
        val options = args.optJSONObject(0)
            ?: return failure("INVALID_ARGUMENT", "fetch needs an options object")
        val address = options.optString("url").trim()
        val url = runCatching { URL(address) }.getOrNull()
            ?: return failure("INVALID_ARGUMENT", "fetch needs an absolute http or https URL")
        if (url.protocol.lowercase() !in setOf("http", "https") || url.host.isBlank())
            return failure("INVALID_ARGUMENT", "fetch needs an absolute http or https URL")

        val method = options.optString("method", "GET").uppercase()
        if (method.isBlank() || method.any { !it.isLetter() || it.code > 127 })
            return failure("INVALID_ARGUMENT", "fetch method must be an HTTP token")
        val form = options.optJSONArray("form")
        val bodyValue = options.opt("body")
        if (form != null && bodyValue != null && bodyValue != JSONObject.NULL)
            return failure("INVALID_ARGUMENT", "fetch cannot have both form and body")
        val body = when (bodyValue) {
            null, JSONObject.NULL -> null
            is String -> bodyValue
            else -> return failure("INVALID_ARGUMENT", "fetch body must be a string")
        }
        if ((body != null || form != null) && method in setOf("GET", "HEAD"))
            return failure("INVALID_ARGUMENT", "A GET or HEAD request cannot have a body")

        val multipart = form?.let { multipart(it) }
        if (multipart is FileResult.Failure) return failure(multipart.code, multipart.message)

        val connection = try {
            (url.openConnection() as HttpURLConnection).apply {
                requestMethod = method
                connectTimeout = CRAFT_NATIVE_FETCH_TIMEOUT_MS
                readTimeout = CRAFT_NATIVE_FETCH_TIMEOUT_MS
                instanceFollowRedirects = true
                options.optJSONObject("headers")?.let { headers ->
                    for (name in headers.keys()) {
                        val value = headers.opt(name)
                        if (value !is String) throw IllegalArgumentException("fetch header values must be strings")
                        setRequestProperty(name, value)
                    }
                }
                if (body != null || multipart is FileResult.Multipart) doOutput = true
                if (multipart is FileResult.Multipart) {
                    setRequestProperty("Content-Type", "multipart/form-data; boundary=${multipart.boundary}")
                    setFixedLengthStreamingMode(multipart.body.length())
                    readTimeout = 600_000
                }
            }
        } catch (error: IllegalArgumentException) {
            if (multipart is FileResult.Multipart) multipart.body.parentFile?.deleteRecursively()
            return failure("INVALID_ARGUMENT", error.message ?: "fetch request is invalid")
        } catch (error: Exception) {
            if (multipart is FileResult.Multipart) multipart.body.parentFile?.deleteRecursively()
            return failure("NETWORK_ERROR", error.message ?: "Network request failed")
        }
        fetchConnections[requestToken] = connection
        if (cancelled.contains(requestToken)) {
            fetchConnections.remove(requestToken)?.disconnect()
            if (multipart is FileResult.Multipart) multipart.body.parentFile?.deleteRecursively()
            return failure("CANCELLED", "Network request was cancelled")
        }
        return try {
            if (body != null) connection.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
            if (multipart is FileResult.Multipart) connection.outputStream.use { output -> multipart.body.inputStream().use { it.copyTo(output, 64 * 1024) } }
            val status = connection.responseCode
            val input = if (status >= 400) connection.errorStream else connection.inputStream
            val output = ByteArrayOutputStream()
            input?.use { stream ->
                val chunk = ByteArray(8192)
                while (true) {
                    val count = stream.read(chunk)
                    if (count < 0) break
                    if (output.size() + count > CRAFT_NATIVE_FETCH_MAX_RESPONSE_BYTES)
                        return failure("RESPONSE_TOO_LARGE", "fetch responses are limited to $CRAFT_NATIVE_FETCH_MAX_RESPONSE_BYTES bytes")
                    output.write(chunk, 0, count)
                }
            }
            val headers = JSONObject()
            connection.headerFields.forEach { (name, values) ->
                if (name != null && !values.isNullOrEmpty()) headers.put(name.lowercase(), values.joinToString(", "))
            }
            success(JSONObject()
                .put("url", connection.url.toString())
                .put("status", status)
                .put("statusText", connection.responseMessage ?: "")
                .put("headers", headers)
                .put("redirected", connection.url != url)
                .put("body", output.toString(Charsets.UTF_8.name())))
        } catch (error: SocketTimeoutException) {
            failure("TIMEOUT", error.message ?: "Network request timed out")
        } catch (error: Exception) {
            failure("NETWORK_ERROR", error.message ?: "Network request failed")
        } finally {
            fetchConnections.remove(requestToken)?.disconnect()
            if (multipart is FileResult.Multipart) multipart.body.parentFile?.deleteRecursively()
        }
    }

    private sealed interface FileResult {
        data class Multipart(val body: File, val boundary: String) : FileResult
        data class Failure(val code: String, val message: String) : FileResult
    }

    private fun multipart(parts: JSONArray): FileResult {
        val boundary = "craft-${UUID.randomUUID()}"
        val file = File(fileRoot, UUID.randomUUID().toString()).apply { mkdirs() }.resolve("upload.multipart")
        var kept = false
        try {
        FileOutputStream(file).use { body ->
        fun append(value: String) { body.write(value.toByteArray(Charsets.UTF_8)) }
        for (index in 0 until parts.length()) {
            val part = parts.optJSONObject(index) ?: return FileResult.Failure("INVALID_ARGUMENT", "A form part must be an object")
            val name = part.optString("name")
            if (name.isBlank()) return FileResult.Failure("INVALID_ARGUMENT", "A form part needs a name")
            append("--$boundary\r\n")
            val path = part.optString("path")
            if (path.isNotBlank()) {
                val file = ownedFile(path) ?: return FileResult.Failure("INVALID_ARGUMENT", "A form file must be one craft.files made, and still there")
                val filename = safeFileName(part.optString("filename").ifBlank { file.name })
                val type = part.optString("type").ifBlank { URLConnection.guessContentTypeFromName(filename) ?: "application/octet-stream" }
                append("Content-Disposition: form-data; name=\"${quoted(name)}\"; filename=\"${quoted(filename)}\"\r\n")
                append("Content-Type: ${headerValue(type)}\r\n\r\n")
                file.inputStream().use { it.copyTo(body, 64 * 1024) }
                append("\r\n")
            } else {
                append("Content-Disposition: form-data; name=\"${quoted(name)}\"\r\n\r\n")
                append(part.optString("value"))
                append("\r\n")
            }
        }
        append("--$boundary--\r\n")
        }
        kept = true
        return FileResult.Multipart(file, boundary)
        } catch (error: Exception) {
            return FileResult.Failure("WRITE_ERROR", error.message ?: "A form file could not be read")
        } finally {
            if (!kept) file.parentFile?.deleteRecursively()
        }
    }

    private fun files(requestToken: String, method: String, args: JSONArray): CraftNativeCapabilityResult {
        return when (method) {
        "write" -> {
            val name = args.optString(0).trim()
            if (name.isBlank()) return failure("INVALID_ARGUMENT", "files.write needs a file name")
            val data = args.optString(1, "")
            val options = args.optJSONObject(2) ?: JSONObject()
            val bytes = when (options.optString("encoding", "utf8")) {
                "utf8" -> data.toByteArray(Charsets.UTF_8)
                "base64" -> runCatching { Base64.decode(data, Base64.DEFAULT) }
                    .getOrElse { return failure("INVALID_ARGUMENT", "files.write base64 is invalid") }
                else -> return failure("INVALID_ARGUMENT", "files.write encoding is 'utf8' or 'base64'")
            }
            store(bytes, name, options.optString("type").ifBlank { URLConnection.guessContentTypeFromName(name) ?: "application/octet-stream" })
        }
        "remove" -> {
            val file = ownedFile(args.optString(0)) ?: return failure("INVALID_ARGUMENT", "files.remove needs a file made by craft.files")
            success(file.delete())
        }
        "download" -> download(requestToken, args)
            else -> failure("UNKNOWN_ACTION", "Unsupported Files method")
        }
    }

    private fun download(requestToken: String, args: JSONArray): CraftNativeCapabilityResult {
        val address = args.optString(0).trim()
        val url = validURL(address) ?: return failure("INVALID_ARGUMENT", "files.download needs an absolute http or https URL")
        val options = args.optJSONObject(1) ?: JSONObject()
        val connection = try {
            (url.openConnection() as HttpURLConnection).apply {
                requestMethod = "GET"
                connectTimeout = CRAFT_NATIVE_FETCH_TIMEOUT_MS
                readTimeout = CRAFT_NATIVE_FETCH_TIMEOUT_MS
                options.optJSONObject("headers")?.let { headers ->
                    for (name in headers.keys()) {
                        val value = headers.opt(name)
                        if (value !is String) throw IllegalArgumentException("files.download header values must be strings")
                        setRequestProperty(name, value)
                    }
                }
            }
        } catch (error: IllegalArgumentException) {
            return failure("INVALID_ARGUMENT", error.message ?: "files.download request is invalid")
        } catch (error: Exception) {
            return failure("NETWORK_ERROR", error.message ?: "File download failed")
        }
        fetchConnections[requestToken] = connection
        if (cancelled.contains(requestToken)) {
            fetchConnections.remove(requestToken)?.disconnect()
            return failure("CANCELLED", "File download was cancelled")
        }
        return try {
            val status = connection.responseCode
            if (status !in 200..299) return refusedDownload(connection, status, requestToken)
            val name = options.optString("name").ifBlank { connection.url.path.substringAfterLast('/').ifBlank { "download" } }
            val file = File(fileRoot, UUID.randomUUID().toString()).apply { mkdirs() }.resolve(safeFileName(name))
            connection.inputStream.use { input -> FileOutputStream(file).use { output ->
                val buffer = ByteArray(8192)
                while (true) {
                    if (cancelled.contains(requestToken)) return failure("CANCELLED", "File download was cancelled")
                    val count = input.read(buffer)
                    if (count < 0) break
                    output.write(buffer, 0, count)
                }
            } }
            success(descriptor(file, connection.contentType ?: "application/octet-stream"))
        } catch (error: SocketTimeoutException) {
            failure("TIMEOUT", error.message ?: "File download timed out")
        } catch (error: Exception) {
            if (cancelled.contains(requestToken)) failure("CANCELLED", "File download was cancelled")
            else failure("NETWORK_ERROR", error.message ?: "File download failed")
        } finally {
            fetchConnections.remove(requestToken)?.disconnect()
            connection.disconnect()
        }
    }

    private fun refusedDownload(
        connection: HttpURLConnection,
        status: Int,
        requestToken: String,
    ): CraftNativeCapabilityResult {
        if (cancelled.contains(requestToken)) return failure("CANCELLED", "File download was cancelled")
        val body = ByteArrayOutputStream()
        connection.errorStream?.use { input ->
            val buffer = ByteArray(8192)
            while (body.size() < CRAFT_NATIVE_FILE_ERROR_BODY_BYTES) {
                val count = input.read(buffer, 0, minOf(buffer.size, CRAFT_NATIVE_FILE_ERROR_BODY_BYTES - body.size()))
                if (count < 0) break
                body.write(buffer, 0, count)
            }
        }
        return success(JSONObject().put("ok", false).put("status", status).put("body", body.toString(Charsets.UTF_8.name())))
    }

    private fun pickVideo(requestToken: String, args: JSONArray, completion: (CraftNativeCapabilityResult) -> Unit) {
        mainHandler.post {
            if (fileRequestCancelled(requestToken)) { cancelled.remove(requestToken); return@post }
            val host = pickerHost ?: return@post complete(requestToken, failure("NEEDS_ACTIVITY", "No screen is showing to pick from"), completion)
            if (pendingFilePick != null) {
                complete(requestToken, failure("BUSY", "Another file picker is already open"), completion)
                return@post
            }
            val options = args.optJSONObject(0) ?: JSONObject()
            val limit = options.optLong("maxBytes", 512L * 1024 * 1024).coerceIn(1, 512L * 1024 * 1024)
            val pending = PendingFilePick(requestToken, "video", 0, 1f, completion, limit)
            val photos = options.optString("source", "library") != "files" && Build.VERSION.SDK_INT >= 33
            val intent = Intent(if (photos) MediaStore.ACTION_PICK_IMAGES else Intent.ACTION_OPEN_DOCUMENT).apply {
                type = "video/*"
                if (!photos) addCategory(Intent.CATEGORY_OPENABLE)
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            }
            launchFilePick(host, intent, pending)
        }
    }

    /** Copy with a bound even when a cloud provider does not report its size. */
    private fun copyVideo(requestToken: String, uri: Uri, limit: Long): CraftNativeCapabilityResult {
        var target: File? = null
        return try {
            if (fileRequestCancelled(requestToken)) throw IllegalStateException("CANCELLED: Video selection was cancelled")
            val name = context.contentResolver.query(uri, arrayOf(android.provider.OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
                if (it.moveToFirst()) it.getString(0) else null
            } ?: "video.mp4"
            val types = mapOf("mp4" to "video/mp4", "m4v" to "video/x-m4v", "mov" to "video/quicktime", "webm" to "video/webm")
            val type = types[name.substringAfterLast('.', "").lowercase()]
                ?: return failure("INVALID_VIDEO", "Choose an MP4, MOV or WebM video.")
            val destination = File(fileRoot, UUID.randomUUID().toString()).apply { mkdirs() }.resolve(safeFileName(name))
            target = destination
            val input = context.contentResolver.openInputStream(uri) ?: throw IllegalArgumentException("The video could not be read")
            var size = 0L
            input.use { source ->
                destination.outputStream().use { output ->
                    val buffer = ByteArray(64 * 1024)
                    while (true) {
                        val count = source.read(buffer)
                        if (count < 0) break
                        if (fileRequestCancelled(requestToken)) throw IllegalStateException("CANCELLED: Video selection was cancelled")
                        size += count
                        require(size <= limit) { "Choose a video under ${limit / 1024 / 1024}MB." }
                        output.write(buffer, 0, count)
                    }
                }
            }
            require(size > 0) { "Choose a nonempty video." }
            success(descriptor(destination, type))
        } catch (error: Exception) {
            target?.parentFile?.deleteRecursively()
            val message = error.message ?: "The video could not be read"
            if (message.startsWith("CANCELLED:")) failure("CANCELLED", message.removePrefix("CANCELLED:").trim())
            else failure("READ_ERROR", message)
        }
    }

    private fun pickImage(
        requestToken: String,
        args: JSONArray,
        completion: (CraftNativeCapabilityResult) -> Unit,
    ) {
        mainHandler.post {
            if (fileRequestCancelled(requestToken)) { cancelled.remove(requestToken); return@post }
            val host = pickerHost ?: return@post complete(requestToken, failure("NEEDS_ACTIVITY", "No screen is showing to pick from"), completion)
            if (pendingFilePick != null) {
                complete(requestToken, failure("BUSY", "Another file picker is already open"), completion)
                return@post
            }
            val options = args.optJSONObject(0) ?: JSONObject()
            val source = options.optString("source", "library")
            if (source != "library" && source != "camera") {
                complete(requestToken, failure("INVALID_ARGUMENT", "files.pickImage source is 'library' or 'camera'"), completion)
                return@post
            }
            val maxPixels = options.optInt("maxPixels", CRAFT_NATIVE_FILE_DEFAULT_MAX_PIXELS)
                .coerceIn(64, CRAFT_NATIVE_FILE_LARGEST_MAX_PIXELS)
            val quality = options.optDouble("quality", CRAFT_NATIVE_FILE_DEFAULT_QUALITY)
                .coerceIn(0.1, 1.0).toFloat()
            if (source == "camera" && !config.optBoolean("enableCamera")) {
                complete(requestToken, failure("CAPABILITY_DISABLED", "Camera is disabled"), completion)
                return@post
            }
            val pending = PendingFilePick(requestToken, source, maxPixels, quality, completion)
            val intent = if (source == "camera") Intent(MediaStore.ACTION_IMAGE_CAPTURE)
            else Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
                addCategory(Intent.CATEGORY_OPENABLE)
                type = "image/*"
            }
            launchFilePick(host, intent, pending)
        }
    }

    private fun pickFile(requestToken: String, args: JSONArray, completion: (CraftNativeCapabilityResult) -> Unit) {
        mainHandler.post {
            if (fileRequestCancelled(requestToken)) { cancelled.remove(requestToken); return@post }
            val host = pickerHost ?: return@post complete(requestToken, failure("NEEDS_ACTIVITY", "No screen is showing to pick from"), completion)
            if (pendingFilePick != null) {
                complete(requestToken, failure("BUSY", "Another file picker is already open"), completion)
                return@post
            }
            val options = args.optJSONObject(0) ?: JSONObject()
            val types = documentTypes(options.optJSONArray("contentTypes"))
            if (types == null) {
                complete(requestToken, failure("INVALID_ARGUMENT", "files.pickFile contentTypes must be MIME types, UTIs, or extensions"), completion)
                return@post
            }
            val selections = options.optInt("maxSelections", 1).coerceIn(1, 20)
            val limit = options.optLong("maxBytes", 512L * 1024 * 1024).coerceIn(1, 512L * 1024 * 1024)
            val pending = PendingFilePick(
                requestToken,
                "file",
                0,
                1f,
                completion,
                selectionLimit = selections,
                fileLimit = limit,
            )
            val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
                addCategory(Intent.CATEGORY_OPENABLE)
                type = types.first
                if (types.second.isNotEmpty()) putExtra(Intent.EXTRA_MIME_TYPES, types.second)
                putExtra(Intent.EXTRA_ALLOW_MULTIPLE, selections > 1)
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            }
            launchFilePick(host, intent, pending)
        }
    }

    /** Android's picker accepts MIME filters; map the common UTI/extension forms used by the shared API. */
    private fun documentTypes(values: JSONArray?): Pair<String, Array<String>>? {
        if (values == null || values.length() == 0) return "*/*" to emptyArray()
        val mime = mutableListOf<String>()
        for (index in 0 until values.length()) {
            val raw = values.optString(index).trim().lowercase()
            if (raw.isBlank()) return null
            val type = when (raw) {
                "public.data", "public.item", "public.content" -> "*/*"
                "public.image" -> "image/*"
                "public.movie" -> "video/*"
                "public.audio" -> "audio/*"
                "public.text" -> "text/*"
                else -> when {
                    raw.contains('/') -> raw
                    raw == "gpx" -> "application/gpx+xml"
                    raw == "tcx" -> "application/vnd.garmin.tcx+xml"
                    raw == "fit" -> "application/octet-stream"
                    raw == "json" -> "application/json"
                    raw == "csv" -> "text/csv"
                    raw == "txt" -> "text/plain"
                    raw == "pdf" -> "application/pdf"
                    else -> return null
                }
            }
            mime += type
        }
        val distinct = mime.distinct()
        return if (distinct.size == 1) distinct.first() to emptyArray() else "*/*" to distinct.toTypedArray()
    }

    fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?): Boolean {
        if (requestCode !in CRAFT_NATIVE_FILE_PICK_FIRST..CRAFT_NATIVE_FILE_PICK_LAST) return false
        val pending = pendingFilePick ?: return true
        if (pending.requestCode != requestCode) return true
        pendingFilePick = null
        if (fileRequestCancelled(pending.requestToken)) {
            cancelled.remove(pending.requestToken)
            return true
        }
        if (resultCode != android.app.Activity.RESULT_OK) {
            complete(pending.requestToken, success(if (pending.source == "file") JSONArray() else JSONObject.NULL), pending.completion)
            return true
        }
        if (pending.source == "video") {
            importPickedFile(pending) {
                data?.data?.let { copyVideo(pending.requestToken, it, pending.videoLimit) }
                    ?: failure("PICKER_FAILED", "The selected video could not be read")
            }
            return true
        }
        if (pending.source == "file") {
            importPickedFile(pending) {
                val uris = buildList {
                    data?.clipData?.let { clips ->
                        for (index in 0 until clips.itemCount) add(clips.getItemAt(index).uri)
                    }
                    data?.data?.let { add(it) }
                }.distinct().take(pending.selectionLimit)
                copyDocuments(pending.requestToken, uris, pending.fileLimit)
            }
            return true
        }
        importPickedFile(pending) {
            runCatching {
                val descriptor = if (pending.source == "camera") {
                    val bitmap = data?.extras?.get("data") as? Bitmap
                    bitmap?.let { writeImage(it, pending.maxPixels, pending.quality, "photo.jpg", pending.requestToken) }
                } else {
                    data?.data?.let { copyUri(pending.requestToken, it, pending.maxPixels, pending.quality) }
                }
                descriptor?.let(::success) ?: if (fileRequestCancelled(pending.requestToken)) failure("CANCELLED", "Image selection was cancelled")
                else failure("PICKER_FAILED", "The selected image could not be read")
            }.getOrElse { failure("READ_ERROR", it.message ?: "The selected image could not be read") }
        }
        return true
    }

    private fun importPickedFile(pending: PendingFilePick, work: () -> CraftNativeCapabilityResult) {
        try {
            networkExecutor.execute {
                val result = if (fileRequestCancelled(pending.requestToken)) failure("CANCELLED", "File selection was cancelled") else work()
                completeFile(pending.requestToken, result, pending.completion)
            }
        } catch (_: java.util.concurrent.RejectedExecutionException) {
            // close() can shut down the executor between result matching and
            // submission. Its closed flag suppresses this abandoned reply.
            complete(pending.requestToken, failure("CANCELLED", "File import host is closed"), pending.completion)
        }
    }

    private fun copyUri(requestToken: String, uri: Uri, maxPixels: Int, quality: Float): JSONObject? {
        if (fileRequestCancelled(requestToken)) return null
        val name = context.contentResolver.query(uri, arrayOf(android.provider.OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
            if (it.moveToFirst()) it.getString(0) else null
        } ?: "photo"
        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
        context.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) } ?: return null
        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
        var sample = 1
        while (max(bounds.outWidth / sample, bounds.outHeight / sample) > maxPixels * 2) sample *= 2
        val options = BitmapFactory.Options().apply { inSampleSize = sample }
        val bitmap = context.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, options) } ?: return null
        return writeImage(bitmap, maxPixels, quality, jpegName(name), requestToken)
    }

    private fun copyDocuments(requestToken: String, uris: List<Uri>, limit: Long): CraftNativeCapabilityResult {
        if (uris.isEmpty()) return failure("PICKER_FAILED", "No document was selected")
        val copied = JSONArray()
        return try {
            uris.forEach { copied.put(copyDocument(requestToken, it, limit)) }
            if (fileRequestCancelled(requestToken)) throw IllegalStateException("CANCELLED: File selection was cancelled")
            success(copied)
        } catch (error: Exception) {
            for (index in 0 until copied.length()) {
                copied.optJSONObject(index)?.optString("path")?.let { ownedFile(it)?.parentFile?.deleteRecursively() }
            }
            val message = error.message ?: "The selected document could not be read"
            if (message.startsWith("CANCELLED:")) failure("CANCELLED", message.removePrefix("CANCELLED:").trim())
            else if (message.startsWith("FILE_TOO_LARGE:")) failure("FILE_TOO_LARGE", message.removePrefix("FILE_TOO_LARGE:").trim())
            else failure("READ_ERROR", message)
        }
    }

    private fun copyDocument(requestToken: String, uri: Uri, limit: Long): JSONObject {
        var target: File? = null
        return try {
            if (fileRequestCancelled(requestToken)) throw IllegalStateException("CANCELLED: File selection was cancelled")
            val name = context.contentResolver.query(uri, arrayOf(android.provider.OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
                if (it.moveToFirst()) it.getString(0) else null
            } ?: "file"
            val type = context.contentResolver.getType(uri) ?: documentMimeType(name)
            val destination = File(fileRoot, UUID.randomUUID().toString()).apply { mkdirs() }.resolve(safeFileName(name))
            target = destination
            val input = context.contentResolver.openInputStream(uri) ?: throw IllegalArgumentException("The selected document could not be read")
            var size = 0L
            input.use { source ->
                destination.outputStream().use { output ->
                    val buffer = ByteArray(64 * 1024)
                    while (true) {
                        val count = source.read(buffer)
                        if (count < 0) break
                        if (fileRequestCancelled(requestToken)) throw IllegalStateException("CANCELLED: File selection was cancelled")
                        size += count
                        require(size <= limit) { "FILE_TOO_LARGE: Choose a file under ${limit / 1024 / 1024}MB." }
                        output.write(buffer, 0, count)
                    }
                }
            }
            require(size > 0) { "Choose a nonempty file." }
            descriptor(destination, type)
        } catch (error: Exception) {
            target?.parentFile?.deleteRecursively()
            throw error
        }
    }

    private fun documentMimeType(name: String): String = when (name.substringAfterLast('.', "").lowercase()) {
        "gpx" -> "application/gpx+xml"
        "tcx" -> "application/vnd.garmin.tcx+xml"
        "json" -> "application/json"
        "csv" -> "text/csv"
        "txt" -> "text/plain"
        "pdf" -> "application/pdf"
        else -> "application/octet-stream"
    }

    private fun writeImage(bitmap: Bitmap, maxPixels: Int, quality: Float, name: String, requestToken: String? = null): JSONObject? {
        if (requestToken != null && fileRequestCancelled(requestToken)) {
            bitmap.recycle()
            return null
        }
        val longest = max(bitmap.width, bitmap.height)
        val scale = if (longest > maxPixels) maxPixels.toFloat() / longest else 1f
        val output = if (scale < 1f) Bitmap.createScaledBitmap(
            bitmap,
            (bitmap.width * scale).roundToInt().coerceAtLeast(1),
            (bitmap.height * scale).roundToInt().coerceAtLeast(1),
            true,
        ) else bitmap
        val file = File(fileRoot, UUID.randomUUID().toString()).apply { mkdirs() }.resolve(safeFileName(name))
        val width = output.width
        val height = output.height
        val written = runCatching {
            FileOutputStream(file).use { output.compress(Bitmap.CompressFormat.JPEG, (quality * 100).roundToInt(), it) }
        }.getOrDefault(false)
        if (output !== bitmap) output.recycle()
        bitmap.recycle()
        if (!written) {
            file.parentFile?.deleteRecursively()
            return null
        }
        if (requestToken != null && fileRequestCancelled(requestToken)) {
            file.parentFile?.deleteRecursively()
            return null
        }
        return descriptor(file, "image/jpeg").put("width", width).put("height", height)
    }

    private fun store(bytes: ByteArray, name: String, type: String): CraftNativeCapabilityResult {
        val file = File(fileRoot, UUID.randomUUID().toString()).apply { mkdirs() }.resolve(safeFileName(name))
        return runCatching { file.writeBytes(bytes); success(descriptor(file, type)) }
            .getOrElse { file.parentFile?.deleteRecursively(); failure("WRITE_ERROR", it.message ?: "File could not be written") }
    }

    private fun descriptor(file: File, type: String): JSONObject = JSONObject()
        .put("path", file.absolutePath)
        .put("name", file.name)
        .put("type", type)
        .put("size", file.length())

    private fun sweepFiles() {
        val cutoff = System.currentTimeMillis() - 24L * 60L * 60L * 1000L
        fileRoot.listFiles()?.forEach { file ->
            // Voice captures have a separate launch lifetime; sweep only
            // generic per-file UUID folders here.
            val owned = runCatching { UUID.fromString(file.name).toString().equals(file.name, ignoreCase = true) }.getOrDefault(false)
            if (owned && file.lastModified() < cutoff) file.deleteRecursively()
        }
    }

    private fun ownedFile(path: String): File? {
        if (path.isBlank()) return null
        val root = runCatching { fileRoot.canonicalFile }.getOrNull() ?: return null
        val file = runCatching { File(path).canonicalFile }.getOrNull() ?: return null
        return file.takeIf { it.path.startsWith(root.path + File.separator) }
    }

    private fun safeFileName(raw: String): String {
        val name = raw.substringAfterLast('/').substringAfterLast('\\').trim()
        return name.ifBlank { "file" }.replace(Regex("[\\\\/:*?\"<>|\\r\\n]"), "_")
    }

    private fun jpegName(raw: String): String {
        val safe = safeFileName(raw)
        val base = safe.substringBeforeLast('.', safe).ifBlank { "photo" }
        return "$base.jpg"
    }

    private fun quoted(value: String): String = value.replace("\\", "%5C").replace("\"", "%22").replace("\r", "%0D").replace("\n", "%0A")
    private fun headerValue(value: String): String = value.replace("\r", "").replace("\n", "")
    private fun validURL(raw: String): URL? = runCatching { URL(raw) }.getOrNull()?.takeIf { it.protocol.lowercase() in setOf("http", "https") && it.host.isNotBlank() }

    private fun fileRequestCancelled(requestToken: String): Boolean =
        closed.get() || cancelled.contains(requestToken) || Thread.currentThread().isInterrupted

    private fun discardFiles(result: CraftNativeCapabilityResult) {
        if (result.code != null) return
        val data = result.data
        val files = if (data is JSONArray) (0 until data.length()).mapNotNull { data.optJSONObject(it) }
            else listOfNotNull(data as? JSONObject)
        files.forEach { file ->
            ownedFile(file.optString("path"))?.parentFile?.deleteRecursively()
        }
    }

    private fun completeFile(requestToken: String, result: CraftNativeCapabilityResult, completion: (CraftNativeCapabilityResult) -> Unit) {
        complete(requestToken, result, completion, discard = { discardFiles(result) })
    }

    private fun complete(
        requestToken: String,
        result: CraftNativeCapabilityResult,
        completion: (CraftNativeCapabilityResult) -> Unit,
        discard: (() -> Unit)? = null,
    ) {
        val deliver: () -> Unit = {
            if (cancelled.remove(requestToken) || closed.get()) discard?.invoke()
            else completion(result)
        }
        if (android.os.Looper.myLooper() == android.os.Looper.getMainLooper()) {
            deliver()
        } else mainHandler.post { deliver() }
    }

    private fun storage(method: String, args: JSONArray): CraftNativeCapabilityResult = synchronized(CraftNativeStorage.lock) {
        if (method == "clear") {
            if (!CraftNativeStorage.commit(storage) { it.clear() }) return failure("STORAGE_ERROR", "Storage could not be cleared")
            storeObserver?.invoke("storage", null, null)
            return success(true)
        }
        if (method == "keys") return success(JSONArray(storage.all.keys.sorted()))
        val key = validKey(args.opt(0)) ?: return failure("INVALID_ARGUMENT", "Storage needs a non-empty key")
        return when (method) {
            "get" -> {
                val raw = storage.getString(key, null) ?: return success(JSONObject.NULL)
                runCatching { success(JSONTokener(raw).nextValue()) }
                    .getOrElse { failure("STORAGE_CORRUPT", "Stored value is not valid JSON") }
            }
            "set" -> {
                if (args.length() != 2) return failure("INVALID_ARGUMENT", "Storage.set needs a key and value")
                val value = jsonString(args.opt(1))
                    ?: return failure("INVALID_ARGUMENT", "Storage values must be JSON serializable")
                if (CraftNativeStorage.commit(storage) { it.putString(key, value) }) {
                    storeObserver?.invoke("storage", key, value)
                    success(true)
                }
                else failure("STORAGE_ERROR", "Storage could not persist the value")
            }
            "compareAndSet" -> {
                if (args.length() != 3) return failure("INVALID_ARGUMENT", "Storage.compareAndSet needs a key, expected value and next value")
                val current = storage.getString(key, null) ?: return success(false)
                if (!CraftNativeStorage.jsonEqual(JSONTokener(current).nextValue(), args.opt(1))) return success(false)
                val next = jsonString(args.opt(2)) ?: return failure("INVALID_ARGUMENT", "Storage values must be JSON serializable")
                if (!CraftNativeStorage.commit(storage) { it.putString(key, next) }) return failure("STORAGE_ERROR", "Storage could not persist the checkpoint")
                storeObserver?.invoke("storage", key, next)
                success(true)
            }
            "setIfAbsent" -> {
                if (args.length() != 2) return failure("INVALID_ARGUMENT", "Storage.setIfAbsent needs a key and value")
                if (storage.contains(key)) return success(false)
                val value = jsonString(args.opt(1)) ?: return failure("INVALID_ARGUMENT", "Storage values must be JSON serializable")
                if (!CraftNativeStorage.commit(storage) { it.putString(key, value) }) return failure("STORAGE_ERROR", "Storage could not persist the new intent")
                storeObserver?.invoke("storage", key, value)
                success(true)
            }
            "remove" -> if (CraftNativeStorage.commit(storage) { it.remove(key) }) {
                storeObserver?.invoke("storage", key, null)
                success(true)
            } else failure("STORAGE_ERROR", "Storage could not remove the value")
            else -> failure("UNKNOWN_ACTION", "Unsupported Storage method")
        }
    }

    private fun secureStorage(method: String, args: JSONArray): CraftNativeCapabilityResult {
        if (method == "clear") {
            return try {
                success(encryptedSecureStorage.edit().clear().commit().also { storeObserver?.invoke("secure", null, null) })
            } catch (error: Exception) {
                failure("SECURE_STORAGE_ERROR", error.message ?: "Secure storage could not be cleared")
            }
        }
        val key = validKey(args.opt(0)) ?: return failure("INVALID_ARGUMENT", "Secure storage needs a non-empty key")
        return try {
            when (method) {
                "set" -> {
                    if (args.length() != 2 || args.opt(1) !is String) return failure("INVALID_ARGUMENT", "SecureStorage.set needs a key and string value")
                    if (encryptedSecureStorage.edit().putString(key, args.getString(1)).commit()) {
                        storeObserver?.invoke("secure", key, args.getString(1))
                        success(true)
                    }
                    else failure("SECURE_STORAGE_ERROR", "Secure storage could not be written")
                }
                "get" -> success(encryptedSecureStorage.getString(key, null) ?: JSONObject.NULL)
                "remove" -> success(encryptedSecureStorage.edit().remove(key).commit().also { storeObserver?.invoke("secure", key, null) })
                else -> failure("UNKNOWN_ACTION", "Unsupported SecureStorage method")
            }
        } catch (error: Exception) {
            failure("SECURE_STORAGE_ERROR", error.message ?: "Secure storage operation failed")
        }
    }

    private fun biometrics(
        requestToken: String,
        method: String,
        args: JSONArray,
        completion: (CraftNativeCapabilityResult) -> Unit,
    ) {
        if (!config.optBoolean("enableBiometric")) {
            complete(requestToken, failure("CAPABILITY_DISABLED", "Biometric authentication is disabled"), completion)
            return
        }
        val manager = BiometricManager.from(context)
        when (method) {
            "isAvailable" -> complete(requestToken, success(manager.canAuthenticate(BiometricManager.Authenticators.BIOMETRIC_STRONG) == BiometricManager.BIOMETRIC_SUCCESS), completion)
            "getBiometricType" -> {
                val available = manager.canAuthenticate(BiometricManager.Authenticators.BIOMETRIC_STRONG) == BiometricManager.BIOMETRIC_SUCCESS
                val type = when {
                    !available -> "none"
                    context.packageManager.hasSystemFeature("android.hardware.biometrics.face") -> "faceId"
                    else -> "fingerprint"
                }
                complete(requestToken, success(type), completion)
            }
            "authenticate" -> {
                val host = activity
                if (host !is FragmentActivity) {
                    complete(requestToken, failure("AUTHENTICATION_FAILED", "Activity does not support biometric prompts"), completion)
                    return
                }
                val reason = args.optString(0).ifBlank { "Authenticate to continue" }
                mainHandler.post {
                    if (cancelled.contains(requestToken)) return@post
                    try {
                        val prompt = BiometricPrompt(host, ContextCompat.getMainExecutor(host), object : BiometricPrompt.AuthenticationCallback() {
                            override fun onAuthenticationSucceeded(result: BiometricPrompt.AuthenticationResult) {
                                biometricPrompts.remove(requestToken)
                                complete(requestToken, success(true), completion)
                            }
                            override fun onAuthenticationError(errorCode: Int, errString: CharSequence) {
                                biometricPrompts.remove(requestToken)
                                complete(requestToken, failure("AUTHENTICATION_FAILED", errString.toString()), completion)
                            }
                        })
                        biometricPrompts[requestToken] = prompt
                        prompt.authenticate(BiometricPrompt.PromptInfo.Builder()
                            .setTitle("Authenticate")
                            .setSubtitle(reason)
                            .setNegativeButtonText("Cancel")
                            .setAllowedAuthenticators(BiometricManager.Authenticators.BIOMETRIC_STRONG)
                            .build())
                    } catch (error: Exception) {
                        complete(requestToken, failure("AUTHENTICATION_FAILED", error.message ?: "Biometric authentication failed"), completion)
                    }
                }
            }
            else -> complete(requestToken, failure("UNKNOWN_ACTION", "Unsupported Biometrics method"), completion)
        }
    }

    private fun database(method: String, args: JSONArray): CraftNativeCapabilityResult {
        val db = database ?: runCatching {
            context.openOrCreateDatabase("craft-native.sqlite", Context.MODE_PRIVATE, null)
        }.getOrElse { return failure("DATABASE_ERROR", it.message ?: "Could not open the local database") }
            .also { database = it }
        return try {
            when (method) {
                "execute" -> {
                    val sql = args.optString(0).trim()
                    if (sql.isEmpty()) return failure("INVALID_ARGUMENT", "Database.execute needs a SQL statement")
                    execute(db, sql, args.optJSONArray(1) ?: JSONArray())
                }
                "query" -> {
                    val sql = args.optString(0).trim()
                    if (sql.isEmpty()) return failure("INVALID_ARGUMENT", "Database.query needs a SQL statement")
                    query(db, sql, args.optJSONArray(1) ?: JSONArray())
                }
                "beginTransaction" -> { db.beginTransaction(); success(true) }
                "commit" -> {
                    if (!db.inTransaction()) failure("DATABASE_ERROR", "No transaction is active")
                    else { db.setTransactionSuccessful(); db.endTransaction(); success(true) }
                }
                "rollback" -> {
                    if (!db.inTransaction()) failure("DATABASE_ERROR", "No transaction is active")
                    else { db.endTransaction(); success(true) }
                }
                else -> failure("UNKNOWN_ACTION", "Unsupported Database method")
            }
        }
        catch (error: Exception) {
            failure("DATABASE_ERROR", error.message ?: "Database operation failed")
        }
    }

    private fun execute(db: SQLiteDatabase, sql: String, params: JSONArray): CraftNativeCapabilityResult {
        val statement = db.compileStatement(sql)
        statement.use {
            if (!bind(it, params)) return failure("INVALID_ARGUMENT", "Database parameters must be strings, numbers, booleans, or null")
            val verb = sql.trimStart().substringBefore(' ').uppercase()
            val insertId: Long
            val rows: Int
            when (verb) {
                "INSERT", "REPLACE" -> { insertId = it.executeInsert(); rows = if (insertId < 0) 0 else 1 }
                "UPDATE", "DELETE" -> { rows = it.executeUpdateDelete(); insertId = 0 }
                else -> { it.execute(); rows = changes(db); insertId = lastInsertId(db) }
            }
            return success(JSONObject().put("rowsAffected", rows).put("lastInsertId", insertId))
        }
    }

    private fun query(db: SQLiteDatabase, sql: String, params: JSONArray): CraftNativeCapabilityResult {
        val cursor = db.rawQueryWithFactory({ _, driver, editTable, query ->
            if (!bind(query, params)) throw IllegalArgumentException("Unsupported database parameter")
            SQLiteCursor(driver, editTable, query)
        }, sql, emptyArray<String>(), "")
        cursor.use {
            val rows = JSONArray()
            while (it.moveToNext()) {
                val row = JSONObject()
                for (column in 0 until it.columnCount) {
                    row.put(it.getColumnName(column), when (it.getType(column)) {
                        Cursor.FIELD_TYPE_NULL -> JSONObject.NULL
                        Cursor.FIELD_TYPE_INTEGER -> it.getLong(column)
                        Cursor.FIELD_TYPE_FLOAT -> it.getDouble(column)
                        Cursor.FIELD_TYPE_BLOB -> Base64.encodeToString(it.getBlob(column), Base64.NO_WRAP)
                        else -> it.getString(column)
                    })
                }
                rows.put(row)
            }
            return success(rows)
        }
    }

    private fun bind(statement: SQLiteStatement, params: JSONArray): Boolean {
        for (offset in 0 until params.length()) {
            val index = offset + 1
            when (val value = params.opt(offset)) {
                null, JSONObject.NULL -> statement.bindNull(index)
                is String -> statement.bindString(index, value)
                is Boolean -> statement.bindLong(index, if (value) 1 else 0)
                is ByteArray -> statement.bindBlob(index, value)
                is Float, is Double -> statement.bindDouble(index, (value as Number).toDouble())
                is Number -> statement.bindLong(index, value.toLong())
                else -> return false
            }
        }
        return true
    }

    private fun bind(query: SQLiteQuery, params: JSONArray): Boolean {
        for (offset in 0 until params.length()) {
            val index = offset + 1
            when (val value = params.opt(offset)) {
                null, JSONObject.NULL -> query.bindNull(index)
                is String -> query.bindString(index, value)
                is Boolean -> query.bindLong(index, if (value) 1 else 0)
                is Float, is Double -> query.bindDouble(index, (value as Number).toDouble())
                is Number -> query.bindLong(index, value.toLong())
                else -> return false
            }
        }
        return true
    }

    private fun changes(db: SQLiteDatabase): Int = db.rawQuery("SELECT changes()", null).use {
        if (it.moveToFirst()) it.getInt(0) else 0
    }

    private fun lastInsertId(db: SQLiteDatabase): Long = db.rawQuery("SELECT last_insert_rowid()", null).use {
        if (it.moveToFirst()) it.getLong(0) else 0
    }

    private fun deepLinks(method: String): CraftNativeCapabilityResult {
        if (!config.optBoolean("enableDeepLinks")) return failure("CAPABILITY_DISABLED", "Deep links are disabled")
        if (method != "getInitialURL") return failure("UNKNOWN_ACTION", "Unsupported DeepLinks method")
        return success(activity?.let { host -> host.consumeInitialDeepLink()?.let(host::deepLinkData) } ?: JSONObject.NULL)
    }

    private fun notifications(
        requestToken: String,
        method: String,
        args: JSONArray,
        completion: (CraftNativeCapabilityResult) -> Unit,
    ) {
        if (!config.optBoolean("enableLocalNotifications")) {
            complete(requestToken, failure("CAPABILITY_DISABLED", "Local notifications are disabled"), completion)
            return
        }
        when (method) {
            "schedule" -> {
                val notification = args.optJSONObject(0)
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU && ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
                    val host = activity
                    if (host == null) { complete(requestToken, failure("PERMISSION_DENIED", "Notification permission must be requested while the app is open"), completion); return }
                    if (pendingNotificationPermission != null) { complete(requestToken, failure("BUSY", "A notification permission request is already open"), completion); return }
                    pendingNotificationPermission = { granted -> complete(requestToken, if (granted) schedule(notification) else failure("PERMISSION_DENIED", "Notification permission denied"), completion) }
                    mainHandler.post { androidx.core.app.ActivityCompat.requestPermissions(host, arrayOf(Manifest.permission.POST_NOTIFICATIONS), CRAFT_NATIVE_NOTIFICATION_PERMISSION_REQUEST) }
                } else complete(requestToken, schedule(notification), completion)
            }
            "cancel" -> {
                val id = validKey(args.opt(0))
                complete(requestToken, if (id == null) failure("INVALID_ARGUMENT", "Notifications.cancel needs an id")
                    else { cancelNotification(id); success(true) }, completion)
            }
            "cancelAll" -> {
                notificationStorage.all.keys.forEach(::cancelNotification)
                (context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager).cancelAll()
                complete(requestToken, success(true), completion)
            }
            "pending" -> complete(requestToken, success(JSONArray(notificationStorage.all.values.mapNotNull {
                runCatching { JSONObject(it as String) }.getOrNull()
            })), completion)
            else -> complete(requestToken, failure("UNKNOWN_ACTION", "Unsupported Notifications method"), completion)
        }
    }

    fun onNotificationPermissions(requestCode: Int) {
        if (requestCode != CRAFT_NATIVE_NOTIFICATION_PERMISSION_REQUEST) return
        val complete = pendingNotificationPermission ?: return
        pendingNotificationPermission = null
        complete(Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU || ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED)
    }

    private fun schedule(value: JSONObject?): CraftNativeCapabilityResult {
        val title = value?.optString("title").orEmpty()
        if (title.isEmpty()) return failure("INVALID_ARGUMENT", "Notifications.schedule needs a title")
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
            return failure("PERMISSION_DENIED", "Notification permission denied")
        }
        val id = validKey(value?.opt("id")) ?: UUID.randomUUID().toString()
        val fireAt = System.currentTimeMillis() + value!!.optLong("delay", 0).coerceAtLeast(0)
        val stored = JSONObject(value.toString()).put("id", id).put("fireAt", fireAt)
        notificationStorage.edit().putString(id, stored.toString()).commit()
        scheduleStored(stored)
        return success(id)
    }

    private fun restoreNotifications() {
        notificationStorage.all.values.forEach { raw ->
            runCatching { JSONObject(raw as String) }.getOrNull()?.let(::scheduleStored)
        }
    }

    private fun scheduleStored(value: JSONObject) {
        val id = value.optString("id")
        if (id.isEmpty()) return
        val alarm = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
        alarm.setAndAllowWhileIdle(
            AlarmManager.RTC_WAKEUP,
            value.optLong("fireAt").coerceAtLeast(System.currentTimeMillis()),
            notificationIntent(id),
        )
    }

    private fun cancelNotification(id: String) {
        val alarm = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
        val intent = notificationIntent(id)
        alarm.cancel(intent)
        intent.cancel()
        notificationStorage.edit().remove(id).commit()
        (context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager).cancel(id, 0)
    }

    private fun notificationIntent(id: String): PendingIntent = PendingIntent.getBroadcast(
        context,
        0,
        Intent(context, CraftNativeNotificationReceiver::class.java)
            .setData(Uri.Builder().scheme("craft-native").authority("notification").appendPath(id).build())
            .putExtra("id", id),
        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
    )

    private fun validKey(value: Any?): String? = (value as? String)?.takeIf {
        it.isNotEmpty() && it.length <= 512 && !it.contains('\u0000')
    }

    private fun jsonString(value: Any?): String? = when (value) {
        null, JSONObject.NULL -> "null"
        is JSONObject, is JSONArray -> value.toString()
        is String -> JSONObject.quote(value)
        is Boolean -> value.toString()
        is Number -> value.toString().takeUnless { it == "NaN" || it == "Infinity" || it == "-Infinity" }
        else -> null
    }

    private fun success(data: Any?) = CraftNativeCapabilityResult(data = data)
    private fun failure(code: String, message: String) = CraftNativeCapabilityResult(code = code, message = message)
}
