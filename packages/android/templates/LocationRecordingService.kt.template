import java.io.File

class CraftRecordingException(val code: String, message: String) : IllegalStateException(message)

object CraftLocationRecordingStore {
    private const val PREFS = "craft_location_recording"
    private const val FILE = "craft-location-recording.jsonl"
    private fun prefs(context: Context) = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
    private fun file(context: Context) = File(context.filesDir, FILE)
    private fun archive(context: Context, id: String): File {
        val digest = java.security.MessageDigest.getInstance("SHA-256").digest(id.toByteArray(Charsets.UTF_8))
        return File(context.filesDir, "craft-location-completed-${digest.joinToString("") { "%02x".format(it) }}.json")
    }
    private fun acknowledged(context: Context, id: String): Boolean {
        val marker = File(archive(context, id).path.replace("-completed-", "-ack-"))
        if (!marker.exists()) return false
        if (marker.readText() != id) throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Invalid recording acknowledgement")
        return true
    }
    private fun writeAtomic(destination: File, value: String) {
        val temporary = File.createTempFile(".craft-recording-", ".tmp", destination.parentFile)
        try {
            java.io.FileOutputStream(temporary).use { stream -> stream.write(value.toByteArray(Charsets.UTF_8)); stream.fd.sync() }
            java.nio.file.Files.move(temporary.toPath(), destination.toPath(), java.nio.file.StandardCopyOption.ATOMIC_MOVE)
        } finally { temporary.delete() }
    }
    private fun expected(options: JSONObject?): String? {
        if (options == null || !options.has("expectedId")) return null
        val id = options.opt("expectedId")
        if (id !is String || id.isBlank()) throw CraftRecordingException("INVALID_ARGUMENT", "expectedId must be a nonempty recording ID")
        return id
    }
    private fun requireOwner(context: Context, options: JSONObject?) {
        val id = expected(options) ?: return
        if (id != prefs(context).getString("id", null)) throw CraftRecordingException("RECORDING_CONFLICT", "The active location recording has changed")
    }
    private fun completed(context: Context, id: String?): JSONObject? {
        if (id == null) return null
        val source = archive(context, id)
        if (acknowledged(context, id)) {
            if (source.exists() && !source.delete()) throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Unable to remove acknowledged recording")
            throw CraftRecordingException("RECORDING_NOT_FOUND", "This recording has been acknowledged")
        }
        if (!source.exists()) return null
        val saved = JSONObject(source.readText())
        if (saved.optString("id") != id || saved.optBoolean("active") || saved.optJSONArray("locations") == null)
            throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Invalid completed recording archive")
        return saved
    }
    private fun archiveCompleted(context: Context) {
        val id = prefs(context).getString("id", null) ?: return
        if (acknowledged(context, id) || completed(context, id) != null) return
        val saved = state(context, includeLocations = true)
        val destination = archive(context, id)
        writeAtomic(destination, saved.toString())
    }
    private fun edit(context: Context, update: (android.content.SharedPreferences.Editor) -> Unit) {
        val values = prefs(context)
        val previous = values.all.toMap()
        val editor = values.edit()
        update(editor)
        if (editor.commit()) return
        // SharedPreferences publishes its memory map before reporting disk
        // failure. Restore it too, so a rejected operation cannot change owner.
        val rollback = values.edit().clear()
        previous.forEach { (key, value) -> when (value) {
            is String -> rollback.putString(key, value)
            is Boolean -> rollback.putBoolean(key, value)
            is Long -> rollback.putLong(key, value)
            is Int -> rollback.putInt(key, value)
            is Float -> rollback.putFloat(key, value)
            else -> throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Invalid recording metadata")
        } }
        rollback.commit()
        throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Unable to persist recording state")
    }
    private fun commit(context: Context, active: Boolean, paused: Boolean) {
        edit(context) { it.putBoolean("active", active).putBoolean("paused", paused) }
    }

    @Synchronized
    fun recover(context: Context) {
        val id = recordingId(context) ?: return
        if (!acknowledged(context, id)) return
        val saved = archive(context, id)
        if (saved.exists() && !saved.delete()) throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Unable to remove acknowledged recording")
        if (file(context).exists() && !file(context).delete()) throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Unable to remove acknowledged samples")
        edit(context) { it.remove("id").remove("startedAt").putBoolean("active", false).putBoolean("paused", false) }
        listener = null
    }

    @Synchronized
    fun start(context: Context, id: String, startedAt: Long, powerMode: String = "default") {
        recover(context)
        if (isActive(context)) throw CraftRecordingException("RECORDING_ALREADY_ACTIVE", "A location recording is already active")
        if (id == recordingId(context) || archive(context, id).exists() || acknowledged(context, id))
            throw CraftRecordingException("RECORDING_CONFLICT", "Recording IDs cannot be reused")
        archiveCompleted(context)
        file(context).writeText("")
        edit(context) { it.putString("id", id).putBoolean("active", true).putBoolean("paused", false).putLong("startedAt", startedAt).putString("powerMode", powerMode).remove("powerSaver") }
    }

    private val POWER_MODES = setOf("default", "saver", "auto")

    /** A mode the page may ask for; `fallback` when the option is absent or null. */
    private fun requestedPowerMode(options: JSONObject?, fallback: String?): String {
        if (options == null || !options.has("powerMode") || options.isNull("powerMode"))
            return fallback ?: throw CraftRecordingException("INVALID_ARGUMENT", "powerMode must be 'default', 'saver' or 'auto'")
        val mode = options.opt("powerMode")
        if (mode !is String || mode !in POWER_MODES) throw CraftRecordingException("INVALID_ARGUMENT", "powerMode must be 'default', 'saver' or 'auto'")
        return mode
    }

    /**
     * The mode the recording was asked for (`default`, `saver` or `auto`):
     * `startRecording({ powerMode })`, changed by `setRecordingPowerMode`.
     * A recording stored by an older build kept a `powerSaver` flag instead.
     */
    @Synchronized
    fun powerMode(context: Context): String {
        val values = prefs(context)
        return values.getString("powerMode", null)?.takeIf { it in POWER_MODES }
            ?: if (values.getBoolean("powerSaver", false)) "saver" else "default"
    }

    /**
     * What the recorder uses right now: `saver` spaces fixes out and batches
     * them, and `auto` is a saver while the device is saving power (Battery
     * Saver on, or under 20% charge and not plugged in). Never outside a recording.
     */
    @Synchronized
    fun isPowerSaver(context: Context): Boolean {
        if (!isActive(context)) return false
        return when (powerMode(context)) {
            "saver" -> true
            "auto" -> deviceIsSavingPower(context)
            else -> false
        }
    }

    fun deviceIsSavingPower(context: Context): Boolean {
        if (context.getSystemService(PowerManager::class.java)?.isPowerSaveMode == true) return true
        // ACTION_BATTERY_CHANGED is sticky: a null receiver reads it right now.
        val battery = context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED)) ?: return false
        val level = battery.getIntExtra(BatteryManager.EXTRA_LEVEL, -1)
        val scale = battery.getIntExtra(BatteryManager.EXTRA_SCALE, -1)
        val pluggedIn = battery.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0
        return level >= 0 && scale > 0 && !pluggedIn && level * 100 < scale * 20
    }

    @Synchronized
    fun updatePowerMode(context: Context, options: JSONObject?): JSONObject {
        requireOwner(context, options)
        val mode = requestedPowerMode(options, null)
        if (!isActive(context)) throw CraftRecordingException("NO_ACTIVE_RECORDING", "No active location recording")
        edit(context) { it.putString("powerMode", mode).remove("powerSaver") }
        return state(context)
    }

    @Synchronized
    fun updatePause(context: Context, paused: Boolean, options: JSONObject?): JSONObject {
        requireOwner(context, options)
        if (!isActive(context)) throw CraftRecordingException("NO_ACTIVE_RECORDING", "No active location recording")
        commit(context, true, paused)
        return state(context)
    }
    @Synchronized fun setPaused(context: Context, paused: Boolean) { updatePause(context, paused, null) }

    @Synchronized
    fun finish(context: Context, options: JSONObject?): JSONObject {
        completed(context, expected(options))?.let { return it }
        requireOwner(context, options)
        val stopped = state(context, includeLocations = true)
        commit(context, false, false)
        listener = null
        return stopped.put("active", false).put("paused", false).put("effectivePowerMode", "default")
    }
    @Synchronized fun stop(context: Context) { finish(context, null) }
    @Synchronized
    fun acknowledge(context: Context, options: JSONObject?): Boolean {
        val id = expected(options) ?: throw CraftRecordingException("INVALID_ARGUMENT", "Acknowledgement needs expectedId")
        val current = recordingId(context) == id
        if (current && isActive(context)) throw CraftRecordingException("RECORDING_ALREADY_ACTIVE", "The recording is still active")
        if (!current && !acknowledged(context, id) && completed(context, id) == null)
            throw CraftRecordingException("RECORDING_CONFLICT", "Unknown recording ID")
        val saved = archive(context, id)
        val marker = File(saved.path.replace("-completed-", "-ack-"))
        if (!marker.exists()) writeAtomic(marker, id)
        if (saved.exists() && !saved.delete()) throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Unable to remove completed recording")
        if (current) {
            if (file(context).exists() && !file(context).delete()) throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Unable to remove recording samples")
            edit(context) { it.remove("id").remove("startedAt").putBoolean("active", false).putBoolean("paused", false) }
            listener = null
        }
        return true
    }

    /** One native backend used by the STX host and the page's JNI entry point. */
    @JvmStatic
    fun perform(context: Context, method: String, optionsJson: String): String = synchronized(this) {
        return try {
            recover(context)
            val options = JSONObject(optionsJson)
            val result: Any = when (method) {
                "startRecording" -> {
                    val permitted = ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED || ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED
                    if (!permitted) throw CraftRecordingException("PERMISSION_DENIED", "Location is not allowed")
                    val id = if (options.has("recordingId")) {
                        val requested = options.opt("recordingId")
                        if (requested !is String || requested.isBlank()) throw CraftRecordingException("INVALID_ARGUMENT", "recordingId must be a nonempty recording ID")
                        requested
                    } else java.util.UUID.randomUUID().toString()
                    start(context, id, System.currentTimeMillis(), requestedPowerMode(options, "default"))
                    try { ContextCompat.startForegroundService(context, Intent(context, LocationRecordingService::class.java).setAction(LocationRecordingService.ACTION_START).putExtra("recordingId", id)) }
                    catch (error: Exception) { finish(context, JSONObject().put("expectedId", id)); throw error }
                    state(context)
                }
                "setRecordingPowerMode" -> {
                    val previous = powerMode(context)
                    val updated = updatePowerMode(context, options)
                    // The running service re-requests its updates for the new spacing.
                    // If Android refuses to start it from the background, the stored
                    // mode is still what the service takes up on its next start.
                    runCatching { ContextCompat.startForegroundService(context, Intent(context, LocationRecordingService::class.java).setAction(LocationRecordingService.ACTION_START).putExtra("recordingId", recordingId(context))) }
                        .onFailure { android.util.Log.w("CraftLocation", "Power mode $previous -> ${powerMode(context)} waits for the service", it) }
                    updated
                }
                "pauseRecording" -> updatePause(context, true, options)
                "resumeRecording" -> {
                    val permitted = ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED || ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED
                    if (!permitted) throw CraftRecordingException("PERMISSION_DENIED", "Location is not allowed")
                    val wasPaused = isPaused(context)
                    val resumed = updatePause(context, false, options)
                    try { ContextCompat.startForegroundService(context, Intent(context, LocationRecordingService::class.java).setAction(LocationRecordingService.ACTION_START).putExtra("recordingId", recordingId(context))) }
                    catch (error: Exception) { updatePause(context, wasPaused, options); throw error }
                    resumed
                }
                "stopRecording" -> {
                    val stopped = finish(context, options)
                    if (stopped.optString("id") == recordingId(context) && !isActive(context))
                        context.startService(Intent(context, LocationRecordingService::class.java).setAction(LocationRecordingService.ACTION_STOP).putExtra("recordingId", stopped.optString("id")))
                    stopped
                }
                "getRecordingState" -> state(context, options = options)
                "readRecording" -> read(context, options)
                "acknowledgeRecording" -> acknowledge(context, options)
                else -> throw CraftRecordingException("UNKNOWN_ACTION", "Unsupported Location method")
            }
            JSONObject().put("ok", true).put("data", result).toString()
        } catch (error: Exception) {
            JSONObject().put("ok", false).put("code", (error as? CraftRecordingException)?.code ?: "RECORDING_STORAGE_ERROR").put("message", error.message ?: "Recording failed").toString()
        }
    }

    @Synchronized fun isActive(context: Context) = prefs(context).getBoolean("active", false)
    @Synchronized fun isPaused(context: Context) = prefs(context).getBoolean("paused", false)
    @Synchronized fun recordingId(context: Context): String? = prefs(context).getString("id", null)
    @Volatile var listener: ((android.location.Location, String) -> Unit)? = null
    @Volatile var nativeListener: ((android.location.Location, String) -> Unit)? = null

    @Synchronized
    fun listen(context: Context, id: String, callback: (android.location.Location, String) -> Unit) {
        if (recordingId(context) == id && isActive(context)) listener = callback
    }

    @JvmOverloads
    fun append(context: Context, location: android.location.Location, expectedId: String? = null) {
        val notify = synchronized(this) {
            val id = recordingId(context) ?: return
            if (!isActive(context) || isPaused(context) || (expectedId != null && expectedId != id)) return
            val json = JSONObject().apply {
                put("latitude", location.latitude); put("longitude", location.longitude)
                put("accuracy", location.accuracy); put("altitude", location.altitude)
                put("speed", location.speed); put("heading", location.bearing)
                put("timestamp", location.time); put("recordingId", recordingId(context))
            }
            file(context).appendText("$json\n")
            Triple(listener, nativeListener, id)
        }
        // The event keeps the owner captured before releasing the store lock.
        notify.first?.invoke(location, notify.third)
        notify.second?.invoke(location, notify.third)
    }

    @Synchronized
    fun locations(context: Context): JSONArray {
        val result = JSONArray()
        val source = file(context)
        if (!source.exists()) {
            val id = recordingId(context)
            if (id != null && !acknowledged(context, id)) throw CraftRecordingException("RECORDING_STORAGE_ERROR", "Recording samples are missing")
            return result
        }
        source.forEachLine { line -> if (line.isNotBlank()) runCatching { result.put(JSONObject(line)) } }
        return result
    }
    @Synchronized
    fun read(context: Context, options: JSONObject?): JSONArray {
        completed(context, expected(options))?.let { return it.getJSONArray("locations") }
        requireOwner(context, options)
        return locations(context)
    }
    @Synchronized
    fun state(context: Context, includeLocations: Boolean = false, options: JSONObject? = null): JSONObject {
        completed(context, expected(options))?.let {
            if (!includeLocations) it.remove("locations")
            return it
        }
        requireOwner(context, options)
        val values = prefs(context)
        val locations = locations(context)
        return JSONObject().apply {
            put("id", values.getString("id", null))
            put("active", values.getBoolean("active", false))
            put("paused", values.getBoolean("paused", false))
            put("startedAt", values.getLong("startedAt", 0).takeIf { it > 0 } ?: JSONObject.NULL)
            put("sampleCount", locations.length())
            put("powerMode", powerMode(context))
            put("effectivePowerMode", if (isPowerSaver(context)) "saver" else "default")
            if (includeLocations) put("locations", locations)
        }
    }
}

class LocationRecordingService : Service() {
    private val client by lazy { LocationServices.getFusedLocationProviderClient(this) }
    private var callback: LocationCallback? = null
    private var callbackRecordingId: String? = null
    private var callbackSaver = false
    private var serviceStartId = 0
    private var powerReceiver: BroadcastReceiver? = null

    override fun onCreate() {
        super.onCreate()
        val manager = getSystemService(NotificationManager::class.java)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            manager.createNotificationChannel(NotificationChannel(CHANNEL, "Activity recording", NotificationManager.IMPORTANCE_LOW))
        }
        val notification = NotificationCompat.Builder(this, CHANNEL)
            .setSmallIcon(R.drawable.craft_notification_icon)
            .setColor(ContextCompat.getColor(this, R.color.craft_notification_color))
            .setContentTitle("Recording your activity")
            .setContentText("${applicationInfo.loadLabel(packageManager)} is securely saving your route")
            .setOngoing(true)
            .setSilent(true)
            .build()
        startForeground(NOTIFICATION_ID, notification)
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        return synchronized(CraftLocationRecordingStore) {
        try { CraftLocationRecordingStore.recover(this) }
        catch (error: Exception) {
            android.util.Log.e("CraftLocation", "Unable to restore recording", error)
            stopUpdates()
            stopSelfResult(startId)
            return START_NOT_STICKY
        }
        val expected = intent?.getStringExtra("recordingId")
        val current = CraftLocationRecordingStore.recordingId(this)
        if (expected != null && expected != current) {
            // ACK can clear A before its queued service intent arrives. Only
            // tear down an unowned service; a newer B must keep its callback.
            if (current == null && !CraftLocationRecordingStore.isActive(this)) {
                stopUpdates()
                stopSelfResult(startId)
                return START_NOT_STICKY
            }
            return START_STICKY
        }
        serviceStartId = startId
        when (intent?.action) {
            ACTION_STOP -> {
                stopUpdates()
                stopSelfResult(startId)
                return START_NOT_STICKY
            }
            else -> if (!startUpdates()) {
                stopSelfResult(startId)
                return START_NOT_STICKY
            }
        }
        START_STICKY
        }
    }

    private fun startUpdates(): Boolean {
        val id = CraftLocationRecordingStore.recordingId(this) ?: return false
        // `auto` can change what the recorder should do without a call: the
        // request is only rebuilt when the mode in use is not the one it was made for.
        val saver = CraftLocationRecordingStore.isPowerSaver(this)
        if (callback != null && callbackRecordingId == id && callbackSaver == saver) {
            syncPowerReceiver()
            return true
        }
        stopUpdates()
        if (!CraftLocationRecordingStore.isActive(this)) return false
        val hasForegroundLocation =
            ContextCompat.checkSelfPermission(this, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED ||
                ContextCompat.checkSelfPermission(this, Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED
        if (!hasForegroundLocation) {
            runCatching { CraftLocationRecordingStore.finish(this, JSONObject().put("expectedId", id)) }
            return false
        }
        // Saving power (an ultra): fixes at least 5 m apart and delivered in
        // batches of up to 20 s, each keeping its own time. 5 m stays under
        // the route's 30 s pause gap at any speed that counts as moving
        // (0.2 m/s), so distance and moving time come out as at full rate.
        val request = LocationRequest.Builder(Priority.PRIORITY_HIGH_ACCURACY, 5_000)
            .setMinUpdateIntervalMillis(2_000)
            .setMaxUpdateDelayMillis(if (saver) 20_000 else 10_000)
            .apply { if (saver) setMinUpdateDistanceMeters(5f) }
            .build()
        val nextCallback = object : LocationCallback() {
            override fun onLocationResult(result: LocationResult) {
                for (location in result.locations) CraftLocationRecordingStore.append(this@LocationRecordingService, location, id)
            }
        }
        callback = nextCallback
        callbackRecordingId = id
        callbackSaver = saver
        syncPowerReceiver()
        return try {
            client.requestLocationUpdates(request, nextCallback, Looper.getMainLooper())
                .addOnFailureListener {
                    synchronized(CraftLocationRecordingStore) {
                        if (callback === nextCallback && CraftLocationRecordingStore.recordingId(this) == id) {
                            runCatching { CraftLocationRecordingStore.finish(this, JSONObject().put("expectedId", id)) }
                                .onFailure { android.util.Log.e("CraftLocation", "Unable to persist failed recording", it) }
                            stopUpdates()
                            stopSelfResult(serviceStartId)
                        }
                    }
                }
            true
        } catch (error: Exception) {
            callback = null
            runCatching { CraftLocationRecordingStore.finish(this, JSONObject().put("expectedId", id)) }
            false
        }
    }

    private fun stopUpdates() {
        callback?.let { client.removeLocationUpdates(it) }
        callback = null
        callbackRecordingId = null
        callbackSaver = false
        powerReceiver?.let { runCatching { unregisterReceiver(it) } }
        powerReceiver = null
    }

    /**
     * `powerMode: 'auto'` follows Battery Saver and the charge, so the service
     * listens for the platform's changes while a recording runs in that mode,
     * and for no other recording.
     */
    private fun syncPowerReceiver() {
        val wanted = CraftLocationRecordingStore.powerMode(this) == "auto"
        if (!wanted) {
            powerReceiver?.let { runCatching { unregisterReceiver(it) } }
            powerReceiver = null
            return
        }
        if (powerReceiver != null) return
        val receiver = object : BroadcastReceiver() {
            override fun onReceive(context: Context?, intent: Intent?) {
                synchronized(CraftLocationRecordingStore) {
                    if (callback != null && CraftLocationRecordingStore.isPowerSaver(this@LocationRecordingService) != callbackSaver) startUpdates()
                }
            }
        }
        powerReceiver = receiver
        val filter = IntentFilter().apply {
            addAction(PowerManager.ACTION_POWER_SAVE_MODE_CHANGED)
            addAction(Intent.ACTION_BATTERY_CHANGED)
        }
        ContextCompat.registerReceiver(this, receiver, filter, ContextCompat.RECEIVER_NOT_EXPORTED)
    }

    override fun onDestroy() {
        stopUpdates()
        super.onDestroy()
    }

    override fun onBind(intent: Intent?): IBinder? = null

    companion object {
        const val ACTION_START = "craft.location.START"
        const val ACTION_STOP = "craft.location.STOP"
        private const val CHANNEL = "craft_location_recording"
        private const val NOTIFICATION_ID = 7001
    }
}
