package {{PACKAGE_NAME}}

import android.app.Activity
import android.content.Context
import android.content.Intent
import android.os.Build
import androidx.core.content.ContextCompat
import androidx.health.services.client.HealthServices
import androidx.health.services.client.data.DataType
import androidx.health.services.client.data.ExerciseType
import org.json.JSONArray
import org.json.JSONObject
import java.util.UUID
import java.util.concurrent.atomic.AtomicReference
import java.util.concurrent.ConcurrentHashMap

/** Native Health Services entry point; the ExerciseClient lives in the retained service. */
internal class CraftHealthServices(
    private val context: Context,
    private val activityProvider: () -> Activity?,
    private val fallback: ((String, JSONArray, (CraftNativeCapabilityResult) -> Unit) -> Unit)? = null,
) {
    private val passiveSteps by lazy { CraftPassiveSteps(context) }
    private fun failure(code: String, message: String) = CraftNativeCapabilityResult(code = code, message = message)

    fun perform(method: String, args: JSONArray, done: (CraftNativeCapabilityResult) -> Unit) {
        if (method.startsWith("passive:")) { passiveSteps.perform(method.removePrefix("passive:"), done); return }
        when (method) {
            "startWorkout" -> start(args.optJSONObject(0) ?: JSONObject(), done)
            "pauseWorkout" -> command(CraftHealthServicesService.ACTION_PAUSE, done)
            "resumeWorkout" -> command(CraftHealthServicesService.ACTION_RESUME, done)
            "endWorkout" -> command(CraftHealthServicesService.ACTION_END, done)
            else -> done(failure("UNKNOWN_ACTION", "Unsupported Health Services method"))
        }
    }

    private fun start(options: JSONObject, done: (CraftNativeCapabilityResult) -> Unit) {
        if (activityProvider() == null) return done(failure("NEEDS_ACTIVITY", "Live workouts require a foreground activity"))
        val type = options.optString("type").takeIf { it.isNotBlank() }
            ?: return done(failure("INVALID_ARGUMENT", "startWorkout needs a workout type"))
        if (type !in SUPPORTED_TYPES) return done(failure("INVALID_ARGUMENT", "Unsupported workout type: $type"))
        if (!activeId.compareAndSet(null, "pending")) return done(failure("BUSY", "A live workout is already running"))
        val id = "live-${UUID.randomUUID()}"
        val exerciseType = when (type) {
            "running" -> ExerciseType.RUNNING
            "walking" -> ExerciseType.WALKING
            "hiking" -> ExerciseType.HIKING
            "cycling" -> ExerciseType.BIKING
            else -> null
        } ?: return unsupported(options, done, "Unsupported workout type: $type")
        val future = HealthServices.getClient(context).exerciseClient.getCapabilitiesAsync()
        future.addListener({
            runCatching {
                val capabilities = future.get()
                val requested = setOf(DataType.HEART_RATE_BPM, DataType.CALORIES_TOTAL, DataType.DISTANCE_TOTAL)
                if (exerciseType !in capabilities.supportedExerciseTypes) {
                    return@runCatching unsupported(options, done, "Health Services does not support this workout on this device")
                }
                val typeCapabilities = capabilities.getExerciseTypeCapabilities(exerciseType)
                if (requested.none { it in typeCapabilities.supportedDataTypes }) {
                    return@runCatching unsupported(options, done, "Health Services exposes none of the requested workout metrics")
                }
                startService(id, type, done)
            }.onFailure { unsupported(options, done, it.message ?: "Health Services is unavailable") }
        }, ContextCompat.getMainExecutor(context))
    }

    private fun startService(id: String, type: String, done: (CraftNativeCapabilityResult) -> Unit) {
        activeId.set(id)
        val intent = Intent(context, CraftHealthServicesService::class.java)
            .setAction(CraftHealthServicesService.ACTION_START)
            .putExtra(CraftHealthServicesService.EXTRA_ID, id)
            .putExtra(CraftHealthServicesService.EXTRA_TYPE, type)
        try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) context.startForegroundService(intent) else context.startService(intent)
            done(CraftNativeCapabilityResult(data = JSONObject().put("id", id).put("type", type).put("startDate", System.currentTimeMillis())))
        } catch (error: Exception) {
            activeId.compareAndSet(id, null)
            done(failure("UNAVAILABLE", error.message ?: "Health Services could not start"))
        }
    }

    private fun unsupported(options: JSONObject, done: (CraftNativeCapabilityResult) -> Unit, message: String) {
        activeId.set(null)
        fallback?.invoke("startWorkout", JSONArray().put(options), done)
            ?: done(failure("UNAVAILABLE", message))
    }

    private fun command(action: String, done: (CraftNativeCapabilityResult) -> Unit) {
        val id = activeId.get()?.takeIf { it != "pending" }
            ?: return done(failure("NO_WORKOUT", "No live workout is running"))
        try {
            context.startService(Intent(context, CraftHealthServicesService::class.java).setAction(action).putExtra(CraftHealthServicesService.EXTRA_ID, id))
            if (action == CraftHealthServicesService.ACTION_END) endCompletions[id] = { result -> finishEnd(result, done) }
            else done(CraftNativeCapabilityResult(data = true))
        } catch (error: Exception) {
            if (action == CraftHealthServicesService.ACTION_END) endCompletions.remove(id)
            done(failure("UNAVAILABLE", error.message ?: "Health Services command failed"))
        }
    }

    private fun finishEnd(result: CraftNativeCapabilityResult, done: (CraftNativeCapabilityResult) -> Unit) {
        val payload = result.data as? JSONObject
        if (result.code != null || payload == null || fallback == null) return done(result)
        fallback.invoke("saveWorkout", JSONArray().put(payload)) { saved ->
            if (saved.code != null) return@invoke done(saved)
            val workoutId = (saved.data as? JSONObject)?.optString("id")?.takeIf { it.isNotBlank() }
                ?: payload.optString("id")
            done(CraftNativeCapabilityResult(data = JSONObject()
                .put("id", payload.optString("id"))
                .put("workoutId", workoutId)
                .put("endDate", payload.optLong("endDate"))
                .put("durationSeconds", payload.optDouble("durationSeconds"))))
        }
    }

    companion object {
        private val activeId = AtomicReference<String?>(null)
        private val endCompletions = ConcurrentHashMap<String, (CraftNativeCapabilityResult) -> Unit>()
        private val SUPPORTED_TYPES = setOf("running", "walking", "hiking", "cycling")

        internal fun completeEnd(id: String, result: CraftNativeCapabilityResult) {
            endCompletions.remove(id)?.invoke(result)
        }

        internal fun failEnd(id: String, message: String) {
            completeEnd(id, CraftNativeCapabilityResult(code = "UNAVAILABLE", message = message))
        }

        internal fun clearActive() {
            activeId.set(null)
        }
    }
}
