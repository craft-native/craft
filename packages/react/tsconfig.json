{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  // Tests are not part of the published surface. `build` runs
  // `tsc --emitDeclarationOnly` over this program, so a test file here would
  // both emit a stray declaration and fail the build on `bun:test` and
  // `node:*` types this package does not depend on.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
