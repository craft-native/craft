# Zig build artifacts
zig-cache/
zig-out/
.zig-cache/
# Dependency sources fetched and verified by the pinned Zig compiler.
zig-pkg/

# Compiled binaries
bin/craft-*
packages/typescript/native/

# OS files
.DS_Store
*.swp
*.swo
*~

# Node.js
# Without the slash: a worktree links node_modules rather than holding the directory.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.iml

# Distribution
dist/
release/

# Test outputs
test-app/
artifacts/native-lifecycle/
artifacts/mobile-e2e/

# Logs
*.log
docs/.bunpress/
.env
# The dotenvx private keys. `.env.production` is committed *because* it is
# ciphertext; this is the thing that opens it, and an exact-match `.env` rule
# does not cover it.
.env.keys
/pantry
pantry

# Signing material: the private key and CSR for the Developer ID certificate.
# Never committed — the key here is what signs releases.
.signing/

# Phase 1 iOS slice fixture build output
packages/ios/fixtures/zig-slice/build/

# Android fixture build output. Same reasoning as the iOS slice above: each
# fixture is its own Gradle project, so the output belongs to whoever ran the
# build rather than to the repository. The `.gradle` directory is Gradle's own
# per-project cache and is recreated on the next build.
packages/android/fixtures/*/build/
packages/android/fixtures/*/.gradle/
