# Copy to .env and fill in real values. .env is gitignored — never commit it.

# AWS — used by release workflows that publish artifacts to S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Porkbun — DNS API for *.craft.dev hostnames
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# ── Release signing ────────────────────────────────────────────────
# The macOS signing and notarization credentials are NOT here and are not
# repository secrets. They live encrypted in `.env.production`, which is
# committed; see the header of that file, or `bunx buddy env:get --help`.
#
# CI needs exactly one secret to open it:
#   DOTENV_PRIVATE_KEY_PRODUCTION
