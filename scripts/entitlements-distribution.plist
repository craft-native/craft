<?xml version="1.0" encoding="UTF-8"?>
<!--
  Distribution entitlements for the standalone Craft CLI installed by Pantry.

  App Sandbox requires a bundle identity. This raw executable has no embedded
  Info.plist and must accept user-supplied paths from the shell; enabling App
  Sandbox here traps in libsecinit before main. Hardened runtime is enabled
  separately by codesign's runtime option, and library validation stays on.

  Application bundles have their own identity and entitlement policy, generated
  by the SDK. This plist is only for the standalone CLI release artifact.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow the runtime's JIT under hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
